# b20 -- the deadlock victim is one that was already waiting.
#
# b16 dooms the transaction whose own step closes the cycle,
# which is the easy case: it fails where it stands. Here the
# cycle is closed by the older transaction, so the victim is
# the younger one, and it is already blocked on a lock.
# Nothing is running on its behalf to return an error, so the
# engine must reach the waiter and wake it. T1's step
# succeeds, and T2 resumes with deadlock.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T2 write R1 t2 blocks -> blocked
@5 T1 write R2 t1 -> ok
@4 T2 write R1 t2 blocks -> deadlock (resumed)
@6 check last T1 ok -> satisfied
@7 check last T2 deadlock -> satisfied
@8 T1 commit -> ok
@9 check committed T1 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T2 write R1 t2 blocks -> blocked
@5 T1 write R2 t1 -> ok
@4 T2 write R1 t2 blocks -> deadlock (resumed)
@6 check last T1 ok -> satisfied
@7 check last T2 deadlock -> satisfied
@8 T1 commit -> ok
@9 check committed T1 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T2 write R1 t2 blocks -> blocked
@5 T1 write R2 t1 -> ok
@4 T2 write R1 t2 blocks -> deadlock (resumed)
@6 check last T1 ok -> satisfied
@7 check last T2 deadlock -> satisfied
@8 T1 commit -> ok
@9 check committed T1 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T2 write R1 t2 blocks -> blocked
@5 T1 write R2 t1 -> ok
@4 T2 write R1 t2 blocks -> deadlock (resumed)
@6 check last T1 ok -> satisfied
@7 check last T2 deadlock -> satisfied
@8 T1 commit -> ok
@9 check committed T1 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
