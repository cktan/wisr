# b11 -- two inserts of the same absent row.
#
# An insert takes the row lock on a key that does not exist
# yet, so two inserters serialize on it rather than both
# succeeding.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 insert R2 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R2 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 insert R2 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R2 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 insert R2 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R2 t1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 insert R2 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R2 t1 -> satisfied
