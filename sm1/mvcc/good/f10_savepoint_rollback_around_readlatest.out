# f10 -- READ COMMITTED: a savepoint rollback and the re-read.
#
# T1 commits R1 and R2 after T2 began.
#
# R1: T2's lock is taken after the savepoint, by the write that
# fails with `updated`. readlatest sets the mark on it, then the
# rollback releases the lock and the mark with it, so the write
# is refused again until T2 reads again.
#
# R2: T2 locks it before the savepoint and reads it after. The
# rollback keeps the lock, so it keeps the mark, and the write
# goes ahead.


== pairing RR/RR == T1=RC T2=RC
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 1 -> ok
@2 T1 write R2 1 -> ok
@3 T1 commit -> ok
@4 T2 lock R2 exclusive -> ok
@4 check last T2 ok -> satisfied
@5 T2 savepoint -> 1
@6 T2 write R1 x -> updated
@6 check last T2 updated -> satisfied
@7 T2 readlatest R1 -> 1
@7 check last T2 1 -> satisfied
@7 T2 readlatest R2 -> 1
@7 check last T2 1 -> satisfied
@8 T2 rollback 1 -> ok
@9 T2 write R1 x -> updated
@9 check last T2 updated -> satisfied
@10 T2 write R2 y -> ok
@10 check last T2 ok -> satisfied
@11 T2 readlatest R1 -> 1
@12 T2 write R1 x -> ok
@12 check last T2 ok -> satisfied
@13 T2 commit -> ok
@14 check committed T1 T2 -> satisfied
@14 check row R1 x -> satisfied
@14 check row R2 y -> satisfied
