# f06 -- REPEATABLE READ and SERIALIZABLE: still first-committer.
#
# The f01 timeline at the levels above READ COMMITTED. T2 waits
# for T1's lock, and when T1 commits, T2's write fails with
# `conflict` and aborts T2. Nothing of the read committed
# protocol applies here.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 1 -> ok
@3 T2 write R1 2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check committed T1 -> satisfied
@6 check row R1 1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 1 -> ok
@3 T2 write R1 2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check committed T1 -> satisfied
@6 check row R1 1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 1 -> ok
@3 T2 write R1 2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check committed T1 -> satisfied
@6 check row R1 1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 1 -> ok
@3 T2 write R1 2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check committed T1 -> satisfied
@6 check row R1 1 -> satisfied
