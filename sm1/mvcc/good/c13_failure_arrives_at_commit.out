# c13 -- where a doomed transaction finds out.
#
# The c02 shape, asking a different question: every read and
# write returns ok, doomed or not, and the failure appears at
# the commit. The retry at the end -- each session writing its
# row again, with nobody concurrent -- must then succeed, which
# is what makes SM1_ERR_SERIALIZATION a retryable error.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R1 -> 0
@2 T1 read R2 -> 0
@3 T2 read R1 -> 0
@3 T2 read R2 -> 0
@4 T1 write R1 t1 -> ok
@5 T2 write R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 T1 begin -> ok
@10 T1 write R1 t1 -> ok
@11 T1 commit -> ok
@12 T2 begin -> ok
@13 T2 write R2 t2 -> ok
@14 T2 commit -> ok
@15 check row R1 t1 -> satisfied
@15 check row R2 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R1 -> 0
@2 T1 read R2 -> 0
@3 T2 read R1 -> 0
@3 T2 read R2 -> 0
@4 T1 write R1 t1 -> ok
@5 T2 write R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 T1 begin -> ok
@10 T1 write R1 t1 -> ok
@11 T1 commit -> ok
@12 T2 begin -> ok
@13 T2 write R2 t2 -> ok
@14 T2 commit -> ok
@15 check row R1 t1 -> satisfied
@15 check row R2 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R1 -> 0
@2 T1 read R2 -> 0
@3 T2 read R1 -> 0
@3 T2 read R2 -> 0
@4 T1 write R1 t1 -> ok
@5 T2 write R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 T1 begin -> ok
@10 T1 write R1 t1 -> ok
@11 T1 commit -> ok
@12 T2 begin -> ok
@13 T2 write R2 t2 -> ok
@14 T2 commit -> ok
@15 check row R1 t1 -> satisfied
@15 check row R2 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R1 -> 0
@2 T1 read R2 -> 0
@3 T2 read R1 -> 0
@3 T2 read R2 -> 0
@4 T1 write R1 t1 -> ok
@5 T2 write R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check at-most-one-committed T1 T2 -> satisfied
@9 T1 begin -> ok
@10 T1 write R1 t1 -> ok
@11 T1 commit -> ok
@12 T2 begin -> ok
@13 T2 write R2 t2 -> ok
@14 T2 commit -> ok
@15 check row R1 t1 -> satisfied
@15 check row R2 t2 -> satisfied
