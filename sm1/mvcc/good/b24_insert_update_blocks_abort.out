# b24 -- an update waiting on an uncommitted insert that
# aborts.
#
# b18 has the insert commit, and the update then fails with
# conflict: the row appeared after its snapshot. Here the
# insert aborts instead, so no row ever existed, and the
# waiter must be told notfound rather than conflict. The
# distinction matters to a caller: conflict is retryable and
# notfound is not, and only the outcome of the transaction it
# waited on decides which it gets.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 write R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R2 t2 blocks -> notfound (resumed)
@5 check last T2 notfound -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 - -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 write R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R2 t2 blocks -> notfound (resumed)
@5 check last T2 notfound -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 - -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 write R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R2 t2 blocks -> notfound (resumed)
@5 check last T2 notfound -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 - -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 write R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R2 t2 blocks -> notfound (resumed)
@5 check last T2 notfound -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 - -> satisfied
