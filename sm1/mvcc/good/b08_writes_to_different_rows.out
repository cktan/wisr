# b08 -- writes to different rows never conflict.
#
# The check is per row, not per store: two transactions
# writing disjoint rows are independent, whatever their levels.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T2 write R2 t2 -> ok
@3 T1 delete R3 -> ok
@3 T2 delete R5 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2, R4=t1}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T2 write R2 t2 -> ok
@3 T1 delete R3 -> ok
@3 T2 delete R5 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2, R4=t1}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T2 write R2 t2 -> ok
@3 T1 delete R3 -> ok
@3 T2 delete R5 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2, R4=t1}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T2 write R2 t2 -> ok
@3 T1 delete R3 -> ok
@3 T2 delete R5 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2, R4=t1}
