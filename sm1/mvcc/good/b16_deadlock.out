# b16 -- two writers that wait on each other.
#
# T1 holds R1 and waits for R2; T2 holds R2 and asks for R1,
# closing the cycle. Waiting is not an answer here: nobody
# will ever release, so the engine must break the cycle
# itself. It picks the youngest transaction, T2, which fails
# with deadlock and drops its locks, and T1's wait ends.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 write R2 t1 blocks -> blocked
@5 T2 write R1 t2 -> deadlock
@4 T1 write R2 t1 blocks -> ok (resumed)
@6 check last T2 deadlock -> satisfied
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 write R2 t1 blocks -> blocked
@5 T2 write R1 t2 -> deadlock
@4 T1 write R2 t1 blocks -> ok (resumed)
@6 check last T2 deadlock -> satisfied
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 write R2 t1 blocks -> blocked
@5 T2 write R1 t2 -> deadlock
@4 T1 write R2 t1 blocks -> ok (resumed)
@6 check last T2 deadlock -> satisfied
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 write R2 t1 blocks -> blocked
@5 T2 write R1 t2 -> deadlock
@4 T1 write R2 t1 blocks -> ok (resumed)
@6 check last T2 deadlock -> satisfied
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R1 t1 -> satisfied
@10 check row R2 t1 -> satisfied
