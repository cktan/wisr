# b01 -- read-write-write: the lost update.
#
# T1 reads R1 and means to write it back. T2 gets there first.
# T1's write must fail with a conflict rather than overwrite a
# value it never saw. The conflict is retryable and aborts T1.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
