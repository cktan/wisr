# c17 -- an edge onto a pivot that has already committed.
#
# T3 reads R1; T2 reads R2, writes R1, and commits, so T2 has
# an edge in. T1's write of R2 gives T2 an edge out after it
# committed, making it a pivot; T1, which has no edge of its
# own out, is the one doomed.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing RR/V == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing V/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing V/V == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> serialization
@8 check failed T1 -> satisfied
