# c01 -- one read-write edge is not a cycle.
#
# T1 reads R1, T2 writes it and commits: T1 --rw--> T2, and
# nothing points back. T1 then writes a row nobody read. This
# must commit at every pairing, S+S included: SSI fails a
# transaction only for two adjacent edges with the far one
# committing first.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t2, R2=t1}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t2, R2=t1}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t2, R2=t1}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t2, R2=t1}
