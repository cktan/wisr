# c19 -- reads alone never doom a transaction.
#
# T1 has no incoming edge, so however long it lives and
# whatever it writes afterwards it commits -- here beside a
# concurrent writer, and then again with nothing else running.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> ok
@7 T1 commit -> ok
@8 T1 begin -> ok
@9 T1 read R1 -> t1
@9 T1 scan R1 R2 -> {R1, R2}
@10 T1 write R1 again -> ok
@11 T1 commit -> ok
@12 check committed T1 T2 -> satisfied
@13 check row R1 again -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> ok
@7 T1 commit -> ok
@8 T1 begin -> ok
@9 T1 read R1 -> t1
@9 T1 scan R1 R2 -> {R1, R2}
@10 T1 write R1 again -> ok
@11 T1 commit -> ok
@12 check committed T1 T2 -> satisfied
@13 check row R1 again -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> ok
@7 T1 commit -> ok
@8 T1 begin -> ok
@9 T1 read R1 -> t1
@9 T1 scan R1 R2 -> {R1, R2}
@10 T1 write R1 again -> ok
@11 T1 commit -> ok
@12 check committed T1 T2 -> satisfied
@13 check row R1 again -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R1 t1 -> ok
@7 T1 commit -> ok
@8 T1 begin -> ok
@9 T1 read R1 -> t1
@9 T1 scan R1 R2 -> {R1, R2}
@10 T1 write R1 again -> ok
@11 T1 commit -> ok
@12 check committed T1 T2 -> satisfied
@13 check row R1 again -> satisfied
