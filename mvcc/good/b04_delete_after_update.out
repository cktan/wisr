# b04 -- a delete over a committed update.
#
# A delete is a write like any other and loses to the earlier
# committer.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
@8 check row R1 t2 -> satisfied
