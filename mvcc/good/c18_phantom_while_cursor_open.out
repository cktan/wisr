# c18 -- an insert into a range whose cursor is still open.
#
# The range is registered when the cursor opens, before its
# snapshot, so a row inserted while it is open is caught even
# though the cursor never returns it. T2's read of R3 and T1's
# write of it close the cycle.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T2 read R3 -> 0
@5 T2 insert R2 t2 -> ok
@6 T2 commit -> ok
@7 T1 next C -> R3=0
@8 T1 next C -> end
@9 T1 close C -> ok
@10 T1 write R3 t1 -> ok
@11 T1 commit -> ok
@12 check committed T1 -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T2 read R3 -> 0
@5 T2 insert R2 t2 -> ok
@6 T2 commit -> ok
@7 T1 next C -> R3=0
@8 T1 next C -> end
@9 T1 close C -> ok
@10 T1 write R3 t1 -> ok
@11 T1 commit -> ok
@12 check committed T1 -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T2 read R3 -> 0
@5 T2 insert R2 t2 -> ok
@6 T2 commit -> ok
@7 T1 next C -> R3=0
@8 T1 next C -> end
@9 T1 close C -> ok
@10 T1 write R3 t1 -> ok
@11 T1 commit -> ok
@12 check committed T1 -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T2 read R3 -> 0
@5 T2 insert R2 t2 -> ok
@6 T2 commit -> ok
@7 T1 next C -> R3=0
@8 T1 next C -> end
@9 T1 close C -> ok
@10 T1 write R3 t1 -> ok
@11 T1 commit -> serialization
@12 check failed T1 -> satisfied
