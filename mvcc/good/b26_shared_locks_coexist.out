# b26 -- two shared locks on one row, and a writer behind
# them.
#
# The first mode of sm_lock. A shared lock is not a write, so
# two transactions may hold one row at once and neither waits;
# what it excludes is writing. T3's write therefore queues
# behind both, and one holder leaving is not enough -- the
# lock is free only when the last of them ends. Nothing was
# written, so the waiter finds the row as its snapshot has it
# and succeeds.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 lock R1 shared -> ok
@3 T2 lock R1 shared -> ok
@4 T3 write R1 t3 blocks -> blocked
@5 T1 commit -> ok
@6 T2 commit -> ok
@4 T3 write R1 t3 blocks -> ok (resumed)
@7 check last T3 ok -> satisfied
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t3 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 lock R1 shared -> ok
@3 T2 lock R1 shared -> ok
@4 T3 write R1 t3 blocks -> blocked
@5 T1 commit -> ok
@6 T2 commit -> ok
@4 T3 write R1 t3 blocks -> ok (resumed)
@7 check last T3 ok -> satisfied
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t3 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 lock R1 shared -> ok
@3 T2 lock R1 shared -> ok
@4 T3 write R1 t3 blocks -> blocked
@5 T1 commit -> ok
@6 T2 commit -> ok
@4 T3 write R1 t3 blocks -> ok (resumed)
@7 check last T3 ok -> satisfied
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t3 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 lock R1 shared -> ok
@3 T2 lock R1 shared -> ok
@4 T3 write R1 t3 blocks -> blocked
@5 T1 commit -> ok
@6 T2 commit -> ok
@4 T3 write R1 t3 blocks -> ok (resumed)
@7 check last T3 ok -> satisfied
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t3 -> satisfied
