# b09 -- a write waits for the row lock, then conflicts.
#
# T1 holds the row lock on R1. T2's write of the same row must
# wait rather than produce a version nobody asked for, and once
# T1 commits, T2 must lose first-committer-wins.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R1 t1 -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R1 t1 -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R1 t1 -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 t2 blocks -> conflict (resumed)
@5 check last T2 conflict -> satisfied
@6 check row R1 t1 -> satisfied
