# c16 -- a point read that steps past a newer version.
#
# T2 reads R2, writes R1, and commits. T1 then reads R1 and
# steps past T2's newer version, which is T1 --rw--> T2, and
# writes R2, which T2 read: T2 --rw--> T1. T2 is a committed
# pivot, so T1 is the one that must fail.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 read R2 -> 0
@3 T2 write R1 t2 -> ok
@4 T2 commit -> ok
@5 T1 read R1 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R2 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 read R2 -> 0
@3 T2 write R1 t2 -> ok
@4 T2 commit -> ok
@5 T1 read R1 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R2 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 read R2 -> 0
@3 T2 write R1 t2 -> ok
@4 T2 commit -> ok
@5 T1 read R1 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
@9 check row R2 t1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 read R2 -> 0
@3 T2 write R1 t2 -> ok
@4 T2 commit -> ok
@5 T1 read R1 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> serialization
@8 check failed T1 -> satisfied
@9 check row R2 0 -> satisfied
