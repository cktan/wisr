# b02 -- write-write with no read at all.
#
# T1 never reads R1, and still conflicts: the rule compares the
# row's newest committed version with T1's snapshot, not with
# anything T1 read.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 write R1 t2 -> ok
@3 T2 commit -> ok
@4 T1 write R1 t1 -> conflict
@5 check last T1 conflict -> satisfied
@6 check row R1 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 write R1 t2 -> ok
@3 T2 commit -> ok
@4 T1 write R1 t1 -> conflict
@5 check last T1 conflict -> satisfied
@6 check row R1 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 write R1 t2 -> ok
@3 T2 commit -> ok
@4 T1 write R1 t1 -> conflict
@5 check last T1 conflict -> satisfied
@6 check row R1 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T2 write R1 t2 -> ok
@3 T2 commit -> ok
@4 T1 write R1 t1 -> conflict
@5 check last T1 conflict -> satisfied
@6 check row R1 t2 -> satisfied
