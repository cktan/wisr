# a11 -- a point read of a row that did not exist yet.
#
# The read keeps saying "no row". T1 only reads here; the
# version where it goes on to insert R2 itself is c05.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R2 -> -
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check row R2 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R2 -> -
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check row R2 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R2 -> -
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check row R2 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R2 -> -
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check row R2 t2 -> satisfied
