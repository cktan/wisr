# b05 -- a delete over a committed delete.
#
# Two transactions deleting one row is a write-write conflict.
# The loser must be told to retry, not told the row was never
# there.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 delete R1 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 delete R1 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 delete R1 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T2 begin -> ok
@4 T2 delete R1 -> ok
@5 T2 commit -> ok
@6 T1 delete R1 -> conflict
@7 check last T1 conflict -> satisfied
