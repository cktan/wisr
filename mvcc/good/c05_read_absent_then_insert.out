# c05 -- reading a row that is not there counts as a read.
#
# Each transaction inserts exactly the row the other looked for
# and did not find, so the edges run both ways even though
# neither read returned anything.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R2 -> -
@3 T2 read R1 -> -
@4 T1 insert R1 t1 -> ok
@5 T2 insert R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R2 -> -
@3 T2 read R1 -> -
@4 T1 insert R1 t1 -> ok
@5 T2 insert R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R2 -> -
@3 T2 read R1 -> -
@4 T1 insert R1 t1 -> ok
@5 T2 insert R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 read R2 -> -
@3 T2 read R1 -> -
@4 T1 insert R1 t1 -> ok
@5 T2 insert R2 t2 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check at-most-one-committed T1 T2 -> satisfied
