# c25 -- a cursor closed without reading anything.
#
# The limit of c24's narrowing: a cursor that never called
# next examined no key, so it read nothing and its predicate
# goes away entirely. T2 may then write anywhere in the range
# it asked for, and only T2 --rw--> T1 remains -- one edge,
# and not a cycle.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 close C -> ok
@4 T2 write R1 t2 -> ok
@5 T2 read R2 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 close C -> ok
@4 T2 write R1 t2 -> ok
@5 T2 read R2 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 close C -> ok
@4 T2 write R1 t2 -> ok
@5 T2 read R2 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 close C -> ok
@4 T2 write R1 t2 -> ok
@5 T2 read R2 -> 0
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
