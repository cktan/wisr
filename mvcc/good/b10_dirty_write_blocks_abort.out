# b10 -- a write waits for the row lock, then proceeds.
#
# The other half of b09: an aborted write is no write at all,
# so the waiter has nothing to lose to and its write succeeds.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R1 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check row R1 t2 -> satisfied
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R1 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check row R1 t2 -> satisfied
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R1 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check row R1 t2 -> satisfied
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R1 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 write R1 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check row R1 t2 -> satisfied
