# a06 -- no phantom from an insert.
#
# R2 is inserted after T1's snapshot, so no repeated read of
# the range may show it. Whether T1 could then WRITE on the
# strength of its scan is c03, not this.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 scan R1 R3 -> {R1, R3}
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 scan R1 R3 -> {R1, R3}
@6 T1 scan R2 R2 -> {}
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check rows -> {R1=0, R2=t2, R3=0}
== pairing RR/V == T1=RR T2=SER
