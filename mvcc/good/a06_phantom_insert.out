@2 T1 scan R1 R3 -> {R1, R3}
@3 T2 begin -> ok
@4 T2 insert R2 t2 -> ok
@5 T2 commit -> ok
@6 T1 scan R1 R3 -> {R1, R3}
@6 T1 scan R2 R2 -> {}
@6 T1 read R2 -> -
@7 T1 commit -> ok
@8 check rows -> {R1=0, R2=t2, R3=0}
