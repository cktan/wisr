# c06 -- the dangerous structure with three transactions.
#
#   T1 --rw--> T2 --rw--> T3, and T3 commits first.
#
# T2 is the pivot. T3 takes T2's level, so S+S means all three
# are SERIALIZABLE and T2 must fail. In either mixed pairing
# one link of the chain is an untracked REPEATABLE READ read,
# so nothing fails.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 commit -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t2 -> satisfied
@11 check row R2 t3 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 commit -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@11 check row R2 t3 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 commit -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@11 check row R2 t3 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 commit -> ok
@7 T2 commit -> serialization
@8 T1 commit -> ok
@9 check failed T2 -> satisfied
@9 check committed T1 T3 -> satisfied
@10 check row R1 0 -> satisfied
@11 check row R2 t3 -> satisfied
