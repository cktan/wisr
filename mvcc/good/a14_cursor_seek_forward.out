@7 T1 seek C R1 -> invalid
@8 check last T1 invalid -> satisfied
@9 T1 next C -> R7=7
@10 T1 close C -> ok
@11 T1 commit -> ok
@12 check row R5 later -> satisfied
@12 check row R7 later -> satisfied
