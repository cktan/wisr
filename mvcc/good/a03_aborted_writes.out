# a03 -- an aborted transaction leaves nothing behind.
#
# T1 writes, deletes, and inserts, then aborts. T2 must see the
# original rows and must be free to write the same rows: an
# aborted write leaves no version and no lock.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@2 T1 insert R3 t1 -> ok
@3 T1 abort -> ok
@4 T2 begin -> ok
@5 T2 read R1 -> 0
@5 T2 read R2 -> 0
@5 T2 read R3 -> -
@6 T2 write R1 t2 -> ok
@6 T2 delete R2 -> ok
@6 T2 insert R3 t2 -> ok
@7 T2 commit -> ok
@8 check rows -> {R1=t2, R3=t2}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@2 T1 insert R3 t1 -> ok
@3 T1 abort -> ok
@4 T2 begin -> ok
@5 T2 read R1 -> 0
@5 T2 read R2 -> 0
@5 T2 read R3 -> -
@6 T2 write R1 t2 -> ok
@6 T2 delete R2 -> ok
@6 T2 insert R3 t2 -> ok
@7 T2 commit -> ok
@8 check rows -> {R1=t2, R3=t2}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@2 T1 insert R3 t1 -> ok
@3 T1 abort -> ok
@4 T2 begin -> ok
@5 T2 read R1 -> 0
@5 T2 read R2 -> 0
@5 T2 read R3 -> -
@6 T2 write R1 t2 -> ok
@6 T2 delete R2 -> ok
@6 T2 insert R3 t2 -> ok
@7 T2 commit -> ok
@8 check rows -> {R1=t2, R3=t2}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@2 T1 insert R3 t1 -> ok
@3 T1 abort -> ok
@4 T2 begin -> ok
@5 T2 read R1 -> 0
@5 T2 read R2 -> 0
@5 T2 read R3 -> -
@6 T2 write R1 t2 -> ok
@6 T2 delete R2 -> ok
@6 T2 insert R3 t2 -> ok
@7 T2 commit -> ok
@8 check rows -> {R1=t2, R3=t2}
