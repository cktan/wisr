# a12 -- the commit boundary decides what a snapshot sees.
#
# T2 begins before T1 commits and must see nothing of it, ever.
# T3 begins afterwards and sees all of it. Visibility is by
# commit order against each snapshot, not by who asked first.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 read R1 -> 0
@4 T2 read R2 -> -
@5 T1 commit -> ok
@6 T2 read R1 -> 0
@6 T2 read R2 -> -
@7 T2 commit -> ok
@8 T3 begin -> ok
@9 T3 read R1 -> t1
@9 T3 read R2 -> t1
@10 T3 commit -> ok
== pairing RR/V == T1=RR T2=SER T3=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 read R1 -> 0
@4 T2 read R2 -> -
@5 T1 commit -> ok
@6 T2 read R1 -> 0
@6 T2 read R2 -> -
@7 T2 commit -> ok
@8 T3 begin -> ok
@9 T3 read R1 -> t1
@9 T3 read R2 -> t1
@10 T3 commit -> ok
== pairing V/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 read R1 -> 0
@4 T2 read R2 -> -
@5 T1 commit -> ok
@6 T2 read R1 -> 0
@6 T2 read R2 -> -
@7 T2 commit -> ok
@8 T3 begin -> ok
@9 T3 read R1 -> t1
@9 T3 read R2 -> t1
@10 T3 commit -> ok
== pairing V/V == T1=SER T2=SER T3=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 read R1 -> 0
@4 T2 read R2 -> -
@5 T1 commit -> ok
@6 T2 read R1 -> 0
@6 T2 read R2 -> -
@7 T2 commit -> ok
@8 T3 begin -> ok
@9 T3 read R1 -> t1
@9 T3 read R2 -> t1
@10 T3 commit -> ok
