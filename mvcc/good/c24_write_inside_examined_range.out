# c24 -- a write inside the part an early-closed cursor read.
#
# The other half of c11. There T2's insert landed past the key
# T1 stopped at, and the narrowed predicate let it through;
# here T2 writes R1, which T1 did read before closing. The
# narrowing must keep that key, so T1 --rw--> T2 stands, and
# with T2 --rw--> T1 from T1's write of R2 the cycle is closed.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T1 close C -> ok
@5 T2 write R1 t2 -> ok
@6 T2 read R2 -> 0
@7 T1 write R2 t1 -> ok
@8 T1 commit? -> recorded
@9 T2 commit? -> recorded
@10 check committed T1 T2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T1 close C -> ok
@5 T2 write R1 t2 -> ok
@6 T2 read R2 -> 0
@7 T1 write R2 t1 -> ok
@8 T1 commit? -> recorded
@9 T2 commit? -> recorded
@10 check committed T1 T2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T1 close C -> ok
@5 T2 write R1 t2 -> ok
@6 T2 read R2 -> 0
@7 T1 write R2 t1 -> ok
@8 T1 commit? -> recorded
@9 T2 commit? -> recorded
@10 check committed T1 T2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 open C R1 R5 -> ok
@3 T1 next C -> R1=0
@4 T1 close C -> ok
@5 T2 write R1 t2 -> ok
@6 T2 read R2 -> 0
@7 T1 write R2 t1 -> ok
@8 T1 commit? -> recorded
@9 T2 commit? -> recorded
@10 check at-most-one-committed T1 T2 -> satisfied
