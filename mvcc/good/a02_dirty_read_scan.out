# a02 -- dirty read through a scan, for an insert and a delete.
#
# T1 inserts R3 and deletes R2 without committing. T2's scan
# must show neither, and must not change when T1 commits.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 delete R2 -> ok
@3 T2 scan R1 R3 -> {R1, R2}
@4 T1 commit -> ok
@5 T2 scan R1 R3 -> {R1, R2}
@6 T2 commit -> ok
@7 check rows -> {R1=0, R3=t1}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 delete R2 -> ok
@3 T2 scan R1 R3 -> {R1, R2}
@4 T1 commit -> ok
@5 T2 scan R1 R3 -> {R1, R2}
@6 T2 commit -> ok
@7 check rows -> {R1=0, R3=t1}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 delete R2 -> ok
@3 T2 scan R1 R3 -> {R1, R2}
@4 T1 commit -> ok
@5 T2 scan R1 R3 -> {R1, R2}
@6 T2 commit -> ok
@7 check rows -> {R1=0, R3=t1}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 delete R2 -> ok
@3 T2 scan R1 R3 -> {R1, R2}
@4 T1 commit -> ok
@5 T2 scan R1 R3 -> {R1, R2}
@6 T2 commit -> ok
@7 check rows -> {R1=0, R3=t1}
