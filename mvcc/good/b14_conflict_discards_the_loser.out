# b14 -- what the loser of a conflict leaves behind.
#
# T1's earlier writes go with it: the conflict aborts the whole
# transaction, so R1 and R2 keep their old values and only T2's
# change survives.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 write R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 write R3 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R3 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 T1 commit -> notrans
@9 check last T1 notrans -> satisfied
@10 check rows -> {R1=0, R2=0, R3=t2}
== pairing RR/V == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 write R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 write R3 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R3 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 T1 commit -> notrans
@9 check last T1 notrans -> satisfied
@10 check rows -> {R1=0, R2=0, R3=t2}
== pairing V/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 write R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 write R3 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R3 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 T1 commit -> notrans
@9 check last T1 notrans -> satisfied
@10 check rows -> {R1=0, R2=0, R3=t2}
== pairing V/V == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 write R1 t1 -> ok
@2 T1 write R2 t1 -> ok
@3 T2 begin -> ok
@4 T2 write R3 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R3 t1 -> conflict
@7 check last T1 conflict -> satisfied
@8 T1 commit -> notrans
@9 check last T1 notrans -> satisfied
@10 check rows -> {R1=0, R2=0, R3=t2}
