# a09 -- a cursor does not see writes made after it opened.
#
# T1 opens a cursor, then updates each row the cursor returns
# and inserts another inside the range. The cursor must go on
# returning the rows as they were, and must never return R4.
# This is what makes "scan a range and update every row in it"
# terminate.


== pairing RR/RR == T1=RR
@1 T1 begin -> ok
@2 T1 open C R1 R4 -> ok
@3 T1 next C -> R1=0
@4 T1 write R1 t1 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 next C -> R2=0
@6 T1 write R2 t1 -> ok
@7 T1 next C -> R3=0
@8 T1 write R3 t1 -> ok
@9 T1 next C -> end
@10 T1 close C -> ok
@11 T1 scan R1 R4 -> {R1, R2, R3, R4}
@12 T1 commit -> ok
@13 check rows -> {R1=t1, R2=t1, R3=t1, R4=t1}
== pairing RR/S == T1=RR
@1 T1 begin -> ok
@2 T1 open C R1 R4 -> ok
@3 T1 next C -> R1=0
@4 T1 write R1 t1 -> ok
@4 T1 insert R4 t1 -> ok
@5 T1 next C -> R2=0
@6 T1 write R2 t1 -> ok
@7 T1 next C -> R3=0
@8 T1 write R3 t1 -> ok
@9 T1 next C -> end
@10 T1 close C -> ok
@11 T1 scan R1 R4 -> {R1, R2, R3, R4}
@12 T1 commit -> ok
@13 check rows -> {R1=t1, R2=t1, R3=t1, R4=t1}
