# a08 -- a transaction reads its own writes.
#
# Its inserts, updates and deletes are visible to it before
# commit, through both read paths, including a row it inserted
# and then overwrote and deleted.


== pairing RR/RR == T1=RR
@1 T1 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@3 T1 read R1 -> t1
@3 T1 read R2 -> -
@3 T1 read R3 -> t1
@3 T1 scan R1 R3 -> {R1, R3}
@4 T1 write R3 again -> ok
@5 T1 read R3 -> again
@6 T1 delete R3 -> ok
@7 T1 read R3 -> -
@7 T1 scan R1 R3 -> {R1}
@8 T1 commit -> ok
@9 check rows -> {R1=t1}
== pairing RR/S == T1=RR
@1 T1 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@3 T1 read R1 -> t1
@3 T1 read R2 -> -
@3 T1 read R3 -> t1
@3 T1 scan R1 R3 -> {R1, R3}
@4 T1 write R3 again -> ok
@5 T1 read R3 -> again
@6 T1 delete R3 -> ok
@7 T1 read R3 -> -
@7 T1 scan R1 R3 -> {R1}
@8 T1 commit -> ok
@9 check rows -> {R1=t1}
== pairing S/RR == T1=SER
@1 T1 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@3 T1 read R1 -> t1
@3 T1 read R2 -> -
@3 T1 read R3 -> t1
@3 T1 scan R1 R3 -> {R1, R3}
@4 T1 write R3 again -> ok
@5 T1 read R3 -> again
@6 T1 delete R3 -> ok
@7 T1 read R3 -> -
@7 T1 scan R1 R3 -> {R1}
@8 T1 commit -> ok
@9 check rows -> {R1=t1}
== pairing S/S == T1=SER
@1 T1 begin -> ok
@2 T1 insert R3 t1 -> ok
@2 T1 write R1 t1 -> ok
@2 T1 delete R2 -> ok
@3 T1 read R1 -> t1
