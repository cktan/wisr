# b15 -- a write after the reader is done.
#
# Nothing to detect: this is the serial history T1, T2. A level
# that conflicted here would make read-then-write impossible.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 commit -> ok
@4 T2 begin -> ok
@5 T2 write R1 t2 -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 commit -> ok
@4 T2 begin -> ok
@5 T2 write R1 t2 -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 commit -> ok
@4 T2 begin -> ok
@5 T2 write R1 t2 -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 commit -> ok
@4 T2 begin -> ok
@5 T2 write R1 t2 -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
