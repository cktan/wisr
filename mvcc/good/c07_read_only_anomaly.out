# c07 -- Fekete's read-only anomaly.
#
# Savings R1 and checking R2 both hold 0, and a withdrawal from
# an overdrawn total costs 1 more. T2 reads both and decides on
# 12; T1's deposit of 20 commits; T3 reads and sees 20 and 0 --
# a state no serial order produces once T2 commits its
# penalty-priced withdrawal. T3 only reads, and is still a full
# participant: at V+V not all three may commit.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T2 begin -> ok
@2 T2 read R1 -> 0
@2 T2 read R2 -> 0
@3 T1 begin -> ok
@4 T1 write R1 20 -> ok
@5 T1 commit -> ok
@6 T3 begin -> ok
@7 T3 read R1 -> 20
@7 T3 read R2 -> 0
@8 T3 commit? -> recorded
@9 T2 write R2 -12 -> ok
@10 T2 commit? -> recorded
@11 check committed T1 T2 T3 -> satisfied
@12 check row R2 -12 -> satisfied
== pairing RR/V == T1=RR T2=SER T3=SER
@1 T2 begin -> ok
@2 T2 read R1 -> 0
@2 T2 read R2 -> 0
@3 T1 begin -> ok
@4 T1 write R1 20 -> ok
@5 T1 commit -> ok
@6 T3 begin -> ok
@7 T3 read R1 -> 20
@7 T3 read R2 -> 0
@8 T3 commit? -> recorded
@9 T2 write R2 -12 -> ok
@10 T2 commit? -> recorded
@11 check committed T1 T2 T3 -> satisfied
== pairing V/RR == T1=SER T2=RR T3=RR
@1 T2 begin -> ok
@2 T2 read R1 -> 0
@2 T2 read R2 -> 0
@3 T1 begin -> ok
@4 T1 write R1 20 -> ok
@5 T1 commit -> ok
@6 T3 begin -> ok
@7 T3 read R1 -> 20
@7 T3 read R2 -> 0
@8 T3 commit? -> recorded
@9 T2 write R2 -12 -> ok
@10 T2 commit? -> recorded
@11 check committed T1 T2 T3 -> satisfied
== pairing V/V == T1=SER T2=SER T3=SER
@1 T2 begin -> ok
@2 T2 read R1 -> 0
@2 T2 read R2 -> 0
@3 T1 begin -> ok
@4 T1 write R1 20 -> ok
@5 T1 commit -> ok
@6 T3 begin -> ok
@7 T3 read R1 -> 20
@7 T3 read R2 -> 0
@8 T3 commit? -> recorded
@9 T2 write R2 -12 -> ok
@10 T2 commit? -> recorded
@11 check not-all-committed T1 T2 T3 -> satisfied
