# c10 -- the reader finishes before the writer starts.
#
# The shape of c02 with the concurrency removed: T2 begins only
# after T1 committed, so the history is the serial one. This
# must never fail.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 write R2 t1 -> ok
@4 T1 commit -> ok
@5 T2 begin -> ok
@6 T2 read R2 -> t1
@7 T2 write R1 t2 -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 write R2 t1 -> ok
@4 T1 commit -> ok
@5 T2 begin -> ok
@6 T2 read R2 -> t1
@7 T2 write R1 t2 -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 write R2 t1 -> ok
@4 T1 commit -> ok
@5 T2 begin -> ok
@6 T2 read R2 -> t1
@7 T2 write R1 t2 -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T1 write R2 t1 -> ok
@4 T1 commit -> ok
@5 T2 begin -> ok
@6 T2 read R2 -> t1
@7 T2 write R1 t2 -> ok
@8 T2 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check rows -> {R1=t2, R2=t1}
