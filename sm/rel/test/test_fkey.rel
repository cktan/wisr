# test_fkey.rel -- foreign keys in sm's catalog, through the C API
# (FOREIGNKEY.md): kept, loaded back, and kept true by the DDL on the
# tables they join. sm keeps them; the host checks the rows, so no row is
# checked here.
#
# 1. A foreign key is kept with every field, and its parent lists it.
# 2. One that does not fit its tables is refused: a taken name, columns
#    that are not there or not the parent index's, unequal ends.
# 3. While it is there, the parent and its index cannot be dropped:
#    ERR_INUSE. (rel drops no column; sm3's test_fkey.cc checks one.)
# 4. It is validated, renamed and dropped; a child dropped takes its keys
#    out of its parent's list.
# 5. After a restart it is there again, and its parent lists it.
# 6. A key between a temporary table and a permanent one is refused.
# 7. Adding a key takes the parent's lock X: another session's write to
#    the parent is blocked until it commits.
# 8. A key between two temporary tables made in the open transaction is
#    listed by the parent at once, as after the commit: digres refuses a
#    commit that would empty a parent its child does not empty by it
#    (dg WORKNOTE.md step 303).

(def test-dir (string (or (os/getenv "REL_TMP") "/tmp") "/wisr_rel_test_fkey"))
(rm-rf test-dir)
(env-init test-dir)
(env-attach test-dir)
(db-create "fkdb")

(session-open s1 "fkdb")
(session-open s2 "fkdb")

# The parent p with its unique index on id, and the child c.
(session-use s1)
(begin :rc)
(table-create p (columns (id :int4 :not-null) (x :text)))
(index-create p_id (table p) (key (id :asc)) :unique true)
(index-create p_x (table p) (key (x :asc)) :unique false)
(table-create c (columns (a :int4) (pid :int4)))
(commit)

# 1. Kept with every field; the parent lists it.
(begin :rc)
(fkey-create c_pid (table c) (columns pid) (references p id)
  :on-delete :cascade :match :full)
(commit)
(begin :rc)
(assert-eq (fkeys c)
           '[{:name "c_pid" :columns [pid] :references "p" :ref-columns [id]
              :on-delete :cascade :on-update :no-action :match :full
              :validated true}])
(assert-eq (referenced-by p) '[["c" "c_pid"]])
(assert-eq (referenced-by c) '[])
(commit)

# 2. What does not fit is refused, and leaves nothing.
(begin :rc)
(assert-err :err-dupkey
  (fkey-create c_pid (table c) (columns pid) (references p id)))
(assert-err :err-invalid
  (fkey-create c_bad (table c) (columns pid) (references p id) :index p_x))
(assert-err :err-invalid
  (fkey-create c_bad (table c) (columns a pid) (references p id) :index p_id))
(commit)
(begin :rc)
(assert-eq (length (fkeys c)) 1)
(commit)

# 3. The parent and its index stay while it is there.
(begin :rc)
(assert-err :err-inuse (table-drop p))
(abort)
(begin :rc)
(assert-err :err-inuse (index-drop p_id))
(abort)

# 4. Validated, renamed and dropped; a dropped child leaves its parent.
(begin :rc)
(fkey-create c_a (table c) (columns a) (references p id) :not-valid true)
(commit)
(begin :rc)
(assert-eq ((get (fkeys c) 1) :validated) false)
(fkey-validate c c_a)
(assert-err :err-dupkey (fkey-rename c c_a c_pid))
(fkey-rename c c_a c_a2)
(commit)
(begin :rc)
(assert-eq (map |($ :name) (fkeys c)) @["c_pid" "c_a2"])
(assert-eq ((get (fkeys c) 1) :validated) true)
(assert-eq (referenced-by p) '[["c" "c_a2"] ["c" "c_pid"]])
(fkey-drop c c_a2)
(commit)
(begin :rc)
(assert-eq (referenced-by p) '[["c" "c_pid"]])
(table-create d (columns (pid :int4)))
(fkey-create d_pid (table d) (columns pid) (references p id))
(commit)
(begin :rc)
(table-drop d)
(commit)
(begin :rc)
(assert-eq (referenced-by p) '[["c" "c_pid"]])
(commit)

# 5. After a restart: still there, and still listed by its parent.
(env-detach :force true)
(env-attach test-dir)
(session-open s1 "fkdb")
(session-open s2 "fkdb")
(session-use s1)
(begin :rc)
(assert-eq (map |($ :name) (fkeys c)) @["c_pid"])
(assert-eq (referenced-by p) '[["c" "c_pid"]])
(commit)

# 6. Not between a temporary table and a permanent one.
(begin :rc)
(temp-table-create tc (columns (pid :int4)))
(assert-err :err-invalid
  (fkey-create tc_pid (table tc) (columns pid) (references p id)))
(commit)

# 7. Adding a key holds the parent X: s2's write to it waits.
(session-use s2)
(qa-nowait true)
(session-use s1)
(begin :rc)
(table-create e (columns (pid :int4)))
(commit)
(begin :rc)
(fkey-create e_pid (table e) (columns pid) (references p id))
(session-use s2)
(begin :rc)
(assert-err :err-blocked (insert p [1 "one"]))
(abort)
(session-use s1)
(commit)
(session-use s2)
(begin :rc)
(insert p [1 "one"])
(commit)

# 8. Temporary tp8 and tc8, tc8 keyed to tp8, all in one transaction:
# tp8 lists tc8's key before the commit and after it.
(session-use s1)
(begin :rc)
(temp-table-create tp8 (columns (id :int4 :not-null)))
(index-create tp8_id (table tp8) (key (id :asc)) :unique true)
(temp-table-create tc8 (columns (pid :int4)))
(fkey-create tc8_pid (table tc8) (columns pid) (references tp8 id))
(assert-eq (referenced-by tp8) '[["tc8" "tc8_pid"]])
(commit)
(begin :rc)
(assert-eq (referenced-by tp8) '[["tc8" "tc8_pid"]])
(commit)

(session-close s1)
(session-close s2)
(env-detach :force true)
(rm-rf test-dir)
(print "test_fkey.rel passed")
