# test_tree.rel -- secondary indexes made trees (../BTREEINDEX.md), through sm.h:
# a scan of a tree's rows gives each row while it has its entry's key; its
# dead entries stay until (compact) removes them.

(def test-dir (string (or (os/getenv "REL_TMP") "/tmp") "/wisr_rel_test_tree"))
(rm-rf test-dir)
(env-init test-dir)
(env-attach test-dir)

(db-create "treedb")
(db-open "treedb")

# The id column of each row a scan gives, in its order.
(defn ids [rows] (map (fn [r] ((r 1) 0)) rows))

# Verify a tree's scan of rows against the writes that move them.
# 1. Make a keyless table and a tree on its state, and insert rows.
# 2. The tree's struct says :tree; a range and an equality give the rows
#    with those states, in the tree's order.
# 3. Move a row off its state and back, move another, delete a third,
#    and roll an insert back: each scan gives each row once, as it is.
(begin :rc)
(table-create jobs
  (columns
    (id :int4 :not-null)
    (state :text)
    (owner :text)))
(index-create jobs_state (table jobs) (key (state :asc)) :tree true)
(insert jobs [1 "a" "Ann"])
(insert jobs [2 "b" "Bob"])
(insert jobs [3 "b" "Cy"])
(insert jobs [4 "b" "Di"])
(insert jobs [5 "c" "Ed"])
(commit)

# A snapshot from before the changes below, for (compact) to keep.
(session-open "old" "treedb")
(session-use "old")
(begin :rr)
(assert-count 5 (scan jobs))
(session-use "default")

(begin :rc)
(def desc (describe-table jobs :include-indices))
(assert-eq ((first (desc :indexes)) :tree) true)
(assert-eq (ids (idx-rows jobs_state :ge ["b"] :le ["b"])) @[2 3 4])
(assert-eq (ids (idx-rows jobs_state :gt ["a"])) @[2 3 4 5])
(update jobs 2 [2 "c" "Bob"])
(update jobs 3 [3 "a" "Cy"])
(update jobs 3 [3 "b" "Cy"])
(delete jobs 4)
(commit)
(begin :rc)
(insert jobs [9 "b" "Gone"])
(abort)

(begin :rc)
(assert-eq (ids (idx-rows jobs_state :ge ["b"] :le ["b"])) @[3])
(assert-eq (ids (idx-rows jobs_state :ge ["c"] :le ["c"])) @[2 5])
(assert-eq (ids (idx-rows jobs_state)) @[1 3 2 5])
(assert-eq ((first (idx-rows jobs_state :ge ["a"] :le ["a"])) 1) [1 "a" "Ann"])
(commit)

# Verify (compact), VACUUM, removes the entries no snapshot needs.
# 1. The tree holds 8 entries for 4 rows: b's of 2, a's of 3, 4's, 9's.
# 2. While the older snapshot, taken before the changes, is open, compact
#    leaves the entries its rows may still be read with; the aborted
#    insert's goes.
# 3. Once it ends, compact leaves one entry a row.
(begin :rc)
(assert-eq (idx-entries jobs_state) 8)
(commit)
(begin :rc)
(compact jobs)
(assert-eq (idx-entries jobs_state) 7)
(commit)
(session-use "old")
(commit)
(session-close "old")
(session-use "default")
(begin :rc)
(compact jobs)
(assert-eq (idx-entries jobs_state) 4)
(assert-eq (ids (idx-rows jobs_state)) @[1 3 2 5])
(commit)

# Verify a tree of an expression, and a partial one, recheck their rows
# as a write computes their keys.
# 1. Make a tree on (lower owner), and one on state where state is "free".
# 2. Rename an owner, and take a row off "free": neither is given under
#    its old entry.
(begin :rc)
(index-create jobs_owner (table jobs) (key ((lower owner) :asc)) :tree true)
(index-create jobs_free (table jobs) (key (id :asc)) :where (state "free")
  :tree true)
(commit)
(index-wait jobs_owner)
(index-wait jobs_free)
(begin :rc)
(def fay (insert jobs [6 "free" "FAY"]))
(def gus (insert jobs [7 "free" "gus"]))
(assert-eq (ids (idx-rows jobs_owner :ge ["fay"] :le ["fay"])) @[6])
(assert-eq (ids (idx-rows jobs_free)) @[6 7])
(update jobs fay [6 "free" "Hal"])
(update jobs gus [7 "busy" "gus"])
(assert-eq (idx-rows jobs_owner :ge ["fay"] :le ["fay"]) @[])
(assert-eq (ids (idx-rows jobs_owner :ge ["hal"] :le ["hal"])) @[6])
(assert-eq (ids (idx-rows jobs_free)) @[6])
(commit)

# Verify a tree of a table with a primary key, made on its rows, and what
# a truncate does.
# 1. Make accounts keyed by id, with rows, then a tree on its owner: the
#    build fills it, and it gives the rows by their key.
# 2. TRUNCATE leaves the tree empty, and a row inserted after is given.
(begin :rc)
(table-create accounts (columns (id :int4 :not-null) (owner :text))
  (primary-key id))
(commit)
(begin :rc)
(insert accounts [10 "x"])
(insert accounts [20 "y"])
(insert accounts [30 "x"])
(commit)
(begin :rc)
(index-create accounts_owner (table accounts) (key (owner :asc)) :tree true)
(commit)
(index-wait accounts_owner)
(begin :rc)
(assert-eq (ids (idx-rows accounts_owner :ge ["x"] :le ["x"])) @[10 30])
(truncate accounts)
(assert-eq (idx-rows accounts_owner) @[])
(insert accounts [40 "x"])
(assert-eq (ids (idx-rows accounts_owner)) @[40])
(commit)

# Verify a unique tree refuses a key a live row has (../BTREEINDEX.md §7).
# 1. Make a unique tree on a new owner column's values: a second
#    owner y is refused, and leaves nothing.
# 2. Delete y's row and insert y again: taken, its old entry dead.
# 3. Rows with no owner are many.
(begin :rc)
(index-create accounts_u (table accounts) (key (owner :asc)) :unique true
  :tree true)
(commit)
(index-wait accounts_u)
(begin :rc)
(insert accounts [50 "y"])
(commit)
(begin :rc)
(assert-err :err-dupkey (insert accounts [60 "y"]))
(abort)
(begin :rc)
(assert-eq (ids (idx-rows accounts_u :ge ["y"] :le ["y"])) @[50])
(delete accounts [50])
(insert accounts [70 "y"])
(insert accounts [80 nil])
(insert accounts [90 nil])
(assert-eq (ids (idx-rows accounts_u :ge ["y"] :le ["y"])) @[70])
(commit)

# Verify a tree's entries, written outside every transaction, leave a
# prepared transaction's row to decide, across a restart.
# 1. Insert owners p1 and p2 in two transactions, and prepare both.
# 2. Restart; commit p1's and abort p2's.
# 3. The unique tree gives p1's row, and none for p2; p2 is taken by
#    a new row, its old entry dead.
(begin :rc)
(insert accounts [101 "p1"])
(prepare "tree_p1")
(session-open "s2" "treedb")
(session-use "s2")
(begin :rc)
(insert accounts [102 "p2"])
(prepare "tree_p2")
(session-use "default")
(db-close)
(env-detach :force true)
(env-attach test-dir)
(db-open "treedb")
(commit-prepared "tree_p1")
(abort-prepared "tree_p2")
(begin :rc)
(assert-eq (ids (idx-rows accounts_u :ge ["p1"] :le ["p1"])) @[101])
(assert-eq (idx-rows accounts_u :ge ["p2"] :le ["p2"]) @[])
(insert accounts [103 "p2"])
(assert-eq (ids (idx-rows accounts_u :ge ["p2"] :le ["p2"])) @[103])
(commit)

# Verify a tree's index-only scan reads no row on a leaf (compact) set all
# visible, and reads the rows of a leaf a write cleared (../BTREEINDEX.md §8).
# 1. Make a keyless table of 300 rows of state "s", a tree on state, and
#    compact: an index-only scan of "s" gives 300 keys, no row read.
# 2. Take a repeatable read snapshot in "snap"; delete a row and move
#    another to "t", and commit: "s" gives 298 keys, some rows read, and
#    "t" one.
# 3. "snap"'s index-only scan still gives 300 "s".
# 4. Once snap ends, compact: 298 "s", no row read.
# 5. Roll an insert of "s" back: its leaf's rows are read, 298 given.
(begin :rc)
(table-create pool (columns (id :int4 :not-null) (state :text)))
(index-create pool_state (table pool) (key (state :asc)) :tree true)
(commit)
(begin :rc)
(def first-row (insert pool [0 "s"]))
(def second-row (insert pool [1 "s"]))
(def third-row (insert pool [2 "s"]))
(for i 3 300 (insert pool [i "s"]))
(commit)
(begin :rc)
(compact pool)
(def all-s (idx-only pool_state :ge ["s"] :le ["s"]))
(assert-eq (length (all-s :keys)) 300)
(assert-eq (all-s :unread) 300)
(assert-eq ((all-s :keys) 0) ["s"])
(commit)

(session-open "snap" "treedb")
(session-use "snap")
(begin :rr)
(assert-eq (length ((idx-only pool_state :ge ["s"] :le ["s"]) :keys)) 300)
(session-use "default")
(begin :rc)
(delete pool first-row)
(update pool second-row [1 "t"])
(commit)
(begin :rc)
(def after (idx-only pool_state :ge ["s"] :le ["s"]))
(assert-eq (length (after :keys)) 298)
(assert (< (after :unread) 298) "a cleared leaf's rows are read")
(assert (> (after :unread) 0) "an untouched leaf's rows are not")
(assert-eq ((idx-only pool_state :ge ["t"] :le ["t"]) :keys) @[["t"]])
(commit)
(session-use "snap")
(assert-eq (length ((idx-only pool_state :ge ["s"] :le ["s"]) :keys)) 300)
(commit)
(session-close "snap")
(session-use "default")
(begin :rc)
(compact pool)
(def settled (idx-only pool_state :ge ["s"] :le ["s"]))
(assert-eq (length (settled :keys)) 298)
(assert-eq (settled :unread) 298)
(commit)
(begin :rc)
(insert pool [900 "s"])
(abort)
(begin :rc)
(def rolled (idx-only pool_state :ge ["s"] :le ["s"]))
(assert-eq (length (rolled :keys)) 298)
(assert (< (rolled :unread) 298) "the rolled-back insert's leaf is read")
(commit)

# Verify a delete fails a serializable reader whose index-only scan read
# no row: the delete reports its entry's key, in the reader's range.
# 1. Compact: every leaf set again.
# 2. ser1 counts "s", no row read; ser2 counts "u", none.
# 3. ser1 inserts a "u", in ser2's range; ser2 deletes an "s", in ser1's.
# 4. ser1 commits; ser2's commit fails, a serialization failure.
(begin :rc)
(compact pool)
(commit)
(session-open "ser1" "treedb")
(session-open "ser2" "treedb")
(session-use "ser1")
(begin :ser)
(assert-eq ((idx-only pool_state :ge ["s"] :le ["s"]) :unread) 298)
(session-use "ser2")
(begin :ser)
(assert-eq ((idx-only pool_state :ge ["u"] :le ["u"]) :keys) @[])
(session-use "ser1")
(insert pool [901 "u"])
(session-use "ser2")
(delete pool third-row)
(session-use "ser1")
(commit)
(session-use "ser2")
(assert-err :err-serialization (commit))
(session-close "ser1")
(session-close "ser2")
(session-use "default")

# Verify a session's copy of a tree's root, which its probes read with
# no pin, follows the root as another session's inserts split it.
# 1. Insert 400 rows of long keys: the root is an inner page.
# 2. "rdr" probes one key, keeping a copy of the root.
# 3. The default session inserts 5,600 more, splitting the pages under
#    the root, and the root itself.
# 4. "rdr" finds every key, old and new, by a probe of its own each.
(def grow-pad (string/repeat "g" 60))
(defn grow-key [i] (string (+ 100000 i) grow-pad))
(begin :rc)
(table-create grow
  (columns
    (id :int4 :not-null)
    (k :text)))
(index-create grow_k (table grow) (key (k :asc)) :tree true)
(each i (range 400) (insert grow [i (grow-key i)]))
(commit)
(session-open "rdr" "treedb")
(session-use "rdr")
(begin :rc)
(assert-eq (ids (idx-rows grow_k :ge [(grow-key 7)] :le [(grow-key 7)])) @[7])
(commit)
(session-use "default")
(begin :rc)
(each i (range 400 6000) (insert grow [i (grow-key i)]))
(commit)
(session-use "rdr")
(begin :rc)
(each i (range 0 6000 7)
  (assert-eq (ids (idx-rows grow_k :ge [(grow-key i)] :le [(grow-key i)]))
             @[i]))
(assert-count 6000 (idx-rows grow_k))
(commit)
(session-close "rdr")
(session-use "default")

# Verify the btree cleaner removes dead entries through sm.h, with no
# (compact) (../BTREEINDEX.md §9).
# 1. Make a table and a tree, insert rows, move one and delete one.
# 2. The tree holds their dead entries.
# 3. While an older snapshot is open, a pass leaves them: it may read them.
# 4. Once it ends, a pass removes them, and the rows are as written.
# 5. A pass with nothing queued changes nothing.
(begin :rc)
(table-create clean (columns (id :int4 :not-null) (state :text)))
(index-create clean_state (table clean) (key (state :asc)) :tree true)
(commit)
(index-wait clean_state)
(begin :rc)
(def clean-a (insert clean [1 "a"]))
(def clean-b (insert clean [2 "a"]))
(insert clean [3 "a"])
(commit)
(session-open "old" "treedb")
(session-use "old")
(begin :rr)
(assert-eq (ids (idx-rows clean_state)) @[1 2 3])
(session-use "default")
(begin :rc)
(update clean clean-a [1 "b"])
(delete clean clean-b)
(commit)
(begin :rc)
(assert-eq (idx-entries clean_state) 4)
(commit)
(cleaner-pass)
(begin :rc)
(assert-eq (idx-entries clean_state) 4)
(commit)
(session-use "old")
(assert-eq (ids (idx-rows clean_state)) @[1 2 3])
(commit)
(session-close "old")
(session-use "default")
(cleaner-pass)
(begin :rc)
(assert-eq (idx-entries clean_state) 2)
(assert-eq (ids (idx-rows clean_state)) @[3 1])
(commit)
(cleaner-pass)
(begin :rc)
(assert-eq (idx-entries clean_state) 2)
(commit)

# Verify a load into an empty table builds its trees whole, unique or
# not (../BTREELOAD_PLAN.md).
# 1. Make a table with a unique tree on k and a tree on g, and load
#    3,000 rows in no order of either, some with a NULL k.
# 2. Each tree gives every row in its key's order, and a range gives
#    its rows; the NULL k rows are no duplicates of each other.
# 3. Every entry is in doubt: an index-only scan reads every row, until
#    a cleaner pass reads each once and sets the leaves all visible.
# 4. An insert lands in the built tree; one of a k there fails.
(def nrows 3000)
# Row i's k: a permutation of 0..2999 as text, NULL for i below 10.
(defn k-of [i] (if (< i 10) nil (string "k" (% (* i 7919) nrows))))
(defn g-of [i] (string "g" (% i 7)))
(def load-rows (map (fn [i] [i (k-of i) (g-of i)]) (range nrows)))
(defn ids-by [key-of]
  (map (fn [r] (r 0))
       (sort-by (fn [r] [(key-of (r 0)) (r 0)])
                (filter (fn [r] (key-of (r 0))) load-rows))))
(begin :rc)
(table-create uload (columns (id :int4 :not-null) (k :text) (g :text)))
(index-create uload_k (table uload) (key (k :asc)) :unique true :tree true)
(index-create uload_g (table uload) (key (g :asc)) :tree true)
(commit)
(index-wait uload_k)
(index-wait uload_g)
(begin :rc)
(load uload load-rows)
(commit)
(begin :rc)
(assert-eq (ids (idx-rows uload_k :ge ["k"] :lt ["l"])) (ids-by k-of))
(assert-eq (ids (idx-rows uload_g)) (ids-by g-of))
(assert-eq (ids (idx-rows uload_k :ge ["k1234"] :le ["k1234"]))
           @[(find (fn [i] (= (k-of i) "k1234")) (range nrows))])
(assert-eq (length (idx-rows uload_k)) nrows)
(def before (idx-only uload_g :ge ["g3"] :le ["g3"]))
(assert-eq (length (before :keys)) (length (filter (fn [i] (= (% i 7) 3))
                                                   (range nrows))))
(assert-eq (before :unread) 0)
(commit)
(cleaner-pass)
(begin :rc)
(def after (idx-only uload_g :ge ["g3"] :le ["g3"]))
(assert-eq (after :unread) (length (after :keys)))
(insert uload [5000 "kz" "gz"])
(assert-eq (ids (idx-rows uload_k :ge ["kz"] :le ["kz"])) @[5000])
(commit)
(begin :rc)
(assert-err :err-dupkey (insert uload [5001 "k17" "gz"]))
(abort)

# Verify a load's duplicate in a unique tree fails it, and leaves its
# table empty and its trees usable.
# 1. Load three rows into an empty table, two with one k: the load
#    fails with SM_ERR_DUPKEY, and its transaction aborts.
# 2. The table and both its trees are empty.
# 3. A load of distinct rows then succeeds, and the trees give them.
(begin :rc)
(table-create udup (columns (id :int4 :not-null) (k :text)))
(index-create udup_k (table udup) (key (k :asc)) :unique true :tree true)
(commit)
(index-wait udup_k)
(begin :rc)
(assert-err :err-dupkey (load udup [[1 "a"] [2 "b"] [3 "a"]]))
(begin :rc)
(assert-count 0 (scan udup))
(assert-eq (idx-entries udup_k) 0)
(load udup [[1 "a"] [2 "b"] [3 "c"]])
(commit)
(begin :rc)
(assert-eq (ids (idx-rows udup_k)) @[1 2 3])
(commit)

# Verify a load aborted after its end leaves only dead entries, which a
# cleaner pass removes.
# 1. Load 500 rows into an empty table, end the load, and abort.
# 2. No row is there, and the tree gives none, though it holds 500
#    entries.
# 3. After a cleaner pass the tree holds none.
(begin :rc)
(table-create uabort (columns (id :int4 :not-null) (k :text)))
(index-create uabort_k (table uabort) (key (k :asc)) :unique true :tree true)
(commit)
(index-wait uabort_k)
(begin :rc)
(load uabort (map (fn [i] [i (string "k" i)]) (range 500)))
(abort)
(begin :rc)
(assert-count 0 (scan uabort))
(assert-eq (ids (idx-rows uabort_k)) @[])
(assert-eq (idx-entries uabort_k) 500)
(commit)
(cleaner-pass)
(begin :rc)
(assert-eq (idx-entries uabort_k) 0)
(commit)

(db-close)
(env-detach)
(rm-rf test-dir)
(print "test_tree.rel passed")
