# test_basic.rel -- basic CRUD, data types, transactions and savepoints

(def test-dir (string (or (os/getenv "REL_TMP") "/tmp") "/wisr_rel_test_basic"))
(rm-rf test-dir)
(env-init test-dir)
(env-attach test-dir)

(db-create "basicdb")
(def dbs (db-list))
(assert-eq dbs ["basicdb"])

(db-open "basicdb")

# 1. Table creation and diverse types
(begin :rc)
(table-create products
  (columns
    (id :int4 :not-null)
    (name :text :not-null)
    (price :float8)
    (stock :int8)
    (active :bool)))

# 2. Insert and Read
(def r1 (insert products [1 "Widget" 19.99 1000 true]))
(def r2 (insert products [2 "Gadget" 49.50 250 false]))
(assert-eq r1 1)
(assert-eq r2 2)

(assert-eq (read products 1) [1 "Widget" 19.99 1000 true])
(assert-eq (read products 2) [2 "Gadget" 49.50 250 false])
(assert-nil (read products 999))

# 3. Table Scan with bounds
(def all-items (scan products))
(assert-count 2 all-items)
(assert-eq (all-items 0) [1 [1 "Widget" 19.99 1000 true]])
(assert-eq (all-items 1) [2 [2 "Gadget" 49.50 250 false]])

(def bounded (scan products :from 2 :to 2))
(assert-count 1 bounded)
(assert-eq (bounded 0) [2 [2 "Gadget" 49.50 250 false]])

# 4. Update
(def old-val (update products 1 [1 "Widget Pro" 29.99 800 true]))
(assert-eq old-val [1 "Widget" 19.99 1000 true])
(assert-eq (read products 1) [1 "Widget Pro" 29.99 800 true])

# 5. Delete
(def del-val (delete products 2))
(assert-eq del-val [2 "Gadget" 49.50 250 false])
(assert-nil (read products 2))
(assert-count 1 (scan products))
(commit)

# 6. Transaction Abort rollback
(begin :rc)
(insert products [3 "Temporary" 5.00 10 true])
(assert-eq (read products 3) [3 "Temporary" 5.00 10 true])
(abort)
# After abort, row 3 must not exist
(begin :rc)
(assert-nil (read products 3))
(commit)

# 7. Savepoint and Rollback
(begin :rc)
(def sp1 (savepoint))
(update products 1 [1 "Widget Ultra" 99.99 100 true])
(assert-eq (read products 1) [1 "Widget Ultra" 99.99 100 true])
(rollback sp1)
(forget sp1)
(assert-eq (read products 1) [1 "Widget Pro" 29.99 800 true])
(commit)

# 8. Table Drop
(begin :rc)
(table-drop products)
(commit)

# 9. Values round-trip through the Datum API for every type rel converts.
# 9.1 Create a table of every convertible type, indexed on a text column.
# 9.2 Insert a row with nulls and a long (4-byte header) varlena.
# 9.3 Read, read-latest and scan it back unchanged.
# 9.4 Update it and confirm the old row and the index key moved.
# 9.5 Delete it and confirm the index entry is gone.
# 9.6 Confirm a value that is not a number, bool or string is
#     refused, not stored.
(begin :rc)
(table-create alltypes
  (columns
    (b :bool) (i2 :int2) (i4 :int4) (i8 :int8)
    (f4 :float4) (f8 :float8)
    (t :text) (vc :varchar) (by :bytea)))
(index-create idx_alltypes_t
  (table alltypes)
  (key (t :asc))
  :unique false
  :include (i4))
(def long-str (string/repeat "x" 200))
(def row-a [true 7 70000 9000000000 1.5 2.25 long-str "vc" "by"])
(def row-b [nil nil nil nil nil nil "short" nil nil])
(def ra (insert alltypes row-a))
(assert-eq (read alltypes ra) row-a)
(assert-eq (read-latest alltypes ra) row-a)
(assert-eq ((scan alltypes) 0) [ra row-a])
(def hit-a (idx-scan idx_alltypes_t :ge [long-str] :le [long-str]))
(assert-count 1 hit-a)
(assert-eq (hit-a 0) [ra false [70000]])
(assert-eq (update alltypes ra row-b) row-a)
(assert-eq (read alltypes ra) row-b)
(assert-count 0 (idx-scan idx_alltypes_t :ge [long-str] :le [long-str]))
(def hit-b (idx-scan idx_alltypes_t :ge ["short"] :le ["short"]))
(assert-count 1 hit-b)
(assert-eq (hit-b 0) [ra false [nil]])
(assert-eq (delete alltypes ra) row-b)
(assert-count 0 (idx-scan idx_alltypes_t))
(table-create dates (columns (d :int4)))
(def refused
  (try (do (insert dates ["not a number"]) false) ([err] true)))
(assert-eq refused true)
(assert-count 0 (scan dates))
(table-drop dates)
(table-drop alltypes)
(commit)

# 10. Every other type round-trips as its canonical text.
# 10.1 Create a table of date, time(3), timestamp, timestamptz,
#      interval, uuid, varchar(20), decimal64(10, 2) and
#      decimal128(30, 5), indexed on the decimal64 and the date.
# 10.2 Insert a row as canonical text; read, scan and the
#      indexes give it back unchanged.
# 10.3 Order holds through the decimal64 index: a smaller value
#      scans first, negative included.
# 10.4 Text that is not canonical for its type, or that does not
#      fit its typmod, is refused.
(begin :rc)
(table-create other
  (columns
    (d :date)
    (t :time 3)
    (ts :timestamp)
    (tz :timestamptz)
    (iv :interval)
    (u :uuid)
    (vc :varchar 20)
    (d64 :decimal64 10 2)
    (d128 :decimal128 30 5)))
(index-create idx_other_d64 (table other) (key (d64 :asc)) :unique false)
(index-create idx_other_d (table other) (key (d :asc)) :unique false)
(def row-o ["2026-09-26" "12:34:56.789" "2026-09-26 12:34:56"
            "2026-09-26 12:34:56+00" "P1Y2M3DT4H5M6S"
            "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11" "hello"
            "12345.67" "123456789012345678901.23456"])
(def ro (insert other row-o))
(assert-eq (read other ro) row-o)
(assert-eq ((scan other) 0) [ro row-o])
(def row-n ["2020-01-01" nil nil nil nil nil nil "-5.00" nil])
(def rn (insert other row-n))
(assert-eq (read other rn) row-n)
(def by-d64 (idx-scan idx_other_d64))
(assert-count 2 by-d64)
(assert-eq ((by-d64 0) 0) rn)
(assert-eq ((by-d64 1) 0) ro)
(def on-day (idx-scan idx_other_d :ge ["2026-09-26"] :le ["2026-09-26"]))
(assert-count 1 on-day)
(assert-eq ((on-day 0) 0) ro)
(def bad-dec
  (try (do (insert other [nil nil nil nil nil nil nil "1.5" nil]) false)
       ([err] true)))
(assert-eq bad-dec true)
(def too-wide
  (try (do (insert other [nil nil nil nil nil nil nil "123456789.00" nil])
         false)
       ([err] true)))
(assert-eq too-wide true)
(index-drop idx_other_d64)
(index-drop idx_other_d)
(table-drop other)
(commit)

# A NULL in a NOT NULL column is refused by the storage manager, on
# insert and on update, and as any failed write it aborts the
# transaction; a NULL where one is allowed is written.
(begin :rc)
(table-create strict (columns (id :int4 :not-null) (note :text)))
(def rs (insert strict [1 nil]))
(commit)
(begin :rc)
(assert-err :err-notnull (insert strict [nil "x"]))
(assert-eq (sm:retryable) false)
(abort)
(begin :rc)
(assert-err :err-notnull (update strict rs [nil "x"]))
(abort)
(begin :rc)
(assert-count 1 (scan strict))
(assert-eq (read strict rs) [1 nil])
(table-drop strict)
(commit)

# A row of the wrong width is refused, by a message that says how wide
# the table's rows are and how wide the row was.
# 1. insert of two values into a table of three.
# 2. load of a row of four into the same table.
# 3. update of a row to two values.
(begin :rc)
(table-create wide3 (columns (a :int4) (b :int4) (c :int4)))
(def rw (insert wide3 [1 2 3]))
(defn panic-of [f] (try (do (f) "no error") ([e] (string e))))
(assert-eq (panic-of |(insert wide3 [1 2]))
           "insert: expected 3 values, got 2")
(assert-eq (panic-of |(load wide3 [[1 2 3] [1 2 3 4]]))
           "load: row 1 must hold 3 values")
(assert-eq (panic-of |(update wide3 rw [1 2]))
           "update: expected 3 values, got 2")
(table-drop wide3)
(commit)

(db-close)
(env-detach :force true)
(rm-rf test-dir)
(print "test_basic.rel: PASSED")
