# k02 -- an update that keeps its key goes past a key-share lock.
#
# T1 holds R1 in KS, as a foreign key check of a child row holds
# its parent. T2's update keeps R1's key: it writes in NKU, which
# KS lets in, so T2 does not wait for T1.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 lock R1 keyshare -> ok
@3 T2 write R1 t2 keykept -> ok
@4 check last T2 ok -> satisfied
@5 T2 commit -> ok
@6 T1 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 lock R1 keyshare -> ok
@3 T2 write R1 t2 keykept -> ok
@4 check last T2 ok -> satisfied
@5 T2 commit -> ok
@6 T1 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 lock R1 keyshare -> ok
@3 T2 write R1 t2 keykept -> ok
@4 check last T2 ok -> satisfied
@5 T2 commit -> ok
@6 T1 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 lock R1 keyshare -> ok
@3 T2 write R1 t2 keykept -> ok
@4 check last T2 ok -> satisfied
@5 T2 commit -> ok
@6 T1 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t2 -> satisfied
