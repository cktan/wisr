# c33 -- a transaction declared read-only spares a pivot.
#
# T2 reads R1 and T1 overwrites it and commits: T2 --rw--> T1.
# T3 reads R2 and T2 overwrites it: T3 --rw--> T2, T2 the pivot,
# with T1 committed first. T1 committed after T3's snapshot, and
# T3 is declared read-only, so T3, T2, T1 is a serial order and
# all three commit. Undeclared, T3 could still write when T2
# commits, and T2 would fail (Ports and Grittner's read-only
# rule, SM1_DESIGN.md §7.3; PostgreSQL's receipt-report, p02).


== pairing RR/RR == T1=RR T2=RR T3=RR-RO
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@3 T1 write R1 t1 -> ok
@4 T1 commit -> ok
@5 T3 read R2 -> 0
@6 T2 write R2 t2 -> ok
@7 T2 commit -> ok
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER-RO
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@3 T1 write R1 t1 -> ok
@4 T1 commit -> ok
@5 T3 read R2 -> 0
@6 T2 write R2 t2 -> ok
@7 T2 commit -> ok
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR-RO
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@3 T1 write R1 t1 -> ok
@4 T1 commit -> ok
@5 T3 read R2 -> 0
@6 T2 write R2 t2 -> ok
@7 T2 commit -> ok
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t2 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER-RO
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@3 T1 write R1 t1 -> ok
@4 T1 commit -> ok
@5 T3 read R2 -> 0
@6 T2 write R2 t2 -> ok
@7 T2 commit -> ok
@8 T3 commit -> ok
@9 check committed T1 T2 T3 -> satisfied
@10 check row R1 t1 -> satisfied
@10 check row R2 t2 -> satisfied
