# c14 -- writes with no reads build no edges.
#
# Neither transaction reads anything, so no read-write conflict
# can exist in either direction, whatever the levels.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 -> ok
@3 T2 write R2 t2 -> ok
@4 T1 commit -> ok
@5 T2 commit -> ok
@6 check committed T1 T2 -> satisfied
@7 check rows -> {R1=t1, R2=t2}
