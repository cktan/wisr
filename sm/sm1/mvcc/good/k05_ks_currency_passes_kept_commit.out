# k05 -- a key-share lock's currency check passes over a committed
# update that kept the key; a share lock's does not.
#
# T2 and T3 read R1 at their snapshots. T1 then updates R1, keeping
# its key, and commits. Above READ COMMITTED a lock fails on a
# version committed after the snapshot, but KS fails only on one
# that changed the key: T2's KS lock is taken, T3's S lock fails.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@2 T3 read R1 -> 0
@3 T1 write R1 t1 keykept -> ok
@4 T1 commit -> ok
@5 T2 lock R1 keyshare -> ok
@6 check last T2 ok -> satisfied
@7 T3 lock R1 shared -> conflict
@8 check last T3 conflict -> satisfied
@9 T3 abort -> notrans
@10 T2 commit -> ok
@11 check committed T1 T2 -> satisfied
@12 check row R1 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@2 T3 read R1 -> 0
@3 T1 write R1 t1 keykept -> ok
@4 T1 commit -> ok
@5 T2 lock R1 keyshare -> ok
@6 check last T2 ok -> satisfied
@7 T3 lock R1 shared -> conflict
@8 check last T3 conflict -> satisfied
@9 T3 abort -> notrans
@10 T2 commit -> ok
@11 check committed T1 T2 -> satisfied
@12 check row R1 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@2 T3 read R1 -> 0
@3 T1 write R1 t1 keykept -> ok
@4 T1 commit -> ok
@5 T2 lock R1 keyshare -> ok
@6 check last T2 ok -> satisfied
@7 T3 lock R1 shared -> conflict
@8 check last T3 conflict -> satisfied
@9 T3 abort -> notrans
@10 T2 commit -> ok
@11 check committed T1 T2 -> satisfied
@12 check row R1 t1 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T2 read R1 -> 0
@2 T3 read R1 -> 0
@3 T1 write R1 t1 keykept -> ok
@4 T1 commit -> ok
@5 T2 lock R1 keyshare -> ok
@6 check last T2 ok -> satisfied
@7 T3 lock R1 shared -> conflict
@8 check last T3 conflict -> satisfied
@9 T3 abort -> notrans
@10 T2 commit -> ok
@11 check committed T1 T2 -> satisfied
@12 check row R1 t1 -> satisfied
