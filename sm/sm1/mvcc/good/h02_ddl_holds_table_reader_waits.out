# h02 -- while DDL holds a table, a reader takes no slot.
#
# X on an oid is counted, so a reader's IS on it goes to the
# lock table instead of a slot, and waits there for T1. Once T1
# commits, the count is back to 0, and T3's IS, asked after,
# takes a slot and is granted at once.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 lockoid 1 exclusive -> ok
@3 T2 lockoid 1 is blocks -> blocked
@4 T1 commit -> ok
@3 T2 lockoid 1 is blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T3 lockoid 1 is -> ok
@7 T2 commit -> ok
@7 T3 commit -> ok
@8 check committed T1 T2 T3 -> satisfied
