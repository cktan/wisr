# p10 -- PostgreSQL's isolation spec multiple-row-versions.
#
# Ported from PostgreSQL's src/test/isolation/specs (branch
# REL_17_STABLE), under the PostgreSQL License; the expected
# outcomes are copied from its expected/multiple-row-versions.out.
#
# Four transactions over a table of a million rows, where the
# cycle runs through several versions of one row.
#
# Table t (id PRIMARY KEY, txt) is seeded with the three rows
# the steps touch, t:0000001, t:0500000 and t:1000000; reads and
# updates are by primary key.

# PostgreSQL's setup:
#
#   CREATE TABLE t (id int NOT NULL, txt text) WITH (fillfactor=50);
#   INSERT INTO t (id)
#   SELECT x FROM (SELECT * FROM generate_series(1, 1000000)) a(x);
#   ALTER TABLE t ADD PRIMARY KEY (id);
#
# and each session runs, before its first step:
#
#   s1: BEGIN ISOLATION LEVEL SERIALIZABLE;
#   s2: BEGIN ISOLATION LEVEL SERIALIZABLE;
#   s3: BEGIN ISOLATION LEVEL SERIALIZABLE;
#   s4: BEGIN ISOLATION LEVEL SERIALIZABLE;


# rx1: SELECT * FROM t WHERE id = 1000000;
# wz1: UPDATE t SET txt = 'a' WHERE id = 1;
# c1: COMMIT;
# wx2: UPDATE t SET txt = 'b' WHERE id = 1000000;
# c2: COMMIT;
# wx3: UPDATE t SET txt = 'c' WHERE id = 1000000;
# ry3: SELECT * FROM t WHERE id = 500000;
# c3: COMMIT;
# wy4: UPDATE t SET txt = 'd' WHERE id = 500000;
# rz4: SELECT * FROM t WHERE id = 1;
# c4: COMMIT;

# Where sm1 differs from PostgreSQL, an "sm1" line under the
# permutation's expect line gives sm1's outcome. sm1's SSI
# applies the refinements of Ports and Grittner (commit order,
# and read-only transactions) as PostgreSQL does
# (SM1_DESIGN.md §7.3), so the differences here are these:
# sm1 fails s3 as well. sm1's SIREAD entries are on keys, so
# s3's write of t:1000000 makes an edge from s1, which read the
# key, and s3 is a pivot between s1 and s4, which committed
# first. PostgreSQL's are on tuple versions: s1 read the version
# s2 replaced, not the one s3 replaced, so it has no such edge.

== permutation 1: rx1 wx2 c2 wx3 ry3 wy4 rz4 c4 c3 wz1 c1 ==
rx1 s1 -> -
wx2 s2 -> - | ok
c2 s2 -> ok
wx3 s3 -> b | ok
ry3 s3 -> -
wy4 s4 -> - | ok
rz4 s4 -> -
c4 s4 -> ok
c3 s3 -> serialization
wz1 s1 -> - | ok
c1 s1 -> serialization
outcome s1=serialize s2=commit s3=serialize s4=commit -> differs from PostgreSQL (s1=serialize s2=commit s3=commit s4=commit) as noted
