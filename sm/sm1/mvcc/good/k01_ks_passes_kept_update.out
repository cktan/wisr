# k01 -- a key-share lock passes over an update in flight that kept
# its key.
#
# T1 updates R1's non-key columns, as UPDATE customer SET phone = ...
# does, and has not committed. T2 checks a foreign key to R1 and
# locks it in KS. The version T1 wrote is flagged key-kept, so T2
# does not wait for T1: both commit (../../LOCKMGR.md §1.13).


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 keykept -> ok
@3 T2 lock R1 keyshare -> ok
@4 check last T2 ok -> satisfied
@5 T1 commit -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t1 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 keykept -> ok
@3 T2 lock R1 keyshare -> ok
@4 check last T2 ok -> satisfied
@5 T1 commit -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t1 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 keykept -> ok
@3 T2 lock R1 keyshare -> ok
@4 check last T2 ok -> satisfied
@5 T1 commit -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t1 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 t1 keykept -> ok
@3 T2 lock R1 keyshare -> ok
@4 check last T2 ok -> satisfied
@5 T1 commit -> ok
@6 T2 commit -> ok
@7 check committed T1 T2 -> satisfied
@8 check row R1 t1 -> satisfied
