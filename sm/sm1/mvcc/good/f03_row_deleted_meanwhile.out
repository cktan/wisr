# f03 -- READ COMMITTED: the row was deleted while T2 waited.
#
# T1 deletes R1 and commits. T2's write is refused with
# `updated`; readlatest reports the row absent, so T2 skips the
# update.


== pairing RR/RR == T1=RC T2=RC
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 delete R1 -> ok
@3 T2 write R1 2 blocks -> blocked
@4 T1 commit -> ok
@3 T2 write R1 2 blocks -> updated (resumed)
@5 check last T2 updated -> satisfied
@6 T2 readlatest R1 -> -
@6 check last T2 - -> satisfied
@7 T2 commit -> ok
@8 check committed T1 T2 -> satisfied
@8 check row R1 - -> satisfied
