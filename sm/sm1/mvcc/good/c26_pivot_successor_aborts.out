# c26 -- the transaction a pivot points at aborts.
#
# c06's chain, T1 --rw--> T2 --rw--> T3, with T3 aborting
# instead of committing. An aborted T3 cannot be part of a
# cycle. wisr keeps the edges themselves, and an abort takes
# its edges with it, so T2 is no longer a pivot and commits.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 abort -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check row R1 t2 -> satisfied
@11 check row R2 0 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 abort -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check row R1 t2 -> satisfied
@11 check row R2 0 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 abort -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check row R1 t2 -> satisfied
@11 check row R2 0 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T1 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T3 write R2 t3 -> ok
@6 T3 abort -> ok
@7 T2 commit -> ok
@8 T1 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check row R1 t2 -> satisfied
@11 check row R2 0 -> satisfied
