# c22 -- write skew over a predicate, resolved by updates.
#
# The doctors-on-call schedule: each transaction scans the
# range to check that someone else is on call, then takes
# itself off by updating its own row. Neither write changes
# the membership of the range, as c03's inserts and c04's
# deletes do, so this is the case where the edge can only come
# from a value written inside a range somebody read.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R2 -> {R1, R2}
@3 T2 scan R1 R2 -> {R1, R2}
@4 T1 write R1 0 -> ok
@5 T2 write R2 0 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=0, R2=0}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R2 -> {R1, R2}
@3 T2 scan R1 R2 -> {R1, R2}
@4 T1 write R1 0 -> ok
@5 T2 write R2 0 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=0, R2=0}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R2 -> {R1, R2}
@3 T2 scan R1 R2 -> {R1, R2}
@4 T1 write R1 0 -> ok
@5 T2 write R2 0 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=0, R2=0}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R2 -> {R1, R2}
@3 T2 scan R1 R2 -> {R1, R2}
@4 T1 write R1 0 -> ok
@5 T2 write R2 0 -> ok
@6 T1 commit? -> recorded
@7 T2 commit? -> recorded
@8 check at-most-one-committed T1 T2 -> satisfied
