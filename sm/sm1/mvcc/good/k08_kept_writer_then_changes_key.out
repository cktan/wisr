# k08 -- a writer that kept the key, then changes it, waits for the
# key-share lock that passed over its first version.
#
# T1 updates R1, keeping its key. T2's KS lock passes over T1's
# version in flight. T1 then writes R1 again and changes the key:
# that write is X, meets T2's KS lock, and waits until T2 commits.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 write R1 a keykept -> ok
@3 T2 lock R1 keyshare -> ok
@4 check last T2 ok -> satisfied
@5 T1 write R1 b blocks -> blocked
@6 T2 commit -> ok
@5 T1 write R1 b blocks -> ok (resumed)
@7 check last T1 ok -> satisfied
@8 T1 commit -> ok
@9 check committed T1 T2 -> satisfied
@10 check row R1 b -> satisfied
