# b18 -- an update and a delete over a committed concurrent
# insert.
#
# R2 and R3 are absent in the snapshots of T1 and T3, so an
# update or a delete of them would ordinarily be NOTFOUND.
# First-committer-wins is checked first, and it is the honest
# answer: the row was created after the snapshot, which is a
# concurrency failure and retryable. Compare b06, which makes
# the same point for an insert, and b13, where the row really
# never existed.


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T3 begin -> ok
@2 T2 begin -> ok
@3 T2 insert R2 t2 -> ok
@3 T2 insert R3 t2 -> ok
@4 T2 commit -> ok
@5 T1 write R2 t1 -> conflict
@6 check last T1 conflict -> satisfied
@7 T3 delete R3 -> conflict
@8 check last T3 conflict -> satisfied
@9 check row R2 t2 -> satisfied
@9 check row R3 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T3 begin -> ok
@2 T2 begin -> ok
@3 T2 insert R2 t2 -> ok
@3 T2 insert R3 t2 -> ok
@4 T2 commit -> ok
@5 T1 write R2 t1 -> conflict
@6 check last T1 conflict -> satisfied
@7 T3 delete R3 -> conflict
@8 check last T3 conflict -> satisfied
@9 check row R2 t2 -> satisfied
@9 check row R3 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T3 begin -> ok
@2 T2 begin -> ok
@3 T2 insert R2 t2 -> ok
@3 T2 insert R3 t2 -> ok
@4 T2 commit -> ok
@5 T1 write R2 t1 -> conflict
@6 check last T1 conflict -> satisfied
@7 T3 delete R3 -> conflict
@8 check last T3 conflict -> satisfied
@9 check row R2 t2 -> satisfied
@9 check row R3 t2 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T3 begin -> ok
@2 T2 begin -> ok
@3 T2 insert R2 t2 -> ok
@3 T2 insert R3 t2 -> ok
@4 T2 commit -> ok
@5 T1 write R2 t1 -> conflict
@6 check last T1 conflict -> satisfied
@7 T3 delete R3 -> conflict
@8 check last T3 conflict -> satisfied
@9 check row R2 t2 -> satisfied
@9 check row R3 t2 -> satisfied
