rxy1 s1 -> {a:checking, a:savings}
wy2 s2 -> 600 | ok
rxy2 s2 -> {a:checking, a:savings}
c1 s1 -> ok
c2 s2 -> serialization
outcome s1=commit s2=serialize -> as PostgreSQL
