# c17 -- an edge onto a pivot that has already committed.
#
# T3 reads R1; T2 reads R2, writes R1, and commits, so T2 has
# an edge in. T1's write of R2 gives T2 an edge out after it
# committed, making it a pivot. T1 is the pivot's successor
# and commits last, after T2, so the order T3, T2, T1 is
# serial and nothing fails: a pivot is dangerous only when its
# successor commits first (Ports and Grittner).


== pairing RR/RR == T1=RR T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing RR/S == T1=RR T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing S/RR == T1=SER T2=RR T3=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
== pairing S/S == T1=SER T2=SER T3=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@1 T3 begin -> ok
@2 T3 read R1 -> 0
@3 T2 read R2 -> 0
@4 T2 write R1 t2 -> ok
@5 T2 commit -> ok
@6 T1 write R2 t1 -> ok
@7 T1 commit -> ok
@8 check committed T1 -> satisfied
