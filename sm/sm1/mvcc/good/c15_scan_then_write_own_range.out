# c15 -- writing inside a range you scanned yourself.
#
# A transaction's own writes into its own predicate are not a
# conflict: an edge needs two different transactions. T2 reads
# elsewhere, so the tracking is on and simply has nothing to
# report.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R3 -> {R1, R2}
@3 T2 read R5 -> 0
@4 T1 write R1 t1 -> ok
@5 T1 insert R3 t1 -> ok
@6 T1 commit -> ok
@7 T2 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t1, R2=0, R3=t1, R5=0}
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R3 -> {R1, R2}
@3 T2 read R5 -> 0
@4 T1 write R1 t1 -> ok
@5 T1 insert R3 t1 -> ok
@6 T1 commit -> ok
@7 T2 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t1, R2=0, R3=t1, R5=0}
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R3 -> {R1, R2}
@3 T2 read R5 -> 0
@4 T1 write R1 t1 -> ok
@5 T1 insert R3 t1 -> ok
@6 T1 commit -> ok
@7 T2 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t1, R2=0, R3=t1, R5=0}
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 scan R1 R3 -> {R1, R2}
@3 T2 read R5 -> 0
@4 T1 write R1 t1 -> ok
@5 T1 insert R3 t1 -> ok
@6 T1 commit -> ok
@7 T2 commit -> ok
@8 check committed T1 T2 -> satisfied
@9 check rows -> {R1=t1, R2=0, R3=t1, R5=0}
