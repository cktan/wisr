# b17 -- two inserts of the same absent row, the first
# aborting.
#
# The other half of b11: an insert takes the row lock on a key
# that is not there, so the second inserter waits, and an
# aborted insert is no insert at all. The waiter therefore
# finds the key still absent and succeeds, as the waiting
# update of b10 does.


== pairing RR/RR == T1=RR T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 insert R2 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 t2 -> satisfied
== pairing RR/S == T1=RR T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 insert R2 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 t2 -> satisfied
== pairing S/RR == T1=SER T2=RR
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 insert R2 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 t2 -> satisfied
== pairing S/S == T1=SER T2=SER
@1 T1 begin -> ok
@1 T2 begin -> ok
@2 T1 insert R2 t1 -> ok
@3 T2 insert R2 t2 blocks -> blocked
@4 T1 abort -> ok
@3 T2 insert R2 t2 blocks -> ok (resumed)
@5 check last T2 ok -> satisfied
@6 T2 commit -> ok
@7 check committed T2 -> satisfied
@8 check row R2 t2 -> satisfied
