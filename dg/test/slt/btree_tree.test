# Verify that an index made a tree, USING btree (../sm/BTREE.md),
# answers as any index does, on digres; PostgreSQL 18 makes its own
# B-tree and gives the same answers.
# 1. Make a table of rows, and a tree on its column c2.
# 2. Confirm a range, an equality and an IN list plan with the tree,
#    and give the rows PostgreSQL gives.
# 3. Update rows off, onto and back to a key, delete some, and roll an
#    insert back: each query gives each row once, under its key now.
# 4. Confirm an index-only scan's answer, and a TRUNCATE's.
# 5. Make a tree of keys of 960 bytes, about three a page, and insert
#    rows out of key order, so its pages split at every level; a range,
#    an order, an equality and rows moved and deleted answer as above.

statement ok
create table t (id int4 primary key, c2 int4, note text)

statement ok
insert into t select g, g % 100, 'n' || g from generate_series(1, 2000) g

statement ok
create index t_c2 on t using btree (c2)

statement ok
set enable_seqscan = off

statement ok
set enable_bitmapscan = off

query T nosort
explain (costs off) select id from t where c2 = 7
----
Index Scan using t_c2 on t
  Index Cond: (c2 = 7)

query I rowsort
select id from t where c2 = 7 and id < 400
----
107
207
307
7

query II nosort
select count(*), sum(id) from t where c2 between 10 and 19
----
200	192900

query I rowsort
select id from t where c2 in (3, 5, 99) and id > 1800
----
1803
1805
1899
1903
1905
1999

statement ok
update t set c2 = 1000 where id in (7, 107)

statement ok
update t set c2 = 2000 where id = 207

statement ok
update t set c2 = 7 where id = 207

statement ok
delete from t where id = 307

statement ok
begin

statement ok
insert into t values (5000, 7, 'gone')

statement ok
rollback

query I rowsort
select id from t where c2 = 7 and id < 400
----
207

query I rowsort
select id from t where c2 >= 1000
----
107
7

query II nosort
select count(*), sum(id) from t where c2 between 0 and 99
----
1997	2000579

query I nosort
select count(*) from t where c2 = 2000
----
0

query I nosort
select c2 from t where c2 > 98 order by c2 limit 3
----
99
99
99

statement ok
truncate t

statement ok
insert into t values (1, 7, 'again')

query T rowsort
select note from t where c2 = 7
----
again

# Verify an expression index and a partial one made trees recheck
# their rows as any write would compute their keys.
# 1. Make trees on lower(note), and on c2 where note like 'p%'.
# 2. Change rows so their expression, or the predicate, no longer
#    holds for the entry they had: queries give each row as it is.

statement ok
insert into t values (2, 8, 'Ann'), (3, 9, 'ann'), (4, 9, 'pat'), (5, 9, 'pete')

statement ok
create index t_lower on t using btree (lower(note))

statement ok
create index t_p on t using btree (c2) where note like 'p%'

statement ok
update t set note = 'Bob' where id = 2

statement ok
update t set note = 'quinn' where id = 4

query I rowsort
select id from t where lower(note) = 'ann'
----
3

query I rowsort
select id from t where lower(note) = 'bob'
----
2

query I rowsort
select id from t where c2 = 9 and note like 'p%'
----
5

# Verify a unique index made a tree refuses a duplicate, and what digres
# refuses of a tree.
# 1. A unique tree on note refuses a second 'pete', and takes it once
#    the first is deleted.
# 2. ON CONFLICT on it finds the row that has the key, or inserts; another
#    parameter is refused.
# 3. Dropping a tree leaves the table's other indexes answering.

statement ok
create unique index t_u on t using btree (note)

statement error duplicate key value violates unique constraint "t_u"
insert into t values (6, 1, 'pete')

statement ok
delete from t where id = 5

statement ok
insert into t values (6, 1, 'pete')

query I rowsort
select id from t where note = 'pete'
----
6

statement ok
insert into t values (7, 1, 'pete') on conflict (note) do nothing

statement ok
insert into t values (8, 1, 'pete') on conflict (note) do update set c2 = 42

statement ok
insert into t values (9, 1, 'zed') on conflict (note) do nothing

query II rowsort
select id, c2 from t where note in ('pete', 'zed')
----
6	42
9	1

onlyif digres
statement error storage parameter "fillfactor" is not supported
create index t_f on t (note) with (fillfactor = 50)

statement ok
drop index t_lower

query I rowsort
select id from t where c2 = 9 and note like 'p%'
----

statement ok
create table lk (id int4 primary key, k text)

statement ok
create index lk_k on lk using btree (k)

statement ok
insert into lk select g, repeat(md5(g::text), 30) from generate_series(1, 1000) g

query T nosort
explain (costs off) select id from lk where k = 'x'
----
Index Scan using lk_k on lk
  Index Cond: (k = 'x'::text)

query II nosort
select count(*), sum(id) from lk where k >= 'e'
----
133	65936

query I nosort
select id from lk order by k limit 5
----
363
168
610
381
236

query I nosort
select id from lk where k = repeat(md5('777'), 30)
----
777

statement ok
update lk set k = repeat(md5((id + 5000)::text), 30) where id % 10 = 0

statement ok
delete from lk where id % 7 = 0

query I nosort
select id from lk where k = repeat(md5('10'), 30)
----

query I nosort
select id from lk where k = repeat(md5('5010'), 30)
----
10

query II nosort
select count(*), sum(id) from lk where k >= 'e'
----
111	54487

query II nosort
select count(*), sum(id) from lk
----
858	429429
