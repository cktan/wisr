# Verify the release of a statement's pins at its end keeps what a later
# statement still reads: an open cursor's rows, and the reads after an
# error a savepoint undid.
# 1. Make two tables with text columns and indexes, and plan nested loops
#    of index scans.
# 2. In a transaction, declare a cursor over the join, FETCH, run other
#    statements while it is open, FETCH again: the rows are whole. Close
#    it; the statements after read and delete as before.
# 3. In another, fail a statement inside a savepoint partway through an
#    index scan, roll back to it, and read again: the rows are whole.

statement ok
create table a (k int4, x text)

statement ok
create table b (k int4, y text)

statement ok
create index ak on a (k)

statement ok
create index bk on b (k)

statement ok
insert into a select i, 'a row ' || i || repeat('.', i) from generate_series(1, 20) i

statement ok
insert into b select i, 'b row ' || i || repeat('.', i) from generate_series(1, 20) i

statement ok
set enable_hashjoin = off

statement ok
set enable_mergejoin = off

statement ok
set enable_seqscan = off

statement ok
set enable_bitmapscan = off

statement ok
begin

statement ok
declare c cursor for select a.k, x, y from a join b on b.k = a.k where a.k between 4 and 7

query ITT
fetch 1 from c
----
4	a row 4....	b row 4....

# A statement of its own, while the cursor is open: its end keeps the
# cursor's pins.
query T
select y from b where k = 12
----
b row 12............

query ITT
fetch 2 from c
----
5	a row 5.....	b row 5.....
6	a row 6......	b row 6......

query T
select x from a where k = 3
----
a row 3...

query ITT
fetch 1 from c
----
7	a row 7.......	b row 7.......

statement ok
close c

query IT
delete from a where k = 2 returning k, x
----
2	a row 2..

query T
select x from a where k = 9
----
a row 9.........

statement ok
commit

statement ok
begin

statement ok
savepoint s

statement error division by zero
select k / (k - 10) from a where k between 8 and 12

statement ok
rollback to s

query IT rowsort
select k, x from a where k between 8 and 11
----
10	a row 10..........
11	a row 11...........
8	a row 8........
9	a row 9.........

statement ok
commit
