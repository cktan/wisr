# Verify a table scan that reads only a row's first columns, up to the
# last its output and filter name, gives what reading every one does.
# 1. Make a table of eight columns, numerics and nulls among them.
# 2. Read its first column, none (count), and every one.
# 3. Filter on a later column than the one read, and on an earlier.
# 4. Join the table to itself, each side reading different columns.
# 5. Read through a cursor, and from a subquery naming an outer column.
# 6. Update and delete by a later column, reading the rows back.
# 7. Drop a column, and read the columns before and after it.
# 8. By index scans: read a column before the key's, which sm checks
#    every row against; filter on a later column; read none, and
#    every one; update by the key; and join, the inner side's key
#    known only at each outer row.
# 9. By bitmap heap scans: read a column before the key's, which
#    the recheck reads every row by; filter on a later column; read
#    none, and every one.
# 10. By a TID scan, and by DELETE RETURNING, which read a row by its
#    tid: a column before a later one in the filter or RETURNING;
#    none; and every one.

statement ok
create table w (a int4, b text, c int4, d numeric(10,2), e text,
                f int8, g bool, h int4)

statement ok
insert into w values
  (1, 'x', 10, 1.50, 'e1', 100, true, 1000),
  (2, null, 20, null, 'e2', null, false, 2000),
  (3, 'z', null, 3.25, null, 300, null, 3000)

query I nosort
select a from w order by a
----
1
2
3

query I nosort
select count(*) from w
----
3

query ITITTITI nosort
select * from w order by a
----
1	x	10	1.50	e1	100	t	1000
2	NULL	20	NULL	e2	NULL	f	2000
3	z	NULL	3.25	NULL	300	NULL	3000

query I nosort
select a from w where h > 1500 order by a
----
2
3

query T nosort
select e from w where a < 3 order by e
----
e1
e2

query T nosort
select d from w where g order by d
----
1.50

query II nosort
select x.a, y.h from w x join w y on x.c = y.c order by x.a
----
1	1000
2	2000

statement ok
begin

statement ok
declare cur cursor for select b, c from w order by a

query TI nosort
fetch 2 from cur
----
x	10
NULL	20

statement ok
commit

query II nosort
select a, (select count(*) from w y where y.f < x.h) from w x order by a
----
1	2
2	2
3	2

statement ok
update w set b = 'u' where h = 2000

statement ok
delete from w where f = 300

query IT nosort
select a, b from w order by a
----
1	x
2	u

statement ok
alter table w drop column c

query IT nosort
select a, b from w order by a
----
1	x
2	u

query IT nosort
select a, h from w order by a
----
1	1000
2	2000

query ITTTITI nosort
select * from w order by a
----
1	x	1.50	e1	100	t	1000
2	u	NULL	e2	NULL	f	2000

statement ok
create table v (a int4, b text, c int4, d numeric(10,2), e text, f int4,
                g int4)

statement ok
insert into v values
  (1, 'x', 2, 1.50, 'e1', 1, 10),
  (2, null, 3, null, 'e2', 2, 20),
  (3, 'z', 1, 3.25, null, 3, 30)

statement ok
create index v_f on v (f)

statement ok
set enable_seqscan = off

statement ok
set enable_bitmapscan = off

query T nosort
explain (costs off) select a from v where f = 2
----
Index Scan using v_f on v
  Index Cond: (f = 2)

query I nosort
select a from v where f = 2
----
2

query T nosort
select b from v where f > 1 and g = 30
----
z

query I nosort
select count(*) from v where f >= 2
----
2

query ITITTII nosort
select * from v where f = 1
----
1	x	2	1.50	e1	1	10

statement ok
update v set b = 'u' where f = 2

query IT nosort
select a, b from v where f = 2
----
2	u

statement ok
set enable_hashjoin = off

statement ok
set enable_mergejoin = off

query T nosort
explain (costs off) select x.a, y.e from v x join v y on y.f = x.c
----
Nested Loop
  ->  Seq Scan on v x
        Disabled: true
  ->  Index Scan using v_f on v y
        Index Cond: (f = x.c)

query IT rowsort
select x.a, y.e from v x join v y on y.f = x.c
----
1	e2
2	NULL
3	e1

statement ok
set enable_indexscan = off

statement ok
set enable_bitmapscan = on

query T nosort
explain (costs off) select a from v where f = 1 or f = 3
----
Bitmap Heap Scan on v
  Recheck Cond: ((f = 1) OR (f = 3))
  ->  BitmapOr
        ->  Bitmap Index Scan on v_f
              Index Cond: (f = 1)
        ->  Bitmap Index Scan on v_f
              Index Cond: (f = 3)

query I rowsort
select a from v where f = 1 or f = 3
----
1
3

query I rowsort
select a from v where (f = 1 or f = 3) and g > 15
----
3

query I nosort
select count(*) from v where f = 1 or f = 3
----
2

query ITITTII rowsort
select * from v where f = 1 or f = 3
----
1	x	2	1.50	e1	1	10
3	z	1	3.25	NULL	3	30

statement ok
insert into v values
  (4, 'p', 5, 4.75, 'e4', 4, 40),
  (5, 'q', 6, null, 'e5', 5, 50),
  (6, 'r', 7, 6.00, 'e6', 6, 60),
  (7, 's', 8, 7.25, 'e7', 7, 70)

onlyif digres
query T nosort
explain (costs off) select a from v where rowno = (select rowno from v where f = 2) and g > 15
----
Tid Scan on v
  TID Cond: (rowno = (InitPlan 1).col1)
  Filter: (g > 15)
  InitPlan 1
    ->  Bitmap Heap Scan on v v_1
          Recheck Cond: (f = 2)
          ->  Bitmap Index Scan on v_f
                Index Cond: (f = 2)

onlyif digres
query I nosort
select a from v where rowno = (select rowno from v where f = 2) and g > 15
----
2

onlyif digres
query I nosort
select a from v where rowno = (select rowno from v where f = 2) and g > 25
----

onlyif digres
query I nosort
select count(*) from v where rowno = (select rowno from v where f = 3)
----
1

onlyif digres
query ITITTII nosort
select * from v where rowno = (select rowno from v where f = 3)
----
3	z	1	3.25	NULL	3	30

query T nosort
delete from v where f = 4 returning b
----
p

query IT nosort
delete from v where f = 5 returning a, e
----
5	e5

query I nosort
delete from v where f = 6 returning 1
----
1

query ITITTII nosort
delete from v where f = 7 returning *
----
7	s	8	7.25	e7	7	70

query I nosort
select count(*) from v
----
3
