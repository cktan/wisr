# Verify that TABLESAMPLE reads a sample of a table in sm, its blocks a
# tid's, 256 rownos each (dg/WORKNOTE.md step 244), as PostgreSQL's reads one
# of a heap's pages.
# 1. A table of 10000 rows: BERNOULLI and SYSTEM at 100 take every row, at 0
#    none.
# 2. BERNOULLI (10) takes about a tenth; SYSTEM (10) fewer than all.
# 3. REPEATABLE with one seed takes the same rows twice, by each method.
# 4. Rows deleted are not sampled: half deleted, 100 takes the other half.
# 5. A sample scan rescanned, under LATERAL, starts again for each outer
#    row.
# 6. A method not built in, as tsm_system_rows' SYSTEM_ROWS, does not exist.

statement ok
create table ts (a int4 primary key, b text)

statement ok
insert into ts select g, 'r' || g from generate_series(1, 10000) g

query IIII nosort
select (select count(*) from ts tablesample bernoulli (100)),
       (select count(*) from ts tablesample system (100)),
       (select count(*) from ts tablesample bernoulli (0)),
       (select count(*) from ts tablesample system (0))
----
10000	10000	0	0

query T nosort
select count(*) between 500 and 1500
  from ts tablesample bernoulli (10) repeatable (1)
----
t

query T nosort
select count(*) < 10000 from ts tablesample system (10) repeatable (1)
----
t

query TT nosort
select (select array_agg(a order by a)
          from ts tablesample bernoulli (5) repeatable (42)) =
       (select array_agg(a order by a)
          from ts tablesample bernoulli (5) repeatable (42)),
       (select array_agg(a order by a)
          from ts tablesample system (20) repeatable (7)) =
       (select array_agg(a order by a)
          from ts tablesample system (20) repeatable (7))
----
t	t

statement ok
delete from ts where a % 2 = 0

query II nosort
select count(*), sum(a % 2) from ts tablesample bernoulli (100)
----
5000	5000

query II nosort
select g, x.n
  from generate_series(1, 3) g,
       lateral (select count(*) as n from ts tablesample bernoulli (100)
                 where a > g) x
 order by g
----
1	4999
2	4999
3	4998

statement error tablesample method system_rows does not exist
select * from ts tablesample system_rows (10)
