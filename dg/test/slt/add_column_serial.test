# Verify ALTER TABLE ... ADD COLUMN of a serial or an identity column, as
# PostgreSQL's: a sequence made for it, each row already there given its
# next value, the column NOT NULL, and the sequence the column's.
# 1. A serial column numbers the rows there in the table's order, goes on
#    for a row inserted after, and refuses a null; dropping the column
#    drops its sequence. A bigserial does the same.
# 2. An identity column, GENERATED ALWAYS, numbers the rows there, goes on
#    for a new row, refuses a value of the inserter's own, and keeps its
#    sequence: giving it another owner is refused.
# 3. One GENERATED BY DEFAULT takes a value of the inserter's own.
# 4. A serial added in a transaction rolled back leaves no sequence.

statement ok
create table t (k int4, x text)

statement ok
insert into t select i, 'row ' || i from generate_series(1, 3) i

statement ok
alter table t add column id serial

query II nosort
select k, id from t order by k
----
1	1
2	2
3	3

statement ok
insert into t (k, x) values (4, 'row 4')

query II nosort
select k, id from t where k = 4
----
4	4

statement error null value in column "id" of relation "t" violates not-null constraint
insert into t (k, x, id) values (5, 'row 5', null)

statement ok
alter table t drop column id

statement error relation "t_id_seq" does not exist
select nextval('t_id_seq')

statement ok
alter table t add column b bigserial

query II nosort
select k, b from t order by k
----
1	1
2	2
3	3
4	4

statement ok
alter table t add column g int8 generated always as identity

query II nosort
select k, g from t order by k
----
1	1
2	2
3	3
4	4

statement ok
insert into t (k, x) values (5, 'row 5')

query II nosort
select k, g from t where k = 5
----
5	5

statement error cannot insert a non-DEFAULT value into column "g"
insert into t (k, x, g) values (6, 'row 6', 100)

statement error cannot change ownership of identity sequence
alter sequence t_g_seq owned by none

statement ok
alter table t add column h int4 generated by default as identity

statement ok
insert into t (k, x, h) values (6, 'row 6', 100)

query III nosort
select k, g, h from t order by k
----
1	1	1
2	2	2
3	3	3
4	4	4
5	5	5
6	6	100

statement ok
begin

statement ok
alter table t add column z serial

statement ok
rollback

statement error relation "t_z_seq" does not exist
select nextval('t_z_seq')
