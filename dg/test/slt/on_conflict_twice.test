# Verify that an INSERT ... ON CONFLICT DO UPDATE whose rows conflict
# with each other is refused, as PostgreSQL refuses it: it would update
# one row twice. sm tells the case by the update finding the row written
# by this statement (dg/WORKNOTE.md step 237).
# 1. Two rows with one key, in one INSERT ... ON CONFLICT DO UPDATE, fail.
# 2. The table then holds nothing: the statement's first row went with it.
# 3. Two rows with one key that conflict with a row already there fail.
# 4. The row there is as it was.
# 5. A join UPDATE that reaches one row twice is still allowed, as in
#    PostgreSQL: the second change of the row is passed over.

statement ok
create table t (a int4 primary key, b int4)

statement error ON CONFLICT DO UPDATE command cannot affect row a second time
insert into t values (1, 0), (1, 1) on conflict (a) do update set b = excluded.b

query I nosort
select count(*) from t
----
0

statement ok
insert into t values (2, 0)

statement error ON CONFLICT DO UPDATE command cannot affect row a second time
insert into t values (2, 1), (2, 2) on conflict (a) do update set b = excluded.b

query II nosort
select a, b from t
----
2	0

statement ok
create table s (a int4, b int4)

statement ok
insert into s values (2, 7), (2, 7)

statement ok
update t set b = s.b from s where t.a = s.a

query II nosort
select a, b from t
----
2	7
