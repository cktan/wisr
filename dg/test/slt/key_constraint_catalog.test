# Verify that pg_constraint lists a table's primary key and unique
# constraints, as PostgreSQL does, and not a unique index CREATE UNIQUE INDEX
# made (dg/WORKNOTE.md step 248).
# 1. A table with a primary key, a unique constraint on one column and one
#    on two with INCLUDE, and a unique index made by CREATE UNIQUE INDEX.
# 2. The primary key is a row of type p, each unique constraint one of type
#    u, named as its index, on its key columns; the index has none.
# 3. pg_get_constraintdef() writes each, INCLUDE columns too.
# 4. Dropping the table drops its rows.

statement ok
create table kp (a int4 primary key, b int4 unique, c int4, d text,
                 unique (b, c) include (d))

statement ok
create unique index kp_c on kp (c)

query TTTT nosort
select conname, contype, conindid::regclass::text, conkey::text
  from pg_constraint where conrelid = 'kp'::regclass order by conname
----
kp_b_c_key	u	kp_b_c_key	{2,3}
kp_b_key	u	kp_b_key	{2}
kp_pkey	p	kp_pkey	{1}

query TT nosort
select conname, pg_get_constraintdef(oid) from pg_constraint
 where conrelid = 'kp'::regclass order by conname
----
kp_b_c_key	UNIQUE (b, c) INCLUDE (d)
kp_b_key	UNIQUE (b)
kp_pkey	PRIMARY KEY (a)

statement ok
drop table kp

query I nosort
select count(*) from pg_constraint where conname like 'kp%'
----
0
