# Verify that an index key takes its type's default operator class and its
# column's collation, named or not, and that the index serves queries.
# 1. Make a table of three types, and index each column naming its
#    default operator class, one descending and one with its collation.
# 2. Confirm a query plans with the index and returns its rows.

statement ok
create table k (i int4, t text, c char(4))

statement ok
insert into k values (1, 'one', 'a'), (2, 'two', 'b'), (3, 'three', 'c')

statement ok
create index ki on k using btree (i int4_ops)

statement ok
create unique index kt on k (t text_ops desc)

statement ok
create index kc on k (c collate "default" bpchar_ops)

statement ok
set enable_seqscan = off

statement ok
set enable_bitmapscan = off

query T nosort
explain (costs off) select i from k where t = 'two'
----
Index Scan using kt on k
  Index Cond: (t = 'two'::text)

query I nosort
select i from k where t = 'two'
----
2

statement error duplicate key value violates unique constraint "kt"
insert into k values (4, 'one', 'd')

# Verify that a wrong operator class or collation is refused as PostgreSQL
# refuses it.
# 1. Name an operator class that does not exist, and one for another type.
# 2. Give options to an operator class that has none.
# 3. Give a collation to a type that has none.

statement error operator class "nosuch_ops" does not exist for access method "btree"
create index kbad on k (i nosuch_ops)

statement error operator class "text_ops" does not accept data type integer
create index kbad on k (i text_ops)

statement error operator class int4_ops has no options
create index kbad on k (i int4_ops(foo=1))

statement error collations are not supported by type integer
create index kbad on k (i collate "C")

# Verify that what sm cannot key by yet is refused: an operator class not
# the type's default, a collation not the column's, and an expression.
# 1. Name text_pattern_ops on a text column.
# 2. Name collation "C" on a column of the default collation.
# 3. Index an expression.

onlyif digres
statement error operator class text_pattern_ops is not supported yet
create index kbad on k (t text_pattern_ops)

onlyif digres
statement error collation "C" is not supported for an index key yet
create index kbad on k (t collate "C")

onlyif digres
statement error an index key is a column, not an expression, yet
create index kbad on k (lower(t))
