# Verify the planner fixes digres takes from PostgreSQL 18 after its fork,
# each a query that once stopped the server on an assertion.
# 1. A whole-row reference to a join over a flattened subquery, in a
#    sub-select (upstream 7a776fc9d28).
# 2. A lateral reference to an outer join's output that the outer join
#    would have to pass into its own input (upstream cbec572918f).
# 3. A lateral reference only a rel referencing the join itself could
#    satisfy, below a left join, a full join, and in a sub-joinlist,
#    once "failed to build any 4-way joins" (upstream 7432ecba189).
# 4. An outer join whose clause reaches a lower join's RHS only within
#    a PlaceHolderVar, not commuted with it (upstream d7938ff3085).

statement ok
create table int4_tbl (f1 int4)

statement ok
insert into int4_tbl values (0), (123456), (-123456), (2147483647), (-2147483647)

query I nosort
select 1 from ((select (select 1) as x) ss1 cross join int4_tbl i4) j
  where (select 1 where j is null) is null
----
1
1
1
1
1

query I nosort
select 1 from ((select (select 1) as x) ss1 cross join int4_tbl i4) j
  where (1, 1) in (select (j is null)::int, count(*) from int4_tbl)
----

query I nosort
select 1 from ((select (select 1) as x) ss1 cross join int4_tbl i4) j
  where exists (select 1 from int4_tbl
                tablesample system ((j is null)::int * 100))
----

statement ok
create table int8_tbl (q1 int8, q2 int8)

statement ok
insert into int8_tbl values (123, 456), (123, 4567890123456789),
  (4567890123456789, 123), (4567890123456789, 4567890123456789),
  (4567890123456789, -4567890123456789)

query I nosort
select count(*) from int4_tbl t1 left join
  (select b.q1 as bx, 1 as one from int4_tbl a left join int8_tbl b on a.f1 = b.q2) t2
    on true
  left join lateral
    (select c.f1 as cnt from int4_tbl c where c.f1 = t2.one offset 0) t3
    on t2.bx = t3.cnt
----
25

query I nosort
select 1 from int4_tbl t1 left join int4_tbl t2 on true,
  lateral (select t2.f1 offset 0) s1 left join int8_tbl t3 on s1.f1 = t3.q1,
  lateral (select t3.q2 offset 0) s2
where s2.q2 > t1.f1
----

query I nosort
select count(*) from int4_tbl t1 left join int4_tbl t2 on true,
  lateral (select t2.f1 offset 0) s1 full join int8_tbl t3 on s1.f1 = t3.q1,
  lateral (select t3.q2 offset 0) s2
where s2.q2 > t1.f1
----
80

statement ok
set from_collapse_limit to 4

query I nosort
select count(*) from int4_tbl t1 left join int4_tbl t2 on true,
  lateral (select t2.f1 offset 0) s1 join int8_tbl t3 on s1.f1 = t3.q1,
  lateral (select t3.q2 offset 0) s2
where s2.q2 > t1.f1
----
0

statement ok
reset from_collapse_limit

query I nosort
select count(*) from int4_tbl t1
  left join int4_tbl t2 on true
  left join lateral (select t2.f1, 1 from int4_tbl t3) s(x, y) on true
  left join int4_tbl t4 on t4.f1 = s.x
  join int4_tbl t5 on true
where s.y is not null
----
625
