# Verify a ROLLBACK TO SAVEPOINT never lets a COPY it rolled back be
# committed: into an empty table COPY is sm's bulk load, which lists
# no row to undo, and the rollback empties the table instead
# (../sm/BULKLOAD.md section 3.5).
# 1. COPY into a table with rows, after a savepoint, roll back to it
#    and commit: the table keeps only its rows from before.
# 2. COPY into an empty table, after a savepoint, roll back to it and
#    commit: the table is empty.
# 3. Create a table after a savepoint, COPY into it, roll back to the
#    savepoint and commit: the table does not exist.
# 4. A COPY into an empty table that fails after its load began, in a
#    savepoint: roll back to it, insert a row and commit; only that row
#    is there.
# 5. A CREATE TABLE AS that fails after its load began, in a savepoint:
#    roll back to it and commit; the table does not exist.
# 6. A COPY whose load fails at its end, on a duplicate key, in a
#    savepoint: roll back to it, read the table empty, insert a row
#    and commit; only that row is there.

statement ok
create table r (a int4)

statement ok
insert into r values (0)

statement ok
begin

statement ok
savepoint one

statement ok
copy r from program 'printf "1\n2\n"'

statement ok
rollback to savepoint one

statement ok
commit

query I nosort
select a from r
----
0

statement ok
create table e (a int4)

statement ok
begin

statement ok
savepoint one

statement ok
copy e from program 'printf "1\n2\n"'

statement ok
rollback to savepoint one

statement ok
commit

query I nosort
select count(*) from e
----
0

statement ok
begin

statement ok
savepoint one

statement ok
create table n (a int4)

statement ok
copy n from program 'printf "1\n2\n"'

statement ok
rollback to savepoint one

statement ok
commit

statement error relation "n" does not exist
select count(*) from n

statement ok
create table w (a int4)

statement ok
begin

statement ok
savepoint one

statement error invalid input syntax for type integer
copy w from program '(seq 1 2000; echo x)'

statement ok
rollback to savepoint one

statement ok
insert into w values (9)

statement ok
commit

query I nosort
select a from w
----
9

statement ok
begin

statement ok
savepoint one

statement error division by zero
create table f as select 10 / (5 - g) as x from generate_series(1, 9) g

statement ok
rollback to savepoint one

statement ok
commit

statement error relation "f" does not exist
select count(*) from f

statement ok
create table u (a int4 primary key)

statement ok
begin

statement ok
savepoint one

skipif digres
statement error duplicate key value violates unique constraint
copy u from program 'printf "1\n1\n"'

onlyif digres
statement error duplicate key value violates a unique index on "u"
copy u from program 'printf "1\n1\n"'

statement ok
rollback to savepoint one

query I nosort
select count(*) from u
----
0

statement ok
insert into u values (2)

statement ok
commit

query I nosort
select a from u
----
2
