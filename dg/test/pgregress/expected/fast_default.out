--dg                   DEFAULT '2016-09-01'::DATE + LENGTH(foo(10)),
--dg               ALTER COLUMN c_date
--dg                   SET DEFAULT '2010-01-01'::DATE - LENGTH(foo(4));
--dg-cascade
--dg INSERT INTO T VALUES (9), (10);
--dg-cascade
