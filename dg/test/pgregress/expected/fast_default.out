-- Test expressions in the defaults
--dg-skip: language "?" does not exist
--dg CREATE OR REPLACE FUNCTION foo(a INT) RETURNS TEXT AS $$
--dg DECLARE res TEXT := '';
--dg         i INT;
--dg BEGIN
--dg   i := 0;
--dg   WHILE (i < a) LOOP
--dg     res := res || chr(ascii('a') + i);
--dg     i := i + 1;
--dg   END LOOP;
--dg   RETURN res;
--dg END; $$ LANGUAGE PLPGSQL STABLE;
--dg-cascade
--dg CREATE TABLE T(pk INT NOT NULL PRIMARY KEY, c_int INT DEFAULT LENGTH(foo(6)));
--dg-cascade
--dg SELECT set('t');
