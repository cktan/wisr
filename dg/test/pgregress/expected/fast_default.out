  2 |       -1 | "hello"
  3 |       -1 | "hello"
  4 |       -1 | "hello"
  5 |       -1 | "hello"
  6 |       -1 | "hello"
  7 |       -1 | "hello"
  8 |       -1 | "hello"
  9 |       -1 | "hello"
(9 rows)

