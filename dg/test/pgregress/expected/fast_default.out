--
-- ALTER TABLE ADD COLUMN DEFAULT test
--
SET search_path = fast_default;
CREATE SCHEMA fast_default;
--dg-skip: type ? is not supported yet
--dg CREATE TABLE m(id OID);
--dg-cascade
--dg INSERT INTO m VALUES (NULL::OID);
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION set(tabname name) RETURNS VOID
--dg AS $$
--dg BEGIN
--dg   UPDATE m
--dg   SET id = (SELECT c.relfilenode
--dg             FROM pg_class AS c, pg_namespace AS s
--dg             WHERE c.relname = tabname
--dg                 AND c.relnamespace = s.oid
--dg                 AND s.nspname = 'fast_default');
--dg END;
--dg $$ LANGUAGE 'plpgsql';
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION comp() RETURNS TEXT
--dg AS $$
--dg BEGIN
--dg   RETURN (SELECT CASE
--dg                WHEN m.id = c.relfilenode THEN 'Unchanged'
--dg                ELSE 'Rewritten'
--dg                END
--dg            FROM m, pg_class AS c, pg_namespace AS s
--dg            WHERE c.relname = 't'
--dg                AND c.relnamespace = s.oid
--dg                AND s.nspname = 'fast_default');
--dg END;
--dg $$ LANGUAGE 'plpgsql';
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION log_rewrite() RETURNS event_trigger
--dg LANGUAGE plpgsql as
--dg $func$
--dg
--dg declare
--dg    this_schema text;
--dg begin
--dg     select into this_schema relnamespace::regnamespace::text
--dg     from pg_class
--dg     where oid = pg_event_trigger_table_rewrite_oid();
--dg     if this_schema = 'fast_default'
--dg     then
--dg         RAISE NOTICE 'rewriting table % for reason %',
--dg           pg_event_trigger_table_rewrite_oid()::regclass,
--dg           pg_event_trigger_table_rewrite_reason();
--dg     end if;
--dg end;
--dg $func$;
CREATE TABLE has_volatile AS
SELECT * FROM generate_series(1,10) id;
--dg-skip: relation pg_event_trigger cannot be opened: digres has no catalog tables
--dg CREATE EVENT TRIGGER has_volatile_rewrite
--dg                   ON table_rewrite
--dg    EXECUTE PROCEDURE log_rewrite();
-- only the last of these should trigger a rewrite
ALTER TABLE has_volatile ADD col1 int;
ALTER TABLE has_volatile ADD col2 int DEFAULT 1;
ALTER TABLE has_volatile ADD col3 timestamptz DEFAULT current_timestamp;
--dg-cascade
--dg ALTER TABLE has_volatile ADD col4 int DEFAULT (random() * 10000)::int;
-- virtual generated columns don't need a rewrite
--dg-skip: ALTER TABLE ... ADD COLUMN supports only NOT NULL, DEFAULT and CHECK yet
--dg ALTER TABLE has_volatile ADD col5 int GENERATED ALWAYS AS (tableoid::int + col2) VIRTUAL;
--dg-cascade
--dg ALTER TABLE has_volatile ALTER COLUMN col5 TYPE float8;
--dg-cascade
--dg ALTER TABLE has_volatile ALTER COLUMN col5 TYPE numeric;
--dg-cascade
--dg ALTER TABLE has_volatile ALTER COLUMN col5 TYPE numeric;
-- here, we do need a rewrite
--dg-cascade
--dg ALTER TABLE has_volatile ALTER COLUMN col1 SET DATA TYPE float8,
--dg   ADD COLUMN col6 float8 GENERATED ALWAYS AS (col1 * 4) VIRTUAL;
-- stored generated columns need a rewrite
--dg-cascade
--dg ALTER TABLE has_volatile ADD col7 int GENERATED ALWAYS AS (55) stored;
-- Test a large sample of different datatypes
CREATE TABLE T(pk INT NOT NULL PRIMARY KEY, c_int INT DEFAULT 1);
--dg-cascade
--dg SELECT set('t');
INSERT INTO T VALUES (1), (2);
ALTER TABLE T ADD COLUMN c_bpchar BPCHAR(5) DEFAULT 'hello',
              ALTER COLUMN c_int SET DEFAULT 2;
