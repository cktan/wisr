-- Test domains with default value for table rewrite.
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg CREATE DOMAIN domain1 AS int DEFAULT 11;  -- constant
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg CREATE DOMAIN domain2 AS int DEFAULT random(min=>10, max=>100);  -- volatile
--dg-cascade
--dg CREATE DOMAIN domain3 AS text DEFAULT foo(4);  -- stable
--dg-cascade
--dg CREATE DOMAIN domain4 AS text[]
--dg   DEFAULT ('{"This", "is", "' || foo(4) || '","the", "real", "world"}')::TEXT[];
--dg-cascade
--dg CREATE TABLE t2 (a domain1);
--dg-cascade
--dg INSERT INTO t2 VALUES (1),(2);
-- no table rewrite
--dg-cascade
--dg ALTER TABLE t2 ADD COLUMN b domain1 default 3;
--dg-cascade
--dg SELECT attnum, attname, atthasmissing, atthasdef, attmissingval
--dg FROM pg_attribute
--dg WHERE attnum > 0 AND attrelid = 't2'::regclass
--dg ORDER BY attnum;
-- table rewrite should happen
--dg-cascade
--dg ALTER TABLE t2 ADD COLUMN c domain3 default left(random()::text,3);
-- no table rewrite
--dg-cascade
--dg ALTER TABLE t2 ADD COLUMN d domain4;
--dg-cascade
--dg SELECT attnum, attname, atthasmissing, atthasdef, attmissingval
--dg FROM pg_attribute
--dg WHERE attnum > 0 AND attrelid = 't2'::regclass
--dg ORDER BY attnum;
-- table rewrite should happen
--dg-cascade
--dg ALTER TABLE t2 ADD COLUMN e domain2;
--dg-cascade
--dg SELECT attnum, attname, atthasmissing, atthasdef, attmissingval
--dg FROM pg_attribute
--dg WHERE attnum > 0 AND attrelid = 't2'::regclass
--dg ORDER BY attnum;
--dg-cascade
--dg SELECT a, b, length(c) = 3 as c_ok, d, e >= 10 as e_ok FROM t2;
--dg-cascade
--dg DROP TABLE t2;
--dg-cascade
--dg DROP DOMAIN domain1;
--dg-cascade
--dg DROP DOMAIN domain2;
--dg-cascade
--dg DROP DOMAIN domain3;
--dg-cascade
--dg DROP DOMAIN domain4;
--dg-cascade
--dg DROP FUNCTION foo(INT);
-- Fall back to full rewrite for volatile expressions
CREATE TABLE T(pk INT NOT NULL PRIMARY KEY);
INSERT INTO T VALUES (1);
--dg-cascade
--dg SELECT set('t');
-- now() is stable, because it returns the transaction timestamp
ALTER TABLE T ADD COLUMN c1 TIMESTAMP DEFAULT now();
--dg-cascade
--dg SELECT comp();
-- clock_timestamp() is volatile
--dg-cascade
--dg ALTER TABLE T ADD COLUMN c2 TIMESTAMP DEFAULT clock_timestamp();
--dg-cascade
--dg SELECT comp();
