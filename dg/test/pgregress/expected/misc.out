--
-- BTREE
--
UPDATE onek
   SET unique1 = onek.unique1 + 1;
UPDATE onek
   SET unique1 = onek.unique1 - 1;
--
-- BTREE partial
--
-- UPDATE onek2
--   SET unique1 = onek2.unique1 + 1;
--UPDATE onek2
--   SET unique1 = onek2.unique1 - 1;
--
-- BTREE shutting out non-functional updates
--
-- the following two tests seem to take a long time on some
-- systems.    This non-func update stuff needs to be examined
-- more closely.  			- jolly (2/22/96)
--
SELECT two, stringu1, ten, string4
   INTO TABLE tmp
   FROM onek;
--dg-cascade
--dg UPDATE tmp
--dg    SET stringu1 = reverse_name(onek.stringu1)
--dg    FROM onek
--dg    WHERE onek.stringu1 = 'JBAAAA' and
--dg 	  onek.stringu1 = tmp.stringu1;
--dg-cascade
--dg UPDATE tmp
--dg    SET stringu1 = reverse_name(onek2.stringu1)
--dg    FROM onek2
--dg    WHERE onek2.stringu1 = 'JCAAAA' and
--dg 	  onek2.stringu1 = tmp.stringu1;
DROP TABLE tmp;
