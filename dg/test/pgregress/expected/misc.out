--
-- mike does post_hacking,
-- joe and sally play basketball, and
-- everyone else does nothing.
--
SELECT p.name, name(p.hobbies) FROM ONLY person p;
ERROR:  relation "person" does not exist
LINE 1: SELECT p.name, name(p.hobbies) FROM ONLY person p;
                                                 ^
--
-- as above, but jeff also does post_hacking.
--
SELECT p.name, name(p.hobbies) FROM person* p;
ERROR:  relation "person" does not exist
LINE 1: SELECT p.name, name(p.hobbies) FROM person* p;
                                            ^
--
-- the next two queries demonstrate how functions generate bogus duplicates.
-- this is a "feature" ..
--
--dg-cascade
--dg SELECT DISTINCT hobbies_r.name, name(hobbies_r.equipment) FROM hobbies_r
--dg   ORDER BY 1,2;
--dg-cascade
--dg SELECT hobbies_r.name, (hobbies_r.equipment).name FROM hobbies_r;
--
-- mike needs advil and peet's coffee,
-- joe and sally need hightops, and
-- everyone else is fine.
--
SELECT p.name, name(p.hobbies), name(equipment(p.hobbies)) FROM ONLY person p;
ERROR:  relation "person" does not exist
LINE 1: ...e(p.hobbies), name(equipment(p.hobbies)) FROM ONLY person p;
                                                              ^
--
-- as above, but jeff needs advil and peet's coffee as well.
--
SELECT p.name, name(p.hobbies), name(equipment(p.hobbies)) FROM person* p;
ERROR:  relation "person" does not exist
LINE 1: ... name(p.hobbies), name(equipment(p.hobbies)) FROM person* p;
                                                             ^
--
-- just like the last two, but make sure that the target list fixup and
-- unflattening is being done correctly.
--
SELECT name(equipment(p.hobbies)), p.name, name(p.hobbies) FROM ONLY person p;
ERROR:  relation "person" does not exist
LINE 1: ...ent(p.hobbies)), p.name, name(p.hobbies) FROM ONLY person p;
                                                              ^
SELECT (p.hobbies).equipment.name, p.name, name(p.hobbies) FROM person* p;
ERROR:  relation "person" does not exist
LINE 1: ...ies).equipment.name, p.name, name(p.hobbies) FROM person* p;
                                                             ^
SELECT (p.hobbies).equipment.name, name(p.hobbies), p.name FROM ONLY person p;
ERROR:  relation "person" does not exist
LINE 1: ....equipment.name, name(p.hobbies), p.name FROM ONLY person p;
                                                              ^
SELECT name(equipment(p.hobbies)), name(p.hobbies), p.name FROM person* p;
ERROR:  relation "person" does not exist
LINE 1: ...uipment(p.hobbies)), name(p.hobbies), p.name FROM person* p;
                                                             ^
