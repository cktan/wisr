--dg-cascade
--dg fetch all in local_portal;
--dg-cascade
--dg declare held_portal cursor with hold for select * from toasted_data;
commit;
--dg-cascade
--dg drop table toasted_data;
--dg-cascade
--dg fetch all in held_portal;
reset default_toast_compression;
