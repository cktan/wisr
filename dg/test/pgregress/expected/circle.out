--
-- CIRCLE
--
-- Back off displayed precision a little bit to reduce platform-to-platform
-- variation in results.
SET extra_float_digits = -1;
--dg-skip: type ? is not supported yet
--dg CREATE TABLE CIRCLE_TBL (f1 circle);
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(5,1),3>');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('((1,2),100)');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES (' 1 , 3 , 5 ');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES (' ( ( 1 , 2 ) , 3 ) ');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES (' ( 100 , 200 ) , 10 ');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES (' < ( 100 , 1 ) , 115 > ');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(3,5),0>');	-- Zero radius
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(3,5),NaN>');	-- NaN radius
-- bad values
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(-100,0),-100>');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(100,200),10');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('<(100,200),10> x');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('1abc,3,5');
--dg-cascade
--dg INSERT INTO CIRCLE_TBL VALUES ('(3,(1,2),3)');
--dg-cascade
--dg SELECT * FROM CIRCLE_TBL;
--dg-cascade
--dg SELECT center(f1) AS center
--dg   FROM CIRCLE_TBL;
--dg-cascade
--dg SELECT radius(f1) AS radius
--dg   FROM CIRCLE_TBL;
--dg-cascade
--dg SELECT diameter(f1) AS diameter
--dg   FROM CIRCLE_TBL;
--dg-cascade
--dg SELECT f1 FROM CIRCLE_TBL WHERE radius(f1) < 5;
--dg-cascade
--dg SELECT f1 FROM CIRCLE_TBL WHERE diameter(f1) >= 10;
--dg-cascade
--dg SELECT c1.f1 AS one, c2.f1 AS two, (c1.f1 <-> c2.f1) AS distance
--dg   FROM CIRCLE_TBL c1, CIRCLE_TBL c2
--dg   WHERE (c1.f1 < c2.f1) AND ((c1.f1 <-> c2.f1) > 0)
--dg   ORDER BY distance, area(c1.f1), area(c2.f1);
