--dg-skip: relation "?" does not exist
--dg SELECT c1.oid
--dg FROM pg_opclass AS c1
--dg WHERE c1.opcmethod = 0 OR c1.opcnamespace = 0 OR c1.opcfamily = 0
--dg     OR c1.opcintype = 0;
-- opcmethod must match owning opfamily's opfmethod
--dg-skip: relation "?" does not exist
--dg SELECT c1.oid, f1.oid
--dg FROM pg_opclass AS c1, pg_opfamily AS f1
--dg WHERE c1.opcfamily = f1.oid AND c1.opcmethod != f1.opfmethod;
-- There should not be multiple entries in pg_opclass with opcdefault true
-- and the same opcmethod/opcintype combination.
--dg-skip: relation "?" does not exist
--dg SELECT c1.oid, c2.oid
--dg FROM pg_opclass AS c1, pg_opclass AS c2
--dg WHERE c1.oid != c2.oid AND
--dg     c1.opcmethod = c2.opcmethod AND c1.opcintype = c2.opcintype AND
--dg     c1.opcdefault AND c2.opcdefault;
-- Ask access methods to validate opclasses
-- (this replaces a lot of SQL-level checks that used to be done in this file)
--dg-skip: relation "?" does not exist
--dg SELECT oid, opcname FROM pg_opclass WHERE NOT amvalidate(oid);
-- **************** pg_am ****************
-- Look for illegal values in pg_am fields
SELECT a1.oid, a1.amname
FROM pg_am AS a1
WHERE a1.amhandler = 0;
