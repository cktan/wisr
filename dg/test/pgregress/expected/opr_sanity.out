-- Check that all combine functions have signature
-- combine(transtype, transtype) returns transtype
--dg-differs: another error: relation "?" does not exist
--dg SELECT a.aggfnoid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggcombinefn = p.oid AND
--dg     (p.pronargs != 2 OR
