(0 rows)

-- For the same reason, we avoid creating built-in variadic aggregates, except
-- that variadic ordered-set aggregates are OK (since they have special syntax
-- that is not subject to the misplaced ORDER BY issue).
--dg-skip: relation "?" does not exist
--dg SELECT p.oid, proname
--dg FROM pg_proc AS p JOIN pg_aggregate AS a ON a.aggfnoid = p.oid
--dg WHERE prokind = 'a' AND provariadic != 0 AND a.aggkind = 'n';
-- **************** pg_opfamily ****************
