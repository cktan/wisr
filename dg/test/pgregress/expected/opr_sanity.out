--dg      OR (p.pronargs > 0 AND
--dg          NOT binary_coercible(p.proargtypes[0], ptr.proargtypes[1]))
--dg      OR (p.pronargs > 1 AND
--dg          NOT binary_coercible(p.proargtypes[1], ptr.proargtypes[2]))
--dg      OR (p.pronargs > 2 AND
--dg          NOT binary_coercible(p.proargtypes[2], ptr.proargtypes[3]))
--dg      OR (p.pronargs > 3 AND
--dg          NOT binary_coercible(p.proargtypes[3], ptr.proargtypes[4]))
--dg      -- we could carry the check further, but 4 args is enough for now
--dg      OR (p.pronargs > 4)
--dg     );
-- Cross-check finalfn (if present) against its entry in pg_proc.
--dg-differs: another error: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, p.proname, pfn.oid, pfn.proname
