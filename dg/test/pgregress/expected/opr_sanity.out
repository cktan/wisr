--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggfnoid = p.oid AND
--dg     (p.prokind != 'a' OR p.proretset OR p.pronargs < a.aggnumdirectargs);
-- Make sure there are no prokind = PROKIND_AGGREGATE pg_proc entries without matches.
--dg-skip: relation "?" does not exist
--dg SELECT oid, proname
--dg FROM pg_proc as p
--dg WHERE p.prokind = 'a' AND
--dg     NOT EXISTS (SELECT 1 FROM pg_aggregate a WHERE a.aggfnoid = p.oid);
-- If there is no finalfn then the output type must be the transtype.
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggfnoid = p.oid AND
--dg     a.aggfinalfn = 0 AND p.prorettype != a.aggtranstype;
-- Cross-check transfn against its entry in pg_proc.
--dg-differs: another error: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, p.proname, ptr.oid, ptr.proname
--dg FROM pg_aggregate AS a, pg_proc AS p, pg_proc AS ptr
--dg WHERE a.aggfnoid = p.oid AND
--dg     a.aggtransfn = ptr.oid AND
--dg     (ptr.proretset
--dg      OR NOT (ptr.pronargs =
--dg              CASE WHEN a.aggkind = 'n' THEN p.pronargs + 1
--dg              ELSE greatest(p.pronargs - a.aggnumdirectargs, 1) + 1 END)
--dg      OR NOT binary_coercible(ptr.prorettype, a.aggtranstype)
