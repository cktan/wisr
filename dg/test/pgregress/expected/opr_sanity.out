-- Check for index amhandler functions with the wrong signature
SELECT a1.oid, a1.amname, p1.oid, p1.proname
FROM pg_am AS a1, pg_proc AS p1
WHERE p1.oid = a1.amhandler AND a1.amtype = 'i' AND
    (p1.prorettype != 'index_am_handler'::regtype
     OR p1.proretset
     OR p1.pronargs != 1
     OR p1.proargtypes[0] != 'internal'::regtype);
 oid | amname | oid | proname 
-----+--------+-----+---------
(0 rows)

-- Check for table amhandler functions with the wrong signature
SELECT a1.oid, a1.amname, p1.oid, p1.proname
FROM pg_am AS a1, pg_proc AS p1
WHERE p1.oid = a1.amhandler AND a1.amtype = 't' AND
    (p1.prorettype != 'table_am_handler'::regtype
     OR p1.proretset
     OR p1.pronargs != 1
     OR p1.proargtypes[0] != 'internal'::regtype);
 oid | amname | oid | proname 
-----+--------+-----+---------
(0 rows)

-- **************** pg_amop ****************
-- Look for illegal values in pg_amop fields
--dg-skip: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopstrategy
--dg FROM pg_amop as a1
--dg WHERE a1.amopfamily = 0 OR a1.amoplefttype = 0 OR a1.amoprighttype = 0
--dg     OR a1.amopopr = 0 OR a1.amopmethod = 0 OR a1.amopstrategy < 1;
--dg-skip: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopstrategy
--dg FROM pg_amop as a1
--dg WHERE NOT ((a1.amoppurpose = 's' AND a1.amopsortfamily = 0) OR
--dg            (a1.amoppurpose = 'o' AND a1.amopsortfamily <> 0));
-- amopmethod must match owning opfamily's opfmethod
--dg-skip: relation "?" does not exist
--dg SELECT a1.oid, f1.oid
--dg FROM pg_amop AS a1, pg_opfamily AS f1
--dg WHERE a1.amopfamily = f1.oid AND a1.amopmethod != f1.opfmethod;
-- Make a list of all the distinct operator names being used in particular
-- strategy slots.  This is a bit hokey, since the list might need to change
-- in future releases, but it's an effective way of spotting mistakes such as
-- swapping two operators within a family.
--dg-skip: relation "?" does not exist
--dg SELECT DISTINCT amopmethod, amopstrategy, oprname
--dg FROM pg_amop a1 LEFT JOIN pg_operator o1 ON amopopr = o1.oid
--dg ORDER BY 1, 2, 3;
-- Check that all opclass search operators have selectivity estimators.
-- This is not absolutely required, but it seems a reasonable thing
-- to insist on for all standard datatypes.
--dg-skip: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopopr, o1.oid, o1.oprname
--dg FROM pg_amop AS a1, pg_operator AS o1
--dg WHERE a1.amopopr = o1.oid AND a1.amoppurpose = 's' AND
--dg     (o1.oprrest = 0 OR o1.oprjoin = 0);
-- Check that each opclass in an opfamily has associated operators, that is
-- ones whose oprleft matches opcintype (possibly by coercion).
--dg-differs: another error: relation "?" does not exist
--dg SELECT c1.opcname, c1.opcfamily
--dg FROM pg_opclass AS c1
--dg WHERE NOT EXISTS(SELECT 1 FROM pg_amop AS a1
--dg                  WHERE a1.amopfamily = c1.opcfamily
--dg                    AND binary_coercible(c1.opcintype, a1.amoplefttype));
-- Check that each operator listed in pg_amop has an associated opclass,
-- that is one whose opcintype matches oprleft (possibly by coercion).
-- Otherwise the operator is useless because it cannot be matched to an index.
-- (In principle it could be useful to list such operators in multiple-datatype
-- btree opfamilies, but in practice you'd expect there to be an opclass for
-- every datatype the family knows about.)
--dg-differs: another error: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopstrategy, a1.amopopr
--dg FROM pg_amop AS a1
--dg WHERE NOT EXISTS(SELECT 1 FROM pg_opclass AS c1
--dg                  WHERE c1.opcfamily = a1.amopfamily
--dg                    AND binary_coercible(c1.opcintype, a1.amoplefttype));
-- Operators that are primary members of opclasses must be immutable (else
-- it suggests that the index ordering isn't fixed).  Operators that are
-- cross-type members need only be stable, since they are just shorthands
-- for index probe queries.
--dg-skip: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopopr, o1.oprname, p1.prosrc
--dg FROM pg_amop AS a1, pg_operator AS o1, pg_proc AS p1
--dg WHERE a1.amopopr = o1.oid AND o1.oprcode = p1.oid AND
--dg     a1.amoplefttype = a1.amoprighttype AND
--dg     p1.provolatile != 'i';
--dg-skip: relation "?" does not exist
--dg SELECT a1.amopfamily, a1.amopopr, o1.oprname, p1.prosrc
--dg FROM pg_amop AS a1, pg_operator AS o1, pg_proc AS p1
--dg WHERE a1.amopopr = o1.oid AND o1.oprcode = p1.oid AND
--dg     a1.amoplefttype != a1.amoprighttype AND
--dg     p1.provolatile = 'v';
-- **************** pg_amproc ****************
-- Look for illegal values in pg_amproc fields
--dg-skip: relation "?" does not exist
--dg SELECT a1.amprocfamily, a1.amprocnum
--dg FROM pg_amproc as a1
--dg WHERE a1.amprocfamily = 0 OR a1.amproclefttype = 0 OR a1.amprocrighttype = 0
--dg     OR a1.amprocnum < 0 OR a1.amproc = 0;
-- Support routines that are primary members of opfamilies must be immutable
-- (else it suggests that the index ordering isn't fixed).  But cross-type
-- members need only be stable, since they are just shorthands
-- for index probe queries.
--dg-skip: relation "?" does not exist
--dg SELECT a1.amprocfamily, a1.amproc, p1.prosrc
--dg FROM pg_amproc AS a1, pg_proc AS p1
--dg WHERE a1.amproc = p1.oid AND
--dg     a1.amproclefttype = a1.amprocrighttype AND
--dg     p1.provolatile != 'i';
--dg-skip: relation "?" does not exist
--dg SELECT a1.amprocfamily, a1.amproc, p1.prosrc
--dg FROM pg_amproc AS a1, pg_proc AS p1
--dg WHERE a1.amproc = p1.oid AND
--dg     a1.amproclefttype != a1.amprocrighttype AND
--dg     p1.provolatile = 'v';
-- Almost all of the core distribution's Btree opclasses can use one of the
-- two generic "equalimage" functions as their support function 4.  Look for
-- opclasses that don't allow deduplication unconditionally here.
--
-- Newly added Btree opclasses don't have to support deduplication.  It will
-- usually be trivial to add support, though.  Note that the expected output
-- of this part of the test will need to be updated when a new opclass cannot
-- support deduplication (by using btequalimage).
--dg-skip: relation "?" does not exist
--dg SELECT amp.amproc::regproc AS proc, opf.opfname AS opfamily_name,
--dg        opc.opcname AS opclass_name, opc.opcintype::regtype AS opcintype
--dg FROM pg_am AS am
--dg JOIN pg_opclass AS opc ON opc.opcmethod = am.oid
--dg JOIN pg_opfamily AS opf ON opc.opcfamily = opf.oid
--dg LEFT JOIN pg_amproc AS amp ON amp.amprocfamily = opf.oid AND
--dg     amp.amproclefttype = opc.opcintype AND amp.amprocnum = 4
--dg WHERE am.amname = 'btree' AND
--dg     amp.amproc IS DISTINCT FROM 'btequalimage'::regproc
--dg ORDER BY 1, 2, 3;
-- **************** pg_index ****************
-- Look for illegal values in pg_index fields.
SELECT indexrelid, indrelid
FROM pg_index
WHERE indexrelid = 0 OR indrelid = 0 OR
      indnatts <= 0 OR indnatts > 32;
 indexrelid | indrelid 
------------+----------
(0 rows)

-- oidvector and int2vector fields should be of length indnatts.
SELECT indexrelid, indrelid
FROM pg_index
WHERE array_lower(indkey, 1) != 0 OR array_upper(indkey, 1) != indnatts-1 OR
    array_lower(indclass, 1) != 0 OR array_upper(indclass, 1) != indnatts-1 OR
    array_lower(indcollation, 1) != 0 OR array_upper(indcollation, 1) != indnatts-1 OR
    array_lower(indoption, 1) != 0 OR array_upper(indoption, 1) != indnatts-1;
 indexrelid | indrelid 
------------+----------
(0 rows)

-- Check that opclasses and collations match the underlying columns.
-- (As written, this test ignores expression indexes.)
--dg-differs: another error: relation "?" does not exist
--dg SELECT indexrelid::regclass, indrelid::regclass, attname, atttypid::regtype, opcname
--dg FROM (SELECT indexrelid, indrelid, unnest(indkey) as ikey,
--dg              unnest(indclass) as iclass, unnest(indcollation) as icoll
--dg       FROM pg_index) ss,
--dg       pg_attribute a,
--dg       pg_opclass opc
--dg WHERE a.attrelid = indrelid AND a.attnum = ikey AND opc.oid = iclass AND
--dg       (NOT binary_coercible(atttypid, opcintype) OR icoll != attcollation);
-- For system catalogs, be even tighter: nearly all indexes should be
-- exact type matches not binary-coercible matches.  At this writing
-- the only exception is an OID index on a regproc column.
--dg-skip: relation "?" does not exist
--dg SELECT indexrelid::regclass, indrelid::regclass, attname, atttypid::regtype, opcname
--dg FROM (SELECT indexrelid, indrelid, unnest(indkey) as ikey,
--dg              unnest(indclass) as iclass, unnest(indcollation) as icoll
--dg       FROM pg_index
--dg       WHERE indrelid < 16384) ss,
--dg       pg_attribute a,
--dg       pg_opclass opc
--dg WHERE a.attrelid = indrelid AND a.attnum = ikey AND opc.oid = iclass AND
--dg       (opcintype != atttypid OR icoll != attcollation)
--dg ORDER BY 1;
-- Check for system catalogs with collation-sensitive ordering.  This is not
-- a representational error in pg_index, but simply wrong catalog design.
-- It's bad because we expect to be able to clone template0 and assign the
-- copy a different database collation.  It would especially not work for
-- shared catalogs.
--dg-differs: the result
--dg SELECT relname, attname, attcollation
--dg FROM pg_class c, pg_attribute a
--dg WHERE c.oid = attrelid AND c.oid < 16384 AND
--dg     c.relkind != 'v' AND  -- we don't care about columns in views
--dg     attcollation != 0 AND
--dg     attcollation != (SELECT oid FROM pg_collation WHERE collname = 'C');
-- Double-check that collation-sensitive indexes have "C" collation, too.
SELECT indexrelid::regclass, indrelid::regclass, iclass, icoll
FROM (SELECT indexrelid, indrelid,
             unnest(indclass) as iclass, unnest(indcollation) as icoll
      FROM pg_index
      WHERE indrelid < 16384) ss
WHERE icoll != 0 AND
    icoll != (SELECT oid FROM pg_collation WHERE collname = 'C');
 indexrelid | indrelid | iclass | icoll 
------------+----------+--------+-------
(0 rows)

