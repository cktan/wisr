--dg     (aggkind = 'n' AND aggnumdirectargs > 0) OR
--dg     aggfinalmodify NOT IN ('r', 's', 'w') OR
--dg     aggmfinalmodify NOT IN ('r', 's', 'w') OR
--dg     aggtranstype = 0 OR aggtransspace < 0 OR aggmtransspace < 0;
