--dg      p.prorettype != p.proargtypes[1] OR
--dg      NOT binary_coercible(a.aggtranstype, p.proargtypes[0]));
-- Check that no combine function for an INTERNAL transtype is strict.
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggcombinefn = p.oid AND
--dg     a.aggtranstype = 'internal'::regtype AND p.proisstrict;
-- serialize/deserialize functions should be specified only for aggregates
-- with transtype internal and a combine function, and we should have both
-- or neither of them.
--dg-skip: relation "?" does not exist
--dg SELECT aggfnoid, aggtranstype, aggserialfn, aggdeserialfn
--dg FROM pg_aggregate
--dg WHERE (aggserialfn != 0 OR aggdeserialfn != 0)
--dg   AND (aggtranstype != 'internal'::regtype OR aggcombinefn = 0 OR
--dg        aggserialfn = 0 OR aggdeserialfn = 0);
-- Check that all serialization functions have signature
-- serialize(internal) returns bytea
-- Also insist that they be strict; it's wasteful to run them on NULLs.
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggserialfn = p.oid AND
--dg     (p.prorettype != 'bytea'::regtype OR p.pronargs != 1 OR
--dg      p.proargtypes[0] != 'internal'::regtype OR
--dg      NOT p.proisstrict);
-- Check that all deserialization functions have signature
-- deserialize(bytea, internal) returns internal
-- Also insist that they be strict; it's wasteful to run them on NULLs.
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid, p.proname
--dg FROM pg_aggregate as a, pg_proc as p
--dg WHERE a.aggdeserialfn = p.oid AND
--dg     (p.prorettype != 'internal'::regtype OR p.pronargs != 2 OR
--dg      p.proargtypes[0] != 'bytea'::regtype OR
--dg      p.proargtypes[1] != 'internal'::regtype OR
--dg      NOT p.proisstrict);
-- Check that aggregates which have the same transition function also have
-- the same combine, serialization, and deserialization functions.
-- While that isn't strictly necessary, it's fishy if they don't.
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid, a.aggcombinefn, a.aggserialfn, a.aggdeserialfn,
--dg        b.aggfnoid, b.aggcombinefn, b.aggserialfn, b.aggdeserialfn
--dg FROM
--dg     pg_aggregate a, pg_aggregate b
--dg WHERE
--dg     a.aggfnoid < b.aggfnoid AND a.aggtransfn = b.aggtransfn AND
--dg     (a.aggcombinefn != b.aggcombinefn OR a.aggserialfn != b.aggserialfn
--dg      OR a.aggdeserialfn != b.aggdeserialfn);
-- Cross-check aggsortop (if present) against pg_operator.
-- We expect to find entries for bool_and, bool_or, every, max, and min.
--dg-skip: relation "?" does not exist
--dg SELECT DISTINCT proname, oprname
--dg FROM pg_operator AS o, pg_aggregate AS a, pg_proc AS p
--dg WHERE a.aggfnoid = p.oid AND a.aggsortop = o.oid
--dg ORDER BY 1, 2;
-- Check datatypes match
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, o.oid
--dg FROM pg_operator AS o, pg_aggregate AS a, pg_proc AS p
--dg WHERE a.aggfnoid = p.oid AND a.aggsortop = o.oid AND
--dg     (oprkind != 'b' OR oprresult != 'boolean'::regtype
--dg      OR oprleft != p.proargtypes[0] OR oprright != p.proargtypes[0]);
-- Check operator is a suitable btree opfamily member
--dg-skip: relation "?" does not exist
--dg SELECT a.aggfnoid::oid, o.oid
--dg FROM pg_operator AS o, pg_aggregate AS a, pg_proc AS p
--dg WHERE a.aggfnoid = p.oid AND a.aggsortop = o.oid AND
--dg     NOT EXISTS(SELECT 1 FROM pg_amop
--dg                WHERE amopmethod = (SELECT oid FROM pg_am WHERE amname = 'btree')
--dg                      AND amopopr = o.oid
--dg                      AND amoplefttype = o.oprleft
--dg                      AND amoprighttype = o.oprright);
-- Check correspondence of btree strategies and names
--dg-skip: relation "?" does not exist
--dg SELECT DISTINCT proname, oprname, amopstrategy
--dg FROM pg_operator AS o, pg_aggregate AS a, pg_proc AS p,
--dg      pg_amop as ao
--dg WHERE a.aggfnoid = p.oid AND a.aggsortop = o.oid AND
--dg     amopopr = o.oid AND
--dg     amopmethod = (SELECT oid FROM pg_am WHERE amname = 'btree')
--dg ORDER BY 1, 2;
-- Check that there are not aggregates with the same name and different
-- numbers of arguments.  While not technically wrong, we have a project policy
-- to avoid this because it opens the door for confusion in connection with
-- ORDER BY: novices frequently put the ORDER BY in the wrong place.
-- See the fate of the single-argument form of string_agg() for history.
-- (Note: we don't forbid users from creating such aggregates; the policy is
-- just to think twice before creating built-in aggregates like this.)
-- The only aggregates that should show up here are count(x) and count(*).
SELECT p1.oid::regprocedure, p2.oid::regprocedure
FROM pg_proc AS p1, pg_proc AS p2
WHERE p1.oid < p2.oid AND p1.proname = p2.proname AND
    p1.prokind = 'a' AND p2.prokind = 'a' AND
    array_dims(p1.proargtypes) != array_dims(p2.proargtypes)
ORDER BY 1;
     oid      |   oid   
--------------+---------
 count("any") | count()
(1 row)

-- For the same reason, built-in aggregates with default arguments are no good.
SELECT oid, proname
FROM pg_proc AS p
WHERE prokind = 'a' AND proargdefaults IS NOT NULL;
 oid | proname 
