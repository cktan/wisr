--
-- ROWTYPES
--
-- Make both a standalone composite type and a table rowtype
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type complex as (r float8, i float8);
create temp table fullname (first text, last text);
-- Nested composite
--dg-cascade
--dg create type quad as (c1 complex, c2 complex);
-- Some simple tests of I/O conversions and row construction
--dg-cascade
--dg select (1.1,2.2)::complex, row((3.3,4.4),(5.5,null))::quad;
--dg-skip: type "?" does not exist
--dg select row('Joe', 'Blow')::fullname, '(Joe,Blow)'::fullname;
--dg-skip: type "?" does not exist
--dg select '(Joe,von Blow)'::fullname, '(Joe,d''Blow)'::fullname;
--dg-skip: type "?" does not exist
--dg select '(Joe,"von""Blow")'::fullname, E'(Joe,d\\\\Blow)'::fullname;
--dg-skip: type "?" does not exist
--dg select '(Joe,"Blow,Jr")'::fullname;
--dg-skip: type "?" does not exist
--dg select '(Joe,)'::fullname;	-- ok, null 2nd column
--dg-differs: another error: type "?" does not exist
--dg select '(Joe)'::fullname;	-- bad
--dg-differs: another error: type "?" does not exist
--dg select '(Joe,,)'::fullname;	-- bad
--dg-differs: another error: type "?" does not exist
--dg select '[]'::fullname;          -- bad
--dg-skip: type "?" does not exist
--dg select ' (Joe,Blow)  '::fullname;  -- ok, extra whitespace
--dg-differs: another error: type "?" does not exist
--dg select '(Joe,Blow) /'::fullname;  -- bad
-- test non-error-throwing API
--dg-cascade
--dg SELECT pg_input_is_valid('(1,2)', 'complex');
--dg-cascade
--dg SELECT pg_input_is_valid('(1,2', 'complex');
--dg-cascade
--dg SELECT pg_input_is_valid('(1,zed)', 'complex');
--dg-cascade
--dg SELECT * FROM pg_input_error_info('(1,zed)', 'complex');
--dg-cascade
--dg SELECT * FROM pg_input_error_info('(1,1e400)', 'complex');
--dg-cascade
--dg create temp table quadtable(f1 int, q quad);
--dg-cascade
--dg insert into quadtable values (1, ((3.3,4.4),(5.5,6.6)));
--dg-cascade
--dg insert into quadtable values (2, ((null,4.4),(5.5,6.6)));
--dg-cascade
--dg select * from quadtable;
--dg-cascade
--dg select f1, q.c1 from quadtable;		-- fails, q is a table reference
--dg-cascade
--dg select f1, (q).c1, (qq.q).c1.i from quadtable qq;
--dg-skip: type "?" does not exist
--dg create temp table people (fn fullname, bd date);
--dg-cascade
--dg insert into people values ('(Joe,Blow)', '1984-01-10');
--dg-cascade
--dg select * from people;
-- at the moment this will not work due to ALTER TABLE inadequacy:
--dg-cascade
--dg alter table fullname add column suffix text default '';
-- but this should work:
--dg-cascade
--dg alter table fullname add column suffix text default null;
--dg-cascade
--dg select * from people;
-- test insertion/updating of subfields
--dg-cascade
--dg update people set fn.suffix = 'Jr';
--dg-cascade
--dg select * from people;
--dg-cascade
--dg insert into quadtable (f1, q.c1.r, q.c2.i) values(44,55,66);
--dg-cascade
--dg update quadtable set q.c1.r = 12 where f1 = 2;
--dg-cascade
--dg update quadtable set q.c1 = 12;  -- error, type mismatch
--dg-cascade
--dg select * from quadtable;
-- The object here is to ensure that toasted references inside
-- composite values don't cause problems.  The large f1 value will
-- be toasted inside pp, it must still work after being copied to people.
create temp table pp (f1 text);
insert into pp values (repeat('abcdefghijkl', 100000));
--dg-cascade
--dg insert into people select ('Jim', f1, null)::fullname, current_date from pp;
--dg-cascade
--dg select (fn).first, substr((fn).last, 1, 20), length((fn).last) from people;
-- try an update on a toasted composite value, too
--dg-cascade
--dg update people set fn.first = 'Jack';
--dg-cascade
--dg select (fn).first, substr((fn).last, 1, 20), length((fn).last) from people;
-- Test row comparison semantics.  Prior to PG 8.2 we did this in a totally
-- non-spec-compliant way.
select ROW(1,2) < ROW(1,3) as true;
 true 
------
 t
(1 row)

select ROW(1,2) < ROW(1,1) as false;
 false 
-------
 f
(1 row)

select ROW(1,2) < ROW(1,NULL) as null;
 null 
------
 
(1 row)

select ROW(1,2,3) < ROW(1,3,NULL) as true; -- the NULL is not examined
 true 
------
 t
(1 row)

select ROW(11,'ABC') < ROW(11,'DEF') as true;
 true 
------
 t
(1 row)

select ROW(11,'ABC') > ROW(11,'DEF') as false;
 false 
-------
 f
(1 row)

select ROW(12,'ABC') > ROW(11,'DEF') as true;
 true 
------
 t
(1 row)

-- = and <> have different NULL-behavior than < etc
select ROW(1,2,3) < ROW(1,NULL,4) as null;
 null 
------
 
(1 row)

select ROW(1,2,3) = ROW(1,NULL,4) as false;
 false 
-------
 f
(1 row)

select ROW(1,2,3) <> ROW(1,NULL,4) as true;
 true 
------
 t
(1 row)

-- We allow operators beyond the six standard ones, if they have btree
-- operator classes.
select ROW('ABC','DEF') ~<=~ ROW('DEF','ABC') as true;
 true 
------
 t
(1 row)

select ROW('ABC','DEF') ~>=~ ROW('DEF','ABC') as false;
 false 
-------
 f
(1 row)

select ROW('ABC','DEF') ~~ ROW('DEF','ABC') as fail;
ERROR:  could not determine interpretation of row comparison operator ~~
LINE 1: select ROW('ABC','DEF') ~~ ROW('DEF','ABC') as fail;
                                ^
HINT:  Row comparison operators must be associated with btree operator families.
-- Comparisons of ROW() expressions can cope with some type mismatches
select ROW(1,2) = ROW(1,2::int8);
 ?column? 
----------
 t
(1 row)

select ROW(1,2) in (ROW(3,4), ROW(1,2));
 ?column? 
----------
 t
(1 row)

select ROW(1,2) in (ROW(3,4), ROW(1,2::int8));
 ?column? 
----------
 t
(1 row)

-- Check row comparison with a subselect
select unique1, unique2 from tenk1
where (unique1, unique2) < any (select ten, ten from tenk1 where hundred < 3)
      and unique1 <= 20
order by 1;
 unique1 | unique2 
---------+---------
       0 |    9998
       1 |    2838
(2 rows)

