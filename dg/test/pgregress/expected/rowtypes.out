--
-- Tests for record_{eq,cmp}
--
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype1 as (a int, b int);
-- all true
--dg-cascade
--dg select row(1, 2)::testtype1 < row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 <= row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 = row(1, 2)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 <> row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 3)::testtype1 >= row(1, 2)::testtype1;
--dg-cascade
--dg select row(1, 3)::testtype1 > row(1, 2)::testtype1;
-- all false
--dg-cascade
--dg select row(1, -2)::testtype1 < row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 <= row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 = row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 <> row(1, -2)::testtype1;
--dg-cascade
--dg select row(1, -3)::testtype1 >= row(1, -2)::testtype1;
--dg-cascade
--dg select row(1, -3)::testtype1 > row(1, -2)::testtype1;
-- true, but see *< below
--dg-cascade
--dg select row(1, -2)::testtype1 < row(1, 3)::testtype1;
-- mismatches
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype3 as (a int, b text);
--dg-cascade
--dg select row(1, 2)::testtype1 < row(1, 'abc')::testtype3;
--dg-cascade
--dg select row(1, 2)::testtype1 <> row(1, 'abc')::testtype3;
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype5 as (a int);
--dg-cascade
--dg select row(1, 2)::testtype1 < row(1)::testtype5;
--dg-cascade
--dg select row(1, 2)::testtype1 <> row(1)::testtype5;
-- non-comparable types
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype6 as (a int, b point);
--dg-cascade
--dg select row(1, '(1,2)')::testtype6 < row(1, '(1,3)')::testtype6;
--dg-cascade
--dg select row(1, '(1,2)')::testtype6 <> row(1, '(1,3)')::testtype6;
--dg-cascade
--dg drop type testtype1, testtype3, testtype5, testtype6;
--
-- Tests for record_image_{eq,cmp}
--
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype1 as (a int, b int);
-- all true
--dg-cascade
--dg select row(1, 2)::testtype1 *< row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 *<= row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 *= row(1, 2)::testtype1;
--dg-cascade
--dg select row(1, 2)::testtype1 *<> row(1, 3)::testtype1;
--dg-cascade
--dg select row(1, 3)::testtype1 *>= row(1, 2)::testtype1;
--dg-cascade
--dg select row(1, 3)::testtype1 *> row(1, 2)::testtype1;
-- all false
--dg-cascade
--dg select row(1, -2)::testtype1 *< row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 *<= row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 *= row(1, -3)::testtype1;
--dg-cascade
--dg select row(1, -2)::testtype1 *<> row(1, -2)::testtype1;
--dg-cascade
--dg select row(1, -3)::testtype1 *>= row(1, -2)::testtype1;
--dg-cascade
--dg select row(1, -3)::testtype1 *> row(1, -2)::testtype1;
-- This returns the "wrong" order because record_image_cmp works on
-- unsigned datums without knowing about the actual data type.
--dg-cascade
--dg select row(1, -2)::testtype1 *< row(1, 3)::testtype1;
-- other types
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype2 as (a smallint, b bool);  -- byval different sizes
--dg-cascade
--dg select row(1, true)::testtype2 *< row(2, true)::testtype2;
--dg-cascade
--dg select row(-2, true)::testtype2 *< row(-1, true)::testtype2;
--dg-cascade
--dg select row(0, false)::testtype2 *< row(0, true)::testtype2;
--dg-cascade
--dg select row(0, false)::testtype2 *<> row(0, true)::testtype2;
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype3 as (a int, b text);  -- variable length
--dg-cascade
--dg select row(1, 'abc')::testtype3 *< row(1, 'abd')::testtype3;
--dg-cascade
--dg select row(1, 'abc')::testtype3 *< row(1, 'abcd')::testtype3;
--dg-cascade
--dg select row(1, 'abc')::testtype3 *> row(1, 'abd')::testtype3;
--dg-cascade
--dg select row(1, 'abc')::testtype3 *<> row(1, 'abd')::testtype3;
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype4 as (a int, b point);  -- by ref, fixed length
--dg-cascade
--dg select row(1, '(1,2)')::testtype4 *< row(1, '(1,3)')::testtype4;
--dg-cascade
--dg select row(1, '(1,2)')::testtype4 *<> row(1, '(1,3)')::testtype4;
-- mismatches
--dg-cascade
--dg select row(1, 2)::testtype1 *< row(1, 'abc')::testtype3;
--dg-cascade
--dg select row(1, 2)::testtype1 *<> row(1, 'abc')::testtype3;
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype5 as (a int);
--dg-cascade
--dg select row(1, 2)::testtype1 *< row(1)::testtype5;
--dg-cascade
--dg select row(1, 2)::testtype1 *<> row(1)::testtype5;
-- non-comparable types
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type testtype6 as (a int, b point);
--dg-cascade
--dg select row(1, '(1,2)')::testtype6 *< row(1, '(1,3)')::testtype6;
--dg-cascade
--dg select row(1, '(1,2)')::testtype6 *>= row(1, '(1,3)')::testtype6;
--dg-cascade
--dg select row(1, '(1,2)')::testtype6 *<> row(1, '(1,3)')::testtype6;
-- anonymous rowtypes in coldeflists
select q.a, q.b = row(2), q.c = array[row(3)], q.d = row(row(4)) from
    unnest(array[row(1, row(2), array[row(3)], row(row(4))),
                 row(2, row(3), array[row(4)], row(row(5)))])
      as q(a int, b record, c record[], d record);
 a | ?column? | ?column? | ?column? 
---+----------+----------+----------
 1 | t        | t        | t
 2 | f        | f        | f
(2 rows)

--dg-cascade
--dg drop type testtype1, testtype2, testtype3, testtype4, testtype5, testtype6;
--
-- Test case derived from bug #5716: check multiple uses of a rowtype result
--
BEGIN;
CREATE TABLE price (
    id SERIAL PRIMARY KEY,
    active BOOLEAN NOT NULL,
    price NUMERIC
);
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg CREATE TYPE price_input AS (
--dg     id INTEGER,
--dg     price NUMERIC
--dg );
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg CREATE TYPE price_key AS (
--dg     id INTEGER
--dg );
--dg-cascade
--dg CREATE FUNCTION price_key_from_table(price) RETURNS price_key AS $$
--dg     SELECT $1.id
--dg $$ LANGUAGE SQL;
--dg-cascade
--dg CREATE FUNCTION price_key_from_input(price_input) RETURNS price_key AS $$
--dg     SELECT $1.id
--dg $$ LANGUAGE SQL;
--dg-cascade
--dg insert into price values (1,false,42), (10,false,100), (11,true,17.99);
--dg-cascade
--dg UPDATE price
--dg     SET active = true, price = input_prices.price
--dg     FROM unnest(ARRAY[(10, 123.00), (11, 99.99)]::price_input[]) input_prices
--dg     WHERE price_key_from_table(price.*) = price_key_from_input(input_prices.*);
--dg-cascade
--dg select * from price;
rollback;
--
-- Test case derived from bug #9085: check * qualification of composite
-- parameters for SQL functions
--
create temp table compos (f1 int, f2 text);
--dg-differs: another error: language "?" does not exist
--dg create function fcompos1(v compos) returns void as $$
--dg insert into compos values (v);  -- fail
--dg $$ language sql;
--dg-skip: language "?" does not exist
--dg create function fcompos1(v compos) returns void as $$
--dg insert into compos values (v.*);
--dg $$ language sql;
--dg-skip: language "?" does not exist
--dg create function fcompos2(v compos) returns void as $$
--dg select fcompos1(v);
--dg $$ language sql;
--dg-skip: language "?" does not exist
--dg create function fcompos3(v compos) returns void as $$
--dg select fcompos1(fcompos3.v.*);
--dg $$ language sql;
--dg-cascade
--dg select fcompos1(row(1,'one'));
--dg-cascade
--dg select fcompos2(row(2,'two'));
--dg-cascade
--dg select fcompos3(row(3,'three'));
--dg-cascade
--dg select * from compos;
--
-- We allow I/O conversion casts from composite types to strings to be
-- invoked via cast syntax, but not functional syntax.  This is because
-- the latter is too prone to be invoked unintentionally.
--
--dg-skip: relation "?" does not have a composite type
--dg select cast (fullname as text) from fullname;
--dg-skip: relation "?" does not have a composite type
--dg select fullname::text from fullname;
--dg-differs: another error: relation "?" does not have a composite type
