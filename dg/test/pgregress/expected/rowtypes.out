-- Check behavior with a non-comparable rowtype
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type cantcompare as (p point, r float8);
--dg-cascade
--dg create temp table cc (f1 cantcompare);
--dg-cascade
--dg insert into cc values('("(1,2)",3)');
--dg-cascade
