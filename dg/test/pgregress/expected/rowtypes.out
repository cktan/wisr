--
-- Tests for component access / FieldSelect
--
CREATE TABLE compositetable(a text, b text);
INSERT INTO compositetable(a, b) VALUES('fa', 'fb');
-- composite type columns can't directly be accessed (error)
--dg-differs: another error: relation "?" does not have a composite type
--dg SELECT d.a FROM (SELECT compositetable AS d FROM compositetable) s;
-- but can be accessed with proper parens
--dg-skip: relation "?" does not have a composite type
--dg SELECT (d).a, (d).b FROM (SELECT compositetable AS d FROM compositetable) s;
-- system columns can't be accessed in composite types (error)
--dg-differs: another error: relation "?" does not have a composite type
--dg SELECT (d).ctid FROM (SELECT compositetable AS d FROM compositetable) s;
-- accessing non-existing column in NULL datum errors out
--dg-differs: another error: type "?" does not exist
--dg SELECT (NULL::compositetable).nonexistent;
-- existing column in a NULL composite yield NULL
--dg-skip: type "?" does not exist
--dg SELECT (NULL::compositetable).a;
-- oids can't be accessed in composite types (error)
--dg-differs: another error: type "?" does not exist
--dg SELECT (NULL::compositetable).oid;
DROP TABLE compositetable;
