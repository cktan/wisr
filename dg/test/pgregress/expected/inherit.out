--
-- Test inheritance features
--
CREATE TABLE a (aa TEXT);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE b (bb TEXT) INHERITS (a);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE c (cc TEXT) INHERITS (a);
--dg-cascade
--dg CREATE TABLE d (dd TEXT) INHERITS (b,c,a);
INSERT INTO a(aa) VALUES('aaa');
INSERT INTO a(aa) VALUES('aaaa');
INSERT INTO a(aa) VALUES('aaaaa');
INSERT INTO a(aa) VALUES('aaaaaa');
INSERT INTO a(aa) VALUES('aaaaaaa');
INSERT INTO a(aa) VALUES('aaaaaaaa');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbb');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbbb');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbbbb');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbbbbb');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbbbbbb');
--dg-cascade
--dg INSERT INTO b(aa) VALUES('bbbbbbbb');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('ccc');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('cccc');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('ccccc');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('cccccc');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('ccccccc');
--dg-cascade
--dg INSERT INTO c(aa) VALUES('cccccccc');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('ddd');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('dddd');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('ddddd');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('dddddd');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('ddddddd');
--dg-cascade
--dg INSERT INTO d(aa) VALUES('dddddddd');
--dg-cascade
--dg SELECT relname, a.* FROM a, pg_class where a.tableoid = pg_class.oid;
--dg-cascade
--dg SELECT relname, b.* FROM b, pg_class where b.tableoid = pg_class.oid;
--dg-cascade
--dg SELECT relname, c.* FROM c, pg_class where c.tableoid = pg_class.oid;
--dg-cascade
--dg SELECT relname, d.* FROM d, pg_class where d.tableoid = pg_class.oid;
SELECT relname, a.* FROM ONLY a, pg_class where a.tableoid = pg_class.oid;
 relname |    aa    
---------+----------
 a       | aaa
 a       | aaaa
 a       | aaaaa
 a       | aaaaaa
 a       | aaaaaaa
 a       | aaaaaaaa
(6 rows)

