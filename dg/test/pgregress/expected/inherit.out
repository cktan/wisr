-- without stats access, these queries would produce hash join plans:
--dg-cascade
--dg explain (costs off)
--dg   select * from permtest_parent p1 inner join permtest_parent p2
--dg   on p1.a = p2.a and p1.c ~ 'a1$';
--dg-cascade
--dg explain (costs off)
--dg   select * from permtest_parent p1 inner join permtest_parent p2
--dg   on p1.a = p2.a and left(p1.c, 3) ~ 'a1$';
reset session authorization;
--dg-cascade
--dg revoke all on permtest_parent from regress_no_child_access;
--dg-cascade
--dg grant select(a,c) on permtest_parent to regress_no_child_access;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_no_child_access;
--dg-cascade
--dg explain (costs off)
--dg   select p2.a, p1.c from permtest_parent p1 inner join permtest_parent p2
--dg   on p1.a = p2.a and p1.c ~ 'a1$';
-- we will not have access to the expression index's stats here:
--dg-cascade
--dg explain (costs off)
