-- Test that parent and child CHECK constraints can be created in either order
--dg-cascade
--dg create table p1(f1 int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table p1_c1() inherits(p1);
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint inh_check_constraint1 check (f1 > 0);
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint1 check (f1 > 0);
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint2 check (f1 < 10);
--dg-cascade
--dg alter table p1 add constraint inh_check_constraint2 check (f1 < 10);
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint inh_check_constraint3 check (f1 > 0) not enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint3 check (f1 > 0) not enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint4 check (f1 < 10) not enforced;
--dg-cascade
--dg alter table p1 add constraint inh_check_constraint4 check (f1 < 10) not enforced;
-- allowed to merge enforced constraint with parent's not enforced constraint
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint5 check (f1 < 10) enforced;
--dg-cascade
--dg alter table p1 add constraint inh_check_constraint5 check (f1 < 10) not enforced;
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint inh_check_constraint6 check (f1 < 10) not enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint6 check (f1 < 10) enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint9 check (f1 < 10) not valid enforced;
--dg-cascade
--dg alter table p1 add constraint inh_check_constraint9 check (f1 < 10) not enforced;
-- the not-valid state of the child constraint will be ignored here.
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint inh_check_constraint10 check (f1 < 10) not enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint10 check (f1 < 10) not valid enforced;
--dg-cascade
--dg create table p1_c2(f1 int constraint inh_check_constraint4 check (f1 < 10)) inherits(p1);
-- but reverse is not allowed
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint7 check (f1 < 10) not enforced;
--dg-cascade
--dg alter table p1 add constraint inh_check_constraint7 check (f1 < 10) enforced;
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint inh_check_constraint8 check (f1 < 10) enforced;
--dg-cascade
--dg alter table p1_c1 add constraint inh_check_constraint8 check (f1 < 10) not enforced;
--dg-cascade
--dg create table p1_fail(f1 int constraint inh_check_constraint2 check (f1 < 10) not enforced) inherits(p1);
-- constraints with different enforceability can be merged by marking them as ENFORCED
--dg-cascade
--dg create table p1_c3() inherits(p1, p1_c1);
-- but not allowed if the child constraint is explicitly asked to be NOT ENFORCED
--dg-cascade
--dg create table p1_fail(f1 int constraint inh_check_constraint6 check (f1 < 10) not enforced) inherits(p1, p1_c1);
--dg-cascade
--dg select conrelid::regclass::text as relname, conname, conislocal, coninhcount, conenforced, convalidated
--dg from pg_constraint where conname like 'inh\_check\_constraint%'
--dg order by 1, 2;
--dg-cascade
--dg drop table p1 cascade;
