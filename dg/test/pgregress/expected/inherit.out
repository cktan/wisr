--dg   on p1.a = p2.a and left(p1.c, 3) ~ 'a1$';
reset session authorization;
--dg-cascade
--dg revoke all on permtest_parent from regress_no_child_access;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg drop role regress_no_child_access;
