--dg-cascade
--dg create table tuplesest_parted2 partition of tuplesest_parted for values from (100) to (200);
create table tuplesest_tab (a int, b int);
--dg-cascade
--dg insert into tuplesest_parted select i%200, i%300, i%400 from generate_series(1, 1000)i;
insert into tuplesest_tab select i, i from generate_series(1, 100)i;
--dg-cascade
--dg analyze tuplesest_parted;
analyze tuplesest_tab;
--dg-cascade
--dg explain (costs off)
