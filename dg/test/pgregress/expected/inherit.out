-- Confirm PRIMARY KEY adds NOT NULL constraint to child table
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TEMP TABLE z (b TEXT, PRIMARY KEY(aa, b)) inherits (a);
--dg-cascade
--dg INSERT INTO z VALUES (NULL, 'text'); -- should fail
-- ... but not UNIQUE.
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TEMP TABLE z2 (b TEXT, UNIQUE(aa, b)) inherits (a);
--dg-cascade
--dg INSERT INTO z2 VALUES (NULL, 'text'); -- should work
-- Check inherited UPDATE with first child excluded
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table some_tab (f1 int, f2 int, f3 int, check (f1 < 10) no inherit);
--dg-cascade
--dg create table some_tab_child () inherits(some_tab);
--dg-cascade
--dg insert into some_tab_child select i, i+1, 0 from generate_series(1,1000) i;
--dg-cascade
--dg create index on some_tab_child(f1, f2);
-- while at it, also check that statement-level triggers fire
--dg-skip: language "?" does not exist
--dg create function some_tab_stmt_trig_func() returns trigger as
--dg $$begin raise notice 'updating some_tab'; return NULL; end;$$
--dg language plpgsql;
--dg-cascade
--dg create trigger some_tab_stmt_trig
--dg   before update on some_tab execute function some_tab_stmt_trig_func();
--dg-cascade
--dg explain (costs off)
--dg update some_tab set f3 = 11 where f1 = 12 and f2 = 13;
--dg-cascade
--dg update some_tab set f3 = 11 where f1 = 12 and f2 = 13;
--dg-cascade
--dg drop table some_tab cascade;
--dg-cascade
--dg drop function some_tab_stmt_trig_func();
-- Check inherited UPDATE with all children excluded
create table some_tab (a int, b int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table some_tab_child () inherits (some_tab);
--dg-cascade
--dg insert into some_tab_child values(1,2);
--dg-cascade
--dg explain (verbose, costs off)
--dg update some_tab set a = a + 1 where false;
update some_tab set a = a + 1 where false;
--dg-cascade
--dg explain (verbose, costs off)
--dg update some_tab set a = a + 1 where false returning b, a;
update some_tab set a = a + 1 where false returning b, a;
 b | a 
---+---
(0 rows)

--dg-cascade
--dg table some_tab;
--dg-cascade
--dg drop table some_tab cascade;
-- Check UPDATE with inherited target and an inherited source table
create temp table foo(f1 int, f2 int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table foo2(f3 int) inherits (foo);
create temp table bar(f1 int, f2 int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table bar2(f3 int) inherits (bar);
insert into foo values(1,1);
insert into foo values(3,3);
--dg-cascade
--dg insert into foo2 values(2,2,2);
--dg-cascade
--dg insert into foo2 values(3,3,3);
insert into bar values(1,1);
insert into bar values(2,2);
insert into bar values(3,3);
insert into bar values(4,4);
--dg-cascade
--dg insert into bar2 values(1,1,1);
--dg-cascade
--dg insert into bar2 values(2,2,2);
--dg-cascade
--dg insert into bar2 values(3,3,3);
--dg-cascade
--dg insert into bar2 values(4,4,4);
update bar set f2 = f2 + 100 where f1 in (select f1 from foo);
--dg-cascade
--dg select tableoid::regclass::text as relname, bar.* from bar order by 1,2;
-- Check UPDATE with inherited target and an appendrel subquery
update bar set f2 = f2 + 100
from
  ( select f1 from foo union all select f1+3 from foo ) ss
where bar.f1 = ss.f1;
--dg-cascade
--dg select tableoid::regclass::text as relname, bar.* from bar order by 1,2;
-- Check UPDATE with *partitioned* inherited target and an appendrel subquery
--dg-cascade
--dg create table some_tab (a int);
insert into some_tab values (0);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table some_tab_child () inherits (some_tab);
--dg-cascade
--dg insert into some_tab_child values (1);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table parted_tab (a int, b char) partition by list (a);
--dg-cascade
--dg create table parted_tab_part1 partition of parted_tab for values in (1);
--dg-cascade
--dg create table parted_tab_part2 partition of parted_tab for values in (2);
--dg-cascade
--dg create table parted_tab_part3 partition of parted_tab for values in (3);
--dg-cascade
--dg insert into parted_tab values (1, 'a'), (2, 'a'), (3, 'a');
--dg-cascade
--dg update parted_tab set b = 'b'
--dg from
--dg   (select a from some_tab union all select a+1 from some_tab) ss (a)
--dg where parted_tab.a = ss.a;
--dg-cascade
--dg select tableoid::regclass::text as relname, parted_tab.* from parted_tab order by 1,2;
--dg-cascade
--dg truncate parted_tab;
--dg-cascade
--dg insert into parted_tab values (1, 'a'), (2, 'a'), (3, 'a');
--dg-cascade
--dg update parted_tab set b = 'b'
--dg from
--dg   (select 0 from parted_tab union all select 1 from parted_tab) ss (a)
--dg where parted_tab.a = ss.a;
--dg-cascade
--dg select tableoid::regclass::text as relname, parted_tab.* from parted_tab order by 1,2;
-- modifies partition key, but no rows will actually be updated
--dg-cascade
--dg explain update parted_tab set a = 2 where false;
--dg-cascade
--dg drop table parted_tab;
-- Check UPDATE with multi-level partitioned inherited target
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table mlparted_tab (a int, b char, c text) partition by list (a);
--dg-cascade
--dg create table mlparted_tab_part1 partition of mlparted_tab for values in (1);
--dg-cascade
--dg create table mlparted_tab_part2 partition of mlparted_tab for values in (2) partition by list (b);
--dg-cascade
--dg create table mlparted_tab_part3 partition of mlparted_tab for values in (3);
--dg-cascade
--dg create table mlparted_tab_part2a partition of mlparted_tab_part2 for values in ('a');
--dg-cascade
--dg create table mlparted_tab_part2b partition of mlparted_tab_part2 for values in ('b');
--dg-cascade
--dg insert into mlparted_tab values (1, 'a'), (2, 'a'), (2, 'b'), (3, 'a');
--dg-cascade
--dg update mlparted_tab mlp set c = 'xxx'
--dg from
--dg   (select a from some_tab union all select a+1 from some_tab) ss (a)
--dg where (mlp.a = ss.a and mlp.b = 'b') or mlp.a = 3;
--dg-cascade
--dg select tableoid::regclass::text as relname, mlparted_tab.* from mlparted_tab order by 1,2;
--dg-cascade
--dg drop table mlparted_tab;
--dg-cascade
--dg drop table some_tab cascade;
/* Test multiple inheritance of column defaults */
CREATE TABLE firstparent (tomorrow date default now()::date + 1);
CREATE TABLE secondparent (tomorrow date default  now() :: date  +  1);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE jointchild () INHERITS (firstparent, secondparent);  -- ok
CREATE TABLE thirdparent (tomorrow date default now()::date - 1);
--dg-differs: another error: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE otherchild () INHERITS (firstparent, thirdparent);  -- not ok
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE otherchild (tomorrow date default now())
--dg   INHERITS (firstparent, thirdparent);  -- ok, child resolves ambiguous default
--dg-cascade
--dg DROP TABLE firstparent, secondparent, jointchild, thirdparent, otherchild;
-- Test changing the type of inherited columns
--dg-cascade
--dg insert into d values('test','one','two','three');
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, a FOREIGN KEY's ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg alter table a alter column aa type integer using bit_length(aa);
--dg-cascade
--dg select * from d;
-- The above verified that we can change the type of a multiply-inherited
-- column; but we should reject that if any definition was inherited from
-- an unrelated parent.
create temp table parent1(f1 int, f2 int);
create temp table parent2(f1 int, f3 bigint);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table childtab(f4 int) inherits(parent1, parent2);
--dg-cascade
--dg alter table parent1 alter column f1 type bigint;  -- fail, conflict w/parent2
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, a FOREIGN KEY's ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg alter table parent1 alter column f2 type bigint;  -- ok
-- Test non-inheritable parent constraints
create table p1(ff1 int);
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint p1chk check (ff1 > 0) no inherit;
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table p1 add constraint p2chk check (ff1 > 10);
-- connoinherit should be true for NO INHERIT constraint
--dg-cascade
--dg select pc.relname, pgc.conname, pgc.contype, pgc.conislocal, pgc.coninhcount, pgc.connoinherit from pg_class as pc inner join pg_constraint as pgc on (pgc.conrelid = pc.oid) where pc.relname = 'p1' order by 1,2;
-- Test that child does not inherit NO INHERIT constraints
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table c1 () inherits (p1);
--dg-cascade
--dg \d p1
--dg-cascade
--dg \d c1
-- Test that child does not override inheritable constraints of the parent
--dg-cascade
--dg create table c2 (constraint p2chk check (ff1 > 10) no inherit) inherits (p1);	--fails
--dg-cascade
--dg drop table p1 cascade;
-- Tests for casting between the rowtypes of parent and child
-- tables. See the pgsql-hackers thread beginning Dec. 4/04
create table base (i integer);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table derived () inherits (base);
--dg-cascade
--dg create table more_derived (like derived, b int) inherits (derived);
--dg-cascade
--dg insert into derived (i) values (0);
--dg-cascade
--dg select derived::base from derived;
--dg-cascade
--dg select NULL::derived::base;
-- remove redundant conversions.
--dg-cascade
--dg explain (verbose on, costs off) select row(i, b)::more_derived::derived::base from more_derived;
--dg-cascade
--dg explain (verbose on, costs off) select (1, 2)::more_derived::derived::base;
--dg-cascade
--dg drop table more_derived;
--dg-cascade
--dg drop table derived;
drop table base;
--dg-cascade
--dg create table p1(ff1 int);
create table p2(f1 text);
--dg-skip: language "?" does not exist
--dg create function p2text(p2) returns text as 'select $1.f1' language sql;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table c1(f3 int) inherits(p1,p2);
--dg-cascade
--dg insert into c1 values(123456789, 'hi', 42);
--dg-cascade
--dg select p2text(c1.*) from c1;
--dg-cascade
--dg drop function p2text(p2);
--dg-cascade
--dg drop table c1;
drop table p2;
drop table p1;
CREATE TABLE ac (aa TEXT);
--dg-skip: ALTER TABLE ... ADD CONSTRAINT supports only FOREIGN KEY yet
--dg alter table ac add constraint ac_check check (aa is not null);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE bc (bb TEXT) INHERITS (ac);
--dg-cascade
--dg select pc.relname, pgc.conname, pgc.contype, pgc.conislocal, pgc.coninhcount, pg_get_expr(pgc.conbin, pc.oid) as consrc from pg_class as pc inner join pg_constraint as pgc on (pgc.conrelid = pc.oid) where pc.relname in ('ac', 'bc') order by 1,2;
--dg-cascade
