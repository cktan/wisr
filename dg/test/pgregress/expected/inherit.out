--dg alter table inh_nn2 alter constraint inh_nn1_f2_not_null no inherit;
drop table inh_nn1, inh_nn2;
--
-- Mixed ownership inheritance tree
--
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg create role regress_alice;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg create role regress_bob;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg grant all on schema public to regress_alice, regress_bob;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg grant regress_alice to regress_bob;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_alice;
--dg-cascade
--dg create table inh_parent (a int not null);
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_bob;
--dg-cascade
--dg create table inh_child () inherits (inh_parent);
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_alice;
-- alice can't do this: she doesn't own inh_child
--dg-cascade
--dg alter table inh_parent alter a drop not null;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_bob;
--dg-cascade
--dg alter table inh_parent alter a drop not null;
reset session authorization;
--dg-cascade
--dg drop table inh_parent, inh_child;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg revoke all on schema public from regress_alice, regress_bob;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg drop role regress_alice, regress_bob;
