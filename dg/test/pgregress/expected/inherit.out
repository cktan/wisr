--dg );
-- no remapping in either direction necessary
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE errtst_child_plaindef (
--dg     partid int not null,
--dg     shdata int not null,
--dg     data int NOT NULL DEFAULT 0,
--dg     CONSTRAINT shdata_small CHECK(shdata < 3),
--dg     CHECK(data < 10)
--dg );
-- remapping in both direction
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE errtst_child_reorder (
--dg     data int NOT NULL DEFAULT 0,
--dg     shdata int not null,
--dg     partid int not null,
--dg     CONSTRAINT shdata_small CHECK(shdata < 3),
--dg     CHECK(data < 10)
--dg );
--dg-cascade
--dg ALTER TABLE errtst_child_fastdef ADD COLUMN data int NOT NULL DEFAULT 0;
--dg-cascade
--dg ALTER TABLE errtst_child_fastdef ADD CONSTRAINT errtest_child_fastdef_data_check CHECK (data < 10);
--dg-cascade
--dg ALTER TABLE errtst_parent ATTACH PARTITION errtst_child_fastdef FOR VALUES FROM (0) TO (10);
--dg-cascade
--dg ALTER TABLE errtst_parent ATTACH PARTITION errtst_child_plaindef FOR VALUES FROM (10) TO (20);
--dg-cascade
--dg ALTER TABLE errtst_parent ATTACH PARTITION errtst_child_reorder FOR VALUES FROM (20) TO (30);
-- insert without child check constraint error
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ( '0', '1', '5');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('10', '1', '5');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('20', '1', '5');
-- insert with child check constraint error
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ( '0', '1', '10');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('10', '1', '10');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('20', '1', '10');
-- insert with child not null constraint error
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ( '0', '1', NULL);
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('10', '1', NULL);
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('20', '1', NULL);
-- insert with shared check constraint error
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ( '0', '5', '5');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('10', '5', '5');
--dg-cascade
--dg INSERT INTO errtst_parent(partid, shdata, data) VALUES ('20', '5', '5');
-- within partition update without child check constraint violation
BEGIN;
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 1 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 1 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 1 WHERE partid = 20;
ROLLBACK;
-- within partition update with child check constraint violation
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 10 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 10 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_parent SET data = data + 10 WHERE partid = 20;
-- direct leaf partition update, without partition id violation
BEGIN;
--dg-cascade
--dg UPDATE errtst_child_fastdef SET partid = 1 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_child_plaindef SET partid = 11 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_child_reorder SET partid = 21 WHERE partid = 20;
ROLLBACK;
-- direct leaf partition update, with partition id violation
--dg-cascade
--dg UPDATE errtst_child_fastdef SET partid = partid + 10 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_child_plaindef SET partid = partid + 10 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_child_reorder SET partid = partid + 10 WHERE partid = 20;
-- partition move, without child check constraint violation
BEGIN;
--dg-cascade
--dg UPDATE errtst_parent SET partid = 10, data = data + 1 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_parent SET partid = 20, data = data + 1 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_parent SET partid = 0, data = data + 1 WHERE partid = 20;
ROLLBACK;
-- partition move, with child check constraint violation
--dg-cascade
--dg UPDATE errtst_parent SET partid = 10, data = data + 10 WHERE partid = 0;
--dg-cascade
--dg UPDATE errtst_parent SET partid = 20, data = data + 10 WHERE partid = 10;
--dg-cascade
--dg UPDATE errtst_parent SET partid = 0, data = data + 10 WHERE partid = 20;
-- partition move, without target partition
--dg-cascade
--dg UPDATE errtst_parent SET partid = 30, data = data + 10 WHERE partid = 20;
--dg-cascade
--dg DROP TABLE errtst_parent;
-- Check that we have the correct tuples estimate for an appendrel
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table tuplesest_parted (a int, b int, c float) partition by range(a);
