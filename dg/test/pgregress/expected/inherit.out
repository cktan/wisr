create table inh_perm_parent (a1 int);
create temp table inh_temp_parent (a1 int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table inh_temp_child () inherits (inh_perm_parent); -- ok
--dg-differs: another error: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table inh_perm_child () inherits (inh_temp_parent); -- error
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table inh_temp_child_2 () inherits (inh_temp_parent); -- ok
insert into inh_perm_parent values (1);
insert into inh_temp_parent values (2);
--dg-cascade
--dg insert into inh_temp_child values (3);
--dg-cascade
--dg insert into inh_temp_child_2 values (4);
--dg-cascade
--dg select tableoid::regclass, a1 from inh_perm_parent;
--dg-cascade
--dg select tableoid::regclass, a1 from inh_temp_parent;
--dg-cascade
--dg drop table inh_perm_parent cascade;
--dg-cascade
--dg drop table inh_temp_parent cascade;
--
-- Check that constraint exclusion works correctly with partitions using
-- implicit constraints generated from the partition bound information.
--
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table list_parted (
--dg 	a	varchar
--dg ) partition by list (a);
--dg-cascade
--dg create table part_ab_cd partition of list_parted for values in ('ab', 'cd');
--dg-cascade
--dg create table part_ef_gh partition of list_parted for values in ('ef', 'gh');
--dg-cascade
--dg create table part_null_xy partition of list_parted for values in (null, 'xy');
--dg-cascade
--dg explain (costs off) select * from list_parted;
--dg-cascade
--dg explain (costs off) select * from list_parted where a is null;
--dg-cascade
--dg explain (costs off) select * from list_parted where a is not null;
--dg-cascade
--dg explain (costs off) select * from list_parted where a in ('ab', 'cd', 'ef');
--dg-cascade
--dg explain (costs off) select * from list_parted where a = 'ab' or a in (null, 'cd');
--dg-cascade
--dg explain (costs off) select * from list_parted where a = 'ab';
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table range_list_parted (
--dg 	a	int,
--dg 	b	char(2)
--dg ) partition by range (a);
--dg-cascade
--dg create table part_1_10 partition of range_list_parted for values from (1) to (10) partition by list (b);
--dg-cascade
--dg create table part_1_10_ab partition of part_1_10 for values in ('ab');
--dg-cascade
--dg create table part_1_10_cd partition of part_1_10 for values in ('cd');
--dg-cascade
--dg create table part_10_20 partition of range_list_parted for values from (10) to (20) partition by list (b);
--dg-cascade
--dg create table part_10_20_ab partition of part_10_20 for values in ('ab');
--dg-cascade
--dg create table part_10_20_cd partition of part_10_20 for values in ('cd');
--dg-cascade
--dg create table part_21_30 partition of range_list_parted for values from (21) to (30) partition by list (b);
--dg-cascade
--dg create table part_21_30_ab partition of part_21_30 for values in ('ab');
--dg-cascade
--dg create table part_21_30_cd partition of part_21_30 for values in ('cd');
--dg-cascade
--dg create table part_40_inf partition of range_list_parted for values from (40) to (maxvalue) partition by list (b);
--dg-cascade
--dg create table part_40_inf_ab partition of part_40_inf for values in ('ab');
--dg-cascade
--dg create table part_40_inf_cd partition of part_40_inf for values in ('cd');
--dg-cascade
--dg create table part_40_inf_null partition of part_40_inf for values in (null);
--dg-cascade
--dg explain (costs off) select * from range_list_parted;
--dg-cascade
--dg explain (costs off) select * from range_list_parted where a = 5;
--dg-cascade
--dg explain (costs off) select * from range_list_parted where b = 'ab';
--dg-cascade
--dg explain (costs off) select * from range_list_parted where a between 3 and 23 and b in ('ab');
/* Should select no rows because range partition key cannot be null */
--dg-cascade
--dg explain (costs off) select * from range_list_parted where a is null;
/* Should only select rows from the null-accepting partition */
--dg-cascade
--dg explain (costs off) select * from range_list_parted where b is null;
--dg-cascade
--dg explain (costs off) select * from range_list_parted where a is not null and a < 67;
--dg-cascade
--dg explain (costs off) select * from range_list_parted where a >= 30;
--dg-cascade
--dg drop table list_parted;
--dg-cascade
--dg drop table range_list_parted;
-- check that constraint exclusion is able to cope with the partition
-- constraint emitted for multi-column range partitioned tables
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table mcrparted (a int, b int, c int) partition by range (a, abs(b), c);
--dg-cascade
--dg create table mcrparted_def partition of mcrparted default;
--dg-cascade
--dg create table mcrparted0 partition of mcrparted for values from (minvalue, minvalue, minvalue) to (1, 1, 1);
--dg-cascade
--dg create table mcrparted1 partition of mcrparted for values from (1, 1, 1) to (10, 5, 10);
--dg-cascade
--dg create table mcrparted2 partition of mcrparted for values from (10, 5, 10) to (10, 10, 10);
--dg-cascade
--dg create table mcrparted3 partition of mcrparted for values from (11, 1, 1) to (20, 10, 10);
--dg-cascade
--dg create table mcrparted4 partition of mcrparted for values from (20, 10, 10) to (20, 20, 20);
--dg-cascade
--dg create table mcrparted5 partition of mcrparted for values from (20, 20, 20) to (maxvalue, maxvalue, maxvalue);
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 0;	-- scans mcrparted0, mcrparted_def
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 10 and abs(b) < 5;	-- scans mcrparted1, mcrparted_def
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 10 and abs(b) = 5;	-- scans mcrparted1, mcrparted2, mcrparted_def
--dg-cascade
--dg explain (costs off) select * from mcrparted where abs(b) = 5;	-- scans all partitions
--dg-cascade
--dg explain (costs off) select * from mcrparted where a > -1;	-- scans all partitions
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 20 and abs(b) = 10 and c > 10;	-- scans mcrparted4
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 20 and c > 20; -- scans mcrparted3, mcrparte4, mcrparte5, mcrparted_def
-- check that partitioned table Appends cope with being referenced in
-- subplans
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table parted_minmax (a int, b varchar(16)) partition by range (a);
--dg-cascade
--dg create table parted_minmax1 partition of parted_minmax for values from (1) to (10);
--dg-cascade
--dg create index parted_minmax1i on parted_minmax1 (a, b);
--dg-cascade
--dg insert into parted_minmax values (1,'12345');
--dg-cascade
--dg explain (costs off) select min(a), max(a) from parted_minmax where b = '12345';
--dg-cascade
--dg select min(a), max(a) from parted_minmax where b = '12345';
--dg-cascade
--dg drop table parted_minmax;
-- Test code that uses Append nodes in place of MergeAppend when the
-- partition ordering matches the desired ordering.
--dg-cascade
--dg create index mcrparted_a_abs_c_idx on mcrparted (a, abs(b), c);
-- MergeAppend must be used when a default partition exists
--dg-cascade
--dg explain (costs off) select * from mcrparted order by a, abs(b), c;
--dg-cascade
--dg drop table mcrparted_def;
-- Append is used for a RANGE partitioned table with no default
-- and no subpartitions
--dg-cascade
--dg explain (costs off) select * from mcrparted order by a, abs(b), c;
-- Append is used with subpaths in reverse order with backwards index scans
--dg-cascade
--dg explain (costs off) select * from mcrparted order by a desc, abs(b) desc, c desc;
-- check that Append plan is used containing a MergeAppend for sub-partitions
-- that are unordered.
--dg-cascade
--dg drop table mcrparted5;
--dg-cascade
--dg create table mcrparted5 partition of mcrparted for values from (20, 20, 20) to (maxvalue, maxvalue, maxvalue) partition by list (a);
--dg-cascade
--dg create table mcrparted5a partition of mcrparted5 for values in(20);
--dg-cascade
--dg create table mcrparted5_def partition of mcrparted5 default;
--dg-cascade
--dg explain (costs off) select * from mcrparted order by a, abs(b), c;
--dg-cascade
--dg drop table mcrparted5_def;
-- check that an Append plan is used and the sub-partitions are flattened
-- into the main Append when the sub-partition is unordered but contains
-- just a single sub-partition.
--dg-cascade
--dg explain (costs off) select a, abs(b) from mcrparted order by a, abs(b), c;
-- check that Append is used when the sub-partitioned tables are pruned
-- during planning.
--dg-cascade
--dg explain (costs off) select * from mcrparted where a < 20 order by a, abs(b), c;
set enable_bitmapscan to off;
set enable_sort to off;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table mclparted (a int) partition by list(a);
--dg-cascade
--dg create table mclparted1 partition of mclparted for values in(1);
--dg-cascade
--dg create table mclparted2 partition of mclparted for values in(2);
--dg-cascade
--dg create index on mclparted (a);
-- Ensure an Append is used for a list partition with an order by.
--dg-cascade
--dg explain (costs off) select * from mclparted order by a;
-- Ensure a MergeAppend is used when a partition exists with interleaved
-- datums in the partition bound.
--dg-cascade
--dg create table mclparted3_5 partition of mclparted for values in(3,5);
--dg-cascade
--dg create table mclparted4 partition of mclparted for values in(4);
--dg-cascade
--dg explain (costs off) select * from mclparted order by a;
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(3,4,5) order by a;
-- Introduce a NULL and DEFAULT partition so we can test more complex cases
--dg-cascade
--dg create table mclparted_null partition of mclparted for values in(null);
--dg-cascade
--dg create table mclparted_def partition of mclparted default;
-- Append can be used providing we don't scan the interleaved partition
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(1,2,4) order by a;
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(1,2,4) or a is null order by a;
-- Test a more complex case where the NULL partition allows some other value
--dg-cascade
--dg drop table mclparted_null;
--dg-cascade
--dg create table mclparted_0_null partition of mclparted for values in(0,null);
-- Ensure MergeAppend is used since 0 and NULLs are in the same partition.
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(1,2,4) or a is null order by a;
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(0,1,2,4) order by a;
-- Ensure Append is used when the null partition is pruned
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(1,2,4) order by a;
-- Ensure MergeAppend is used when the default partition is not pruned
--dg-cascade
--dg explain (costs off) select * from mclparted where a in(1,2,4,100) order by a;
--dg-cascade
--dg drop table mclparted;
reset enable_sort;
reset enable_bitmapscan;
-- Ensure subplans which don't have a path with the correct pathkeys get
-- sorted correctly.
--dg-cascade
--dg drop index mcrparted_a_abs_c_idx;
--dg-cascade
--dg create index on mcrparted1 (a, abs(b), c);
--dg-cascade
--dg create index on mcrparted2 (a, abs(b), c);
--dg-cascade
--dg create index on mcrparted3 (a, abs(b), c);
--dg-cascade
--dg create index on mcrparted4 (a, abs(b), c);
--dg-cascade
--dg explain (costs off) select * from mcrparted where a < 20 order by a, abs(b), c limit 1;
set enable_bitmapscan = 0;
-- Ensure Append node can be used when the partition is ordered by some
-- pathkeys which were deemed redundant.
--dg-cascade
--dg explain (costs off) select * from mcrparted where a = 10 order by a, abs(b), c;
reset enable_bitmapscan;
--dg-cascade
--dg drop table mcrparted;
