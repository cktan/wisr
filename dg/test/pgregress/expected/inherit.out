--dg-cascade
--dg SELECT relname, d.* FROM ONLY d, pg_class where d.tableoid = pg_class.oid;
UPDATE a SET aa='zzzz' WHERE aa='aaaa';
UPDATE ONLY a SET aa='zzzzz' WHERE aa='aaaaa';
--dg-cascade
--dg UPDATE b SET aa='zzz' WHERE aa='aaa';
