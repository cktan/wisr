-- A couple of other hash join tests unrelated to work_mem management.
-- Check that EXPLAIN ANALYZE has data even if the leader doesn't participate
savepoint settings;
--dg-skip: unrecognized configuration parameter "?"
--dg set local max_parallel_workers_per_gather = 2;
set local work_mem = '4MB';
set local hash_mem_multiplier = 1.0;
--dg-skip: unrecognized configuration parameter "?"
--dg set local parallel_leader_participation = off;
--dg-cascade
--dg select * from hash_join_batches(
--dg $$
--dg   select count(*) from simple r join simple s using (id);
--dg $$);
rollback to settings;
-- Exercise rescans.  We'll turn off parallel_leader_participation so
-- that we can check that instrumentation comes back correctly.
create table join_foo as select generate_series(1, 3) as id, 'xxxxx'::text as t;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg alter table join_foo set (parallel_workers = 0);
create table join_bar as select generate_series(1, 10000) as id, 'xxxxx'::text as t;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg alter table join_bar set (parallel_workers = 2);
-- multi-batch with rescan, parallel-oblivious
savepoint settings;
--dg-skip: unrecognized configuration parameter "?"
--dg set enable_parallel_hash = off;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_leader_participation = off;
--dg-skip: unrecognized configuration parameter "?"
--dg set min_parallel_table_scan_size = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_setup_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_tuple_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set max_parallel_workers_per_gather = 2;
set enable_material = off;
set enable_mergejoin = off;
set work_mem = '64kB';
set hash_mem_multiplier = 1.0;
--dg-cascade
--dg explain (costs off)
--dg   select count(*) from join_foo
--dg     left join (select b1.id, b1.t from join_bar b1 join join_bar b2 using (id)) ss
--dg     on join_foo.id < ss.id + 1 and join_foo.id > ss.id - 1;
select count(*) from join_foo
  left join (select b1.id, b1.t from join_bar b1 join join_bar b2 using (id)) ss
  on join_foo.id < ss.id + 1 and join_foo.id > ss.id - 1;
 count 
-------
     3
(1 row)

--dg-cascade
--dg select final > 1 as multibatch
--dg   from hash_join_batches(
--dg $$
--dg   select count(*) from join_foo
--dg     left join (select b1.id, b1.t from join_bar b1 join join_bar b2 using (id)) ss
--dg     on join_foo.id < ss.id + 1 and join_foo.id > ss.id - 1;
--dg $$);
rollback to settings;
-- single-batch with rescan, parallel-oblivious
savepoint settings;
--dg-skip: unrecognized configuration parameter "?"
--dg set enable_parallel_hash = off;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_leader_participation = off;
--dg-skip: unrecognized configuration parameter "?"
--dg set min_parallel_table_scan_size = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_setup_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set parallel_tuple_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg set max_parallel_workers_per_gather = 2;
set enable_material = off;
set enable_mergejoin = off;
set work_mem = '4MB';
set hash_mem_multiplier = 1.0;
--dg-cascade
--dg explain (costs off)
--dg   select count(*) from join_foo
--dg     left join (select b1.id, b1.t from join_bar b1 join join_bar b2 using (id)) ss
--dg     on join_foo.id < ss.id + 1 and join_foo.id > ss.id - 1;
select count(*) from join_foo
  left join (select b1.id, b1.t from join_bar b1 join join_bar b2 using (id)) ss
  on join_foo.id < ss.id + 1 and join_foo.id > ss.id - 1;
 count 
-------
     3
(1 row)

