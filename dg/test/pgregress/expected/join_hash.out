rollback to settings;
-- The "ugly" case: increasing the number of batches during execution
-- doesn't help, so stop trying to fit in work_mem and hope for the
-- best; in this case we plan for 1 batch, increases just once and
-- then stop increasing because that didn't help at all, so we blow
-- right through the work_mem budget and hope for the best...
-- non-parallel
savepoint settings;
--dg-skip: unrecognized configuration parameter "?"
--dg set local max_parallel_workers_per_gather = 0;
set local work_mem = '128kB';
set local hash_mem_multiplier = 1.0;
--dg-cascade
--dg explain (costs off)
--dg   select count(*) from simple r join extremely_skewed s using (id);
select count(*) from simple r join extremely_skewed s using (id);
 count 
-------
 20000
(1 row)

--dg-cascade
--dg select * from hash_join_batches(
--dg $$
--dg   select count(*) from simple r join extremely_skewed s using (id);
--dg $$);
rollback to settings;
-- parallel with parallel-oblivious hash join
savepoint settings;
