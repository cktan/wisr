--Test text search dictionaries and configurations
-- Test ISpell dictionary with ispell affix file
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH DICTIONARY ispell (
--dg                         Template=ispell,
--dg                         DictFile=ispell_sample,
--dg                         AffFile=ispell_sample
--dg );
--dg-cascade
--dg SELECT ts_lexize('ispell', 'skies');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'bookings');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'booking');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'foot');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'foots');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'rebookings');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'rebooking');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'rebook');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'unbookings');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'unbooking');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'unbook');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'footklubber');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'footballklubber');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'ballyklubber');
--dg-cascade
--dg SELECT ts_lexize('ispell', 'footballyklubber');
