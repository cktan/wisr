-- Synonym dictionary
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH DICTIONARY synonym (
--dg 						Template=synonym,
--dg 						Synonyms=synonym_sample
--dg );
--dg-cascade
--dg SELECT ts_lexize('synonym', 'PoStGrEs');
--dg-cascade
--dg SELECT ts_lexize('synonym', 'Gogle');
--dg-cascade
--dg SELECT ts_lexize('synonym', 'indices');
-- test altering boolean parameters
--dg-cascade
--dg SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 'synonym';
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH DICTIONARY synonym (CaseSensitive = 1);
--dg-cascade
--dg SELECT ts_lexize('synonym', 'PoStGrEs');
--dg-cascade
--dg SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 'synonym';
--dg-cascade
--dg ALTER TEXT SEARCH DICTIONARY synonym (CaseSensitive = 2);  -- fail
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH DICTIONARY synonym (CaseSensitive = off);
--dg-cascade
--dg SELECT ts_lexize('synonym', 'PoStGrEs');
--dg-cascade
--dg SELECT dictinitoption FROM pg_ts_dict WHERE dictname = 'synonym';
-- Create and simple test thesaurus dictionary
-- More tests in configuration checks because ts_lexize()
-- cannot pass more than one word to thesaurus.
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH DICTIONARY thesaurus (
--dg                         Template=thesaurus,
--dg 						DictFile=thesaurus_sample,
--dg 						Dictionary=english_stem
--dg );
--dg-cascade
--dg SELECT ts_lexize('thesaurus', 'one');
-- Test ispell dictionary in configuration
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH CONFIGURATION ispell_tst (
--dg 						COPY=english
--dg );
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION ispell_tst ALTER MAPPING FOR
--dg 	word, numword, asciiword, hword, numhword, asciihword, hword_part, hword_numpart, hword_asciipart
--dg 	WITH ispell, english_stem;
--dg-cascade
--dg SELECT to_tsvector('ispell_tst', 'Booking the skies after rebookings for footballklubber from a foot');
--dg-cascade
--dg SELECT to_tsquery('ispell_tst', 'footballklubber');
--dg-cascade
--dg SELECT to_tsquery('ispell_tst', 'footballyklubber:b & rebookings:A & sky');
-- Test ispell dictionary with hunspell affix in configuration
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH CONFIGURATION hunspell_tst (
--dg 						COPY=ispell_tst
--dg );
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING
--dg 	REPLACE ispell WITH hunspell;
--dg-cascade
--dg SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballklubber');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballyklubber:b & rebookings:A & sky');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballyklubber:b <-> sky');
--dg-cascade
--dg SELECT phraseto_tsquery('hunspell_tst', 'footballyklubber sky');
-- Test ispell dictionary with hunspell affix with FLAG long in configuration
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING
--dg 	REPLACE hunspell WITH hunspell_long;
--dg-cascade
--dg SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballklubber');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballyklubber:b & rebookings:A & sky');
-- Test ispell dictionary with hunspell affix with FLAG num in configuration
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING
--dg 	REPLACE hunspell_long WITH hunspell_num;
--dg-cascade
--dg SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballklubber');
--dg-cascade
--dg SELECT to_tsquery('hunspell_tst', 'footballyklubber:b & rebookings:A & sky');
