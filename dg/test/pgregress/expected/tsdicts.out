-- Test grammar for configurations
--dg-skip: text search is not supported
--dg CREATE TEXT SEARCH CONFIGURATION dummy_tst (COPY=english);
-- Overridden mapping change with duplicated tokens.
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   ALTER MAPPING FOR word, word WITH ispell;
-- Not a token supported by the configuration's parser, fails.
--dg-cascade
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   DROP MAPPING FOR not_a_token, not_a_token;
-- Not a token supported by the configuration's parser, fails even
-- with IF EXISTS.
--dg-cascade
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   DROP MAPPING IF EXISTS FOR not_a_token, not_a_token;
-- Token supported by the configuration's parser, succeeds.
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   DROP MAPPING FOR word, word;
-- No mapping for token supported by the configuration's parser, fails.
--dg-cascade
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   DROP MAPPING FOR word;
-- Token supported by the configuration's parser, cannot be found,
-- succeeds with IF EXISTS.
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   DROP MAPPING IF EXISTS FOR word, word;
-- Re-add mapping, with duplicated tokens supported by the parser.
--dg-skip: text search is not supported
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   ADD MAPPING FOR word, word WITH ispell;
-- Not a token supported by the configuration's parser, fails.
--dg-cascade
--dg ALTER TEXT SEARCH CONFIGURATION dummy_tst
--dg   ADD MAPPING FOR not_a_token WITH ispell;
--dg-skip: relation pg_ts_config cannot be opened: digres has no catalog tables
--dg DROP TEXT SEARCH CONFIGURATION dummy_tst;
