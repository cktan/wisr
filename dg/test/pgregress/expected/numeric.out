--dg SELECT t1.id1, t1.id2, t1.result, t2.expected
--dg     FROM num_result t1, num_exp_div t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != t2.expected;
