--
-- Tests for VARIANCE()
--
CREATE TABLE num_variance (a numeric);
INSERT INTO num_variance VALUES (0);
--dg-skip: "?" is out of range for type double precision
--dg INSERT INTO num_variance VALUES (3e-500);
--dg-skip: "?" is out of range for type double precision
--dg INSERT INTO num_variance VALUES (-3e-500);
--dg-skip: "?" is out of range for type double precision
--dg INSERT INTO num_variance VALUES (4e-500 - 1e-16383);
--dg-skip: "?" is out of range for type double precision
--dg INSERT INTO num_variance VALUES (-4e-500 + 1e-16383);
-- variance is just under 12.5e-1000 and so should round down to 12e-1000
--dg-cascade
--dg SELECT trim_scale(variance(a) * 1e1000) FROM num_variance;
-- check that parallel execution produces the same result
BEGIN;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg ALTER TABLE num_variance SET (parallel_workers = 4);
--dg-skip: unrecognized configuration parameter "?"
--dg SET LOCAL parallel_setup_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg SET LOCAL max_parallel_workers_per_gather = 4;
--dg-cascade
--dg SELECT trim_scale(variance(a) * 1e1000) FROM num_variance;
ROLLBACK;
-- case where sum of squares would overflow but variance does not
DELETE FROM num_variance;
--dg-skip: "?" is out of range for type double precision
--dg INSERT INTO num_variance SELECT 9e131071 + x FROM generate_series(1, 5) x;
--dg-cascade
--dg SELECT variance(a) FROM num_variance;
-- check that parallel execution produces the same result
BEGIN;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg ALTER TABLE num_variance SET (parallel_workers = 4);
--dg-skip: unrecognized configuration parameter "?"
--dg SET LOCAL parallel_setup_cost = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg SET LOCAL max_parallel_workers_per_gather = 4;
--dg-cascade
--dg SELECT variance(a) FROM num_variance;
ROLLBACK;
DROP TABLE num_variance;
