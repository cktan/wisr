-- ******************************
-- * Create indices for faster checks
-- ******************************
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_add_idx ON num_exp_add (id1, id2);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_sub_idx ON num_exp_sub (id1, id2);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_div_idx ON num_exp_div (id1, id2);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_mul_idx ON num_exp_mul (id1, id2);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_sqrt_idx ON num_exp_sqrt (id);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_ln_idx ON num_exp_ln (id);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_log10_idx ON num_exp_log10 (id);
--dg-cascade
--dg CREATE UNIQUE INDEX num_exp_power_10_ln_idx ON num_exp_power_10_ln (id);
--dg-cascade
--dg VACUUM ANALYZE num_exp_add;
--dg-cascade
--dg VACUUM ANALYZE num_exp_sub;
--dg-cascade
--dg VACUUM ANALYZE num_exp_div;
--dg-cascade
--dg VACUUM ANALYZE num_exp_mul;
--dg-cascade
--dg VACUUM ANALYZE num_exp_sqrt;
--dg-cascade
--dg VACUUM ANALYZE num_exp_ln;
--dg-cascade
--dg VACUUM ANALYZE num_exp_log10;
--dg-cascade
--dg VACUUM ANALYZE num_exp_power_10_ln;
-- ******************************
-- * Now check the behaviour of the NUMERIC type
-- ******************************
-- ******************************
-- * Addition check
-- ******************************
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, t1.val + t2.val
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, t2.expected
--dg     FROM num_result t1, num_exp_add t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != t2.expected;
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val + t2.val, 10)
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 10) as expected
--dg     FROM num_result t1, num_exp_add t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != round(t2.expected, 10);
-- ******************************
-- * Subtraction check
-- ******************************
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, t1.val - t2.val
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, t2.expected
--dg     FROM num_result t1, num_exp_sub t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != t2.expected;
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val - t2.val, 40)
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 40)
--dg     FROM num_result t1, num_exp_sub t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != round(t2.expected, 40);
-- ******************************
-- * Multiply check
-- ******************************
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, t1.val * t2.val
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, t2.expected
--dg     FROM num_result t1, num_exp_mul t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != t2.expected;
--dg-cascade
--dg DELETE FROM num_result;
--dg-cascade
--dg INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val * t2.val, 30)
--dg     FROM num_data t1, num_data t2;
--dg-cascade
--dg SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 30) as expected
--dg     FROM num_result t1, num_exp_mul t2
--dg     WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
--dg     AND t1.result != round(t2.expected, 30);
