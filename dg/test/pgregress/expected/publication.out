-- Test the list of partitions published with or without
-- 'PUBLISH_VIA_PARTITION_ROOT' parameter
SET client_min_messages = 'ERROR';
CREATE SCHEMA sch1;
CREATE SCHEMA sch2;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE sch1.tbl1 (a int) PARTITION BY RANGE(a);
--dg-cascade
--dg CREATE TABLE sch2.tbl1_part1 PARTITION OF sch1.tbl1 FOR VALUES FROM (1) to (10);
-- Schema publication that does not include the schema that has the parent table
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub FOR TABLES IN SCHEMA sch2 WITH (PUBLISH_VIA_PARTITION_ROOT=1);
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub;
-- Table publication that does not include the parent table
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub FOR TABLE sch2.tbl1_part1 WITH (PUBLISH_VIA_PARTITION_ROOT=1);
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
-- Table publication that includes both the parent table and the child table
--dg-skip: publications are not supported
--dg ALTER PUBLICATION pub ADD TABLE sch1.tbl1;
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub;
-- Schema publication that does not include the schema that has the parent table
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub FOR TABLES IN SCHEMA sch2 WITH (PUBLISH_VIA_PARTITION_ROOT=0);
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub;
-- Table publication that does not include the parent table
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub FOR TABLE sch2.tbl1_part1 WITH (PUBLISH_VIA_PARTITION_ROOT=0);
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
-- Table publication that includes both the parent table and the child table
--dg-skip: publications are not supported
--dg ALTER PUBLICATION pub ADD TABLE sch1.tbl1;
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub;
--dg-cascade
--dg DROP TABLE sch2.tbl1_part1;
--dg-cascade
--dg DROP TABLE sch1.tbl1;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE sch1.tbl1 (a int) PARTITION BY RANGE(a);
--dg-cascade
--dg CREATE TABLE sch1.tbl1_part1 PARTITION OF sch1.tbl1 FOR VALUES FROM (1) to (10);
--dg-cascade
--dg CREATE TABLE sch1.tbl1_part2 PARTITION OF sch1.tbl1 FOR VALUES FROM (10) to (20);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE sch1.tbl1_part3 (a int) PARTITION BY RANGE(a);
--dg-cascade
--dg ALTER TABLE sch1.tbl1 ATTACH PARTITION sch1.tbl1_part3 FOR VALUES FROM (20) to (30);
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub FOR TABLES IN SCHEMA sch1 WITH (PUBLISH_VIA_PARTITION_ROOT=1);
--dg-cascade
--dg SELECT * FROM pg_publication_tables;
RESET client_min_messages;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub;
--dg-cascade
--dg DROP TABLE sch1.tbl1;
--dg-cascade
--dg DROP SCHEMA sch1 cascade;
DROP SCHEMA sch2 cascade;
-- ======================================================
-- Test the 'publish_generated_columns' parameter with the following values:
-- 'stored', 'none'.
SET client_min_messages = 'ERROR';
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub1 FOR ALL TABLES WITH (publish_generated_columns = stored);
--dg-cascade
--dg \dRp+ pub1
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub2 FOR ALL TABLES WITH (publish_generated_columns = none);
--dg-cascade
--dg \dRp+ pub2
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub1;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub2;
-- Test the 'publish_generated_columns' parameter as 'none' and 'stored' for
-- different scenarios with/without generated columns in column lists.
--dg-skip: column "?" asks for what CREATE TABLE does not support yet
--dg CREATE TABLE gencols (a int, gen1 int GENERATED ALWAYS AS (a * 2) STORED);
-- Generated columns in column list, when 'publish_generated_columns'='none'
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub1 FOR table gencols(a, gen1) WITH (publish_generated_columns = none);
--dg-cascade
--dg \dRp+ pub1
-- Generated columns in column list, when 'publish_generated_columns'='stored'
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub2 FOR table gencols(a, gen1) WITH (publish_generated_columns = stored);
--dg-cascade
--dg \dRp+ pub2
-- Generated columns in column list, then set 'publish_generated_columns'='none'
--dg-skip: publications are not supported
--dg ALTER PUBLICATION pub2 SET (publish_generated_columns = none);
--dg-cascade
--dg \dRp+ pub2
-- Remove generated columns from column list, when 'publish_generated_columns'='none'
--dg-skip: publications are not supported
--dg ALTER PUBLICATION pub2 SET TABLE gencols(a);
--dg-cascade
--dg \dRp+ pub2
-- Add generated columns in column list, when 'publish_generated_columns'='none'
--dg-skip: publications are not supported
--dg ALTER PUBLICATION pub2 SET TABLE gencols(a, gen1);
--dg-cascade
--dg \dRp+ pub2
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub1;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub2;
--dg-cascade
--dg DROP TABLE gencols;
RESET client_min_messages;
-- Test that the INSERT ON CONFLICT command correctly checks REPLICA IDENTITY
-- when the target table is published.
CREATE TABLE testpub_insert_onconfl_no_ri (a int unique, b int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE testpub_insert_onconfl_parted (a int unique, b int) PARTITION by RANGE (a);
--dg-cascade
--dg CREATE TABLE testpub_insert_onconfl_part_no_ri PARTITION OF testpub_insert_onconfl_parted FOR VALUES FROM (1) TO (10);
SET client_min_messages = 'ERROR';
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub1 FOR ALL TABLES;
RESET client_min_messages;
-- fail - missing REPLICA IDENTITY
--dg-cascade
--dg INSERT INTO testpub_insert_onconfl_no_ri VALUES (1, 1) ON CONFLICT (a) DO UPDATE SET b = 2;
-- ok - no updates
INSERT INTO testpub_insert_onconfl_no_ri VALUES (1, 1) ON CONFLICT DO NOTHING;
-- fail - missing REPLICA IDENTITY in partition testpub_insert_onconfl_no_ri
--dg-cascade
--dg INSERT INTO testpub_insert_onconfl_parted VALUES (1, 1) ON CONFLICT (a) DO UPDATE SET b = 2;
-- ok - no updates
--dg-cascade
--dg INSERT INTO testpub_insert_onconfl_parted VALUES (1, 1) ON CONFLICT DO NOTHING;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub1;
DROP TABLE testpub_insert_onconfl_no_ri;
--dg-cascade
--dg DROP TABLE testpub_insert_onconfl_parted;
-- Test that the MERGE command correctly checks REPLICA IDENTITY when the
-- target table is published.
CREATE TABLE testpub_merge_no_ri (a int, b int);
CREATE TABLE testpub_merge_pk (a int primary key, b int);
SET client_min_messages = 'ERROR';
--dg-skip: publications are not supported
--dg CREATE PUBLICATION pub1 FOR ALL TABLES;
RESET client_min_messages;
-- fail - missing REPLICA IDENTITY
--dg-cascade
--dg MERGE INTO testpub_merge_no_ri USING testpub_merge_pk s ON s.a >= 1
--dg  WHEN MATCHED THEN UPDATE SET b = s.b;
-- fail - missing REPLICA IDENTITY
--dg-cascade
--dg MERGE INTO testpub_merge_no_ri USING testpub_merge_pk s ON s.a >= 1
--dg  WHEN MATCHED THEN DELETE;
-- ok - insert and do nothing are not restricted
--dg-skip: MERGE does not write to table "?" yet
--dg MERGE INTO testpub_merge_no_ri USING testpub_merge_pk s ON s.a >= 1
--dg  WHEN MATCHED THEN DO NOTHING
--dg  WHEN NOT MATCHED THEN INSERT (a, b) VALUES (0, 0);
-- ok - REPLICA IDENTITY is DEFAULT and table has a PK
--dg-skip: MERGE does not write to table "?" yet
--dg MERGE INTO testpub_merge_pk USING testpub_merge_no_ri s ON s.a >= 1
--dg  WHEN MATCHED AND s.a > 0 THEN UPDATE SET b = s.b
--dg  WHEN MATCHED THEN DELETE;
--dg-skip: publications are not supported
--dg DROP PUBLICATION pub1;
DROP TABLE testpub_merge_no_ri;
DROP TABLE testpub_merge_pk;
RESET SESSION AUTHORIZATION;
--dg-cascade
--dg DROP ROLE regress_publication_user, regress_publication_user2;
DROP ROLE regress_publication_user_dummy;
