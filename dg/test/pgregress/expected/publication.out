-- Tests for partitioned tables
SET client_min_messages = 'ERROR';
--dg-skip: publications are not supported
--dg CREATE PUBLICATION testpub_forparted;
--dg-skip: publications are not supported
--dg CREATE PUBLICATION testpub_forparted1;
RESET client_min_messages;
--dg-cascade
--dg CREATE TABLE testpub_parted1 (LIKE testpub_parted);
--dg-cascade
--dg CREATE TABLE testpub_parted2 (LIKE testpub_parted);
--dg-skip: publications are not supported
--dg ALTER PUBLICATION testpub_forparted1 SET (publish='insert');
--dg-cascade
--dg ALTER TABLE testpub_parted ATTACH PARTITION testpub_parted1 FOR VALUES IN (1);
--dg-cascade
--dg ALTER TABLE testpub_parted ATTACH PARTITION testpub_parted2 FOR VALUES IN (2);
-- works despite missing REPLICA IDENTITY, because updates are not replicated
--dg-cascade
--dg UPDATE testpub_parted1 SET a = 1;
-- only parent is listed as being in publication, not the partition
--dg-skip: publications are not supported
--dg ALTER PUBLICATION testpub_forparted ADD TABLE testpub_parted;
--dg-cascade
--dg \dRp+ testpub_forparted
-- works despite missing REPLICA IDENTITY, because no actual update happened
--dg-cascade
--dg UPDATE testpub_parted SET a = 1 WHERE false;
-- should now fail, because parent's publication replicates updates
--dg-cascade
--dg UPDATE testpub_parted1 SET a = 1;
--dg-cascade
--dg ALTER TABLE testpub_parted DETACH PARTITION testpub_parted1;
-- works again, because parent's publication is no longer considered
--dg-cascade
--dg UPDATE testpub_parted1 SET a = 1;
--dg-skip: publications are not supported
--dg ALTER PUBLICATION testpub_forparted SET (publish_via_partition_root = true);
--dg-cascade
--dg \dRp+ testpub_forparted
-- still fail, because parent's publication replicates updates
--dg-cascade
--dg UPDATE testpub_parted2 SET a = 2;
--dg-skip: publications are not supported
--dg ALTER PUBLICATION testpub_forparted DROP TABLE testpub_parted;
-- works again, because update is no longer replicated
--dg-cascade
--dg UPDATE testpub_parted2 SET a = 2;
--dg-cascade
--dg DROP TABLE testpub_parted1, testpub_parted2;
--dg-skip: publications are not supported
--dg DROP PUBLICATION testpub_forparted, testpub_forparted1;
