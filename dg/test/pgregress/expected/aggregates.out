-- test aggregates with common transition functions share the same states
begin work;
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type avg_state as (total bigint, count bigint);
--dg-cascade
--dg create or replace function avg_transfn(state avg_state, n int) returns avg_state as
--dg $$
--dg declare new_state avg_state;
--dg begin
--dg 	raise notice 'avg_transfn called with %', n;
--dg 	if state is null then
--dg 		if n is not null then
--dg 			new_state.total := n;
--dg 			new_state.count := 1;
--dg 			return new_state;
--dg 		end if;
--dg 		return null;
--dg 	elsif n is not null then
--dg 		state.total := state.total + n;
--dg 		state.count := state.count + 1;
--dg 		return state;
--dg 	end if;
--dg
--dg 	return null;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg create function avg_finalfn(state avg_state) returns int4 as
--dg $$
--dg begin
--dg 	if state is null then
--dg 		return NULL;
--dg 	else
--dg 		return state.total / state.count;
--dg 	end if;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg create function sum_finalfn(state avg_state) returns int4 as
--dg $$
--dg begin
--dg 	if state is null then
--dg 		return NULL;
--dg 	else
--dg 		return state.total;
--dg 	end if;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg create aggregate my_avg(int4)
--dg (
--dg    stype = avg_state,
--dg    sfunc = avg_transfn,
--dg    finalfunc = avg_finalfn
--dg );
--dg-cascade
--dg create aggregate my_sum(int4)
--dg (
--dg    stype = avg_state,
--dg    sfunc = avg_transfn,
--dg    finalfunc = sum_finalfn
--dg );
-- aggregate state should be shared as aggs are the same.
--dg-cascade
--dg select my_avg(one),my_avg(one) from (values(1),(3)) t(one);
-- aggregate state should be shared as transfn is the same for both aggs.
--dg-cascade
--dg select my_avg(one),my_sum(one) from (values(1),(3)) t(one);
-- same as previous one, but with DISTINCT, which requires sorting the input.
--dg-cascade
--dg select my_avg(distinct one),my_sum(distinct one) from (values(1),(3),(1)) t(one);
-- shouldn't share states due to the distinctness not matching.
--dg-cascade
--dg select my_avg(distinct one),my_sum(one) from (values(1),(3)) t(one);
-- shouldn't share states due to the filter clause not matching.
--dg-cascade
--dg select my_avg(one) filter (where one > 1),my_sum(one) from (values(1),(3)) t(one);
-- this should not share the state due to different input columns.
--dg-cascade
--dg select my_avg(one),my_sum(two) from (values(1,2),(3,4)) t(one,two);
-- exercise cases where OSAs share state
--dg-cascade
--dg select
--dg   percentile_cont(0.5) within group (order by a),
--dg   percentile_disc(0.5) within group (order by a)
--dg from (values(1::float8),(3),(5),(7)) t(a);
--dg-cascade
--dg select
--dg   percentile_cont(0.25) within group (order by a),
--dg   percentile_disc(0.5) within group (order by a)
--dg from (values(1::float8),(3),(5),(7)) t(a);
-- these can't share state currently
--dg-cascade
--dg select
--dg   rank(4) within group (order by a),
--dg   dense_rank(4) within group (order by a)
--dg from (values(1),(3),(5),(7)) t(a);
-- test that aggs with the same sfunc and initcond share the same agg state
--dg-cascade
--dg create aggregate my_sum_init(int4)
--dg (
--dg    stype = avg_state,
--dg    sfunc = avg_transfn,
--dg    finalfunc = sum_finalfn,
--dg    initcond = '(10,0)'
--dg );
--dg-cascade
--dg create aggregate my_avg_init(int4)
--dg (
--dg    stype = avg_state,
--dg    sfunc = avg_transfn,
--dg    finalfunc = avg_finalfn,
--dg    initcond = '(10,0)'
--dg );
--dg-cascade
--dg create aggregate my_avg_init2(int4)
--dg (
--dg    stype = avg_state,
--dg    sfunc = avg_transfn,
--dg    finalfunc = avg_finalfn,
--dg    initcond = '(4,0)'
--dg );
-- state should be shared if INITCONDs are matching
--dg-cascade
--dg select my_sum_init(one),my_avg_init(one) from (values(1),(3)) t(one);
-- Varying INITCONDs should cause the states not to be shared.
--dg-cascade
--dg select my_sum_init(one),my_avg_init2(one) from (values(1),(3)) t(one);
rollback;
-- test aggregate state sharing to ensure it works if one aggregate has a
-- finalfn and the other one has none.
begin work;
--dg-skip: language "?" does not exist
--dg create or replace function sum_transfn(state int4, n int4) returns int4 as
--dg $$
--dg declare new_state int4;
--dg begin
--dg 	raise notice 'sum_transfn called with %', n;
--dg 	if state is null then
--dg 		if n is not null then
--dg 			new_state := n;
--dg 			return new_state;
--dg 		end if;
--dg 		return null;
--dg 	elsif n is not null then
--dg 		state := state + n;
--dg 		return state;
--dg 	end if;
--dg
--dg 	return null;
--dg end
--dg $$ language plpgsql;
--dg-skip: language "?" does not exist
--dg create function halfsum_finalfn(state int4) returns int4 as
--dg $$
--dg begin
--dg 	if state is null then
--dg 		return NULL;
--dg 	else
--dg 		return state / 2;
--dg 	end if;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg create aggregate my_sum(int4)
--dg (
--dg    stype = int4,
--dg    sfunc = sum_transfn
--dg );
--dg-cascade
--dg create aggregate my_half_sum(int4)
--dg (
--dg    stype = int4,
--dg    sfunc = sum_transfn,
--dg    finalfunc = halfsum_finalfn
--dg );
-- Agg state should be shared even though my_sum has no finalfn
--dg-cascade
--dg select my_sum(one),my_half_sum(one) from (values(1),(2),(3),(4)) t(one);
rollback;
-- test that the aggregate transition logic correctly handles
-- transition / combine functions returning NULL
-- First test the case of a normal transition function returning NULL
BEGIN;
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION balkifnull(int8, int4)
--dg RETURNS int8
--dg STRICT
--dg LANGUAGE plpgsql AS $$
--dg BEGIN
--dg     IF $1 IS NULL THEN
--dg        RAISE 'erroneously called with NULL argument';
--dg     END IF;
--dg     RETURN NULL;
--dg END$$;
--dg-cascade
--dg CREATE AGGREGATE balk(int4)
--dg (
--dg     SFUNC = balkifnull(int8, int4),
--dg     STYPE = int8,
--dg     PARALLEL = SAFE,
--dg     INITCOND = '0'
--dg );
--dg-cascade
