--dg select * from WSlot where roomno = '001' order by slotname;
--dg-cascade
--dg select * from PSlot where slotname ~ 'PS.base.a' order by slotname;
update WSlot set backlink = 'PS.base.a5' where slotname = 'WS.001.3a';
--dg-cascade
--dg select * from WSlot where roomno = '001' order by slotname;
--dg-cascade
--dg select * from PSlot where slotname ~ 'PS.base.a' order by slotname;
