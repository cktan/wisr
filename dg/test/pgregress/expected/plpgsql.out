-- Test re-RAISE inside a nested exception block.  This case is allowed
-- by Oracle's PL/SQL but was handled differently by PG before 9.1.
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION reraise_test() RETURNS void AS $$
--dg BEGIN
--dg    BEGIN
--dg        RAISE syntax_error;
--dg    EXCEPTION
--dg        WHEN syntax_error THEN
--dg            BEGIN
--dg                raise notice 'exception % thrown in inner block, reraising', sqlerrm;
--dg                RAISE;
--dg            EXCEPTION
--dg                WHEN OTHERS THEN
--dg                    raise notice 'RIGHT - exception % caught in inner block', sqlerrm;
--dg            END;
--dg    END;
--dg EXCEPTION
--dg    WHEN OTHERS THEN
--dg        raise notice 'WRONG - exception % caught in outer block', sqlerrm;
--dg END;
--dg $$ LANGUAGE plpgsql;
--dg-cascade
--dg SELECT reraise_test();
