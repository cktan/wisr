--dg   raise notice 'x.f1 = %, x.f2 = %', x.f1, x.f2;
--dg end$$ language plpgsql;
--dg-cascade
--dg select stricttest();
--dg-skip: language "?" does not exist
--dg create or replace function stricttest() returns void as $$
--dg declare x record;
--dg begin
--dg   -- this should work since EXECUTE isn't as picky
--dg   execute 'insert into foo values(7,8),(9,10) returning *' into x;
--dg   raise notice 'x.f1 = %, x.f2 = %', x.f1, x.f2;
--dg end$$ language plpgsql;
--dg-cascade
--dg select stricttest();
--dg-cascade
--dg select * from foo;
