-- ************************************************************
-- * AFTER INSERT or UPDATE or DELETE on slot with backlink
-- *	- Ensure that the opponent correctly points back to us
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_backlink_a() returns trigger as '
--dg declare
--dg     dummy	integer;
--dg begin
--dg     if tg_op = ''INSERT'' then
--dg         if new.backlink != '''' then
--dg 	    dummy := tg_backlink_set(new.backlink, new.slotname);
--dg 	end if;
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''UPDATE'' then
--dg         if new.backlink != old.backlink then
--dg 	    if old.backlink != '''' then
--dg 	        dummy := tg_backlink_unset(old.backlink, old.slotname);
--dg 	    end if;
--dg 	    if new.backlink != '''' then
--dg 	        dummy := tg_backlink_set(new.backlink, new.slotname);
--dg 	    end if;
--dg 	else
--dg 	    if new.slotname != old.slotname and new.backlink != '''' then
--dg 	        dummy := tg_slotlink_set(new.backlink, new.slotname);
--dg 	    end if;
--dg 	end if;
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''DELETE'' then
--dg         if old.backlink != '''' then
--dg 	    dummy := tg_backlink_unset(old.backlink, old.slotname);
--dg 	end if;
--dg 	return old;
--dg     end if;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_backlink_a after insert or update or delete
--dg     on PSlot for each row execute procedure tg_backlink_a('PS');
--dg-cascade
--dg create trigger tg_backlink_a after insert or update or delete
--dg     on WSlot for each row execute procedure tg_backlink_a('WS');
--dg-cascade
--dg create trigger tg_backlink_a after insert or update or delete
--dg     on PLine for each row execute procedure tg_backlink_a('PL');
-- ************************************************************
-- * Support function to set the opponents backlink field
-- * if it does not already point to the requested slot
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_backlink_set(myname bpchar, blname bpchar)
--dg returns integer as '
--dg declare
--dg     mytype	char(2);
--dg     link	char(4);
--dg     rec		record;
--dg begin
--dg     mytype := substr(myname, 1, 2);
--dg     link := mytype || substr(blname, 1, 2);
--dg     if link = ''PLPL'' then
--dg         raise exception
--dg 		''backlink between two phone lines does not make sense'';
--dg     end if;
--dg     if link in (''PLWS'', ''WSPL'') then
--dg         raise exception
--dg 		''direct link of phone line to wall slot not permitted'';
--dg     end if;
--dg     if mytype = ''PS'' then
--dg         select into rec * from PSlot where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.backlink != blname then
--dg 	    update PSlot set backlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''WS'' then
--dg         select into rec * from WSlot where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.backlink != blname then
--dg 	    update WSlot set backlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''PL'' then
--dg         select into rec * from PLine where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.backlink != blname then
--dg 	    update PLine set backlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     raise exception ''illegal backlink beginning with %'', mytype;
--dg end;
--dg ' language plpgsql;
-- ************************************************************
-- * Support function to clear out the backlink field if
-- * it still points to specific slot
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_backlink_unset(bpchar, bpchar)
--dg returns integer as '
--dg declare
--dg     myname	alias for $1;
--dg     blname	alias for $2;
--dg     mytype	char(2);
--dg     rec		record;
--dg begin
--dg     mytype := substr(myname, 1, 2);
--dg     if mytype = ''PS'' then
--dg         select into rec * from PSlot where slotname = myname;
--dg 	if not found then
--dg 	    return 0;
--dg 	end if;
--dg 	if rec.backlink = blname then
--dg 	    update PSlot set backlink = '''' where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''WS'' then
--dg         select into rec * from WSlot where slotname = myname;
--dg 	if not found then
--dg 	    return 0;
--dg 	end if;
--dg 	if rec.backlink = blname then
--dg 	    update WSlot set backlink = '''' where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''PL'' then
--dg         select into rec * from PLine where slotname = myname;
--dg 	if not found then
--dg 	    return 0;
--dg 	end if;
--dg 	if rec.backlink = blname then
--dg 	    update PLine set backlink = '''' where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg end
--dg ' language plpgsql;
-- ************************************************************
-- * AFTER INSERT or UPDATE or DELETE on slot with slotlink
-- *	- Ensure that the opponent correctly points back to us
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_slotlink_a() returns trigger as '
--dg declare
--dg     dummy	integer;
--dg begin
--dg     if tg_op = ''INSERT'' then
--dg         if new.slotlink != '''' then
--dg 	    dummy := tg_slotlink_set(new.slotlink, new.slotname);
--dg 	end if;
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''UPDATE'' then
--dg         if new.slotlink != old.slotlink then
--dg 	    if old.slotlink != '''' then
--dg 	        dummy := tg_slotlink_unset(old.slotlink, old.slotname);
--dg 	    end if;
--dg 	    if new.slotlink != '''' then
--dg 	        dummy := tg_slotlink_set(new.slotlink, new.slotname);
--dg 	    end if;
--dg 	else
--dg 	    if new.slotname != old.slotname and new.slotlink != '''' then
--dg 	        dummy := tg_slotlink_set(new.slotlink, new.slotname);
--dg 	    end if;
--dg 	end if;
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''DELETE'' then
--dg         if old.slotlink != '''' then
--dg 	    dummy := tg_slotlink_unset(old.slotlink, old.slotname);
--dg 	end if;
--dg 	return old;
--dg     end if;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_slotlink_a after insert or update or delete
--dg     on PSlot for each row execute procedure tg_slotlink_a('PS');
--dg-cascade
--dg create trigger tg_slotlink_a after insert or update or delete
--dg     on WSlot for each row execute procedure tg_slotlink_a('WS');
--dg-cascade
--dg create trigger tg_slotlink_a after insert or update or delete
--dg     on IFace for each row execute procedure tg_slotlink_a('IF');
--dg-cascade
--dg create trigger tg_slotlink_a after insert or update or delete
--dg     on HSlot for each row execute procedure tg_slotlink_a('HS');
--dg-cascade
--dg create trigger tg_slotlink_a after insert or update or delete
--dg     on PHone for each row execute procedure tg_slotlink_a('PH');
-- ************************************************************
-- * Support function to set the opponents slotlink field
-- * if it does not already point to the requested slot
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_slotlink_set(bpchar, bpchar)
--dg returns integer as '
--dg declare
--dg     myname	alias for $1;
--dg     blname	alias for $2;
--dg     mytype	char(2);
--dg     link	char(4);
--dg     rec		record;
--dg begin
--dg     mytype := substr(myname, 1, 2);
--dg     link := mytype || substr(blname, 1, 2);
--dg     if link = ''PHPH'' then
--dg         raise exception
--dg 		''slotlink between two phones does not make sense'';
--dg     end if;
--dg     if link in (''PHHS'', ''HSPH'') then
--dg         raise exception
--dg 		''link of phone to hub does not make sense'';
--dg     end if;
--dg     if link in (''PHIF'', ''IFPH'') then
--dg         raise exception
--dg 		''link of phone to hub does not make sense'';
--dg     end if;
--dg     if link in (''PSWS'', ''WSPS'') then
--dg         raise exception
--dg 		''slotlink from patchslot to wallslot not permitted'';
--dg     end if;
--dg     if mytype = ''PS'' then
--dg         select into rec * from PSlot where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.slotlink != blname then
--dg 	    update PSlot set slotlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''WS'' then
--dg         select into rec * from WSlot where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.slotlink != blname then
--dg 	    update WSlot set slotlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''IF'' then
--dg         select into rec * from IFace where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.slotlink != blname then
--dg 	    update IFace set slotlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''HS'' then
--dg         select into rec * from HSlot where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.slotlink != blname then
--dg 	    update HSlot set slotlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     if mytype = ''PH'' then
--dg         select into rec * from PHone where slotname = myname;
--dg 	if not found then
--dg 	    raise exception ''% does not exist'', myname;
--dg 	end if;
--dg 	if rec.slotlink != blname then
--dg 	    update PHone set slotlink = blname where slotname = myname;
--dg 	end if;
--dg 	return 0;
--dg     end if;
--dg     raise exception ''illegal slotlink beginning with %'', mytype;
--dg end;
--dg ' language plpgsql;
