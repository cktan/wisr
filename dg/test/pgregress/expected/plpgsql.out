-- test FOR-over-cursor
--dg-skip: language "?" does not exist
--dg create or replace function forc01() returns void as $$
--dg declare
--dg   c cursor(r1 integer, r2 integer)
--dg        for select * from generate_series(r1,r2) i;
--dg   c2 cursor
--dg        for select * from generate_series(41,43) i;
--dg begin
--dg   -- assign portal names to cursors to get stable output
--dg   c := 'c';
--dg   c2 := 'c2';
--dg   for r in c(5,7) loop
--dg     raise notice '% from %', r.i, c;
--dg   end loop;
--dg   -- again, to test if cursor was closed properly
--dg   -- (and while we're at it, test named-parameter notation)
--dg   for r in c(r2 := 10, r1 => 9) loop
--dg     raise notice '% from %', r.i, c;
--dg   end loop;
--dg   -- and test a parameterless cursor
--dg   for r in c2 loop
--dg     raise notice '% from %', r.i, c2;
--dg   end loop;
--dg   -- and try it with a hand-assigned name
--dg   raise notice 'after loop, c2 = %', c2;
--dg   c2 := 'special_name';
--dg   for r in c2 loop
--dg     raise notice '% from %', r.i, c2;
--dg   end loop;
--dg   raise notice 'after loop, c2 = %', c2;
--dg   -- and try it with a generated name
--dg   -- (which we can't show in the output because it's variable)
--dg   c2 := null;
--dg   for r in c2 loop
--dg     raise notice '%', r.i;
--dg   end loop;
--dg   raise notice 'after loop, c2 = %', c2;
--dg   return;
--dg end;
--dg $$ language plpgsql;
--dg-cascade
--dg select forc01();
