CREATE TABLE transition_table_base (id int PRIMARY KEY, val text);
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION transition_table_base_ins_func()
--dg   RETURNS trigger
--dg   LANGUAGE plpgsql
--dg AS $$
--dg DECLARE
--dg   t text;
--dg   l text;
--dg BEGIN
--dg   t = '';
--dg   FOR l IN EXECUTE
--dg            $q$
--dg              EXPLAIN (TIMING off, COSTS off, VERBOSE on)
--dg              SELECT * FROM newtable
--dg            $q$ LOOP
--dg     t = t || l || E'\n';
--dg   END LOOP;
--dg
--dg   RAISE INFO '%', t;
--dg   RETURN new;
--dg END;
--dg $$;
CREATE TRIGGER transition_table_base_ins_trig
  AFTER INSERT ON transition_table_base
  REFERENCING OLD TABLE AS oldtable NEW TABLE AS newtable
  FOR EACH STATEMENT
  EXECUTE PROCEDURE transition_table_base_ins_func();
