--
-- EXECUTE ... INTO test
--
create table eifoo (i integer, y integer);
--dg-skip: a relation's storage cannot be made: digres has no catalog tables
--dg create type eitype as (i integer, y integer);
--dg-skip: language "?" does not exist
--dg create or replace function execute_into_test(varchar) returns record as $$
--dg declare
--dg     _r record;
--dg     _rt eifoo%rowtype;
--dg     _v eitype;
--dg     i int;
--dg     j int;
--dg     k int;
--dg begin
--dg     execute 'insert into '||$1||' values(10,15)';
--dg     execute 'select (row).* from (select row(10,1)::eifoo) s' into _r;
--dg     raise notice '% %', _r.i, _r.y;
--dg     execute 'select * from '||$1||' limit 1' into _rt;
--dg     raise notice '% %', _rt.i, _rt.y;
--dg     execute 'select *, 20 from '||$1||' limit 1' into i, j, k;
--dg     raise notice '% % %', i, j, k;
--dg     execute 'select 1,2' into _v;
--dg     return _v;
--dg end; $$ language plpgsql;
--dg-cascade
--dg select execute_into_test('eifoo');
drop table eifoo cascade;
--dg-cascade
--dg drop type eitype cascade;
