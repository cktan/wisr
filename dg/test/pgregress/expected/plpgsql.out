-- ************************************************************
-- * BEFORE UPDATE on PSlot
-- *	- do delete/insert instead of update if name changes
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_pslot_bu() returns trigger as '
--dg begin
--dg     if new.slotname != old.slotname then
--dg         delete from PSlot where slotname = old.slotname;
--dg 	insert into PSlot (
--dg 		    slotname,
--dg 		    pfname,
--dg 		    slotlink,
--dg 		    backlink
--dg 		) values (
--dg 		    new.slotname,
--dg 		    new.pfname,
--dg 		    new.slotlink,
--dg 		    new.backlink
--dg 		);
--dg         return null;
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_pslot_bu before update
--dg     on PSlot for each row execute procedure tg_pslot_bu();
