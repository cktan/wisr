--
-- Test recursion, per bug report 7-Sep-01
--
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION recursion_test(int,int) RETURNS text AS '
--dg DECLARE rslt text;
--dg BEGIN
--dg     IF $1 <= 0 THEN
--dg         rslt = CAST($2 AS TEXT);
--dg     ELSE
--dg         rslt = CAST($1 AS TEXT) || '','' || recursion_test($1 - 1, $2);
--dg     END IF;
--dg     RETURN rslt;
--dg END;' LANGUAGE plpgsql;
--dg-cascade
--dg SELECT recursion_test(4,3);
--
-- Test the FOUND magic variable
--
CREATE TABLE found_test_tbl (a int);
--dg-skip: language "?" does not exist
--dg create function test_found()
--dg   returns boolean as '
--dg   declare
--dg   begin
--dg   insert into found_test_tbl values (1);
--dg   if FOUND then
--dg      insert into found_test_tbl values (2);
--dg   end if;
--dg
--dg   update found_test_tbl set a = 100 where a = 1;
--dg   if FOUND then
--dg     insert into found_test_tbl values (3);
--dg   end if;
--dg
--dg   delete from found_test_tbl where a = 9999; -- matches no rows
--dg   if not FOUND then
--dg     insert into found_test_tbl values (4);
--dg   end if;
--dg
--dg   for i in 1 .. 10 loop
--dg     -- no need to do anything
--dg   end loop;
--dg   if FOUND then
--dg     insert into found_test_tbl values (5);
--dg   end if;
--dg
--dg   -- never executes the loop
--dg   for i in 2 .. 1 loop
--dg     -- no need to do anything
--dg   end loop;
--dg   if not FOUND then
--dg     insert into found_test_tbl values (6);
--dg   end if;
--dg   return true;
--dg   end;' language plpgsql;
--dg-cascade
--dg select test_found();
--dg-cascade
--dg select * from found_test_tbl;
