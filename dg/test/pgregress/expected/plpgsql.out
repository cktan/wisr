-- regression test: verify that multiple uses of same plpgsql datum within
-- a SQL command all get mapped to the same $n parameter.  The return value
-- of the SELECT is not important, we only care that it doesn't fail with
-- a complaint about an ungrouped column reference.
--dg-skip: language "?" does not exist
--dg create function multi_datum_use(p1 int) returns bool as $$
--dg declare
--dg   x int;
--dg   y int;
--dg begin
--dg   select into x,y unique1/p1, unique1/$1 from tenk1 group by unique1/p1;
--dg   return x = y;
--dg end$$ language plpgsql;
--dg-cascade
--dg select multi_datum_use(42);
--
-- Test STRICT limiter in both planned and EXECUTE invocations.
-- Note that a data-modifying query is quasi strict (disallow multi rows)
-- by default in the planned case, but not in EXECUTE.
--
create temp table foo (f1 int, f2 int);
insert into foo values (1,2), (3,4);
--dg-skip: language "?" does not exist
--dg create or replace function stricttest() returns void as $$
--dg declare x record;
--dg begin
--dg   -- should work
--dg   insert into foo values(5,6) returning * into x;
--dg   raise notice 'x.f1 = %, x.f2 = %', x.f1, x.f2;
--dg end$$ language plpgsql;
--dg-cascade
--dg select stricttest();
--dg-skip: language "?" does not exist
--dg create or replace function stricttest() returns void as $$
--dg declare x record;
--dg begin
--dg   -- should fail due to implicit strict
--dg   insert into foo values(7,8),(9,10) returning * into x;
--dg   raise notice 'x.f1 = %, x.f2 = %', x.f1, x.f2;
--dg end$$ language plpgsql;
--dg-cascade
--dg select stricttest();
--dg-skip: language "?" does not exist
--dg create or replace function stricttest() returns void as $$
--dg declare x record;
--dg begin
--dg   -- should work
