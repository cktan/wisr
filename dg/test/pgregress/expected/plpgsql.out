--
-- PLPGSQL
--
-- Scenario:
--
--     A building with a modern TP cable installation where any
--     of the wall connectors can be used to plug in phones,
--     ethernet interfaces or local office hubs. The backside
--     of the wall connectors is wired to one of several patch-
--     fields in the building.
--
--     In the patchfields, there are hubs and all the slots
--     representing the wall connectors. In addition there are
--     slots that can represent a phone line from the central
--     phone system.
--
--     Triggers ensure consistency of the patching information.
--
--     Functions are used to build up powerful views that let
--     you look behind the wall when looking at a patchfield
--     or into a room.
--
create table Room (
    roomno	char(8),
    comment	text
);
create unique index Room_rno on Room using btree (roomno bpchar_ops);
create table WSlot (
    slotname	char(20),
    roomno	char(8),
    slotlink	char(20),
    backlink	char(20)
);
create unique index WSlot_name on WSlot using btree (slotname bpchar_ops);
create table PField (
    name	text,
    comment	text
);
create unique index PField_name on PField using btree (name text_ops);
create table PSlot (
    slotname	char(20),
    pfname	text,
    slotlink	char(20),
    backlink	char(20)
);
create unique index PSlot_name on PSlot using btree (slotname bpchar_ops);
create table PLine (
    slotname	char(20),
    phonenumber	char(20),
    comment	text,
    backlink	char(20)
);
create unique index PLine_name on PLine using btree (slotname bpchar_ops);
create table Hub (
    name	char(14),
    comment	text,
    nslots	integer
);
create unique index Hub_name on Hub using btree (name bpchar_ops);
create table HSlot (
    slotname	char(20),
    hubname	char(14),
    slotno	integer,
    slotlink	char(20)
);
create unique index HSlot_name on HSlot using btree (slotname bpchar_ops);
create index HSlot_hubname on HSlot using btree (hubname bpchar_ops);
create table System (
    name	text,
    comment	text
);
create unique index System_name on System using btree (name text_ops);
create table IFace (
    slotname	char(20),
    sysname	text,
    ifname	text,
    slotlink	char(20)
);
create unique index IFace_name on IFace using btree (slotname bpchar_ops);
create table PHone (
    slotname	char(20),
    comment	text,
    slotlink	char(20)
);
create unique index PHone_name on PHone using btree (slotname bpchar_ops);
-- ************************************************************
-- *
-- * Trigger procedures and functions for the patchfield
-- * test of PL/pgSQL
-- *
-- ************************************************************
-- ************************************************************
-- * AFTER UPDATE on Room
-- *	- If room no changes let wall slots follow
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_room_au() returns trigger as '
--dg begin
--dg     if new.roomno != old.roomno then
--dg         update WSlot set roomno = new.roomno where roomno = old.roomno;
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_room_au after update
--dg     on Room for each row execute procedure tg_room_au();
-- ************************************************************
-- * AFTER DELETE on Room
-- *	- delete wall slots in this room
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_room_ad() returns trigger as '
--dg begin
--dg     delete from WSlot where roomno = old.roomno;
--dg     return old;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_room_ad after delete
--dg     on Room for each row execute procedure tg_room_ad();
-- ************************************************************
-- * BEFORE INSERT or UPDATE on WSlot
-- *	- Check that room exists
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_wslot_biu() returns trigger as $$
--dg begin
--dg     if count(*) = 0 from Room where roomno = new.roomno then
--dg         raise exception 'Room % does not exist', new.roomno;
--dg     end if;
--dg     return new;
--dg end;
--dg $$ language plpgsql;
--dg-cascade
--dg create trigger tg_wslot_biu before insert or update
--dg     on WSlot for each row execute procedure tg_wslot_biu();
-- ************************************************************
-- * AFTER UPDATE on PField
-- *	- Let PSlots of this field follow
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_pfield_au() returns trigger as '
--dg begin
--dg     if new.name != old.name then
--dg         update PSlot set pfname = new.name where pfname = old.name;
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_pfield_au after update
--dg     on PField for each row execute procedure tg_pfield_au();
-- ************************************************************
-- * AFTER DELETE on PField
-- *	- Remove all slots of this patchfield
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_pfield_ad() returns trigger as '
--dg begin
--dg     delete from PSlot where pfname = old.name;
--dg     return old;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_pfield_ad after delete
--dg     on PField for each row execute procedure tg_pfield_ad();
-- ************************************************************
-- * BEFORE INSERT or UPDATE on PSlot
-- *	- Ensure that our patchfield does exist
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_pslot_biu() returns trigger as $proc$
--dg declare
--dg     pfrec	record;
--dg     ps          alias for new;
--dg begin
--dg     select into pfrec * from PField where name = ps.pfname;
--dg     if not found then
--dg         raise exception $$Patchfield "%" does not exist$$, ps.pfname;
--dg     end if;
--dg     return ps;
--dg end;
--dg $proc$ language plpgsql;
--dg-cascade
--dg create trigger tg_pslot_biu before insert or update
--dg     on PSlot for each row execute procedure tg_pslot_biu();
-- ************************************************************
-- * AFTER UPDATE on System
-- *	- If system name changes let interfaces follow
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_system_au() returns trigger as '
--dg begin
--dg     if new.name != old.name then
--dg         update IFace set sysname = new.name where sysname = old.name;
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_system_au after update
--dg     on System for each row execute procedure tg_system_au();
-- ************************************************************
-- * BEFORE INSERT or UPDATE on IFace
-- *	- set the slotname to IF.sysname.ifname
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_iface_biu() returns trigger as $$
--dg declare
--dg     sname	text;
--dg     sysrec	record;
--dg begin
--dg     select into sysrec * from system where name = new.sysname;
--dg     if not found then
--dg         raise exception $q$system "%" does not exist$q$, new.sysname;
--dg     end if;
--dg     sname := 'IF.' || new.sysname;
--dg     sname := sname || '.';
--dg     sname := sname || new.ifname;
--dg     if length(sname) > 20 then
--dg         raise exception 'IFace slotname "%" too long (20 char max)', sname;
--dg     end if;
--dg     new.slotname := sname;
--dg     return new;
--dg end;
--dg $$ language plpgsql;
--dg-cascade
--dg create trigger tg_iface_biu before insert or update
--dg     on IFace for each row execute procedure tg_iface_biu();
-- ************************************************************
-- * AFTER INSERT or UPDATE or DELETE on Hub
-- *	- insert/delete/rename slots as required
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_hub_a() returns trigger as '
--dg declare
--dg     hname	text;
--dg     dummy	integer;
--dg begin
--dg     if tg_op = ''INSERT'' then
--dg 	dummy := tg_hub_adjustslots(new.name, 0, new.nslots);
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''UPDATE'' then
--dg 	if new.name != old.name then
--dg 	    update HSlot set hubname = new.name where hubname = old.name;
--dg 	end if;
--dg 	dummy := tg_hub_adjustslots(new.name, old.nslots, new.nslots);
--dg 	return new;
--dg     end if;
--dg     if tg_op = ''DELETE'' then
--dg 	dummy := tg_hub_adjustslots(old.name, old.nslots, 0);
--dg 	return old;
--dg     end if;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_hub_a after insert or update or delete
--dg     on Hub for each row execute procedure tg_hub_a();
-- ************************************************************
-- * Support function to add/remove slots of Hub
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_hub_adjustslots(hname bpchar,
--dg                                    oldnslots integer,
--dg                                    newnslots integer)
--dg returns integer as '
--dg begin
--dg     if newnslots = oldnslots then
--dg         return 0;
--dg     end if;
--dg     if newnslots < oldnslots then
--dg         delete from HSlot where hubname = hname and slotno > newnslots;
--dg 	return 0;
--dg     end if;
--dg     for i in oldnslots + 1 .. newnslots loop
--dg         insert into HSlot (slotname, hubname, slotno, slotlink)
--dg 		values (''HS.dummy'', hname, i, '''');
--dg     end loop;
--dg     return 0;
--dg end
--dg ' language plpgsql;
-- Test comments
COMMENT ON FUNCTION tg_hub_adjustslots_wrong(bpchar, integer, integer) IS 'function with args';
ERROR:  function tg_hub_adjustslots_wrong(character, integer, integer) does not exist
--dg-cascade
--dg COMMENT ON FUNCTION tg_hub_adjustslots(bpchar, integer, integer) IS 'function with args';
--dg-cascade
--dg COMMENT ON FUNCTION tg_hub_adjustslots(bpchar, integer, integer) IS NULL;
-- ************************************************************
-- * BEFORE INSERT or UPDATE on HSlot
-- *	- prevent from manual manipulation
-- *	- set the slotname to HS.hubname.slotno
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_hslot_biu() returns trigger as '
--dg declare
--dg     sname	text;
--dg     xname	HSlot.slotname%TYPE;
--dg     hubrec	record;
--dg begin
--dg     select into hubrec * from Hub where name = new.hubname;
--dg     if not found then
--dg         raise exception ''no manual manipulation of HSlot'';
--dg     end if;
--dg     if new.slotno < 1 or new.slotno > hubrec.nslots then
--dg         raise exception ''no manual manipulation of HSlot'';
--dg     end if;
--dg     if tg_op = ''UPDATE'' and new.hubname != old.hubname then
--dg 	if count(*) > 0 from Hub where name = old.hubname then
--dg 	    raise exception ''no manual manipulation of HSlot'';
--dg 	end if;
--dg     end if;
--dg     sname := ''HS.'' || trim(new.hubname);
--dg     sname := sname || ''.'';
--dg     sname := sname || new.slotno::text;
--dg     if length(sname) > 20 then
--dg         raise exception ''HSlot slotname "%" too long (20 char max)'', sname;
--dg     end if;
--dg     new.slotname := sname;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_hslot_biu before insert or update
--dg     on HSlot for each row execute procedure tg_hslot_biu();
-- ************************************************************
-- * BEFORE DELETE on HSlot
-- *	- prevent from manual manipulation
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_hslot_bd() returns trigger as '
--dg declare
--dg     hubrec	record;
--dg begin
--dg     select into hubrec * from Hub where name = old.hubname;
--dg     if not found then
--dg         return old;
--dg     end if;
--dg     if old.slotno > hubrec.nslots then
--dg         return old;
--dg     end if;
--dg     raise exception ''no manual manipulation of HSlot'';
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_hslot_bd before delete
--dg     on HSlot for each row execute procedure tg_hslot_bd();
-- ************************************************************
-- * BEFORE INSERT on all slots
-- *	- Check name prefix
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_chkslotname() returns trigger as '
--dg begin
--dg     if substr(new.slotname, 1, 2) != tg_argv[0] then
--dg         raise exception ''slotname must begin with %'', tg_argv[0];
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_chkslotname before insert
--dg     on PSlot for each row execute procedure tg_chkslotname('PS');
--dg-cascade
--dg create trigger tg_chkslotname before insert
--dg     on WSlot for each row execute procedure tg_chkslotname('WS');
--dg-cascade
--dg create trigger tg_chkslotname before insert
--dg     on PLine for each row execute procedure tg_chkslotname('PL');
--dg-cascade
--dg create trigger tg_chkslotname before insert
--dg     on IFace for each row execute procedure tg_chkslotname('IF');
--dg-cascade
--dg create trigger tg_chkslotname before insert
--dg     on PHone for each row execute procedure tg_chkslotname('PH');
-- ************************************************************
-- * BEFORE INSERT or UPDATE on all slots with slotlink
-- *	- Set slotlink to empty string if NULL value given
-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function tg_chkslotlink() returns trigger as '
--dg begin
--dg     if new.slotlink isnull then
--dg         new.slotlink := '''';
--dg     end if;
--dg     return new;
--dg end;
--dg ' language plpgsql;
--dg-cascade
--dg create trigger tg_chkslotlink before insert or update
--dg     on PSlot for each row execute procedure tg_chkslotlink();
--dg-cascade
--dg create trigger tg_chkslotlink before insert or update
--dg     on WSlot for each row execute procedure tg_chkslotlink();
--dg-cascade
--dg create trigger tg_chkslotlink before insert or update
--dg     on IFace for each row execute procedure tg_chkslotlink();
--dg-cascade
--dg create trigger tg_chkslotlink before insert or update
--dg     on HSlot for each row execute procedure tg_chkslotlink();
--dg-cascade
--dg create trigger tg_chkslotlink before insert or update
--dg     on PHone for each row execute procedure tg_chkslotlink();
