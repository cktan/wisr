-- ************************************************************
--dg-skip: language "?" does not exist
--dg create function pslot_backlink_view(bpchar)
--dg returns text as '
--dg <<outer>>
--dg declare
--dg     rec		record;
--dg     bltype	char(2);
--dg     retval	text;
--dg begin
--dg     select into rec * from PSlot where slotname = $1;
--dg     if not found then
--dg         return '''';
--dg     end if;
--dg     if rec.backlink = '''' then
--dg         return ''-'';
--dg     end if;
--dg     bltype := substr(rec.backlink, 1, 2);
--dg     if bltype = ''PL'' then
--dg         declare
--dg 	    rec		record;
--dg 	begin
--dg 	    select into rec * from PLine where slotname = "outer".rec.backlink;
--dg 	    retval := ''Phone line '' || trim(rec.phonenumber);
--dg 	    if rec.comment != '''' then
--dg 	        retval := retval || '' ('';
--dg 		retval := retval || rec.comment;
--dg 		retval := retval || '')'';
--dg 	    end if;
--dg 	    return retval;
--dg 	end;
--dg     end if;
--dg     if bltype = ''WS'' then
--dg         select into rec * from WSlot where slotname = rec.backlink;
--dg 	retval := trim(rec.slotname) || '' in room '';
--dg 	retval := retval || trim(rec.roomno);
--dg 	retval := retval || '' -> '';
--dg 	return retval || wslot_slotlink_view(rec.slotname);
--dg     end if;
--dg     return rec.backlink;
--dg end;
