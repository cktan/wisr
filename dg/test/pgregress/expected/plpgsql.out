-- attempt modifications which would break RI (should all fail)
--dg-cascade
--dg DELETE FROM transition_table_level1
--dg   WHERE level1_no = 25;
--dg-cascade
--dg UPDATE transition_table_level1 SET level1_no = -1
--dg   WHERE level1_no = 30;
