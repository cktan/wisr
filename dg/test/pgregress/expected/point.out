--
-- POINT
--
-- avoid bit-exact output here because operations may not be bit-exact.
SET extra_float_digits = 0;
-- point_tbl was already created and filled in test_setup.sql.
-- Here we just try to insert bad values.
INSERT INTO POINT_TBL(f1) VALUES ('asdfasdf');
ERROR:  relation "point_tbl" does not exist
LINE 1: INSERT INTO POINT_TBL(f1) VALUES ('asdfasdf');
                    ^
INSERT INTO POINT_TBL(f1) VALUES ('(10.0 10.0)');
ERROR:  relation "point_tbl" does not exist
LINE 1: INSERT INTO POINT_TBL(f1) VALUES ('(10.0 10.0)');
                    ^
INSERT INTO POINT_TBL(f1) VALUES ('(10.0, 10.0) x');
ERROR:  relation "point_tbl" does not exist
LINE 1: INSERT INTO POINT_TBL(f1) VALUES ('(10.0, 10.0) x');
                    ^
INSERT INTO POINT_TBL(f1) VALUES ('(10.0,10.0');
ERROR:  relation "point_tbl" does not exist
LINE 1: INSERT INTO POINT_TBL(f1) VALUES ('(10.0,10.0');
                    ^
INSERT INTO POINT_TBL(f1) VALUES ('(10.0, 1e+500)');	-- Out of range
ERROR:  relation "point_tbl" does not exist
LINE 1: INSERT INTO POINT_TBL(f1) VALUES ('(10.0, 1e+500)');
                    ^
SELECT * FROM POINT_TBL;
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT * FROM POINT_TBL;
                      ^
-- left of
SELECT p.* FROM POINT_TBL p WHERE p.f1 << '(0.0, 0.0)';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p WHERE p.f1 << '(0.0, 0.0)';
                        ^
-- right of
SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' >> p.f1;
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' >> p.f1;
                        ^
-- above
SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' |>> p.f1;
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' |>> p.f1;
                        ^
-- below
SELECT p.* FROM POINT_TBL p WHERE p.f1 <<| '(0.0, 0.0)';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p WHERE p.f1 <<| '(0.0, 0.0)';
                        ^
-- equal
SELECT p.* FROM POINT_TBL p WHERE p.f1 ~= '(5.1, 34.5)';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p WHERE p.f1 ~= '(5.1, 34.5)';
                        ^
-- point in box
SELECT p.* FROM POINT_TBL p
   WHERE p.f1 <@ box '(0,0,100,100)';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p
                        ^
SELECT p.* FROM POINT_TBL p
   WHERE box '(0,0,100,100)' @> p.f1;
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p
                        ^
SELECT p.* FROM POINT_TBL p
   WHERE not p.f1 <@ box '(0,0,100,100)';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p
                        ^
SELECT p.* FROM POINT_TBL p
   WHERE p.f1 <@ path '[(0,0),(-10,0),(-10,10)]';
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p
                        ^
SELECT p.* FROM POINT_TBL p
   WHERE not box '(0,0,100,100)' @> p.f1;
ERROR:  relation "point_tbl" does not exist
LINE 1: SELECT p.* FROM POINT_TBL p
                        ^
SELECT p.f1, p.f1 <-> point '(0,0)' AS dist
   FROM POINT_TBL p
   ORDER BY dist;
ERROR:  relation "point_tbl" does not exist
LINE 2:    FROM POINT_TBL p
                ^
SELECT p1.f1 AS point1, p2.f1 AS point2, p1.f1 <-> p2.f1 AS dist
   FROM POINT_TBL p1, POINT_TBL p2
   ORDER BY dist, p1.f1[0], p2.f1[0];
ERROR:  relation "point_tbl" does not exist
LINE 2:    FROM POINT_TBL p1, POINT_TBL p2
                ^
SELECT p1.f1 AS point1, p2.f1 AS point2
   FROM POINT_TBL p1, POINT_TBL p2
   WHERE (p1.f1 <-> p2.f1) > 3;
ERROR:  relation "point_tbl" does not exist
LINE 2:    FROM POINT_TBL p1, POINT_TBL p2
                ^
-- put distance result into output to allow sorting with GEQ optimizer - tgl 97/05/10
SELECT p1.f1 AS point1, p2.f1 AS point2, (p1.f1 <-> p2.f1) AS distance
   FROM POINT_TBL p1, POINT_TBL p2
   WHERE (p1.f1 <-> p2.f1) > 3 and p1.f1 << p2.f1
   ORDER BY distance, p1.f1[0], p2.f1[0];
ERROR:  relation "point_tbl" does not exist
LINE 2:    FROM POINT_TBL p1, POINT_TBL p2
                ^
-- put distance result into output to allow sorting with GEQ optimizer - tgl 97/05/10
SELECT p1.f1 AS point1, p2.f1 AS point2, (p1.f1 <-> p2.f1) AS distance
   FROM POINT_TBL p1, POINT_TBL p2
   WHERE (p1.f1 <-> p2.f1) > 3 and p1.f1 << p2.f1 and p1.f1 |>> p2.f1
   ORDER BY distance;
ERROR:  relation "point_tbl" does not exist
LINE 2:    FROM POINT_TBL p1, POINT_TBL p2
                ^
-- Test that GiST indexes provide same behavior as sequential scan
--dg-skip: type ? is not supported yet
--dg CREATE TEMP TABLE point_gist_tbl(f1 point);
--dg-cascade
--dg INSERT INTO point_gist_tbl SELECT '(0,0)' FROM generate_series(0,1000);
--dg-cascade
--dg CREATE INDEX point_gist_tbl_index ON point_gist_tbl USING gist (f1);
--dg-cascade
--dg INSERT INTO point_gist_tbl VALUES ('(0.0000009,0.0000009)');
SET enable_seqscan TO true;
SET enable_indexscan TO false;
SET enable_bitmapscan TO false;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 ~= '(0.0000009,0.0000009)'::point;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 <@ '(0.0000009,0.0000009),(0.0000009,0.0000009)'::box;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 ~= '(0.0000018,0.0000018)'::point;
SET enable_seqscan TO false;
SET enable_indexscan TO true;
SET enable_bitmapscan TO true;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 ~= '(0.0000009,0.0000009)'::point;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 <@ '(0.0000009,0.0000009),(0.0000009,0.0000009)'::box;
--dg-cascade
--dg SELECT COUNT(*) FROM point_gist_tbl WHERE f1 ~= '(0.0000018,0.0000018)'::point;
RESET enable_seqscan;
RESET enable_indexscan;
RESET enable_bitmapscan;
