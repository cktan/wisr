--
-- Test GIN indexes.
--
-- There are other tests to test different GIN opclasses. This is for testing
-- GIN itself.
-- Create and populate a test table with a GIN index.
--dg-skip: type ? is not supported yet
--dg create table gin_test_tbl(i int4[]) with (autovacuum_enabled = off);
--dg-cascade
--dg create index gin_test_idx on gin_test_tbl using gin (i)
--dg   with (fastupdate = on, gin_pending_list_limit = 4096);
--dg-cascade
--dg insert into gin_test_tbl select array[1, 2, g] from generate_series(1, 20000) g;
--dg-cascade
--dg insert into gin_test_tbl select array[1, 3, g] from generate_series(1, 1000) g;
--dg-cascade
--dg select gin_clean_pending_list('gin_test_idx')>10 as many; -- flush the fastupdate buffers
--dg-cascade
--dg insert into gin_test_tbl select array[3, 1, g] from generate_series(1, 1000) g;
--dg-cascade
--dg vacuum gin_test_tbl; -- flush the fastupdate buffers
--dg-cascade
--dg select gin_clean_pending_list('gin_test_idx'); -- nothing to flush
-- Test vacuuming
--dg-cascade
--dg delete from gin_test_tbl where i @> array[2];
--dg-cascade
--dg vacuum gin_test_tbl;
-- Disable fastupdate, and do more insertions. With fastupdate enabled, most
-- insertions (by flushing the list pages) cause page splits. Without
-- fastupdate, we get more churn in the GIN data leaf pages, and exercise the
-- recompression codepaths.
--dg-skip: ALTER INDEX is not supported yet
--dg alter index gin_test_idx set (fastupdate = off);
--dg-cascade
--dg insert into gin_test_tbl select array[1, 2, g] from generate_series(1, 1000) g;
--dg-cascade
--dg insert into gin_test_tbl select array[1, 3, g] from generate_series(1, 1000) g;
--dg-cascade
--dg delete from gin_test_tbl where i @> array[2];
--dg-cascade
--dg vacuum gin_test_tbl;
-- Test for "rare && frequent" searches
--dg-cascade
--dg explain (costs off)
--dg select count(*) from gin_test_tbl where i @> array[1, 999];
--dg-cascade
--dg select count(*) from gin_test_tbl where i @> array[1, 999];
-- Very weak test for gin_fuzzy_search_limit
--dg-skip: unrecognized configuration parameter "?"
--dg set gin_fuzzy_search_limit = 1000;
--dg-cascade
--dg explain (costs off)
--dg select count(*) > 0 as ok from gin_test_tbl where i @> array[1];
--dg-cascade
--dg select count(*) > 0 as ok from gin_test_tbl where i @> array[1];
--dg-skip: unrecognized configuration parameter "?"
--dg reset gin_fuzzy_search_limit;
-- Test optimization of empty queries
--dg-skip: type ? is not supported yet
--dg create temp table t_gin_test_tbl(i int4[], j int4[]);
--dg-cascade
--dg create index on t_gin_test_tbl using gin (i, j);
--dg-cascade
--dg insert into t_gin_test_tbl
--dg values
--dg   (null,    null),
--dg   ('{}',    null),
--dg   ('{1}',   null),
--dg   ('{1,2}', null),
--dg   (null,    '{}'),
--dg   (null,    '{10}'),
--dg   ('{1,2}', '{10}'),
--dg   ('{2}',   '{10}'),
--dg   ('{1,3}', '{}'),
--dg   ('{1,1}', '{10}');
set enable_seqscan = off;
--dg-cascade
--dg explain (costs off)
--dg select * from t_gin_test_tbl where array[0] <@ i;
--dg-cascade
--dg select * from t_gin_test_tbl where array[0] <@ i;
--dg-cascade
--dg select * from t_gin_test_tbl where array[0] <@ i and '{}'::int4[] <@ j;
--dg-cascade
--dg explain (costs off)
--dg select * from t_gin_test_tbl where i @> '{}';
--dg-cascade
--dg select * from t_gin_test_tbl where i @> '{}';
--dg-skip: language "?" does not exist
--dg create function explain_query_json(query_sql text)
--dg returns table (explain_line json)
--dg language plpgsql as
--dg $$
--dg begin
--dg   set enable_seqscan = off;
--dg   set enable_bitmapscan = on;
--dg   return query execute 'EXPLAIN (ANALYZE, FORMAT json) ' || query_sql;
--dg end;
--dg $$;
--dg-skip: language "?" does not exist
--dg create function execute_text_query_index(query_sql text)
--dg returns setof text
--dg language plpgsql
--dg as
--dg $$
--dg begin
--dg   set enable_seqscan = off;
--dg   set enable_bitmapscan = on;
--dg   return query execute query_sql;
--dg end;
--dg $$;
--dg-skip: language "?" does not exist
--dg create function execute_text_query_heap(query_sql text)
--dg returns setof text
--dg language plpgsql
--dg as
--dg $$
--dg begin
--dg   set enable_seqscan = on;
--dg   set enable_bitmapscan = off;
--dg   return query execute query_sql;
--dg end;
--dg $$;
-- check number of rows returned by index and removed by recheck
--dg-cascade
--dg select
--dg   query,
--dg   js->0->'Plan'->'Plans'->0->'Actual Rows' as "return by index",
--dg   js->0->'Plan'->'Rows Removed by Index Recheck' as "removed by recheck",
--dg   (res_index = res_heap) as "match"
--dg from
--dg   (values
--dg     ($$ i @> '{}' $$),
--dg     ($$ j @> '{}' $$),
--dg     ($$ i @> '{}' and j @> '{}' $$),
--dg     ($$ i @> '{1}' $$),
--dg     ($$ i @> '{1}' and j @> '{}' $$),
--dg     ($$ i @> '{1}' and i @> '{}' and j @> '{}' $$),
--dg     ($$ j @> '{10}' $$),
--dg     ($$ j @> '{10}' and i @> '{}' $$),
--dg     ($$ j @> '{10}' and j @> '{}' and i @> '{}' $$),
--dg     ($$ i @> '{1}' and j @> '{10}' $$)
--dg   ) q(query),
--dg   lateral explain_query_json($$select * from t_gin_test_tbl where $$ || query) js,
--dg   lateral execute_text_query_index($$select string_agg((i, j)::text, ' ') from t_gin_test_tbl where $$ || query) res_index,
--dg   lateral execute_text_query_heap($$select string_agg((i, j)::text, ' ') from t_gin_test_tbl where $$ || query) res_heap;
reset enable_seqscan;
reset enable_bitmapscan;
-- re-purpose t_gin_test_tbl to test scans involving posting trees
--dg-cascade
--dg insert into t_gin_test_tbl select array[1, g, g/10], array[2, g, g/10]
--dg   from generate_series(1, 20000) g;
--dg-cascade
--dg select gin_clean_pending_list('t_gin_test_tbl_i_j_idx') is not null;
--dg-cascade
--dg analyze t_gin_test_tbl;
set enable_seqscan = off;
set enable_bitmapscan = on;
--dg-cascade
--dg explain (costs off)
--dg select count(*) from t_gin_test_tbl where j @> array[50];
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> array[50];
--dg-cascade
--dg explain (costs off)
--dg select count(*) from t_gin_test_tbl where j @> array[2];
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> array[2];
--dg-cascade
--dg explain (costs off)
--dg select count(*) from t_gin_test_tbl where j @> '{}'::int[];
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> '{}'::int[];
-- test vacuuming of posting trees
--dg-cascade
--dg delete from t_gin_test_tbl where j @> array[2];
--dg-cascade
--dg vacuum t_gin_test_tbl;
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> array[50];
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> array[2];
--dg-cascade
--dg select count(*) from t_gin_test_tbl where j @> '{}'::int[];
reset enable_seqscan;
reset enable_bitmapscan;
--dg-cascade
--dg drop table t_gin_test_tbl;
-- test an unlogged table, mostly to get coverage of ginbuildempty
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create unlogged table t_gin_test_tbl(i int4[], j int4[]);
--dg-cascade
--dg create index on t_gin_test_tbl using gin (i, j);
--dg-cascade
--dg insert into t_gin_test_tbl
--dg values
--dg   (null,    null),
--dg   ('{}',    null),
--dg   ('{1}',   '{2,3}');
--dg-cascade
--dg drop table t_gin_test_tbl;
