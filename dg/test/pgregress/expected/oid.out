--dg-cascade
--dg SELECT o.* FROM OID_TBL o WHERE o.f1 <> '1234';
--dg-cascade
--dg SELECT o.* FROM OID_TBL o WHERE o.f1 <= '1234';
--dg-cascade
--dg SELECT o.* FROM OID_TBL o WHERE o.f1 < '1234';
--dg-cascade
--dg SELECT o.* FROM OID_TBL o WHERE o.f1 >= '1234';
--dg-cascade
--dg SELECT o.* FROM OID_TBL o WHERE o.f1 > '1234';
--dg-cascade
--dg DROP TABLE OID_TBL;
