-- Test it with a CHECK condition that produces a toasted pg_constraint entry
BEGIN;
--dg-skip: language "?" does not exist
--dg do $$
--dg begin
--dg   execute format($cmd$
--dg     CREATE TEMP TABLE temptest (col text CHECK (col < %L)) ON COMMIT DROP
--dg   $cmd$,
--dg     (SELECT string_agg(g.i::text || ':' || random()::text, '|')
--dg      FROM generate_series(1, 100) g(i)));
--dg end$$;
--dg-cascade
--dg SELECT * FROM temptest;
COMMIT;
SELECT * FROM temptest;
ERROR:  relation "temptest" does not exist
LINE 1: SELECT * FROM temptest;
                      ^
-- ON COMMIT is only allowed for TEMP
CREATE TABLE temptest(col int) ON COMMIT DELETE ROWS;
ERROR:  ON COMMIT can only be used on temporary tables
CREATE TABLE temptest(col) ON COMMIT DELETE ROWS AS SELECT 1;
ERROR:  ON COMMIT can only be used on temporary tables
-- Test foreign keys
BEGIN;
CREATE TEMP TABLE temptest1(col int PRIMARY KEY);
CREATE TEMP TABLE temptest2(col int REFERENCES temptest1)
  ON COMMIT DELETE ROWS;
INSERT INTO temptest1 VALUES (1);
INSERT INTO temptest2 VALUES (1);
COMMIT;
SELECT * FROM temptest1;
 col 
-----
   1
(1 row)

SELECT * FROM temptest2;
 col 
-----
(0 rows)

BEGIN;
CREATE TEMP TABLE temptest3(col int PRIMARY KEY) ON COMMIT DELETE ROWS;
CREATE TEMP TABLE temptest4(col int REFERENCES temptest3);
COMMIT;
ERROR:  unsupported ON COMMIT and foreign key combination
DETAIL:  Table "temptest4" references "temptest3", but they do not have the same ON COMMIT setting.
-- Test manipulation of temp schema's placement in search path
create table public.whereami (f1 text);
insert into public.whereami values ('public');
create temp table whereami (f1 text);
insert into whereami values ('temp');
--dg-skip: language "?" does not exist
--dg create function public.whoami() returns text
--dg   as $$select 'public'::text$$ language sql;
--dg-skip: language "?" does not exist
--dg create function pg_temp.whoami() returns text
--dg   as $$select 'temp'::text$$ language sql;
-- default should have pg_temp implicitly first, but only for tables
select * from whereami;
  f1  
------
 temp
(1 row)

--dg-cascade
--dg select whoami();
-- can list temp first explicitly, but it still doesn't affect functions
set search_path = pg_temp, public;
select * from whereami;
  f1  
------
 temp
(1 row)

--dg-cascade
--dg select whoami();
-- or put it last for security
set search_path = public, pg_temp;
select * from whereami;
   f1   
--------
 public
(1 row)

--dg-cascade
--dg select whoami();
-- you can invoke a temp function explicitly, though
--dg-cascade
--dg select pg_temp.whoami();
drop table public.whereami;
-- types in temp schema
set search_path = pg_temp, public;
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg create domain pg_temp.nonempty as text check (value <> '');
-- function-syntax invocation of types matches rules for functions
select nonempty('');
ERROR:  function nonempty(unknown) does not exist
LINE 1: select nonempty('');
               ^
HINT:  No function matches the given name and argument types. You might need to add explicit type casts.
--dg-cascade
--dg select pg_temp.nonempty('');
-- other syntax matches rules for tables
--dg-cascade
--dg select ''::nonempty;
reset search_path;
-- For partitioned temp tables, ON COMMIT actions ignore storage-less
-- partitioned tables.
begin;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table temp_parted_oncommit (a int)
--dg   partition by list (a) on commit delete rows;
--dg-cascade
--dg create temp table temp_parted_oncommit_1
--dg   partition of temp_parted_oncommit
--dg   for values in (1) on commit delete rows;
--dg-cascade
--dg insert into temp_parted_oncommit values (1);
commit;
-- partitions are emptied by the previous commit
--dg-cascade
--dg select * from temp_parted_oncommit;
--dg-cascade
--dg drop table temp_parted_oncommit;
-- Check dependencies between ON COMMIT actions with a partitioned
-- table and its partitions.  Using ON COMMIT DROP on a parent removes
-- the whole set.
begin;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table temp_parted_oncommit_test (a int)
--dg   partition by list (a) on commit drop;
--dg-cascade
--dg create temp table temp_parted_oncommit_test1
--dg   partition of temp_parted_oncommit_test
--dg   for values in (1) on commit delete rows;
--dg-cascade
--dg create temp table temp_parted_oncommit_test2
--dg   partition of temp_parted_oncommit_test
--dg   for values in (2) on commit drop;
--dg-cascade
--dg insert into temp_parted_oncommit_test values (1), (2);
commit;
-- no relations remain in this case.
select relname from pg_class where relname ~ '^temp_parted_oncommit_test';
 relname 
---------
(0 rows)

-- Using ON COMMIT DELETE on a partitioned table does not remove
-- all rows if partitions preserve their data.
begin;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table temp_parted_oncommit_test (a int)
--dg   partition by list (a) on commit delete rows;
--dg-cascade
--dg create temp table temp_parted_oncommit_test1
--dg   partition of temp_parted_oncommit_test
--dg   for values in (1) on commit preserve rows;
--dg-cascade
--dg create temp table temp_parted_oncommit_test2
--dg   partition of temp_parted_oncommit_test
--dg   for values in (2) on commit drop;
--dg-cascade
--dg insert into temp_parted_oncommit_test values (1), (2);
commit;
-- Data from the remaining partition is still here as its rows are
-- preserved.
--dg-cascade
--dg select * from temp_parted_oncommit_test;
-- two relations remain in this case.
--dg-cascade
--dg select relname from pg_class where relname ~ '^temp_parted_oncommit_test'
--dg   order by relname;
--dg-cascade
--dg drop table temp_parted_oncommit_test;
-- Check dependencies between ON COMMIT actions with inheritance trees.
-- Using ON COMMIT DROP on a parent removes the whole set.
begin;
create temp table temp_inh_oncommit_test (a int) on commit drop;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table temp_inh_oncommit_test1 ()
--dg   inherits(temp_inh_oncommit_test) on commit delete rows;
--dg-cascade
--dg insert into temp_inh_oncommit_test1 values (1);
commit;
-- no relations remain in this case
select relname from pg_class where relname ~ '^temp_inh_oncommit_test';
 relname 
---------
(0 rows)

-- Data on the parent is removed, and the child goes away.
begin;
create temp table temp_inh_oncommit_test (a int) on commit delete rows;
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create temp table temp_inh_oncommit_test1 ()
--dg   inherits(temp_inh_oncommit_test) on commit drop;
--dg-cascade
--dg insert into temp_inh_oncommit_test1 values (1);
--dg-cascade
--dg insert into temp_inh_oncommit_test values (1);
commit;
--dg-cascade
--dg select * from temp_inh_oncommit_test;
-- one relation remains
--dg-cascade
--dg select relname from pg_class where relname ~ '^temp_inh_oncommit_test';
--dg-cascade
--dg drop table temp_inh_oncommit_test;
-- Tests with two-phase commit
