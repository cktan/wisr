----------------------+-----------------------
               1004.3 |                1004.3
 1.2345678901234e+200 | 1.23456789012338e+200
 1.2345678901234e-200 | 1.23456789012339e-200
(3 rows)

-- check edge cases for exp
SELECT exp('inf'::float8), exp('-inf'::float8), exp('nan'::float8);
   exp    | exp | exp 
----------+-----+-----
 Infinity |   0 | NaN
