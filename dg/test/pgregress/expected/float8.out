-- test edge-case coercions to integer
SELECT '32767.4'::float8::int2;
 int2  
-------
 32767
(1 row)

SELECT '32767.6'::float8::int2;
ERROR:  smallint out of range
SELECT '-32768.4'::float8::int2;
  int2  
--------
 -32768
(1 row)

SELECT '-32768.6'::float8::int2;
