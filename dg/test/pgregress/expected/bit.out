-- Get/Set bit
SELECT get_bit(B'0101011000100', 10);
 get_bit 
---------
       1
(1 row)

SELECT set_bit(B'0101011000100100', 15, 1);
     set_bit      
------------------
 0101011000100101
(1 row)

SELECT set_bit(B'0101011000100100', 16, 1);	-- fail
ERROR:  bit index 16 out of valid range (0..15)
-- Overlay
SELECT overlay(B'0101011100' placing '001' from 2 for 3);
  overlay   
------------
 0001011100
(1 row)

SELECT overlay(B'0101011100' placing '101' from 6);
  overlay   
------------
 0101010100
(1 row)

SELECT overlay(B'0101011100' placing '001' from 11);
    overlay    
---------------
 0101011100001
(1 row)

SELECT overlay(B'0101011100' placing '001' from 20);
    overlay    
---------------
 0101011100001
(1 row)

-- bit_count
SELECT bit_count(B'0101011100'::bit(10));
 bit_count 
-----------
         5
(1 row)

SELECT bit_count(B'1111111111'::bit(10));
 bit_count 
-----------
        10
(1 row)

SELECT bit_count(repeat('0', 100)::bit(100));
 bit_count 
-----------
         0
(1 row)

SELECT bit_count(repeat('1', 100)::bit(100));
 bit_count 
-----------
       100
(1 row)

SELECT bit_count(repeat('01', 500)::bit(1000));
 bit_count 
-----------
       500
(1 row)

SELECT bit_count(repeat('10101', 200)::bit(1000));
 bit_count 
-----------
       600
(1 row)

