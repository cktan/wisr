-- Substring
--dg-cascade
--dg SELECT b,
--dg        SUBSTRING(b FROM 2 FOR 4) AS sub_2_4,
--dg        SUBSTRING(b FROM 7 FOR 13) AS sub_7_13,
--dg        SUBSTRING(b FROM 6) AS sub_6
--dg        FROM BIT_TABLE;
--dg-cascade
--dg SELECT v,
--dg        SUBSTRING(v FROM 2 FOR 4) AS sub_2_4,
--dg        SUBSTRING(v FROM 7 FOR 13) AS sub_7_13,
--dg        SUBSTRING(v FROM 6) AS sub_6
--dg        FROM VARBIT_TABLE;
-- test overflow cases
SELECT SUBSTRING('01010101'::bit(8) FROM 2 FOR 2147483646) AS "1010101";
 1010101 
---------
 1010101
(1 row)

SELECT SUBSTRING('01010101'::bit(8) FROM -10 FOR 2147483646) AS "01010101";
 01010101 
----------
 01010101
(1 row)

SELECT SUBSTRING('01010101'::bit(8) FROM -10 FOR -2147483646) AS "error";
ERROR:  negative substring length not allowed
SELECT SUBSTRING('01010101'::varbit FROM 2 FOR 2147483646) AS "1010101";
 1010101 
---------
 1010101
(1 row)

SELECT SUBSTRING('01010101'::varbit FROM -10 FOR 2147483646) AS "01010101";
 01010101 
----------
 01010101
(1 row)

SELECT SUBSTRING('01010101'::varbit FROM -10 FOR -2147483646) AS "error";
ERROR:  negative substring length not allowed
--- Bit operations
--dg-cascade
--dg DROP TABLE varbit_table;
--dg-skip: type ? is not supported yet
--dg CREATE TABLE varbit_table (a BIT VARYING(16), b BIT VARYING(16));
--dg-cascade
--dg COPY varbit_table FROM stdin;
--dg X0F	X10
--dg X1F	X11
--dg X2F	X12
--dg X3F	X13
--dg X8F	X04
--dg X000F	X0010
--dg X0123	XFFFF
--dg X2468	X2468
--dg XFA50	X05AF
--dg X1234	XFFF5
--dg \.
--dg-cascade
--dg SELECT a, b, ~a AS "~ a", a & b AS "a & b",
--dg        a | b AS "a | b", a # b AS "a # b" FROM varbit_table;
--dg-cascade
--dg SELECT a,b,a<b AS "a<b",a<=b AS "a<=b",a=b AS "a=b",
--dg         a>=b AS "a>=b",a>b AS "a>b",a<>b AS "a<>b" FROM varbit_table;
--dg-cascade
--dg SELECT a,a<<4 AS "a<<4",b,b>>2 AS "b>>2" FROM varbit_table;
--dg-cascade
--dg DROP TABLE varbit_table;
--- Bit operations
--dg-cascade
--dg DROP TABLE bit_table;
--dg-skip: type ? is not supported yet
--dg CREATE TABLE bit_table (a BIT(16), b BIT(16));
--dg-cascade
--dg COPY bit_table FROM stdin;
--dg X0F00	X1000
--dg X1F00	X1100
--dg X2F00	X1200
--dg X3F00	X1300
--dg X8F00	X0400
--dg X000F	X0010
--dg X0123	XFFFF
--dg X2468	X2468
--dg XFA50	X05AF
--dg X1234	XFFF5
--dg \.
--dg-cascade
--dg SELECT a,b,~a AS "~ a",a & b AS "a & b",
--dg 	a|b AS "a | b", a # b AS "a # b" FROM bit_table;
--dg-cascade
--dg SELECT a,b,a<b AS "a<b",a<=b AS "a<=b",a=b AS "a=b",
--dg         a>=b AS "a>=b",a>b AS "a>b",a<>b AS "a<>b" FROM bit_table;
--dg-cascade
--dg SELECT a,a<<4 AS "a<<4",b,b>>2 AS "b>>2" FROM bit_table;
--dg-cascade
--dg DROP TABLE bit_table;
-- The following should fail
select B'001' & B'10';
ERROR:  cannot AND bit strings of different sizes
select B'0111' | B'011';
ERROR:  cannot OR bit strings of different sizes
select B'0010' # B'011101';
ERROR:  cannot XOR bit strings of different sizes
-- More position tests, checking all the boundary cases
SELECT POSITION(B'1010' IN B'0000101');   -- 0
 position 
----------
        0
(1 row)

SELECT POSITION(B'1010' IN B'00001010');  -- 5
 position 
----------
        5
(1 row)

SELECT POSITION(B'1010' IN B'00000101');  -- 0
 position 
----------
        0
(1 row)

SELECT POSITION(B'1010' IN B'000001010');  -- 6
 position 
----------
        6
(1 row)

SELECT POSITION(B'' IN B'00001010');  -- 1
 position 
----------
        1
(1 row)

SELECT POSITION(B'0' IN B'');  -- 0
 position 
----------
        0
(1 row)

SELECT POSITION(B'' IN B'');  -- 0
 position 
----------
        0
(1 row)

