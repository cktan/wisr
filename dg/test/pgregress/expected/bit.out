-- Literals with syntax errors
SELECT b' 0';
ERROR:  " " is not a valid binary digit
LINE 1: SELECT b' 0';
               ^
SELECT b'0 ';
ERROR:  " " is not a valid binary digit
LINE 1: SELECT b'0 ';
               ^
SELECT x' 0';
ERROR:  " " is not a valid hexadecimal digit
LINE 1: SELECT x' 0';
               ^
SELECT x'0 ';
ERROR:  " " is not a valid hexadecimal digit
LINE 1: SELECT x'0 ';
               ^
