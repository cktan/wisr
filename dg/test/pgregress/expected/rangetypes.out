-- Tests for range data types.
--
-- test input parser
-- (type textrange was already made in test_setup.sql)
--
-- negative tests; should fail
select ''::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select ''::textrange;
                   ^
select '-[a,z)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '-[a,z)'::textrange;
                         ^
select '[a,z) - '::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[a,z) - '::textrange;
                           ^
select '(",a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(",a)'::textrange;
                        ^
select '(,,a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(,,a)'::textrange;
                        ^
select '(),a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(),a)'::textrange;
                        ^
select '(a,))'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(a,))'::textrange;
                        ^
select '(],a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(],a)'::textrange;
                        ^
select '(a,])'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(a,])'::textrange;
                        ^
select '[z,a]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[z,a]'::textrange;
                        ^
-- should succeed
select '  empty  '::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '  empty  '::textrange;
                            ^
select ' ( empty, empty )  '::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select ' ( empty, empty )  '::textrange;
                                      ^
select ' ( " a " " a ", " z " " z " )  '::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select ' ( " a " " a ", " z " " z " )  '::textrange;
                                                  ^
select '(a,)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(a,)'::textrange;
                       ^
select '[,z]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[,z]'::textrange;
                       ^
select '[a,]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[a,]'::textrange;
                       ^
select '(,)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(,)'::textrange;
                      ^
select '[ , ]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[ , ]'::textrange;
                        ^
select '["",""]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '["",""]'::textrange;
                          ^
select '[",",","]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[",",","]'::textrange;
                            ^
select '["\\","\\"]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '["\\","\\"]'::textrange;
                              ^
select '(\\,a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(\\,a)'::textrange;
                         ^
select '((,z)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '((,z)'::textrange;
                        ^
select '([,z)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '([,z)'::textrange;
                        ^
select '(!,()'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(!,()'::textrange;
                        ^
select '(!,[)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(!,[)'::textrange;
                        ^
select '[a,a]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[a,a]'::textrange;
                        ^
-- these are allowed but normalize to empty:
select '[a,a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '[a,a)'::textrange;
                        ^
select '(a,a]'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(a,a]'::textrange;
                        ^
select '(a,a)'::textrange;
ERROR:  type "textrange" does not exist
LINE 1: select '(a,a)'::textrange;
                        ^
-- Also try it with non-error-throwing API
select pg_input_is_valid('(1,4)', 'int4range');
 pg_input_is_valid 
-------------------
 t
(1 row)

select pg_input_is_valid('(1,4', 'int4range');
 pg_input_is_valid 
-------------------
 f
(1 row)

select * from pg_input_error_info('(1,4', 'int4range');
             message             |          detail          | hint | sql_error_code 
---------------------------------+--------------------------+------+----------------
 malformed range literal: "(1,4" | Unexpected end of input. |      | 22P02
(1 row)

select pg_input_is_valid('(4,1)', 'int4range');
 pg_input_is_valid 
-------------------
 f
(1 row)

select * from pg_input_error_info('(4,1)', 'int4range');
                              message                              | detail | hint | sql_error_code 
-------------------------------------------------------------------+--------+------+----------------
 range lower bound must be less than or equal to range upper bound |        |      | 22000
(1 row)

select pg_input_is_valid('(4,zed)', 'int4range');
 pg_input_is_valid 
-------------------
 f
(1 row)

select * from pg_input_error_info('(4,zed)', 'int4range');
                   message                    | detail | hint | sql_error_code 
----------------------------------------------+--------+------+----------------
 invalid input syntax for type integer: "zed" |        |      | 22P02
(1 row)

select pg_input_is_valid('[1,2147483647]', 'int4range');
 pg_input_is_valid 
-------------------
 f
(1 row)

select * from pg_input_error_info('[1,2147483647]', 'int4range');
       message        | detail | hint | sql_error_code 
----------------------+--------+------+----------------
 integer out of range |        |      | 22003
(1 row)

select pg_input_is_valid('[2000-01-01,5874897-12-31]', 'daterange');
 pg_input_is_valid 
-------------------
 f
(1 row)

select * from pg_input_error_info('[2000-01-01,5874897-12-31]', 'daterange');
      message      | detail | hint | sql_error_code 
-------------------+--------+------+----------------
 date out of range |        |      | 22008
(1 row)

--
-- create some test data and test the operators
--
--dg-skip: type ? is not supported yet
--dg CREATE TABLE numrange_test (nr NUMRANGE);
--dg-cascade
--dg create index numrange_test_btree on numrange_test(nr);
--dg-cascade
--dg INSERT INTO numrange_test VALUES('[,)');
--dg-cascade
--dg INSERT INTO numrange_test VALUES('[3,]');
--dg-cascade
--dg INSERT INTO numrange_test VALUES('[, 5)');
--dg-cascade
--dg INSERT INTO numrange_test VALUES(numrange(1.1, 2.2));
--dg-cascade
--dg INSERT INTO numrange_test VALUES('empty');
--dg-cascade
--dg INSERT INTO numrange_test VALUES(numrange(1.7, 1.7, '[]'));
--dg-cascade
--dg SELECT nr, isempty(nr), lower(nr), upper(nr) FROM numrange_test;
--dg-cascade
--dg SELECT nr, lower_inc(nr), lower_inf(nr), upper_inc(nr), upper_inf(nr) FROM numrange_test;
--dg-cascade
--dg SELECT * FROM numrange_test WHERE range_contains(nr, numrange(1.9,1.91));
--dg-cascade
--dg SELECT * FROM numrange_test WHERE nr @> numrange(1.0,10000.1);
--dg-cascade
--dg SELECT * FROM numrange_test WHERE range_contained_by(numrange(-1e7,-10000.1), nr);
--dg-cascade
--dg SELECT * FROM numrange_test WHERE 1.9 <@ nr;
--dg-cascade
--dg select * from numrange_test where nr = 'empty';
--dg-cascade
--dg select * from numrange_test where nr = '(1.1, 2.2)';
--dg-cascade
--dg select * from numrange_test where nr = '[1.1, 2.2)';
--dg-cascade
--dg select * from numrange_test where nr < 'empty';
--dg-cascade
--dg select * from numrange_test where nr < numrange(-1000.0, -1000.0,'[]');
--dg-cascade
--dg select * from numrange_test where nr < numrange(0.0, 1.0,'[]');
--dg-cascade
--dg select * from numrange_test where nr < numrange(1000.0, 1001.0,'[]');
--dg-cascade
--dg select * from numrange_test where nr <= 'empty';
--dg-cascade
--dg select * from numrange_test where nr >= 'empty';
--dg-cascade
--dg select * from numrange_test where nr > 'empty';
--dg-cascade
--dg select * from numrange_test where nr > numrange(-1001.0, -1000.0,'[]');
--dg-cascade
--dg select * from numrange_test where nr > numrange(0.0, 1.0,'[]');
--dg-cascade
--dg select * from numrange_test where nr > numrange(1000.0, 1000.0,'[]');
select numrange(2.0, 1.0);
ERROR:  range lower bound must be less than or equal to range upper bound
select numrange(2.0, 3.0) -|- numrange(3.0, 4.0);
