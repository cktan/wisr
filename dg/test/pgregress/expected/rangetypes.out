--dg-cascade
--dg select range_intersect_agg(nr) from numrange_test;
--dg-cascade
--dg select range_intersect_agg(nr) from numrange_test where false;
--dg-cascade
--dg select range_intersect_agg(nr) from numrange_test where nr @> 4.0;
--dg-cascade
--dg analyze numrange_test;
--dg-skip: type ? is not supported yet
--dg create table numrange_test2(nr numrange);
--dg-cascade
--dg create index numrange_test2_hash_idx on numrange_test2 using hash (nr);
--dg-cascade
--dg INSERT INTO numrange_test2 VALUES('[, 5)');
--dg-cascade
--dg INSERT INTO numrange_test2 VALUES(numrange(1.1, 2.2));
--dg-cascade
--dg INSERT INTO numrange_test2 VALUES(numrange(1.1, 2.2));
--dg-cascade
--dg INSERT INTO numrange_test2 VALUES(numrange(1.1, 2.2,'()'));
--dg-cascade
--dg INSERT INTO numrange_test2 VALUES('empty');
--dg-cascade
--dg select * from numrange_test2 where nr = 'empty'::numrange;
--dg-cascade
--dg select * from numrange_test2 where nr = numrange(1.1, 2.2);
--dg-cascade
--dg select * from numrange_test2 where nr = numrange(1.1, 2.3);
set enable_nestloop=t;
set enable_hashjoin=f;
set enable_mergejoin=f;
--dg-cascade
--dg select * from numrange_test natural join numrange_test2 order by nr;
set enable_nestloop=f;
set enable_hashjoin=t;
set enable_mergejoin=f;
--dg-cascade
--dg select * from numrange_test natural join numrange_test2 order by nr;
set enable_nestloop=f;
set enable_hashjoin=f;
set enable_mergejoin=t;
--dg-cascade
--dg select * from numrange_test natural join numrange_test2 order by nr;
set enable_nestloop to default;
set enable_hashjoin to default;
set enable_mergejoin to default;
-- keep numrange_test around to help exercise dump/reload
--dg-cascade
--dg DROP TABLE numrange_test2;
