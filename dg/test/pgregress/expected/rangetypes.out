-- test GiST index that's been built incrementally
--dg-skip: type ? is not supported yet
--dg create table test_range_gist(ir int4range);
--dg-cascade
--dg create index test_range_gist_idx on test_range_gist using gist (ir);
--dg-cascade
--dg insert into test_range_gist select int4range(g, g+10) from generate_series(1,2000) g;
--dg-cascade
--dg insert into test_range_gist select 'empty'::int4range from generate_series(1,500) g;
--dg-cascade
--dg insert into test_range_gist select int4range(g, g+10000) from generate_series(1,1000) g;
--dg-cascade
--dg insert into test_range_gist select 'empty'::int4range from generate_series(1,500) g;
--dg-cascade
--dg insert into test_range_gist select int4range(NULL,g*10,'(]') from generate_series(1,100) g;
--dg-cascade
--dg insert into test_range_gist select int4range(g*10,NULL,'(]') from generate_series(1,100) g;
--dg-cascade
--dg insert into test_range_gist select int4range(g, g+10) from generate_series(1,2000) g;
-- test statistics and selectivity estimation as well
--
-- We don't check the accuracy of selectivity estimation, but at least check
-- it doesn't fall.
--dg-cascade
--dg analyze test_range_gist;
-- first, verify non-indexed results
SET enable_seqscan    = t;
SET enable_indexscan  = f;
SET enable_bitmapscan = f;
--dg-cascade
--dg select count(*) from test_range_gist where ir @> 'empty'::int4range;
--dg-cascade
--dg select count(*) from test_range_gist where ir = int4range(10,20);
--dg-cascade
--dg select count(*) from test_range_gist where ir @> 10;
--dg-cascade
--dg select count(*) from test_range_gist where ir @> int4range(10,20);
--dg-cascade
--dg select count(*) from test_range_gist where ir && int4range(10,20);
--dg-cascade
--dg select count(*) from test_range_gist where ir <@ int4range(10,50);
--dg-cascade
--dg select count(*) from test_range_gist where ir << int4range(100,500);
--dg-cascade
--dg select count(*) from test_range_gist where ir >> int4range(100,500);
--dg-cascade
--dg select count(*) from test_range_gist where ir &< int4range(100,500);
--dg-cascade
--dg select count(*) from test_range_gist where ir &> int4range(100,500);
--dg-cascade
--dg select count(*) from test_range_gist where ir -|- int4range(100,500);
--dg-cascade
--dg select count(*) from test_range_gist where ir @> '{}'::int4multirange;
--dg-cascade
--dg select count(*) from test_range_gist where ir @> int4multirange(int4range(10,20), int4range(30,40));
--dg-cascade
--dg select count(*) from test_range_gist where ir && '{(10,20),(30,40),(50,60)}'::int4multirange;
--dg-cascade
--dg select count(*) from test_range_gist where ir <@ '{(10,30),(40,60),(70,90)}'::int4multirange;
--dg-cascade
--dg select count(*) from test_range_gist where ir << int4multirange(int4range(100,200), int4range(400,500));
--dg-cascade
--dg select count(*) from test_range_gist where ir >> int4multirange(int4range(100,200), int4range(400,500));
--dg-cascade
--dg select count(*) from test_range_gist where ir &< int4multirange(int4range(100,200), int4range(400,500));
--dg-cascade
--dg select count(*) from test_range_gist where ir &> int4multirange(int4range(100,200), int4range(400,500));
--dg-cascade
--dg select count(*) from test_range_gist where ir -|- int4multirange(int4range(100,200), int4range(400,500));
-- now check same queries using index
SET enable_seqscan    = f;
SET enable_indexscan  = t;
SET enable_bitmapscan = f;
--dg-cascade
--dg select count(*) from test_range_gist where ir @> 'empty'::int4range;
--dg-cascade
