--
-- Tests to exercise the plan caching/invalidation mechanism
--
CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl;
-- create and use a cached plan
PREPARE prepstmt AS SELECT * FROM pcachetest;
EXECUTE prepstmt;
        q1        |        q2         
------------------+-------------------
              123 |               456
              123 |  4567890123456789
 4567890123456789 |               123
 4567890123456789 |  4567890123456789
 4567890123456789 | -4567890123456789
(5 rows)

-- and one with parameters
PREPARE prepstmt2(bigint) AS SELECT * FROM pcachetest WHERE q1 = $1;
EXECUTE prepstmt2(123);
 q1  |        q2        
-----+------------------
 123 |              456
 123 | 4567890123456789
(2 rows)

-- invalidate the plans and see what happens
DROP TABLE pcachetest;
EXECUTE prepstmt;
ERROR:  relation "pcachetest" does not exist
EXECUTE prepstmt2(123);
ERROR:  relation "pcachetest" does not exist
-- recreate the temp table (this demonstrates that the raw plan is
-- purely textual and doesn't depend on OIDs, for instance)
CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl ORDER BY 2;
EXECUTE prepstmt;
        q1        |        q2         
------------------+-------------------
 4567890123456789 | -4567890123456789
 4567890123456789 |               123
              123 |               456
              123 |  4567890123456789
 4567890123456789 |  4567890123456789
(5 rows)

EXECUTE prepstmt2(123);
 q1  |        q2        
-----+------------------
 123 |              456
 123 | 4567890123456789
(2 rows)

-- prepared statements should prevent change in output tupdesc,
-- since clients probably aren't expecting that to change on the fly
ALTER TABLE pcachetest ADD COLUMN q3 bigint;
EXECUTE prepstmt;
ERROR:  cached plan must not change result type
EXECUTE prepstmt2(123);
ERROR:  cached plan must not change result type
-- but we're nice guys and will let you undo your mistake
ALTER TABLE pcachetest DROP COLUMN q3;
EXECUTE prepstmt;
        q1        |        q2         
------------------+-------------------
 4567890123456789 | -4567890123456789
 4567890123456789 |               123
              123 |               456
              123 |  4567890123456789
 4567890123456789 |  4567890123456789
(5 rows)

EXECUTE prepstmt2(123);
 q1  |        q2        
-----+------------------
 123 |              456
 123 | 4567890123456789
(2 rows)

-- Try it with a view, which isn't directly used in the resulting plan
-- but should trigger invalidation anyway
CREATE TEMP VIEW pcacheview AS
  SELECT * FROM pcachetest;
PREPARE vprep AS SELECT * FROM pcacheview;
EXECUTE vprep;
        q1        |        q2         
------------------+-------------------
 4567890123456789 | -4567890123456789
 4567890123456789 |               123
              123 |               456
              123 |  4567890123456789
 4567890123456789 |  4567890123456789
(5 rows)

CREATE OR REPLACE TEMP VIEW pcacheview AS
  SELECT q1, q2/2 AS q2 FROM pcachetest;
EXECUTE vprep;
        q1        |        q2         
------------------+-------------------
 4567890123456789 | -2283945061728394
 4567890123456789 |                61
              123 |               228
              123 |  2283945061728394
 4567890123456789 |  2283945061728394
(5 rows)

-- Check basic SPI plan invalidation
--dg-skip: language "?" does not exist
--dg create function cache_test(int) returns int as $$
--dg declare total int;
--dg begin
--dg 	create temp table t1(f1 int);
--dg 	insert into t1 values($1);
--dg 	insert into t1 values(11);
--dg 	insert into t1 values(12);
--dg 	insert into t1 values(13);
--dg 	select sum(f1) into total from t1;
--dg 	drop table t1;
--dg 	return total;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg select cache_test(1);
--dg-cascade
--dg select cache_test(2);
--dg-cascade
--dg select cache_test(3);
-- Check invalidation of plpgsql "simple expression"
create temp view v1 as
  select 2+2 as f1;
--dg-skip: language "?" does not exist
--dg create function cache_test_2() returns int as $$
--dg begin
--dg 	return f1 from v1;
--dg end$$ language plpgsql;
--dg-cascade
--dg select cache_test_2();
create or replace temp view v1 as
  select 2+2+4 as f1;
--dg-cascade
--dg select cache_test_2();
create or replace temp view v1 as
  select 2+2+4+(select max(unique1) from tenk1) as f1;
--dg-cascade
--dg select cache_test_2();
--- Check that change of search_path is honored when re-using cached plan
create schema s1
  create table abc (f1 int);
create schema s2
  create table abc (f1 int);
insert into s1.abc values(123);
insert into s2.abc values(456);
set search_path = s1;
prepare p1 as select f1 from abc;
execute p1;
 f1  
-----
 123
(1 row)

set search_path = s2;
select f1 from abc;
 f1  
-----
 456
(1 row)

execute p1;
 f1  
-----
 456
(1 row)

alter table s1.abc add column f2 float8;   -- force replan
execute p1;
 f1  
-----
 456
(1 row)

drop schema s1 cascade;
NOTICE:  drop cascades to table s1.abc
--dg-differs: the result
--dg drop schema s2 cascade;
reset search_path;
-- Check that invalidation deals with regclass constants
--dg-skip: CREATE SEQUENCE supports only START and INCREMENT yet, not TEMPORARY or UNLOGGED
--dg create temp sequence seq;
--dg-cascade
--dg prepare p2 as select nextval('seq');
--dg-cascade
--dg execute p2;
--dg-cascade
--dg drop sequence seq;
--dg-skip: CREATE SEQUENCE supports only START and INCREMENT yet, not TEMPORARY or UNLOGGED
--dg create temp sequence seq;
--dg-cascade
--dg execute p2;
-- Check DDL via SPI, immediately followed by SPI plan re-use
-- (bug in original coding)
--dg-skip: language "?" does not exist
--dg create function cachebug() returns void as $$
--dg declare r int;
--dg begin
--dg   drop table if exists temptable cascade;
--dg   create temp table temptable as select * from generate_series(1,3) as f1;
--dg   create temp view vv as select * from temptable;
--dg   for r in select * from vv loop
--dg     raise notice '%', r;
--dg   end loop;
--dg end$$ language plpgsql;
--dg-cascade
--dg select cachebug();
--dg-cascade
--dg select cachebug();
-- Check that addition or removal of any partition is correctly dealt with by
-- default partition table when it is being used in prepared statement.
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table pc_list_parted (a int) partition by list(a);
--dg-cascade
--dg create table pc_list_part_null partition of pc_list_parted for values in (null);
--dg-cascade
--dg create table pc_list_part_1 partition of pc_list_parted for values in (1);
--dg-cascade
--dg create table pc_list_part_def partition of pc_list_parted default;
--dg-cascade
--dg prepare pstmt_def_insert (int) as insert into pc_list_part_def values($1);
-- should fail
--dg-cascade
--dg execute pstmt_def_insert(null);
--dg-cascade
--dg execute pstmt_def_insert(1);
--dg-cascade
--dg create table pc_list_part_2 partition of pc_list_parted for values in (2);
--dg-cascade
--dg execute pstmt_def_insert(2);
--dg-cascade
--dg alter table pc_list_parted detach partition pc_list_part_null;
-- should be ok
--dg-cascade
--dg execute pstmt_def_insert(null);
--dg-cascade
--dg drop table pc_list_part_1;
-- should be ok
--dg-cascade
--dg execute pstmt_def_insert(1);
--dg-cascade
--dg drop table pc_list_parted, pc_list_part_null;
--dg-cascade
--dg deallocate pstmt_def_insert;
-- Test plan_cache_mode
create table test_mode (a int);
insert into test_mode select 1 from generate_series(1,1000) union all select 2;
create index on test_mode (a);
analyze test_mode;
prepare test_mode_pp (int) as select count(*) from test_mode where a = $1;
--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
-- up to 5 executions, custom plan is used
set plan_cache_mode to auto;
explain (costs off) execute test_mode_pp(2);
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate
   ->  Index Only Scan using test_mode_a_idx on test_mode
         Index Cond: (a = 2)
(3 rows)

--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
-- force generic plan
set plan_cache_mode to force_generic_plan;
explain (costs off) execute test_mode_pp(2);
         QUERY PLAN          
-----------------------------
 Aggregate
   ->  Seq Scan on test_mode
         Filter: (a = $1)
(3 rows)

--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
-- get to generic plan by 5 executions
set plan_cache_mode to auto;
execute test_mode_pp(1); -- 1x
 count 
-------
  1000
(1 row)

execute test_mode_pp(1); -- 2x
 count 
-------
  1000
(1 row)

execute test_mode_pp(1); -- 3x
 count 
-------
  1000
(1 row)

execute test_mode_pp(1); -- 4x
 count 
-------
  1000
(1 row)

--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
execute test_mode_pp(1); -- 5x
 count 
-------
  1000
(1 row)

--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
-- we should now get a really bad plan
explain (costs off) execute test_mode_pp(2);
         QUERY PLAN          
-----------------------------
 Aggregate
   ->  Seq Scan on test_mode
         Filter: (a = $1)
(3 rows)

-- but we can force a custom plan
set plan_cache_mode to force_custom_plan;
explain (costs off) execute test_mode_pp(2);
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate
   ->  Index Only Scan using test_mode_a_idx on test_mode
         Index Cond: (a = 2)
(3 rows)

--dg-skip: relation "?" does not exist
--dg select name, generic_plans, custom_plans from pg_prepared_statements
--dg   where  name = 'test_mode_pp';
drop table test_mode;
