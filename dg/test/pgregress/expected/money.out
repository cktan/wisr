--
-- MONEY
--
-- Note that we assume lc_monetary has been set to C.
--
--dg-skip: type ? is not supported yet
--dg CREATE TABLE money_data (m money);
--dg-cascade
--dg INSERT INTO money_data VALUES ('123');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg SELECT m + '123' FROM money_data;
--dg-cascade
--dg SELECT m + '123.45' FROM money_data;
--dg-cascade
--dg SELECT m - '123.45' FROM money_data;
--dg-cascade
--dg SELECT m / '2'::money FROM money_data;
--dg-cascade
--dg SELECT m * 2 FROM money_data;
--dg-cascade
--dg SELECT 2 * m FROM money_data;
--dg-cascade
--dg SELECT m / 2 FROM money_data;
--dg-cascade
--dg SELECT m * 2::int2 FROM money_data;
--dg-cascade
--dg SELECT 2::int2 * m FROM money_data;
--dg-cascade
--dg SELECT m / 2::int2 FROM money_data;
--dg-cascade
--dg SELECT m * 2::int8 FROM money_data;
--dg-cascade
--dg SELECT 2::int8 * m FROM money_data;
--dg-cascade
--dg SELECT m / 2::int8 FROM money_data;
--dg-cascade
--dg SELECT m * 2::float8 FROM money_data;
--dg-cascade
--dg SELECT 2::float8 * m FROM money_data;
--dg-cascade
--dg SELECT m / 2::float8 FROM money_data;
--dg-cascade
--dg SELECT m * 2::float4 FROM money_data;
--dg-cascade
--dg SELECT 2::float4 * m FROM money_data;
--dg-cascade
--dg SELECT m / 2::float4 FROM money_data;
-- All true
--dg-cascade
--dg SELECT m = '$123.00' FROM money_data;
--dg-cascade
--dg SELECT m != '$124.00' FROM money_data;
--dg-cascade
--dg SELECT m <= '$123.00' FROM money_data;
--dg-cascade
--dg SELECT m >= '$123.00' FROM money_data;
--dg-cascade
--dg SELECT m < '$124.00' FROM money_data;
--dg-cascade
--dg SELECT m > '$122.00' FROM money_data;
-- All false
--dg-cascade
--dg SELECT m = '$123.01' FROM money_data;
--dg-cascade
--dg SELECT m != '$123.00' FROM money_data;
--dg-cascade
--dg SELECT m <= '$122.99' FROM money_data;
--dg-cascade
--dg SELECT m >= '$123.01' FROM money_data;
--dg-cascade
--dg SELECT m > '$124.00' FROM money_data;
--dg-cascade
--dg SELECT m < '$122.00' FROM money_data;
--dg-cascade
--dg SELECT cashlarger(m, '$124.00') FROM money_data;
--dg-cascade
--dg SELECT cashsmaller(m, '$124.00') FROM money_data;
--dg-cascade
--dg SELECT cash_words(m) FROM money_data;
--dg-cascade
--dg SELECT cash_words(m + '1.23') FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.45');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.451');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.454');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.455');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.456');
--dg-cascade
--dg SELECT * FROM money_data;
--dg-cascade
--dg DELETE FROM money_data;
--dg-cascade
--dg INSERT INTO money_data VALUES ('$123.459');
--dg-cascade
--dg SELECT * FROM money_data;
-- input checks
SELECT '1234567890'::money;
       money       
-------------------
 $1,234,567,890.00
(1 row)

SELECT '12345678901234567'::money;
           money            
----------------------------
 $12,345,678,901,234,567.00
(1 row)

SELECT '123456789012345678'::money;
