(1 row)

SELECT '($123,456.78)'::money;
    money     
--------------
 -$123,456.78
(1 row)

-- test non-error-throwing API
SELECT pg_input_is_valid('\x0001', 'money');
 pg_input_is_valid 
-------------------
 f
(1 row)

