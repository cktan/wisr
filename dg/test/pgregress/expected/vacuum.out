--dg-cascade
--dg ANALYZE past_inh_parent;
--dg-cascade
--dg SELECT reltuples, relhassubclass
--dg   FROM pg_class WHERE oid = 'past_inh_parent'::regclass;
--dg-cascade
--dg DROP TABLE past_inh_child;
--dg-cascade
--dg ANALYZE past_inh_parent;
--dg-cascade
--dg SELECT reltuples, relhassubclass
--dg   FROM pg_class WHERE oid = 'past_inh_parent'::regclass;
COMMIT;
