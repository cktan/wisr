--
-- Tests for ANALYZE ONLY / VACUUM ONLY on partitioned tables
--
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE only_parted (a int, b text) PARTITION BY LIST (a);
--dg-cascade
--dg CREATE TABLE only_parted1 PARTITION OF only_parted FOR VALUES IN (1);
--dg-cascade
--dg INSERT INTO only_parted VALUES (1, 'a');
-- Ensure only the partitioned table is analyzed
--dg-cascade
--dg ANALYZE ONLY only_parted;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_parted'::regclass, 'only_parted1'::regclass)
--dg   ORDER BY relname;
-- Ensure partitioned table and the partitions are analyzed
--dg-cascade
--dg ANALYZE only_parted;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_parted'::regclass, 'only_parted1'::regclass)
--dg   ORDER BY relname;
--dg-cascade
--dg DROP TABLE only_parted;
-- VACUUM ONLY on a partitioned table does nothing, ensure we get a warning.
--dg-cascade
--dg VACUUM ONLY vacparted;
-- Try ANALYZE ONLY with a column list
--dg-skip: ANALYZE of chosen columns is not supported yet
--dg ANALYZE ONLY vacparted(a,b);
--
-- Tests for VACUUM ONLY / ANALYZE ONLY on inheritance tables
--
CREATE TABLE only_inh_parent (a int primary key, b TEXT);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE only_inh_child () INHERITS (only_inh_parent);
--dg-cascade
--dg INSERT INTO only_inh_child(a,b) VALUES (1, 'aaa'), (2, 'bbb'), (3, 'ccc');
-- Ensure only parent is analyzed
ANALYZE ONLY only_inh_parent;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_inh_parent'::regclass, 'only_inh_child'::regclass)
--dg   ORDER BY relname;
-- Ensure the parent and child are analyzed
ANALYZE only_inh_parent;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_inh_parent'::regclass, 'only_inh_child'::regclass)
--dg   ORDER BY relname;
-- Ensure only the parent is vacuumed
VACUUM ONLY only_inh_parent;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_inh_parent'::regclass, 'only_inh_child'::regclass)
--dg   ORDER BY relname;
-- Ensure parent and child are vacuumed
VACUUM only_inh_parent;
--dg-cascade
--dg SELECT relname, last_analyze IS NOT NULL AS analyzed, last_vacuum IS NOT NULL AS vacuumed
--dg   FROM pg_stat_user_tables
--dg   WHERE relid IN ('only_inh_parent'::regclass, 'only_inh_child'::regclass)
--dg   ORDER BY relname;
--dg-cascade
--dg DROP TABLE only_inh_parent CASCADE;
-- parenthesized syntax for ANALYZE
ANALYZE (VERBOSE) does_not_exist;
ERROR:  relation "does_not_exist" does not exist
ANALYZE (nonexistent-arg) does_not_exist;
ERROR:  syntax error at or near "arg"
LINE 1: ANALYZE (nonexistent-arg) does_not_exist;
                             ^
ANALYZE (nonexistentarg) does_not_exit;
ERROR:  unrecognized ANALYZE option "nonexistentarg"
LINE 1: ANALYZE (nonexistentarg) does_not_exit;
                 ^
-- ensure argument order independence, and that SKIP_LOCKED on non-existing
-- relation still errors out.  Suppress WARNING messages caused by concurrent
-- autovacuums.
SET client_min_messages TO 'ERROR';
ANALYZE (SKIP_LOCKED, VERBOSE) does_not_exist;
ERROR:  relation "does_not_exist" does not exist
ANALYZE (VERBOSE, SKIP_LOCKED) does_not_exist;
ERROR:  relation "does_not_exist" does not exist
-- SKIP_LOCKED option
VACUUM (SKIP_LOCKED) vactst;
VACUUM (SKIP_LOCKED, FULL) vactst;
ANALYZE (SKIP_LOCKED) vactst;
RESET client_min_messages;
-- ensure VACUUM and ANALYZE don't have a problem with serializable
SET default_transaction_isolation = serializable;
VACUUM vactst;
ANALYZE vactst;
RESET default_transaction_isolation;
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;
ANALYZE vactst;
COMMIT;
-- PROCESS_TOAST option
CREATE TABLE vac_option_tab (a INT, t TEXT);
INSERT INTO vac_option_tab SELECT a, 't' || a FROM generate_series(1, 10) AS a;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg ALTER TABLE vac_option_tab ALTER COLUMN t SET STORAGE EXTERNAL;
-- Check the number of vacuums done on table vac_option_tab and on its
-- toast relation, to check that PROCESS_TOAST and PROCESS_MAIN work on
-- what they should.
--dg-skip: relation "?" does not exist
--dg CREATE VIEW vac_option_tab_counts AS
--dg   SELECT CASE WHEN c.relname IS NULL
--dg     THEN 'main' ELSE 'toast' END as rel,
--dg   s.vacuum_count
--dg   FROM pg_stat_all_tables s
--dg   LEFT JOIN pg_class c ON s.relid = c.reltoastrelid
--dg   WHERE c.relname = 'vac_option_tab' OR s.relname = 'vac_option_tab'
--dg   ORDER BY rel;
VACUUM (PROCESS_TOAST TRUE) vac_option_tab;
--dg-cascade
--dg SELECT * FROM vac_option_tab_counts;
VACUUM (PROCESS_TOAST FALSE) vac_option_tab;
--dg-cascade
--dg SELECT * FROM vac_option_tab_counts;
--dg-differs: no error where PostgreSQL has: PROCESS_TOAST required with VACUUM FULL
--dg VACUUM (PROCESS_TOAST FALSE, FULL) vac_option_tab; -- error
-- PROCESS_MAIN option
-- Only the toast table is processed.
VACUUM (PROCESS_MAIN FALSE) vac_option_tab;
--dg-cascade
--dg SELECT * FROM vac_option_tab_counts;
-- Nothing is processed.
VACUUM (PROCESS_MAIN FALSE, PROCESS_TOAST FALSE) vac_option_tab;
--dg-cascade
--dg SELECT * FROM vac_option_tab_counts;
-- Check if the filenodes nodes have been updated as wanted after FULL.
SELECT relfilenode AS main_filenode FROM pg_class
  WHERE relname = 'vac_option_tab' \gset
--dg-differs: the result
--dg SELECT t.relfilenode AS toast_filenode FROM pg_class c, pg_class t
--dg   WHERE c.reltoastrelid = t.oid AND c.relname = 'vac_option_tab' \gset
-- Only the toast relation is processed.
VACUUM (PROCESS_MAIN FALSE, FULL) vac_option_tab;
SELECT relfilenode = :main_filenode AS is_same_main_filenode
  FROM pg_class WHERE relname = 'vac_option_tab';
 is_same_main_filenode 
-----------------------
 t
(1 row)

--dg-cascade
--dg SELECT t.relfilenode = :toast_filenode AS is_same_toast_filenode
--dg   FROM pg_class c, pg_class t
--dg   WHERE c.reltoastrelid = t.oid AND c.relname = 'vac_option_tab';
-- BUFFER_USAGE_LIMIT option
VACUUM (BUFFER_USAGE_LIMIT '512 kB') vac_option_tab;
--dg-skip: unrecognized ANALYZE option "?"
--dg ANALYZE (BUFFER_USAGE_LIMIT '512 kB') vac_option_tab;
-- try disabling the buffer usage limit
VACUUM (BUFFER_USAGE_LIMIT 0) vac_option_tab;
--dg-skip: unrecognized ANALYZE option "?"
--dg ANALYZE (BUFFER_USAGE_LIMIT 0) vac_option_tab;
-- value exceeds max size error
--dg-differs: no error where PostgreSQL has: BUFFER_USAGE_LIMIT option must be N or between N kB and N kB
--dg VACUUM (BUFFER_USAGE_LIMIT 16777220) vac_option_tab;
-- value is less than min size error
--dg-differs: no error where PostgreSQL has: BUFFER_USAGE_LIMIT option must be N or between N kB and N kB
--dg VACUUM (BUFFER_USAGE_LIMIT 120) vac_option_tab;
-- integer overflow error
--dg-differs: no error where PostgreSQL has: BUFFER_USAGE_LIMIT option must be N or between N kB and N kB
--dg VACUUM (BUFFER_USAGE_LIMIT 10000000000) vac_option_tab;
-- incompatible with VACUUM FULL error
--dg-differs: no error where PostgreSQL has: BUFFER_USAGE_LIMIT cannot be specified for VACUUM FULL
--dg VACUUM (BUFFER_USAGE_LIMIT '512 kB', FULL) vac_option_tab;
-- SKIP_DATABASE_STATS option
VACUUM (SKIP_DATABASE_STATS) vactst;
-- ONLY_DATABASE_STATS option
VACUUM (ONLY_DATABASE_STATS);
--dg-differs: no error where PostgreSQL has: ONLY_DATABASE_STATS cannot be specified with a list of tables
--dg VACUUM (ONLY_DATABASE_STATS) vactst;  -- error
--dg-cascade
--dg DROP VIEW vac_option_tab_counts;
DROP TABLE vac_option_tab;
DROP TABLE vaccluster;
DROP TABLE vactst;
--dg-cascade
--dg DROP TABLE vacparted;
DROP TABLE no_index_cleanup;
-- relation ownership, WARNING logs generated as all are skipped.
CREATE TABLE vacowned (a int);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE vacowned_parted (a int) PARTITION BY LIST (a);
--dg-cascade
--dg CREATE TABLE vacowned_part1 PARTITION OF vacowned_parted FOR VALUES IN (1);
--dg-cascade
--dg CREATE TABLE vacowned_part2 PARTITION OF vacowned_parted FOR VALUES IN (2);
CREATE ROLE regress_vacuum;
SET ROLE regress_vacuum;
-- Simple table
VACUUM vacowned;
WARNING:  permission denied to vacuum "vacowned", skipping it
ANALYZE vacowned;
WARNING:  permission denied to analyze "vacowned", skipping it
--dg-differs: the result
--dg VACUUM (ANALYZE) vacowned;
-- Catalog
VACUUM pg_catalog.pg_class;
WARNING:  permission denied to vacuum "pg_class", skipping it
ANALYZE pg_catalog.pg_class;
WARNING:  permission denied to analyze "pg_class", skipping it
--dg-differs: the result
--dg VACUUM (ANALYZE) pg_catalog.pg_class;
-- Shared catalog
VACUUM pg_catalog.pg_authid;
WARNING:  permission denied to vacuum "pg_authid", skipping it
ANALYZE pg_catalog.pg_authid;
WARNING:  permission denied to analyze "pg_authid", skipping it
--dg-differs: the result
--dg VACUUM (ANALYZE) pg_catalog.pg_authid;
-- Partitioned table and its partitions, nothing owned by other user.
-- Relations are not listed in a single command to test ownership
-- independently.
--dg-cascade
--dg VACUUM vacowned_parted;
--dg-cascade
--dg VACUUM vacowned_part1;
--dg-cascade
--dg VACUUM vacowned_part2;
--dg-cascade
--dg ANALYZE vacowned_parted;
--dg-cascade
--dg ANALYZE vacowned_part1;
--dg-cascade
--dg ANALYZE vacowned_part2;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_parted;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part1;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part2;
RESET ROLE;
-- Partitioned table and one partition owned by other user.
--dg-cascade
--dg ALTER TABLE vacowned_parted OWNER TO regress_vacuum;
--dg-cascade
--dg ALTER TABLE vacowned_part1 OWNER TO regress_vacuum;
SET ROLE regress_vacuum;
--dg-cascade
--dg VACUUM vacowned_parted;
--dg-cascade
--dg VACUUM vacowned_part1;
--dg-cascade
--dg VACUUM vacowned_part2;
--dg-cascade
--dg ANALYZE vacowned_parted;
--dg-cascade
--dg ANALYZE vacowned_part1;
--dg-cascade
--dg ANALYZE vacowned_part2;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_parted;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part1;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part2;
RESET ROLE;
-- Only one partition owned by other user.
--dg-cascade
--dg ALTER TABLE vacowned_parted OWNER TO CURRENT_USER;
SET ROLE regress_vacuum;
--dg-cascade
--dg VACUUM vacowned_parted;
--dg-cascade
--dg VACUUM vacowned_part1;
--dg-cascade
--dg VACUUM vacowned_part2;
--dg-cascade
--dg ANALYZE vacowned_parted;
--dg-cascade
--dg ANALYZE vacowned_part1;
--dg-cascade
--dg ANALYZE vacowned_part2;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_parted;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part1;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part2;
RESET ROLE;
-- Only partitioned table owned by other user.
--dg-cascade
--dg ALTER TABLE vacowned_parted OWNER TO regress_vacuum;
--dg-cascade
--dg ALTER TABLE vacowned_part1 OWNER TO CURRENT_USER;
SET ROLE regress_vacuum;
--dg-cascade
--dg VACUUM vacowned_parted;
--dg-cascade
--dg VACUUM vacowned_part1;
--dg-cascade
--dg VACUUM vacowned_part2;
--dg-cascade
--dg ANALYZE vacowned_parted;
--dg-cascade
--dg ANALYZE vacowned_part1;
--dg-cascade
--dg ANALYZE vacowned_part2;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_parted;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part1;
--dg-cascade
--dg VACUUM (ANALYZE) vacowned_part2;
RESET ROLE;
DROP TABLE vacowned;
--dg-cascade
--dg DROP TABLE vacowned_parted;
DROP ROLE regress_vacuum;
