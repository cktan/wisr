-- ALTER OPERATOR FAMILY ... ADD/DROP
-- Should work. Textbook case of CREATE / ALTER ADD / ALTER DROP / DROP
BEGIN TRANSACTION;
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg CREATE OPERATOR FAMILY alt_opf4 USING btree;
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD
--dg   -- int4 vs int2
--dg   OPERATOR 1 < (int4, int2) ,
--dg   OPERATOR 2 <= (int4, int2) ,
--dg   OPERATOR 3 = (int4, int2) ,
--dg   OPERATOR 4 >= (int4, int2) ,
--dg   OPERATOR 5 > (int4, int2) ,
--dg   FUNCTION 1 btint42cmp(int4, int2);
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree DROP
--dg   -- int4 vs int2
--dg   OPERATOR 1 (int4, int2) ,
--dg   OPERATOR 2 (int4, int2) ,
--dg   OPERATOR 3 (int4, int2) ,
--dg   OPERATOR 4 (int4, int2) ,
--dg   OPERATOR 5 (int4, int2) ,
--dg   FUNCTION 1 (int4, int2) ;
--dg-cascade
--dg DROP OPERATOR FAMILY alt_opf4 USING btree;
ROLLBACK;
-- Should fail. Invalid values for ALTER OPERATOR FAMILY .. ADD / DROP
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg CREATE OPERATOR FAMILY alt_opf4 USING btree;
ALTER OPERATOR FAMILY alt_opf4 USING invalid_index_method ADD  OPERATOR 1 < (int4, int2); -- invalid indexing_method
ERROR:  access method "invalid_index_method" does not exist
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD OPERATOR 6 < (int4, int2); -- operator number should be between 1 and 5
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD OPERATOR 0 < (int4, int2); -- operator number should be between 1 and 5
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD OPERATOR 1 < ; -- operator without argument types
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD FUNCTION 0 btint42cmp(int4, int2); -- invalid options parsing function
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD FUNCTION 7 btint42cmp(int4, int2); -- function number should be between 1 and 6
--dg-cascade
--dg ALTER OPERATOR FAMILY alt_opf4 USING btree ADD STORAGE invalid_storage; -- Ensure STORAGE is not a part of ALTER OPERATOR FAMILY
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg DROP OPERATOR FAMILY alt_opf4 USING btree;
