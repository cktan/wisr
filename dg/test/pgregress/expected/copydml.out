--dg-skip: language "?" does not exist
--dg create function qqq_trig() returns trigger as $$
--dg begin
--dg if tg_op in ('INSERT', 'UPDATE') then
--dg     raise notice '% % %', tg_when, tg_op, new.id;
--dg     return new;
--dg else
--dg     raise notice '% % %', tg_when, tg_op, old.id;
--dg     return old;
--dg end if;
--dg end
--dg $$ language plpgsql;
--dg-cascade
--dg create trigger qqqbef before insert or update or delete on copydml_test
