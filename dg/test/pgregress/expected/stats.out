-- Test that resetting stats works for reset timestamp
-----
-- Test that reset_slru with a specified SLRU works.
--dg-skip: relation "?" does not exist
--dg SELECT stats_reset AS slru_commit_ts_reset_ts FROM pg_stat_slru WHERE name = 'commit_timestamp' \gset
--dg-skip: relation "?" does not exist
--dg SELECT stats_reset AS slru_notify_reset_ts FROM pg_stat_slru WHERE name = 'notify' \gset
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_reset_slru('commit_timestamp');
