--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_oid);
DROP TABLE drop_stats_test;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_oid);
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_oid);
-- check that rollback protects against having stats dropped and that local
-- modifications don't pose a problem
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_xact_oid);
--dg-cascade
--dg SELECT pg_stat_get_tuples_inserted(:drop_stats_test_xact_oid);
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_xact_oid);
BEGIN;
INSERT INTO drop_stats_test_xact DEFAULT VALUES;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_xact_oid);
DROP TABLE drop_stats_test_xact;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_xact_oid);
ROLLBACK;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_force_next_flush();
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_xact_oid);
--dg-cascade
--dg SELECT pg_stat_get_tuples_inserted(:drop_stats_test_xact_oid);
-- transactional drop
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_xact_oid);
--dg-cascade
--dg SELECT pg_stat_get_tuples_inserted(:drop_stats_test_xact_oid);
BEGIN;
INSERT INTO drop_stats_test_xact DEFAULT VALUES;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_xact_oid);
--dg-skip: current transaction is aborted, commands ignored until end of transaction block
--dg DROP TABLE drop_stats_test_xact;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_xact_oid);
COMMIT;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_force_next_flush();
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_xact_oid);
--dg-cascade
--dg SELECT pg_stat_get_tuples_inserted(:drop_stats_test_xact_oid);
-- savepoint rollback (2 levels)
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
BEGIN;
INSERT INTO drop_stats_test_subxact DEFAULT VALUES;
SAVEPOINT sp1;
INSERT INTO drop_stats_test_subxact DEFAULT VALUES;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_subxact_oid);
--dg-skip: current transaction is aborted, commands ignored until end of transaction block
--dg SAVEPOINT sp2;
DROP TABLE drop_stats_test_subxact;
--dg-cascade
--dg ROLLBACK TO SAVEPOINT sp2;
--dg-cascade
--dg SELECT pg_stat_get_xact_tuples_inserted(:drop_stats_test_subxact_oid);
COMMIT;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_force_next_flush();
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
-- savepoint rolback (1 level)
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
BEGIN;
SAVEPOINT sp1;
--dg-cascade
--dg DROP TABLE drop_stats_test_subxact;
--dg-cascade
--dg SAVEPOINT sp2;
ROLLBACK TO SAVEPOINT sp1;
COMMIT;
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
-- and now actually drop
--dg-cascade
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
BEGIN;
SAVEPOINT sp1;
--dg-cascade
--dg DROP TABLE drop_stats_test_subxact;
--dg-cascade
--dg SAVEPOINT sp2;
--dg-cascade
--dg RELEASE SAVEPOINT sp1;
COMMIT;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_get_live_tuples(:drop_stats_test_subxact_oid);
DROP TABLE trunc_stats_test, trunc_stats_test1, trunc_stats_test2, trunc_stats_test3, trunc_stats_test4;
--dg-cascade
