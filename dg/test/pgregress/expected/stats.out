-- Basic tests for track_functions
---
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION stats_test_func1() RETURNS VOID LANGUAGE plpgsql AS $$BEGIN END;$$;
--dg-cascade
--dg SELECT 'stats_test_func1()'::regprocedure::oid AS stats_test_func1_oid \gset
--dg-skip: language "?" does not exist
