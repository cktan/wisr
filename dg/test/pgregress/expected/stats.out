-- test that stats are accumulated
BEGIN;
--dg-skip: unrecognized configuration parameter "?"
--dg SET LOCAL stats_fetch_consistency = none;
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func1_oid);
--dg-cascade
--dg SELECT pg_stat_get_xact_function_calls(:stats_test_func1_oid);
--dg-cascade
--dg SELECT stats_test_func1();
--dg-cascade
--dg SELECT pg_stat_get_xact_function_calls(:stats_test_func1_oid);
--dg-cascade
--dg SELECT stats_test_func1();
--dg-cascade
--dg SELECT pg_stat_get_xact_function_calls(:stats_test_func1_oid);
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func1_oid);
COMMIT;
-- Verify that function stats are not transactional
-- rolled back savepoint in committing transaction
BEGIN;
--dg-cascade
--dg SELECT stats_test_func2();
--dg-cascade
--dg SAVEPOINT foo;
--dg-cascade
--dg SELECT stats_test_func2();
--dg-cascade
--dg ROLLBACK TO SAVEPOINT foo;
--dg-cascade
--dg SELECT pg_stat_get_xact_function_calls(:stats_test_func2_oid);
--dg-cascade
--dg SELECT stats_test_func2();
COMMIT;
-- rolled back transaction
BEGIN;
--dg-cascade
--dg SELECT stats_test_func2();
ROLLBACK;
--dg-skip: function ?(...) does not exist
--dg SELECT pg_stat_force_next_flush();
-- check collected stats
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func1_oid;
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func2_oid;
-- check that a rolled back drop function stats leaves stats alive
BEGIN;
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func1_oid;
--dg-cascade
--dg DROP FUNCTION stats_test_func1();
-- shouldn't be visible via view
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func1_oid;
-- but still via oid access
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func1_oid);
ROLLBACK;
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func1_oid;
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func1_oid);
-- check that function dropped in main transaction leaves no stats behind
BEGIN;
--dg-cascade
--dg DROP FUNCTION stats_test_func1();
COMMIT;
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func1_oid;
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func1_oid);
-- check that function dropped in a subtransaction leaves no stats behind
BEGIN;
--dg-cascade
--dg SELECT stats_test_func2();
--dg-cascade
--dg SAVEPOINT a;
--dg-cascade
--dg SELECT stats_test_func2();
--dg-cascade
--dg SAVEPOINT b;
--dg-cascade
--dg DROP FUNCTION stats_test_func2();
COMMIT;
--dg-cascade
--dg SELECT funcname, calls FROM pg_stat_user_functions WHERE funcid = :stats_test_func2_oid;
--dg-cascade
--dg SELECT pg_stat_get_function_calls(:stats_test_func2_oid);
-- Check that stats for relations are dropped. For that we need to access stats
-- by oid after the DROP TABLE. Save oids.
CREATE TABLE drop_stats_test();
INSERT INTO drop_stats_test DEFAULT VALUES;
SELECT 'drop_stats_test'::regclass::oid AS drop_stats_test_oid \gset
CREATE TABLE drop_stats_test_xact();
INSERT INTO drop_stats_test_xact DEFAULT VALUES;
SELECT 'drop_stats_test_xact'::regclass::oid AS drop_stats_test_xact_oid \gset
CREATE TABLE drop_stats_test_subxact();
