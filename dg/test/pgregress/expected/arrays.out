--dg update arrtest1 set i[2] = 22, t[2] = 'twenty-two';
--dg-cascade
--dg select * from arrtest1;
--dg-cascade
--dg update arrtest1 set i[5] = 5, t[5] = 'five';
--dg-cascade
--dg select * from arrtest1;
--dg-cascade
--dg update arrtest1 set i[8] = 8, t[8] = 'eight';
--dg-cascade
--dg select * from arrtest1;
