-- only use parallelism when explicitly intending to do so
--dg-skip: unrecognized configuration parameter "?"
--dg SET max_parallel_maintenance_workers = 0;
--dg-skip: unrecognized configuration parameter "?"
--dg SET max_parallel_workers = 0;
-- A table with contents that, when sorted, triggers abbreviated
-- key aborts. One easy way to achieve that is to use uuids that all
-- have the same prefix, as abbreviated keys for uuids just use the
-- first sizeof(Datum) bytes.
--dg-skip: CREATE SEQUENCE supports only START and INCREMENT yet, not TEMPORARY or UNLOGGED
--dg CREATE TEMP TABLE abbrev_abort_uuids (
--dg     id serial not null,
--dg     abort_increasing uuid,
--dg     abort_decreasing uuid,
--dg     noabort_increasing uuid,
--dg     noabort_decreasing uuid);
--dg-cascade
--dg INSERT INTO abbrev_abort_uuids (abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing)
--dg     SELECT
--dg         ('00000000-0000-0000-0000-'||to_char(g.i, '000000000000FM'))::uuid abort_increasing,
--dg         ('00000000-0000-0000-0000-'||to_char(20000 - g.i, '000000000000FM'))::uuid abort_decreasing,
--dg         (to_char(g.i % 10009, '00000000FM')||'-0000-0000-0000-'||to_char(g.i, '000000000000FM'))::uuid noabort_increasing,
--dg         (to_char(((20000 - g.i) % 10009), '00000000FM')||'-0000-0000-0000-'||to_char(20000 - g.i, '000000000000FM'))::uuid noabort_decreasing
--dg     FROM generate_series(0, 20000, 1) g(i);
-- and a few NULLs
--dg-cascade
--dg INSERT INTO abbrev_abort_uuids(id) VALUES(0);
--dg-cascade
--dg INSERT INTO abbrev_abort_uuids DEFAULT VALUES;
--dg-cascade
--dg INSERT INTO abbrev_abort_uuids DEFAULT VALUES;
-- add just a few duplicates
--dg-cascade
--dg INSERT INTO abbrev_abort_uuids (abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing)
--dg     SELECT abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg     FROM abbrev_abort_uuids
--dg     WHERE (id < 10 OR id > 19990) AND id % 3 = 0 AND abort_increasing is not null;
----
-- Check sort node uses of tuplesort wrt. abbreviated keys
----
-- plain sort triggering abbreviated abort
--dg-cascade
--dg SELECT abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_increasing OFFSET 20000 - 4;
--dg-cascade
--dg SELECT abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_decreasing NULLS FIRST OFFSET 20000 - 4;
-- plain sort not triggering abbreviated abort
--dg-cascade
--dg SELECT noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_increasing OFFSET 20000 - 4;
--dg-cascade
--dg SELECT noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing NULLS FIRST OFFSET 20000 - 4;
-- bounded sort (disables abbreviated keys)
--dg-cascade
--dg SELECT abort_increasing, noabort_increasing FROM abbrev_abort_uuids ORDER BY abort_increasing LIMIT 5;
--dg-cascade
--dg SELECT abort_increasing, noabort_increasing FROM abbrev_abort_uuids ORDER BY noabort_increasing NULLS FIRST LIMIT 5;
----
-- Check index creation uses of tuplesort wrt. abbreviated keys
----
-- index creation using abbreviated keys successfully
--dg-cascade
--dg CREATE INDEX abbrev_abort_uuids__noabort_increasing_idx ON abbrev_abort_uuids (noabort_increasing);
--dg-cascade
--dg CREATE INDEX abbrev_abort_uuids__noabort_decreasing_idx ON abbrev_abort_uuids (noabort_decreasing);
-- verify
--dg-cascade
--dg EXPLAIN (COSTS OFF)
--dg SELECT id, noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_increasing LIMIT 5;
--dg-cascade
--dg SELECT id, noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_increasing LIMIT 5;
--dg-cascade
--dg EXPLAIN (COSTS OFF)
--dg SELECT id, noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing LIMIT 5;
--dg-cascade
--dg SELECT id, noabort_increasing, noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing LIMIT 5;
-- index creation using abbreviated keys, hitting abort
--dg-cascade
--dg CREATE INDEX abbrev_abort_uuids__abort_increasing_idx ON abbrev_abort_uuids (abort_increasing);
--dg-cascade
--dg CREATE INDEX abbrev_abort_uuids__abort_decreasing_idx ON abbrev_abort_uuids (abort_decreasing);
-- verify
--dg-cascade
--dg EXPLAIN (COSTS OFF)
--dg SELECT id, abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_increasing LIMIT 5;
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_increasing LIMIT 5;
--dg-cascade
--dg EXPLAIN (COSTS OFF)
--dg SELECT id, abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_decreasing LIMIT 5;
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing FROM abbrev_abort_uuids ORDER BY abort_decreasing LIMIT 5;
----
-- Check CLUSTER uses of tuplesort wrt. abbreviated keys
----
-- when aborting, increasing order
BEGIN;
SET LOCAL enable_indexscan = false;
--dg-cascade
--dg CLUSTER abbrev_abort_uuids USING abbrev_abort_uuids__abort_increasing_idx;
-- head
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid LIMIT 5;
-- tail
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid DESC LIMIT 5;
ROLLBACK;
-- when aborting, decreasing order
BEGIN;
SET LOCAL enable_indexscan = false;
--dg-cascade
--dg CLUSTER abbrev_abort_uuids USING abbrev_abort_uuids__abort_decreasing_idx;
-- head
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid LIMIT 5;
-- tail
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid DESC LIMIT 5;
ROLLBACK;
-- when not aborting, increasing order
BEGIN;
SET LOCAL enable_indexscan = false;
--dg-cascade
--dg CLUSTER abbrev_abort_uuids USING abbrev_abort_uuids__noabort_increasing_idx;
-- head
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid LIMIT 5;
-- tail
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid DESC LIMIT 5;
ROLLBACK;
-- when no aborting, decreasing order
BEGIN;
SET LOCAL enable_indexscan = false;
--dg-cascade
--dg CLUSTER abbrev_abort_uuids USING abbrev_abort_uuids__noabort_decreasing_idx;
-- head
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid LIMIT 5;
-- tail
--dg-cascade
--dg SELECT id, abort_increasing, abort_decreasing, noabort_increasing, noabort_decreasing
--dg FROM abbrev_abort_uuids
--dg ORDER BY ctid DESC LIMIT 5;
ROLLBACK;
----
-- test sorting of large datums VALUES
----
-- Ensure the order is correct and values look intact
SELECT LEFT(a,10),b FROM
    (VALUES(REPEAT('a', 512 * 1024),1),(REPEAT('b', 512 * 1024),2)) v(a,b)
ORDER BY v.a DESC;
    left    | b 
------------+---
 bbbbbbbbbb | 2
 aaaaaaaaaa | 1
(2 rows)

----
-- test forward and backward scans for in-memory and disk based tuplesort
----
-- in-memory
BEGIN;
SET LOCAL enable_indexscan = false;
-- unfortunately can't show analyze output confirming sort method,
-- the memory used output wouldn't be stable
--dg-cascade
--dg EXPLAIN (COSTS OFF) DECLARE c SCROLL CURSOR FOR SELECT noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing;
--dg-cascade
--dg DECLARE c SCROLL CURSOR FOR SELECT noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing;
-- first and second
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
-- scroll beyond beginning
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
-- scroll beyond end
--dg-cascade
--dg FETCH LAST FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
COMMIT;
-- disk based
BEGIN;
SET LOCAL enable_indexscan = false;
SET LOCAL work_mem = '100kB';
-- unfortunately can't show analyze output confirming sort method,
-- the memory used output wouldn't be stable
--dg-cascade
--dg EXPLAIN (COSTS OFF) DECLARE c SCROLL CURSOR FOR SELECT noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing;
--dg-cascade
--dg DECLARE c SCROLL CURSOR FOR SELECT noabort_decreasing FROM abbrev_abort_uuids ORDER BY noabort_decreasing;
-- first and second
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
-- scroll beyond beginning
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
-- scroll beyond end
--dg-cascade
--dg FETCH LAST FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
--dg-cascade
--dg FETCH BACKWARD FROM c;
--dg-cascade
--dg FETCH NEXT FROM c;
COMMIT;
----
-- test tuplesort using both in-memory and disk sort
---
-- memory based
--dg-cascade
--dg SELECT
--dg     -- fixed-width by-value datum
--dg     (array_agg(id ORDER BY id DESC NULLS FIRST))[0:5],
--dg     -- fixed-width by-ref datum
--dg     (array_agg(abort_increasing ORDER BY abort_increasing DESC NULLS LAST))[0:5],
--dg     -- variable-width datum
--dg     (array_agg(id::text ORDER BY id::text DESC NULLS LAST))[0:5],
--dg     -- fixed width by-value datum tuplesort
--dg     percentile_disc(0.99) WITHIN GROUP (ORDER BY id),
--dg     -- ensure state is shared
--dg     percentile_disc(0.01) WITHIN GROUP (ORDER BY id),
--dg     -- fixed width by-ref datum tuplesort
--dg     percentile_disc(0.8) WITHIN GROUP (ORDER BY abort_increasing),
--dg     -- variable width by-ref datum tuplesort
--dg     percentile_disc(0.2) WITHIN GROUP (ORDER BY id::text),
--dg     -- multi-column tuplesort
--dg     rank('00000000-0000-0000-0000-000000000000', '2', '2') WITHIN GROUP (ORDER BY noabort_increasing, id, id::text)
--dg FROM (
--dg     SELECT * FROM abbrev_abort_uuids
--dg     UNION ALL
--dg     SELECT NULL, NULL, NULL, NULL, NULL) s;
-- disk based (see also above)
BEGIN;
SET LOCAL work_mem = '100kB';
--dg-cascade
--dg SELECT
--dg     (array_agg(id ORDER BY id DESC NULLS FIRST))[0:5],
--dg     (array_agg(abort_increasing ORDER BY abort_increasing DESC NULLS LAST))[0:5],
--dg     (array_agg(id::text ORDER BY id::text DESC NULLS LAST))[0:5],
--dg     percentile_disc(0.99) WITHIN GROUP (ORDER BY id),
--dg     percentile_disc(0.01) WITHIN GROUP (ORDER BY id),
--dg     percentile_disc(0.8) WITHIN GROUP (ORDER BY abort_increasing),
--dg     percentile_disc(0.2) WITHIN GROUP (ORDER BY id::text),
--dg     rank('00000000-0000-0000-0000-000000000000', '2', '2') WITHIN GROUP (ORDER BY noabort_increasing, id, id::text)
--dg FROM (
--dg     SELECT * FROM abbrev_abort_uuids
--dg     UNION ALL
--dg     SELECT NULL, NULL, NULL, NULL, NULL) s;
ROLLBACK;
----
-- test tuplesort mark/restore
---
CREATE TEMP TABLE test_mark_restore(col1 int, col2 int, col12 int);
-- need a few duplicates for mark/restore to matter
INSERT INTO test_mark_restore(col1, col2, col12)
   SELECT a.i, b.i, a.i * b.i FROM generate_series(1, 500) a(i), generate_series(1, 5) b(i);
BEGIN;
SET LOCAL enable_nestloop = off;
SET LOCAL enable_hashjoin = off;
SET LOCAL enable_material = off;
-- set query into variable once, to avoid repetition of the fairly long query
SELECT $$
    SELECT col12, count(distinct a.col1), count(distinct a.col2), count(distinct b.col1), count(distinct b.col2), count(*)
    FROM test_mark_restore a
        JOIN test_mark_restore b USING(col12)
    GROUP BY 1
    HAVING count(*) > 1
    ORDER BY 2 DESC, 1 DESC, 3 DESC, 4 DESC, 5 DESC, 6 DESC
    LIMIT 10
$$ AS qry \gset
-- test mark/restore with in-memory sorts
EXPLAIN (COSTS OFF) :qry;
                                                                                 QUERY PLAN                                                                                  
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (count(DISTINCT a.col1)) DESC, a.col12 DESC, (count(DISTINCT a.col2)) DESC, (count(DISTINCT b.col1)) DESC, (count(DISTINCT b.col2)) DESC, (count(*)) DESC
         ->  GroupAggregate
               Group Key: a.col12
               Filter: (count(*) > 1)
               ->  Incremental Sort
                     Sort Key: a.col12 DESC, a.col1
                     Presorted Key: a.col12
                     ->  Merge Join
                           Merge Cond: (a.col12 = b.col12)
                           ->  Sort
                                 Sort Key: a.col12 DESC
                                 ->  Seq Scan on test_mark_restore a
                           ->  Sort
                                 Sort Key: b.col12 DESC
                                 ->  Seq Scan on test_mark_restore b
(17 rows)

:qry;
 col12 | count | count | count | count | count 
-------+-------+-------+-------+-------+-------
   480 |     5 |     5 |     5 |     5 |    25
   420 |     5 |     5 |     5 |     5 |    25
   360 |     5 |     5 |     5 |     5 |    25
   300 |     5 |     5 |     5 |     5 |    25
   240 |     5 |     5 |     5 |     5 |    25
   180 |     5 |     5 |     5 |     5 |    25
   120 |     5 |     5 |     5 |     5 |    25
    60 |     5 |     5 |     5 |     5 |    25
   960 |     4 |     4 |     4 |     4 |    16
   900 |     4 |     4 |     4 |     4 |    16
(10 rows)

-- test mark/restore with on-disk sorts
SET LOCAL work_mem = '100kB';
EXPLAIN (COSTS OFF) :qry;
                                                                                 QUERY PLAN                                                                                  
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (count(DISTINCT a.col1)) DESC, a.col12 DESC, (count(DISTINCT a.col2)) DESC, (count(DISTINCT b.col1)) DESC, (count(DISTINCT b.col2)) DESC, (count(*)) DESC
         ->  GroupAggregate
               Group Key: a.col12
               Filter: (count(*) > 1)
               ->  Incremental Sort
                     Sort Key: a.col12 DESC, a.col1
                     Presorted Key: a.col12
                     ->  Merge Join
                           Merge Cond: (a.col12 = b.col12)
                           ->  Sort
                                 Sort Key: a.col12 DESC
                                 ->  Seq Scan on test_mark_restore a
                           ->  Sort
                                 Sort Key: b.col12 DESC
                                 ->  Seq Scan on test_mark_restore b
(17 rows)

:qry;
 col12 | count | count | count | count | count 
-------+-------+-------+-------+-------+-------
   480 |     5 |     5 |     5 |     5 |    25
   420 |     5 |     5 |     5 |     5 |    25
   360 |     5 |     5 |     5 |     5 |    25
   300 |     5 |     5 |     5 |     5 |    25
   240 |     5 |     5 |     5 |     5 |    25
   180 |     5 |     5 |     5 |     5 |    25
   120 |     5 |     5 |     5 |     5 |    25
    60 |     5 |     5 |     5 |     5 |    25
   960 |     4 |     4 |     4 |     4 |    16
   900 |     4 |     4 |     4 |     4 |    16
(10 rows)

COMMIT;
