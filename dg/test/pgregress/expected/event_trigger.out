--dg 			undroppable_objs USING (object_type, object_identity)
--dg 	LOOP
--dg 		RAISE EXCEPTION 'object % of type % cannot be dropped',
--dg 			obj.object_identity, obj.object_type;
--dg 	END LOOP;
--dg END;
--dg $$;
