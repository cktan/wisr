-- With simple relation
CREATE TABLE concur_reindex_tab (c1 int);
CREATE INDEX concur_reindex_ind ON concur_reindex_tab (c1);
-- Both start and end triggers enabled.
--dg-cascade
--dg REINDEX INDEX concur_reindex_ind;
--dg-cascade
--dg REINDEX TABLE concur_reindex_tab;
--dg-cascade
--dg REINDEX INDEX CONCURRENTLY concur_reindex_ind;
--dg-cascade
--dg REINDEX TABLE CONCURRENTLY concur_reindex_tab;
-- with start trigger disabled.
--dg-skip: relation pg_event_trigger cannot be opened: digres has no catalog tables
--dg ALTER EVENT TRIGGER regress_reindex_start DISABLE;
--dg-cascade
--dg REINDEX INDEX concur_reindex_ind;
--dg-cascade
--dg REINDEX INDEX CONCURRENTLY concur_reindex_ind;
-- without an index
DROP INDEX concur_reindex_ind;
--dg-differs: the result
--dg REINDEX TABLE concur_reindex_tab;
--dg-differs: the result
--dg REINDEX TABLE CONCURRENTLY concur_reindex_tab;
-- With a Schema
CREATE SCHEMA concur_reindex_schema;
-- No indexes
--dg-differs: the result
--dg REINDEX SCHEMA concur_reindex_schema;
--dg-differs: the result
--dg REINDEX SCHEMA CONCURRENTLY concur_reindex_schema;
CREATE TABLE concur_reindex_schema.tab (a int);
CREATE INDEX ind ON concur_reindex_schema.tab (a);
-- One index reported
--dg-cascade
--dg REINDEX SCHEMA concur_reindex_schema;
--dg-cascade
--dg REINDEX SCHEMA CONCURRENTLY concur_reindex_schema;
-- One table on schema but no indexes
DROP INDEX concur_reindex_schema.ind;
--dg-differs: the result
--dg REINDEX SCHEMA concur_reindex_schema;
--dg-differs: the result
--dg REINDEX SCHEMA CONCURRENTLY concur_reindex_schema;
DROP SCHEMA concur_reindex_schema CASCADE;
NOTICE:  drop cascades to table concur_reindex_schema.tab
-- With a partitioned table, and nothing else.
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg CREATE TABLE concur_reindex_part (id int) PARTITION BY RANGE (id);
--dg-cascade
--dg REINDEX TABLE concur_reindex_part;
--dg-cascade
--dg REINDEX TABLE CONCURRENTLY concur_reindex_part;
-- Partition that would be reindexed, still nothing.
--dg-cascade
--dg CREATE TABLE concur_reindex_child PARTITION OF concur_reindex_part
--dg   FOR VALUES FROM (0) TO (10);
--dg-cascade
--dg REINDEX TABLE concur_reindex_part;
--dg-cascade
--dg REINDEX TABLE CONCURRENTLY concur_reindex_part;
-- Now add some indexes.
--dg-cascade
--dg CREATE INDEX concur_reindex_partidx ON concur_reindex_part (id);
--dg-cascade
--dg REINDEX INDEX concur_reindex_partidx;
--dg-cascade
--dg REINDEX INDEX CONCURRENTLY concur_reindex_partidx;
--dg-cascade
--dg REINDEX TABLE concur_reindex_part;
--dg-cascade
--dg REINDEX TABLE CONCURRENTLY concur_reindex_part;
--dg-cascade
--dg DROP TABLE concur_reindex_part;
-- Clean up
--dg-skip: relation pg_event_trigger cannot be opened: digres has no catalog tables
--dg DROP EVENT TRIGGER regress_reindex_start;
--dg-skip: relation pg_event_trigger cannot be opened: digres has no catalog tables
--dg DROP EVENT TRIGGER regress_reindex_end;
--dg-skip: relation pg_event_trigger cannot be opened: digres has no catalog tables
--dg DROP EVENT TRIGGER regress_reindex_end_snap;
--dg-cascade
--dg DROP FUNCTION reindex_end_command();
--dg-cascade
--dg DROP FUNCTION reindex_end_command_snap();
--dg-cascade
--dg DROP FUNCTION reindex_start_command();
DROP TABLE concur_reindex_tab;
