--
-- Test handling of vars from correlated subqueries in quals from outer
-- security barrier views, per bug #13988
--
--dg-cascade
--dg CREATE TABLE t1 (a int, b text, c int);
--dg-cascade
--dg INSERT INTO t1 VALUES (1, 'one', 10);
CREATE TABLE t2 (cc int);
INSERT INTO t2 VALUES (10), (20);
CREATE VIEW v1 WITH (security_barrier = true) AS
  SELECT * FROM t1 WHERE (a > 0)
  WITH CHECK OPTION;
--dg-cascade
--dg CREATE VIEW v2 WITH (security_barrier = true) AS
--dg   SELECT * FROM v1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.cc = v1.c)
--dg   WITH CHECK OPTION;
--dg-cascade
--dg INSERT INTO v2 VALUES (2, 'two', 20); -- ok
--dg-cascade
--dg INSERT INTO v2 VALUES (-2, 'minus two', 20); -- not allowed
--dg-cascade
--dg INSERT INTO v2 VALUES (3, 'three', 30); -- not allowed
--dg-cascade
--dg UPDATE v2 SET b = 'ONE' WHERE a = 1; -- ok
--dg-cascade
--dg UPDATE v2 SET a = -1 WHERE a = 1; -- not allowed
--dg-cascade
--dg UPDATE v2 SET c = 30 WHERE a = 1; -- not allowed
--dg-cascade
--dg DELETE FROM v2 WHERE a = 2; -- ok
--dg-cascade
--dg SELECT * FROM v2;
--dg-cascade
--dg DROP VIEW v2;
DROP VIEW v1;
DROP TABLE t2;
--dg-cascade
--dg DROP TABLE t1;
--
-- Test sub-select in nested security barrier views, per bug #17972
--
--dg-cascade
--dg CREATE TABLE t1 (a int);
CREATE VIEW v1 WITH (security_barrier = true) AS
  SELECT * FROM t1;
--dg-skip: relation pg_rewrite cannot be written: digres has no catalog tables
--dg CREATE RULE v1_upd_rule AS ON UPDATE TO v1 DO INSTEAD
--dg   UPDATE t1 SET a = NEW.a WHERE a = OLD.a;
CREATE VIEW v2 WITH (security_barrier = true) AS
  SELECT * FROM v1 WHERE EXISTS (SELECT 1);
--dg-cascade
--dg EXPLAIN (COSTS OFF) UPDATE v2 SET a = 1;
DROP VIEW v2;
DROP VIEW v1;
--dg-cascade
--dg DROP TABLE t1;
--
-- Test CREATE OR REPLACE VIEW turning a non-updatable view into an
-- auto-updatable view and adding check options in a single step
--
--dg-cascade
--dg CREATE TABLE t1 (a int, b text);
CREATE VIEW v1 AS SELECT null::int AS a;
CREATE OR REPLACE VIEW v1 AS SELECT * FROM t1 WHERE a > 0 WITH CHECK OPTION;
--dg-cascade
--dg INSERT INTO v1 VALUES (1, 'ok'); -- ok
--dg-cascade
--dg INSERT INTO v1 VALUES (-1, 'invalid'); -- should fail
DROP VIEW v1;
--dg-cascade
--dg DROP TABLE t1;
-- check that an auto-updatable view on a partitioned table works correctly
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table uv_pt (a int, b int, v varchar) partition by range (a, b);
--dg-skip: CREATE TABLE supports only columns, NOT NULL, PRIMARY KEY, UNIQUE and TEMPORARY yet
--dg create table uv_pt1 (b int not null, v varchar, a int not null) partition by range (b);
--dg-cascade
--dg create table uv_pt11 (like uv_pt1);
--dg-cascade
--dg alter table uv_pt11 drop a;
--dg-cascade
--dg alter table uv_pt11 add a int;
--dg-cascade
--dg alter table uv_pt11 drop a;
--dg-cascade
--dg alter table uv_pt11 add a int not null;
--dg-cascade
--dg alter table uv_pt1 attach partition uv_pt11 for values from (2) to (5);
--dg-cascade
--dg alter table uv_pt attach partition uv_pt1 for values from (1, 2) to (1, 10);
--dg-cascade
--dg create view uv_ptv as select * from uv_pt;
--dg-cascade
--dg select events & 4 != 0 AS upd,
--dg        events & 8 != 0 AS ins,
--dg        events & 16 != 0 AS del
--dg   from pg_catalog.pg_relation_is_updatable('uv_pt'::regclass, false) t(events);
--dg-cascade
--dg select pg_catalog.pg_column_is_updatable('uv_pt'::regclass, 1::smallint, false);
--dg-cascade
--dg select pg_catalog.pg_column_is_updatable('uv_pt'::regclass, 2::smallint, false);
--dg-cascade
--dg select table_name, is_updatable, is_insertable_into
--dg   from information_schema.views where table_name = 'uv_ptv';
--dg-cascade
--dg select table_name, column_name, is_updatable
--dg   from information_schema.columns where table_name = 'uv_ptv' order by column_name;
--dg-cascade
--dg insert into uv_ptv values (1, 2);
--dg-cascade
--dg select tableoid::regclass, * from uv_pt;
--dg-cascade
--dg create view uv_ptv_wco as select * from uv_pt where a = 0 with check option;
--dg-cascade
--dg insert into uv_ptv_wco values (1, 2);
--dg-cascade
--dg merge into uv_ptv t
--dg   using (values (1,2), (1,4)) as v(a,b) on t.a = v.a -- fail: matches 2 src rows
--dg   when matched then update set b = t.b + 1
--dg   when not matched then insert values (v.a, v.b + 1);
--dg-cascade
--dg merge into uv_ptv t
--dg   using (values (1,2), (1,4)) as v(a,b) on t.a = v.a and t.b = v.b
--dg   when matched then update set b = t.b + 1
--dg   when not matched then insert values (v.a, v.b + 1); -- fail: no partition for b=5
--dg-cascade
--dg merge into uv_ptv t
--dg   using (values (1,2), (1,3)) as v(a,b) on t.a = v.a and t.b = v.b
--dg   when matched then update set b = t.b + 1
--dg   when not matched then insert values (v.a, v.b + 1); -- ok
--dg-cascade
--dg select tableoid::regclass, * from uv_pt order by a, b;
--dg-cascade
--dg drop view uv_ptv, uv_ptv_wco;
--dg-cascade
--dg drop table uv_pt, uv_pt1, uv_pt11;
