--dg INSERT INTO t111
--dg SELECT i,i,'t111','t111d','{1,1,1}'::int[] FROM generate_series(1,10) g(i);
--dg-cascade
--dg ANALYZE t111;
--dg-cascade
--dg CREATE VIEW v1 WITH (security_barrier=true) AS
--dg SELECT *, (SELECT d FROM t11 WHERE t11.a = t1.a LIMIT 1) AS d
--dg FROM t1
--dg WHERE a > 5 AND EXISTS(SELECT 1 FROM t12 WHERE t12.a = t1.a);
--dg-cascade
--dg SELECT * FROM v1 WHERE a=3; -- should not see anything
--dg-cascade
--dg SELECT * FROM v1 WHERE a=8;
--dg-cascade
--dg EXPLAIN (VERBOSE, COSTS OFF)
--dg UPDATE v1 SET a=100 WHERE snoop(a) AND leakproof(a) AND a < 7 AND a != 6;
--dg-cascade
--dg UPDATE v1 SET a=100 WHERE snoop(a) AND leakproof(a) AND a < 7 AND a != 6;
--dg-cascade
--dg SELECT * FROM v1 WHERE a=100; -- Nothing should have been changed to 100
SELECT * FROM t1 WHERE a=100; -- Nothing should have been changed to 100
