--dg CREATE FUNCTION rw_view1_trig_fn()
--dg RETURNS trigger AS
--dg $$
--dg BEGIN
--dg   IF TG_OP = 'INSERT' THEN
--dg     UPDATE base_tbl SET b=NEW.b WHERE a=1;
--dg     RETURN NULL;
--dg   END IF;
--dg   RETURN NULL;
--dg END;
--dg $$
