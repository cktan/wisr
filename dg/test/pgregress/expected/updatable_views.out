--dg INSERT INTO t12
--dg SELECT i,i,'t12','{1,2}'::int[] FROM generate_series(1,10) g(i);
--dg-cascade
--dg ANALYZE t12;
--dg-cascade
--dg CREATE TABLE t111 () INHERITS (t11, t12);
