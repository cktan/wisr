--dg SELECT * FROM temporal_mltrng ORDER BY id, valid_at;
-- should fail:
--dg-cascade
--dg UPDATE  temporal_mltrng
--dg SET     id = '[1,2)',
--dg         valid_at = datemultirange(daterange('2018-03-05', '2018-05-05'))
--dg WHERE   id = '[21,22)';
-- set the scalar part to NULL
--dg-cascade
--dg UPDATE  temporal_mltrng
--dg SET     id = NULL,
--dg         valid_at = datemultirange(daterange('2018-03-05', '2018-05-05'))
--dg WHERE   id = '[21,22)';
-- set the multirange part to NULL
--dg-cascade
--dg UPDATE  temporal_mltrng
--dg SET     id = '[1,2)',
--dg         valid_at = NULL
--dg WHERE   id = '[21,22)';
-- rejects empty:
--dg-cascade
--dg UPDATE  temporal_mltrng
--dg SET     id = '[1,2)',
--dg         valid_at = '{}'
--dg WHERE   id = '[21,22)';
--dg-cascade
--dg SELECT * FROM temporal_mltrng ORDER BY id, valid_at;
