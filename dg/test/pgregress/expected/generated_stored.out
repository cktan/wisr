--dg   WHEN (NEW.* IS NOT NULL)  -- error
--dg   EXECUTE PROCEDURE gtest_trigger_func();
--dg-cascade
--dg CREATE TRIGGER gtest2 BEFORE INSERT ON gtest26
--dg   FOR EACH ROW
--dg   WHEN (NEW.a < 0)
--dg   EXECUTE PROCEDURE gtest_trigger_func();
--dg-cascade
--dg CREATE TRIGGER gtest3 AFTER DELETE OR UPDATE ON gtest26
--dg   FOR EACH ROW
--dg   WHEN (OLD.b < 0)  -- ok
