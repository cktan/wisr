--dg CREATE FUNCTION gtest_trigger_func() RETURNS trigger
--dg   LANGUAGE plpgsql
--dg AS $$
--dg BEGIN
--dg   IF tg_op IN ('DELETE', 'UPDATE') THEN
--dg     RAISE INFO '%: %: old = %', TG_NAME, TG_WHEN, OLD;
--dg   END IF;
--dg   IF tg_op IN ('INSERT', 'UPDATE') THEN
--dg     RAISE INFO '%: %: new = %', TG_NAME, TG_WHEN, NEW;
--dg   END IF;
--dg   IF tg_op = 'DELETE' THEN
--dg     RETURN OLD;
--dg   ELSE
--dg     RETURN NEW;
--dg   END IF;
--dg END
--dg $$;
--dg-cascade
--dg CREATE TRIGGER gtest1 BEFORE DELETE OR UPDATE ON gtest26
--dg   FOR EACH ROW
--dg   WHEN (OLD.b < 0)  -- ok
--dg   EXECUTE PROCEDURE gtest_trigger_func();
--dg-cascade
--dg CREATE TRIGGER gtest2a BEFORE INSERT OR UPDATE ON gtest26
--dg   FOR EACH ROW
--dg   WHEN (NEW.b < 0)  -- error
--dg   EXECUTE PROCEDURE gtest_trigger_func();
