ROLLBACK;
SELECT * FROM oer_test;
 a 
---
 1
 3
(2 rows)

BEGIN;
INSERT INTO oer_test VALUES (5);
COMMIT AND CHAIN;
INSERT INTO oer_test VALUES (6);
COMMIT;
SELECT * FROM oer_test;
