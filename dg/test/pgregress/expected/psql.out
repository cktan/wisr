BEGIN;
-- Create an owner for tested objects because output contains owner name.
--dg-skip: CREATE ROLE cannot run inside a transaction block
--dg CREATE ROLE regress_zeropriv_owner;
--dg-cascade
--dg SET LOCAL ROLE regress_zeropriv_owner;
--dg-cascade
--dg CREATE DOMAIN regress_zeropriv_domain AS int;
--dg-cascade
--dg REVOKE ALL ON DOMAIN regress_zeropriv_domain FROM CURRENT_USER, PUBLIC;
--dg-cascade
--dg \dD+ regress_zeropriv_domain
--dg-cascade
--dg CREATE PROCEDURE regress_zeropriv_proc() LANGUAGE sql AS '';
--dg-cascade
--dg REVOKE ALL ON PROCEDURE regress_zeropriv_proc() FROM CURRENT_USER, PUBLIC;
--dg-cascade
--dg \df+ regress_zeropriv_proc
--dg-cascade
--dg CREATE TABLE regress_zeropriv_tbl (a int);
--dg-cascade
--dg REVOKE ALL ON TABLE regress_zeropriv_tbl FROM CURRENT_USER;
--dg-cascade
--dg \dp regress_zeropriv_tbl
--dg-cascade
--dg CREATE TYPE regress_zeropriv_type AS (a int);
--dg-cascade
--dg REVOKE ALL ON TYPE regress_zeropriv_type FROM CURRENT_USER, PUBLIC;
--dg-cascade
--dg \dT+ regress_zeropriv_type
ROLLBACK;
