--
-- combined queries
--
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION warn(msg TEXT) RETURNS BOOLEAN LANGUAGE plpgsql
--dg AS $$
--dg   BEGIN RAISE NOTICE 'warn %', msg ; RETURN TRUE ; END
--dg $$;
-- show both
--dg-cascade
--dg SELECT 1 AS one \; SELECT warn('1.5') \; SELECT 2 AS two ;
-- \gset applies to last query only
--dg-cascade
--dg SELECT 3 AS three \; SELECT warn('3.5') \; SELECT 4 AS four \gset
--dg-cascade
--dg \echo :three :four
-- syntax error stops all processing
SELECT 5 \; SELECT 6 + \; SELECT warn('6.5') \; SELECT 7 ;
ERROR:  syntax error at or near ";"
LINE 1: SELECT 5 ; SELECT 6 + ; SELECT warn('6.5') ; SELECT 7 ;
                              ^
-- with aborted transaction, stop on first error
BEGIN \; SELECT 8 AS eight \; SELECT 9/0 AS nine \; ROLLBACK \; SELECT 10 AS ten ;
 eight 
-------
     8
(1 row)

ERROR:  division by zero
-- close previously aborted transaction
ROLLBACK;
-- miscellaneous SQL commands
-- (non SELECT output is sent to stderr, thus is not shown in expected results)
--dg-differs: the result
--dg SELECT 'ok' AS "begin" \;
--dg CREATE TABLE psql_comics(s TEXT) \;
--dg INSERT INTO psql_comics VALUES ('Calvin'), ('hobbes') \;
--dg COPY psql_comics FROM STDIN \;
--dg UPDATE psql_comics SET s = 'Hobbes' WHERE s = 'hobbes' \;
--dg DELETE FROM psql_comics WHERE s = 'Moe' \;
--dg COPY psql_comics TO STDOUT \;
--dg TRUNCATE psql_comics \;
--dg DROP TABLE psql_comics \;
--dg SELECT 'ok' AS "done" ;
--dg Moe
--dg Susie
--dg \.
\set SHOW_ALL_RESULTS off
--dg-cascade
--dg SELECT 1 AS one \; SELECT warn('1.5') \; SELECT 2 AS two ;
\set SHOW_ALL_RESULTS on
--dg-cascade
--dg DROP FUNCTION warn(TEXT);
--
-- \g with file
--
\getenv abs_builddir PG_ABS_BUILDDIR
\set g_out_file :abs_builddir '/results/psql-output1'
--dg-skip: CREATE SEQUENCE supports only START and INCREMENT yet, not TEMPORARY or UNLOGGED
--dg CREATE TEMPORARY TABLE reload_output(
--dg   lineno int NOT NULL GENERATED ALWAYS AS IDENTITY,
--dg   line text
--dg );
SELECT 1 AS a \g :g_out_file
--dg-cascade
--dg COPY reload_output(line) FROM :'g_out_file';
SELECT 2 AS b\; SELECT 3 AS c\; SELECT 4 AS d \g :g_out_file
--dg-cascade
--dg COPY reload_output(line) FROM :'g_out_file';
COPY (SELECT 'foo') TO STDOUT \; COPY (SELECT 'bar') TO STDOUT \g :g_out_file
--dg-cascade
--dg COPY reload_output(line) FROM :'g_out_file';
--dg-cascade
--dg SELECT line FROM reload_output ORDER BY lineno;
--dg-cascade
--dg TRUNCATE TABLE reload_output;
--
-- \o with file
--
\set o_out_file :abs_builddir '/results/psql-output2'
\o :o_out_file
SELECT max(unique1) FROM onek;
SELECT 1 AS a\; SELECT 2 AS b\; SELECT 3 AS c;
-- COPY TO file
-- The data goes to :g_out_file and the status to :o_out_file
\set QUIET false
COPY (SELECT unique1 FROM onek ORDER BY unique1 LIMIT 10) TO :'g_out_file';
-- DML command status
UPDATE onek SET unique1 = unique1 WHERE false;
\set QUIET true
\o
-- Check the contents of the files generated.
--dg-cascade
--dg COPY reload_output(line) FROM :'g_out_file';
--dg-cascade
--dg SELECT line FROM reload_output ORDER BY lineno;
--dg-cascade
--dg TRUNCATE TABLE reload_output;
--dg-cascade
--dg COPY reload_output(line) FROM :'o_out_file';
--dg-cascade
--dg SELECT line FROM reload_output ORDER BY lineno;
--dg-cascade
--dg TRUNCATE TABLE reload_output;
-- Multiple COPY TO STDOUT with output file
\o :o_out_file
-- The data goes to :o_out_file with no status generated.
COPY (SELECT 'foo1') TO STDOUT \; COPY (SELECT 'bar1') TO STDOUT;
-- Combination of \o and \g file with multiple COPY queries.
COPY (SELECT 'foo2') TO STDOUT \; COPY (SELECT 'bar2') TO STDOUT \g :g_out_file
\o
-- Check the contents of the files generated.
--dg-cascade
--dg COPY reload_output(line) FROM :'g_out_file';
--dg-cascade
--dg SELECT line FROM reload_output ORDER BY lineno;
--dg-cascade
--dg TRUNCATE TABLE reload_output;
--dg-cascade
--dg COPY reload_output(line) FROM :'o_out_file';
--dg-cascade
--dg SELECT line FROM reload_output ORDER BY lineno;
--dg-cascade
--dg DROP TABLE reload_output;
-- \copy must skip in-line data, even if the issued COPY command fails.
\copy no_such_table from stdin
ERROR:  relation "no_such_table" does not exist
\echo this should get output
this should get output
--
-- AUTOCOMMIT and combined queries
--
\set AUTOCOMMIT off
\echo '# AUTOCOMMIT:' :AUTOCOMMIT
# AUTOCOMMIT: off
-- BEGIN is now implicit
CREATE TABLE foo(s TEXT) \;
ROLLBACK;
CREATE TABLE foo(s TEXT) \;
INSERT INTO foo(s) VALUES ('hello'), ('world') \;
COMMIT;
DROP TABLE foo \;
ROLLBACK;
-- table foo is still there
SELECT * FROM foo ORDER BY 1 \;
DROP TABLE foo \;
COMMIT;
   s   
-------
 hello
 world
(2 rows)

\set AUTOCOMMIT on
\echo '# AUTOCOMMIT:' :AUTOCOMMIT
# AUTOCOMMIT: on
-- BEGIN now explicit for multi-statement transactions
BEGIN \;
CREATE TABLE foo(s TEXT) \;
INSERT INTO foo(s) VALUES ('hello'), ('world') \;
COMMIT;
BEGIN \;
DROP TABLE foo \;
ROLLBACK \;
-- implicit transactions
SELECT * FROM foo ORDER BY 1 \;
DROP TABLE foo;
   s   
-------
 hello
 world
(2 rows)

--
-- test ON_ERROR_ROLLBACK and combined queries
--
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION psql_error(msg TEXT) RETURNS BOOLEAN AS $$
--dg   BEGIN
--dg     RAISE EXCEPTION 'error %', msg;
--dg   END;
--dg $$ LANGUAGE plpgsql;
\set ON_ERROR_ROLLBACK on
\echo '# ON_ERROR_ROLLBACK:' :ON_ERROR_ROLLBACK
# ON_ERROR_ROLLBACK: on
\echo '# AUTOCOMMIT:' :AUTOCOMMIT
# AUTOCOMMIT: on
BEGIN;
CREATE TABLE bla(s NO_SUCH_TYPE);               -- fails
ERROR:  type "no_such_type" does not exist
LINE 1: CREATE TABLE bla(s NO_SUCH_TYPE);
                           ^
CREATE TABLE bla(s TEXT);                       -- succeeds
--dg-cascade
--dg SELECT psql_error('oops!');                     -- fails
INSERT INTO bla VALUES ('Calvin'), ('Hobbes');
COMMIT;
SELECT * FROM bla ORDER BY 1;
   s    
--------
 Calvin
 Hobbes
(2 rows)

BEGIN;
INSERT INTO bla VALUES ('Susie');         -- succeeds
-- now with combined queries
--dg-cascade
--dg INSERT INTO bla VALUES ('Rosalyn') \;     -- will rollback
--dg SELECT 'before error' AS show \;          -- will show nevertheless!
--dg   SELECT psql_error('boum!') \;           -- failure
--dg   SELECT 'after error' AS noshow;         -- hidden by preceding error
--dg-cascade
--dg INSERT INTO bla(s) VALUES ('Moe') \;      -- will rollback
--dg   SELECT psql_error('bam!');
INSERT INTO bla VALUES ('Miss Wormwood'); -- succeeds
COMMIT;
SELECT * FROM bla ORDER BY 1;
       s       
---------------
 Calvin
 Hobbes
 Miss Wormwood
 Susie
(4 rows)

-- some with autocommit off
\set AUTOCOMMIT off
\echo '# AUTOCOMMIT:' :AUTOCOMMIT
# AUTOCOMMIT: off
-- implicit BEGIN
INSERT INTO bla VALUES ('Dad');           -- succeeds
--dg-cascade
--dg SELECT psql_error('bad!');                -- implicit partial rollback
--dg-cascade
--dg INSERT INTO bla VALUES ('Mum') \;         -- will rollback
--dg SELECT COUNT(*) AS "#mum"
--dg FROM bla WHERE s = 'Mum' \;               -- but be counted here
--dg SELECT psql_error('bad!');                -- implicit partial rollback
COMMIT;
SELECT COUNT(*) AS "#mum"
FROM bla WHERE s = 'Mum' \;               -- no mum here
SELECT * FROM bla ORDER BY 1;
 #mum 
------
    0
(1 row)

       s       
---------------
 Calvin
 Dad
 Hobbes
 Miss Wormwood
 Susie
(5 rows)

COMMIT;
-- reset all
\set AUTOCOMMIT on
\set ON_ERROR_ROLLBACK off
\echo '# final ON_ERROR_ROLLBACK:' :ON_ERROR_ROLLBACK
# final ON_ERROR_ROLLBACK: off
DROP TABLE bla;
--dg-cascade
--dg DROP FUNCTION psql_error;
