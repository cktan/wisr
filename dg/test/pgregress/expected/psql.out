INSERT INTO ac_test VALUES (2);
ROLLBACK;
SELECT * FROM ac_test;
 a 
---
 1
(1 row)

COMMIT;
BEGIN;
INSERT INTO ac_test VALUES (3);
COMMIT;
SELECT * FROM ac_test;
 a 
---
 1
 3
(2 rows)

COMMIT;
BEGIN;
INSERT INTO ac_test VALUES (4);
ROLLBACK;
SELECT * FROM ac_test;
