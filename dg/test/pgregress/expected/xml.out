--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<foo><bar></bar></foo>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<foo><bar></bar></foo>' AS text INDENT);
