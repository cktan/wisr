-- if all is ok, then result is empty
-- one line xml test
--dg-cascade
--dg WITH
--dg    x AS (SELECT proname, proowner, procost::numeric, pronargs,
--dg                 array_to_string(proargnames,',') as proargnames,
--dg                 case when proargtypes <> '' then array_to_string(proargtypes::oid[],',') end as proargtypes
--dg            FROM pg_proc WHERE proname = 'f_leak'),
--dg    y AS (SELECT xmlelement(name proc,
--dg                            xmlforest(proname, proowner,
--dg                                      procost, pronargs,
--dg                                      proargnames, proargtypes)) as proc
--dg            FROM x),
--dg    z AS (SELECT xmltable.*
--dg            FROM y,
--dg                 LATERAL xmltable('/proc' PASSING proc
--dg                                  COLUMNS proname name,
--dg                                          proowner oid,
--dg                                          procost float,
--dg                                          pronargs int,
--dg                                          proargnames text,
--dg                                          proargtypes text))
--dg    SELECT * FROM z
--dg    EXCEPT SELECT * FROM x;
-- multi line xml test, result should be empty too
--dg-cascade
--dg WITH
--dg    x AS (SELECT proname, proowner, procost::numeric, pronargs,
--dg                 array_to_string(proargnames,',') as proargnames,
--dg                 case when proargtypes <> '' then array_to_string(proargtypes::oid[],',') end as proargtypes
--dg            FROM pg_proc),
--dg    y AS (SELECT xmlelement(name data,
--dg                            xmlagg(xmlelement(name proc,
--dg                                              xmlforest(proname, proowner, procost,
--dg                                                        pronargs, proargnames, proargtypes)))) as doc
--dg            FROM x),
--dg    z AS (SELECT xmltable.*
--dg            FROM y,
--dg                 LATERAL xmltable('/data/proc' PASSING doc
--dg                                  COLUMNS proname name,
--dg                                          proowner oid,
--dg                                          procost float,
--dg                                          pronargs int,
--dg                                          proargnames text,
--dg                                          proargtypes text))
--dg    SELECT * FROM z
--dg    EXCEPT SELECT * FROM x;
--dg-skip: type ? is not supported yet
--dg CREATE TABLE xmltest2(x xml, _path text);
--dg-cascade
--dg INSERT INTO xmltest2 VALUES('<d><r><ac>1</ac></r></d>', 'A');
--dg-cascade
--dg INSERT INTO xmltest2 VALUES('<d><r><bc>2</bc></r></d>', 'B');
--dg-cascade
--dg INSERT INTO xmltest2 VALUES('<d><r><cc>3</cc></r></d>', 'C');
--dg-cascade
--dg INSERT INTO xmltest2 VALUES('<d><r><dc>2</dc></r></d>', 'D');
--dg-cascade
--dg SELECT xmltable.* FROM xmltest2, LATERAL xmltable('/d/r' PASSING x COLUMNS a int PATH '' || lower(_path) || 'c');
--dg-cascade
--dg SELECT xmltable.* FROM xmltest2, LATERAL xmltable(('/d/r/' || lower(_path) || 'c') PASSING x COLUMNS a int PATH '.');
--dg-cascade
--dg SELECT xmltable.* FROM xmltest2, LATERAL xmltable(('/d/r/' || lower(_path) || 'c') PASSING x COLUMNS a int PATH 'x' DEFAULT ascii(_path) - 54);
-- XPath result can be boolean or number too
--dg-cascade
--dg SELECT * FROM XMLTABLE('*' PASSING '<a>a</a>' COLUMNS a xml PATH '.', b text PATH '.', c text PATH '"hi"', d boolean PATH '. = "a"', e integer PATH 'string-length(.)');
--dg-cascade
--dg \x
--dg-cascade
--dg SELECT * FROM XMLTABLE('*' PASSING '<e>pre<!--c1--><?pi arg?><![CDATA[&ent1]]><n2>&amp;deep</n2>post</e>' COLUMNS x xml PATH '/e/n2', y xml PATH '/');
--dg-cascade
--dg \x
--dg-cascade
--dg SELECT * FROM XMLTABLE('.' PASSING XMLELEMENT(NAME a) columns a varchar(20) PATH '"<foo/>"', b xml PATH '"<foo/>"');
