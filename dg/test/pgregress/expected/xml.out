-- Test xml_is_well_formed and variants
--dg-cascade
--dg SELECT xml_is_well_formed_document('<foo>bar</foo>');
--dg-cascade
--dg SELECT xml_is_well_formed_document('abc');
--dg-cascade
--dg SELECT xml_is_well_formed_content('<foo>bar</foo>');
--dg-cascade
--dg SELECT xml_is_well_formed_content('abc');
--dg-cascade
--dg SET xmloption TO DOCUMENT;
--dg-cascade
--dg SELECT xml_is_well_formed('abc');
--dg-cascade
--dg SELECT xml_is_well_formed('<>');
--dg-cascade
--dg SELECT xml_is_well_formed('<abc/>');
--dg-cascade
--dg SELECT xml_is_well_formed('<foo>bar</foo>');
--dg-cascade
--dg SELECT xml_is_well_formed('<foo>bar</foo');
--dg-cascade
--dg SELECT xml_is_well_formed('<foo><bar>baz</foo>');
--dg-cascade
--dg SELECT xml_is_well_formed('<local:data xmlns:local="http://127.0.0.1"><local:piece id="1">number one</local:piece><local:piece id="2" /></local:data>');
--dg-cascade
--dg SELECT xml_is_well_formed('<pg:foo xmlns:pg="http://postgresql.org/stuff">bar</my:foo>');
--dg-cascade
--dg SELECT xml_is_well_formed('<pg:foo xmlns:pg="http://postgresql.org/stuff">bar</pg:foo>');
--dg-cascade
--dg SELECT xml_is_well_formed('<invalidentity>&</abc>');
--dg-cascade
--dg SELECT xml_is_well_formed('<undefinedentity>&idontexist;</abc>');
--dg-cascade
--dg SELECT xml_is_well_formed('<invalidns xmlns=''&lt;''/>');
--dg-cascade
--dg SELECT xml_is_well_formed('<relativens xmlns=''relative''/>');
--dg-cascade
--dg SELECT xml_is_well_formed('<twoerrors>&idontexist;</unbalanced>');
--dg-cascade
--dg SET xmloption TO CONTENT;
--dg-cascade
--dg SELECT xml_is_well_formed('abc');
-- Since xpath() deals with namespaces, it's a bit stricter about
-- what's well-formed and what's not. If we don't obey these rules
-- (i.e. ignore namespace-related errors from libxml), xpath()
-- fails in subtle ways. The following would for example produce
-- the xml value
--   <invalidns xmlns='<'/>
-- which is invalid because '<' may not appear un-escaped in
-- attribute values.
-- Since different libxml versions emit slightly different
-- error messages, we suppress the DETAIL in this test.
--dg-cascade
--dg \set VERBOSITY terse
--dg-cascade
--dg SELECT xpath('/*', '<invalidns xmlns=''&lt;''/>');
--dg-cascade
--dg \set VERBOSITY default
-- Again, the XML isn't well-formed for namespace purposes
--dg-cascade
--dg SELECT xpath('/*', '<nosuchprefix:tag/>');
-- XPath deprecates relative namespaces, but they're not supposed to
-- throw an error, only a warning.
--dg-cascade
--dg SELECT xpath('/*', '<relativens xmlns=''relative''/>');
-- External entity references should not leak filesystem information.
--dg-cascade
--dg SELECT XMLPARSE(DOCUMENT '<!DOCTYPE foo [<!ENTITY c SYSTEM "/etc/passwd">]><foo>&c;</foo>');
--dg-cascade
--dg SELECT XMLPARSE(DOCUMENT '<!DOCTYPE foo [<!ENTITY c SYSTEM "/etc/no.such.file">]><foo>&c;</foo>');
-- This might or might not load the requested DTD, but it mustn't throw error.
--dg-cascade
--dg SELECT XMLPARSE(DOCUMENT '<!DOCTYPE chapter PUBLIC "-//OASIS//DTD DocBook XML V4.1.2//EN" "http://www.oasis-open.org/docbook/xml/4.1.2/docbookx.dtd"><chapter>&nbsp;</chapter>');
-- XMLPATH tests
--dg-skip: type ? is not supported yet
--dg CREATE TABLE xmldata(data xml);
--dg-cascade
--dg INSERT INTO xmldata VALUES('<ROWS>
--dg <ROW id="1">
--dg   <COUNTRY_ID>AU</COUNTRY_ID>
--dg   <COUNTRY_NAME>Australia</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID>
--dg </ROW>
--dg <ROW id="2">
--dg   <COUNTRY_ID>CN</COUNTRY_ID>
--dg   <COUNTRY_NAME>China</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID>
--dg </ROW>
--dg <ROW id="3">
--dg   <COUNTRY_ID>HK</COUNTRY_ID>
--dg   <COUNTRY_NAME>HongKong</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID>
--dg </ROW>
--dg <ROW id="4">
--dg   <COUNTRY_ID>IN</COUNTRY_ID>
--dg   <COUNTRY_NAME>India</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID>
--dg </ROW>
--dg <ROW id="5">
--dg   <COUNTRY_ID>JP</COUNTRY_ID>
--dg   <COUNTRY_NAME>Japan</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID><PREMIER_NAME>Sinzo Abe</PREMIER_NAME>
--dg </ROW>
--dg <ROW id="6">
--dg   <COUNTRY_ID>SG</COUNTRY_ID>
--dg   <COUNTRY_NAME>Singapore</COUNTRY_NAME>
--dg   <REGION_ID>3</REGION_ID><SIZE unit="km">791</SIZE>
--dg </ROW>
--dg </ROWS>');
-- XMLTABLE with columns
--dg-cascade
--dg SELECT  xmltable.*
--dg    FROM (SELECT data FROM xmldata) x,
--dg         LATERAL XMLTABLE('/ROWS/ROW'
--dg                          PASSING data
--dg                          COLUMNS id int PATH '@id',
--dg                                   _id FOR ORDINALITY,
--dg                                   country_name text PATH 'COUNTRY_NAME/text()' NOT NULL,
--dg                                   country_id text PATH 'COUNTRY_ID',
--dg                                   region_id int PATH 'REGION_ID',
--dg                                   size float PATH 'SIZE',
--dg                                   unit text PATH 'SIZE/@unit',
--dg                                   premier_name text PATH 'PREMIER_NAME' DEFAULT 'not specified');
--dg-cascade
--dg CREATE VIEW xmltableview1 AS SELECT  xmltable.*
--dg    FROM (SELECT data FROM xmldata) x,
--dg         LATERAL XMLTABLE('/ROWS/ROW'
--dg                          PASSING data
--dg                          COLUMNS id int PATH '@id',
--dg                                   _id FOR ORDINALITY,
--dg                                   country_name text PATH 'COUNTRY_NAME/text()' NOT NULL,
--dg                                   country_id text PATH 'COUNTRY_ID',
--dg                                   region_id int PATH 'REGION_ID',
--dg                                   size float PATH 'SIZE',
--dg                                   unit text PATH 'SIZE/@unit',
--dg                                   premier_name text PATH 'PREMIER_NAME' DEFAULT 'not specified');
--dg-cascade
--dg SELECT * FROM xmltableview1;
--dg-cascade
--dg \sv xmltableview1
--dg-cascade
--dg EXPLAIN (COSTS OFF) SELECT * FROM xmltableview1;
--dg-cascade
--dg EXPLAIN (COSTS OFF, VERBOSE) SELECT * FROM xmltableview1;
-- errors
--dg-cascade
--dg SELECT * FROM XMLTABLE (ROW () PASSING null COLUMNS v1 timestamp) AS f (v1, v2);
--dg-cascade
--dg SELECT * FROM XMLTABLE (ROW () PASSING null COLUMNS v1 timestamp __pg__is_not_null 1) AS f (v1);
-- XMLNAMESPACES tests
--dg-cascade
--dg SELECT * FROM XMLTABLE(XMLNAMESPACES('http://x.y' AS zz),
--dg                       '/zz:rows/zz:row'
--dg                       PASSING '<rows xmlns="http://x.y"><row><a>10</a></row></rows>'
--dg                       COLUMNS a int PATH 'zz:a');
--dg-cascade
--dg CREATE VIEW xmltableview2 AS SELECT * FROM XMLTABLE(XMLNAMESPACES('http://x.y' AS "Zz"),
--dg                       '/Zz:rows/Zz:row'
--dg                       PASSING '<rows xmlns="http://x.y"><row><a>10</a></row></rows>'
--dg                       COLUMNS a int PATH 'Zz:a');
--dg-cascade
--dg SELECT * FROM xmltableview2;
--dg-cascade
--dg \sv xmltableview2
--dg-cascade
--dg SELECT * FROM XMLTABLE(XMLNAMESPACES(DEFAULT 'http://x.y'),
--dg                       '/rows/row'
--dg                       PASSING '<rows xmlns="http://x.y"><row><a>10</a></row></rows>'
--dg                       COLUMNS a int PATH 'a');
--dg-cascade
--dg SELECT * FROM XMLTABLE('.'
--dg                        PASSING '<foo/>'
--dg                        COLUMNS a text PATH 'foo/namespace::node()');
-- used in prepare statements
--dg-cascade
--dg PREPARE pp AS
--dg SELECT  xmltable.*
--dg    FROM (SELECT data FROM xmldata) x,
--dg         LATERAL XMLTABLE('/ROWS/ROW'
--dg                          PASSING data
--dg                          COLUMNS id int PATH '@id',
--dg                                   _id FOR ORDINALITY,
--dg                                   country_name text PATH 'COUNTRY_NAME' NOT NULL,
--dg                                   country_id text PATH 'COUNTRY_ID',
--dg                                   region_id int PATH 'REGION_ID',
--dg                                   size float PATH 'SIZE',
--dg                                   unit text PATH 'SIZE/@unit',
--dg                                   premier_name text PATH 'PREMIER_NAME' DEFAULT 'not specified');
--dg-cascade
--dg EXECUTE pp;
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS "COUNTRY_NAME" text, "REGION_ID" int);
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id FOR ORDINALITY, "COUNTRY_NAME" text, "REGION_ID" int);
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id int PATH '@id', "COUNTRY_NAME" text, "REGION_ID" int);
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id int PATH '@id');
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id FOR ORDINALITY);
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id int PATH '@id', "COUNTRY_NAME" text, "REGION_ID" int, rawdata xml PATH '.');
--dg-cascade
--dg SELECT xmltable.* FROM xmldata, LATERAL xmltable('/ROWS/ROW[COUNTRY_NAME="Japan" or COUNTRY_NAME="India"]' PASSING data COLUMNS id int PATH '@id', "COUNTRY_NAME" text, "REGION_ID" int, rawdata xml PATH './*');
--dg-cascade
--dg SELECT * FROM xmltable('/root' passing '<root><element>a1a<!-- aaaa -->a2a<?aaaaa?> <!--z-->  bbbb<x>xxx</x>cccc</element></root>' COLUMNS element text);
--dg-cascade
--dg SELECT * FROM xmltable('/root' passing '<root><element>a1a<!-- aaaa -->a2a<?aaaaa?> <!--z-->  bbbb<x>xxx</x>cccc</element></root>' COLUMNS element text PATH 'element/text()'); -- should fail
