-- Round-trip non-ASCII data through xpath().
--dg-skip: language "?" does not exist
--dg DO $$
--dg DECLARE
--dg   xml_declaration text := '<?xml version="1.0" encoding="ISO-8859-1"?>';
--dg   degree_symbol text;
--dg   res xml[];
--dg BEGIN
--dg   -- Per the documentation, except when the server encoding is UTF8, xpath()
--dg   -- may not work on non-ASCII data.  The untranslatable_character and
--dg   -- undefined_function traps below, currently dead code, will become relevant
--dg   -- if we remove this limitation.
--dg   IF current_setting('server_encoding') <> 'UTF8' THEN
--dg     RAISE LOG 'skip: encoding % unsupported for xpath',
--dg       current_setting('server_encoding');
--dg     RETURN;
--dg   END IF;
--dg
--dg   degree_symbol := convert_from('\xc2b0', 'UTF8');
--dg   res := xpath('text()', (xml_declaration ||
--dg     '<x>' || degree_symbol || '</x>')::xml);
--dg   IF degree_symbol <> res[1]::text THEN
--dg     RAISE 'expected % (%), got % (%)',
--dg       degree_symbol, convert_to(degree_symbol, 'UTF8'),
--dg       res[1], convert_to(res[1]::text, 'UTF8');
--dg   END IF;
--dg EXCEPTION
--dg   -- character with byte sequence 0xc2 0xb0 in encoding "UTF8" has no equivalent in encoding "LATIN8"
--dg   WHEN untranslatable_character
--dg   -- default conversion function for encoding "UTF8" to "MULE_INTERNAL" does not exist
--dg   OR undefined_function
--dg   -- unsupported XML feature
--dg   OR feature_not_supported THEN
--dg     RAISE LOG 'skip: %', SQLERRM;
--dg END
--dg $$;
