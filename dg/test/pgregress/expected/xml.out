-- indent
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<foo><bar><val x="y">42</val></bar></foo>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<foo><bar><val x="y">42</val></bar></foo>' AS text INDENT);
-- no indent
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<foo><bar><val x="y">42</val></bar></foo>' AS text NO INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<foo><bar><val x="y">42</val></bar></foo>' AS text NO INDENT);
-- indent non singly-rooted xml
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<foo>73</foo><bar><val x="y">42</val></bar>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<foo>73</foo><bar><val x="y">42</val></bar>' AS text INDENT);
-- indent non singly-rooted xml with mixed contents
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT 'text node<foo>73</foo>text node<bar><val x="y">42</val></bar>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  'text node<foo>73</foo>text node<bar><val x="y">42</val></bar>' AS text INDENT);
-- indent singly-rooted xml with mixed contents
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<foo><bar><val x="y">42</val><val x="y">text node<val>73</val></val></bar></foo>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<foo><bar><val x="y">42</val><val x="y">text node<val>73</val></val></bar></foo>' AS text INDENT);
-- indent empty string
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '' AS text INDENT);
-- whitespaces
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '  ' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '  ' AS text INDENT);
-- indent null
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT NULL AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  NULL AS text INDENT);
-- indent with XML declaration
--dg-cascade
--dg SELECT xmlserialize(DOCUMENT '<?xml version="1.0" encoding="UTF-8"?><foo><bar><val>73</val></bar></foo>' AS text INDENT);
--dg-cascade
--dg SELECT xmlserialize(CONTENT  '<?xml version="1.0" encoding="UTF-8"?><foo><bar><val>73</val></bar></foo>' AS text INDENT);
