--dg SELECT xpath_exists('//town[text() = ''Cwmbran'']','<towns><town>Bidford-on-Avon</town><town>Cwmbran</town><town>Bristol</town></towns>'::xml);
--dg-cascade
--dg SELECT xpath_exists('count(/nosuchtag)', '<root/>'::xml);
