--dg 	    'concur_reindex_ind3'::regclass,
--dg 	    'concur_reindex_ind4'::regclass,
--dg 	    'concur_reindex_matview'::regclass)
--dg   ORDER BY 1, 2;
--dg-differs: the result
--dg REINDEX INDEX CONCURRENTLY concur_reindex_ind1;
--dg-differs: the result
--dg REINDEX TABLE CONCURRENTLY concur_reindex_tab;
--dg-cascade
--dg REINDEX TABLE CONCURRENTLY concur_reindex_matview;
--dg-cascade
--dg SELECT pg_describe_object(classid, objid, objsubid) as obj,
--dg        pg_describe_object(refclassid,refobjid,refobjsubid) as objref,
--dg        deptype
--dg FROM pg_depend
--dg WHERE classid = 'pg_class'::regclass AND
--dg   objid in ('concur_reindex_tab'::regclass,
--dg             'concur_reindex_ind1'::regclass,
--dg 	    'concur_reindex_ind2'::regclass,
--dg 	    'concur_reindex_ind3'::regclass,
--dg 	    'concur_reindex_ind4'::regclass,
