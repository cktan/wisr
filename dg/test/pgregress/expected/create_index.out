-- Test GIN index's reloptions
--
--dg-cascade
--dg CREATE INDEX gin_relopts_test ON array_index_op_test USING gin (i)
--dg   WITH (FASTUPDATE=on, GIN_PENDING_LIST_LIMIT=128);
--dg-cascade
