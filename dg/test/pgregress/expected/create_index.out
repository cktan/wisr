--
-- GIN over int[] and text[]
--
-- Note: GIN currently supports only bitmap scans, not plain indexscans
--
--dg-skip: type ? is not supported yet
--dg CREATE TABLE array_index_op_test (
--dg 	seqno		int4,
--dg 	i			int4[],
--dg 	t			text[]
--dg );
\set filename :abs_srcdir '/data/array.data'
--dg-cascade
--dg COPY array_index_op_test FROM :'filename';
--dg-cascade
--dg ANALYZE array_index_op_test;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i = '{NULL}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i @> '{NULL}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i && '{NULL}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i <@ '{NULL}' ORDER BY seqno;
SET enable_seqscan = OFF;
SET enable_indexscan = OFF;
SET enable_bitmapscan = ON;
--dg-cascade
--dg CREATE INDEX intarrayidx ON array_index_op_test USING gin (i);
--dg-cascade
--dg explain (costs off)
--dg SELECT * FROM array_index_op_test WHERE i @> '{32}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i @> '{32}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i && '{32}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i @> '{17}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i && '{17}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i @> '{32,17}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i && '{32,17}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i <@ '{38,34,32,89}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i = '{47,77}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i = '{}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i @> '{}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i && '{}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE i <@ '{}' ORDER BY seqno;
--dg-cascade
--dg CREATE INDEX textarrayidx ON array_index_op_test USING gin (t);
--dg-cascade
--dg explain (costs off)
--dg SELECT * FROM array_index_op_test WHERE t @> '{AAAAAAAA72908}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE t @> '{AAAAAAAA72908}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE t && '{AAAAAAAA72908}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE t @> '{AAAAAAAAAA646}' ORDER BY seqno;
--dg-cascade
--dg SELECT * FROM array_index_op_test WHERE t && '{AAAAAAAAAA646}' ORDER BY seqno;
