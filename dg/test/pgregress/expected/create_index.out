--dg-differs: no error where PostgreSQL has: REINDEX CONCURRENTLY cannot run inside a transaction block
--dg REINDEX INDEX CONCURRENTLY concur_temp_ind_1;
COMMIT;
-- ON COMMIT DELETE ROWS
