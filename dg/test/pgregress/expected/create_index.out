--
-- Try a GIN index with a lot of items with same key. (GIN creates a posting
-- tree when there are enough duplicates)
--
--dg-skip: type ? is not supported yet
--dg CREATE TABLE array_gin_test (a int[]);
--dg-cascade
--dg INSERT INTO array_gin_test SELECT ARRAY[1, g%5, g] FROM generate_series(1, 10000) g;
--dg-cascade
--dg CREATE INDEX array_gin_test_idx ON array_gin_test USING gin (a);
--dg-cascade
--dg SELECT COUNT(*) FROM array_gin_test WHERE a @> '{2}';
--dg-cascade
--dg DROP TABLE array_gin_test;
