-- test with RLS enabled.
CREATE ROLE regress_rls_copy_user;
CREATE ROLE regress_rls_copy_user_colperms;
CREATE TABLE rls_t1 (a int, b int, c int);
COPY rls_t1 (a, b, c) from stdin;
--dg-skip: relation pg_policy cannot be written: digres has no catalog tables
--dg CREATE POLICY p1 ON rls_t1 FOR SELECT USING (a % 2 = 0);
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, a FOREIGN KEY's ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg ALTER TABLE rls_t1 ENABLE ROW LEVEL SECURITY;
--dg-skip: ALTER TABLE supports only ADD COLUMN, DROP COLUMN, a FOREIGN KEY's ADD, DROP and VALIDATE CONSTRAINT, and RENAME yet
--dg ALTER TABLE rls_t1 FORCE ROW LEVEL SECURITY;
GRANT SELECT ON TABLE rls_t1 TO regress_rls_copy_user;
--dg-skip: column privileges are not supported yet
--dg GRANT SELECT (a, b) ON TABLE rls_t1 TO regress_rls_copy_user_colperms;
-- all columns
COPY rls_t1 TO stdout;
1	4	1
2	3	2
3	2	3
4	1	4
COPY rls_t1 (a, b, c) TO stdout;
1	4	1
2	3	2
3	2	3
4	1	4
-- subset of columns
COPY rls_t1 (a) TO stdout;
1
2
3
4
COPY rls_t1 (a, b) TO stdout;
1	4
2	3
3	2
4	1
-- column reordering
COPY rls_t1 (b, a) TO stdout;
4	1
3	2
2	3
1	4
SET SESSION AUTHORIZATION regress_rls_copy_user;
-- all columns
--dg-cascade
--dg COPY rls_t1 TO stdout;
--dg-cascade
--dg COPY rls_t1 (a, b, c) TO stdout;
-- subset of columns
--dg-cascade
--dg COPY rls_t1 (a) TO stdout;
--dg-cascade
--dg COPY rls_t1 (a, b) TO stdout;
-- column reordering
--dg-cascade
--dg COPY rls_t1 (b, a) TO stdout;
RESET SESSION AUTHORIZATION;
SET SESSION AUTHORIZATION regress_rls_copy_user_colperms;
-- attempt all columns (should fail)
COPY rls_t1 TO stdout;
ERROR:  permission denied for table rls_t1
COPY rls_t1 (a, b, c) TO stdout;
ERROR:  permission denied for table rls_t1
-- try to copy column with no privileges (should fail)
COPY rls_t1 (c) TO stdout;
ERROR:  permission denied for table rls_t1
-- subset of columns (should succeed)
--dg-cascade
--dg COPY rls_t1 (a) TO stdout;
--dg-cascade
--dg COPY rls_t1 (a, b) TO stdout;
RESET SESSION AUTHORIZATION;
-- test with INSTEAD OF INSERT trigger on a view
CREATE TABLE instead_of_insert_tbl(id serial, name text);
CREATE VIEW instead_of_insert_tbl_view AS SELECT ''::text AS str;
COPY instead_of_insert_tbl_view FROM stdin; -- fail
ERROR:  cannot copy to view "instead_of_insert_tbl_view"
HINT:  To enable copying to a view, provide an INSTEAD OF INSERT trigger.
--dg-skip: language "?" does not exist
--dg CREATE FUNCTION fun_instead_of_insert_tbl() RETURNS trigger AS $$
--dg BEGIN
--dg   INSERT INTO instead_of_insert_tbl (name) VALUES (NEW.str);
--dg   RETURN NULL;
--dg END;
--dg $$ LANGUAGE plpgsql;
--dg-cascade
--dg CREATE TRIGGER trig_instead_of_insert_tbl_view
--dg   INSTEAD OF INSERT ON instead_of_insert_tbl_view
--dg   FOR EACH ROW EXECUTE PROCEDURE fun_instead_of_insert_tbl();
--dg-cascade
--dg COPY instead_of_insert_tbl_view FROM stdin;
--dg test1
--dg \.
--dg-cascade
--dg SELECT * FROM instead_of_insert_tbl;
-- Test of COPY optimization with view using INSTEAD OF INSERT
-- trigger when relation is created in the same transaction as
-- when COPY is executed.
BEGIN;
CREATE VIEW instead_of_insert_tbl_view_2 as select ''::text as str;
--dg-cascade
--dg CREATE TRIGGER trig_instead_of_insert_tbl_view_2
--dg   INSTEAD OF INSERT ON instead_of_insert_tbl_view_2
--dg   FOR EACH ROW EXECUTE PROCEDURE fun_instead_of_insert_tbl();
--dg-cascade
--dg COPY instead_of_insert_tbl_view_2 FROM stdin;
--dg test1
--dg \.
--dg-cascade
--dg SELECT * FROM instead_of_insert_tbl;
COMMIT;
