--
-- Tests for the planner's "equivalence class" mechanism
--
-- One thing that's not tested well during normal querying is the logic
-- for handling "broken" ECs.  This is because an EC can only become broken
-- if its underlying btree operator family doesn't include a complete set
-- of cross-type equality operators.  There are not (and should not be)
-- any such families built into Postgres; so we have to hack things up
-- to create one.  We do this by making two alias types that are really
-- int8 (so we need no new C code) and adding only some operators for them
-- into the standard integer_ops opfamily.
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg create type int8alias1;
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg create function int8alias1in(cstring) returns int8alias1
--dg   strict immutable language internal as 'int8in';
--dg-cascade
--dg create function int8alias1out(int8alias1) returns cstring
--dg   strict immutable language internal as 'int8out';
--dg-cascade
--dg create type int8alias1 (
--dg     input = int8alias1in,
--dg     output = int8alias1out,
--dg     like = int8
--dg );
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg create type int8alias2;
--dg-skip: relation pg_type cannot be written: digres has no catalog tables
--dg create function int8alias2in(cstring) returns int8alias2
--dg   strict immutable language internal as 'int8in';
--dg-cascade
--dg create function int8alias2out(int8alias2) returns cstring
--dg   strict immutable language internal as 'int8out';
--dg-cascade
--dg create type int8alias2 (
--dg     input = int8alias2in,
--dg     output = int8alias2out,
--dg     like = int8
--dg );
--dg-cascade
--dg create cast (int8 as int8alias1) without function;
--dg-cascade
--dg create cast (int8 as int8alias2) without function;
--dg-cascade
--dg create cast (int8alias1 as int8) without function;
--dg-cascade
--dg create cast (int8alias2 as int8) without function;
--dg-cascade
--dg create function int8alias1eq(int8alias1, int8alias1) returns bool
--dg   strict immutable language internal as 'int8eq';
--dg-cascade
--dg create operator = (
--dg     procedure = int8alias1eq,
--dg     leftarg = int8alias1, rightarg = int8alias1,
--dg     commutator = =,
--dg     restrict = eqsel, join = eqjoinsel,
--dg     merges
--dg );
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   operator 3 = (int8alias1, int8alias1);
--dg-cascade
--dg create function int8alias2eq(int8alias2, int8alias2) returns bool
--dg   strict immutable language internal as 'int8eq';
--dg-cascade
--dg create operator = (
--dg     procedure = int8alias2eq,
--dg     leftarg = int8alias2, rightarg = int8alias2,
--dg     commutator = =,
--dg     restrict = eqsel, join = eqjoinsel,
--dg     merges
--dg );
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   operator 3 = (int8alias2, int8alias2);
--dg-cascade
--dg create function int8alias1eq(int8, int8alias1) returns bool
--dg   strict immutable language internal as 'int8eq';
--dg-cascade
--dg create operator = (
--dg     procedure = int8alias1eq,
--dg     leftarg = int8, rightarg = int8alias1,
--dg     restrict = eqsel, join = eqjoinsel,
--dg     merges
--dg );
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   operator 3 = (int8, int8alias1);
--dg-cascade
--dg create function int8alias1eq(int8alias1, int8alias2) returns bool
--dg   strict immutable language internal as 'int8eq';
--dg-cascade
--dg create operator = (
--dg     procedure = int8alias1eq,
--dg     leftarg = int8alias1, rightarg = int8alias2,
--dg     restrict = eqsel, join = eqjoinsel,
--dg     merges
--dg );
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   operator 3 = (int8alias1, int8alias2);
--dg-cascade
--dg create function int8alias1lt(int8alias1, int8alias1) returns bool
--dg   strict immutable language internal as 'int8lt';
--dg-cascade
--dg create operator < (
--dg     procedure = int8alias1lt,
--dg     leftarg = int8alias1, rightarg = int8alias1
--dg );
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   operator 1 < (int8alias1, int8alias1);
--dg-cascade
--dg create function int8alias1cmp(int8, int8alias1) returns int
--dg   strict immutable language internal as 'btint8cmp';
--dg-skip: relation pg_opfamily cannot be opened: digres has no catalog tables
--dg alter operator family integer_ops using btree add
--dg   function 1 int8alias1cmp (int8, int8alias1);
create table ec0 (ff int8 primary key, f1 int8, f2 int8);
--dg-cascade
--dg create table ec1 (ff int8 primary key, f1 int8alias1, f2 int8alias2);
--dg-cascade
--dg create table ec2 (xf int8 primary key, x1 int8alias1, x2 int8alias2);
-- for the moment we only want to look at nestloop plans
set enable_hashjoin = off;
set enable_mergejoin = off;
--
-- Note that for cases where there's a missing operator, we don't care so
-- much whether the plan is ideal as that we don't fail or generate an
-- outright incorrect plan.
--
explain (costs off)
  select * from ec0 where ff = f1 and f1 = '42'::int8;
            QUERY PLAN             
-----------------------------------
 Index Scan using ec0_pkey on ec0
   Index Cond: (ff = '42'::bigint)
   Filter: (f1 = '42'::bigint)
(3 rows)

--dg-cascade
--dg explain (costs off)
--dg   select * from ec0 where ff = f1 and f1 = '42'::int8alias1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1 where ff = f1 and f1 = '42'::int8alias1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1 where ff = f1 and f1 = '42'::int8alias2;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1, ec2 where ff = x1 and ff = '42'::int8;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1, ec2 where ff = x1 and ff = '42'::int8alias1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1, ec2 where ff = x1 and '42'::int8 = x1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1, ec2 where ff = x1 and x1 = '42'::int8alias1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1, ec2 where ff = x1 and x1 = '42'::int8alias2;
--dg-cascade
--dg create unique index ec1_expr1 on ec1((ff + 1));
--dg-cascade
--dg create unique index ec1_expr2 on ec1((ff + 2 + 1));
--dg-cascade
--dg create unique index ec1_expr3 on ec1((ff + 3 + 1));
--dg-cascade
--dg create unique index ec1_expr4 on ec1((ff + 4));
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1
--dg   where ss1.x = ec1.f1 and ec1.ff = 42::int8;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1
--dg   where ss1.x = ec1.f1 and ec1.ff = 42::int8 and ec1.ff = ec1.f1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss2
--dg   where ss1.x = ec1.f1 and ss1.x = ss2.x and ec1.ff = 42::int8;
-- let's try that as a mergejoin
set enable_mergejoin = on;
set enable_nestloop = off;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss2
--dg   where ss1.x = ec1.f1 and ss1.x = ss2.x and ec1.ff = 42::int8;
-- check partially indexed scan
set enable_nestloop = on;
set enable_mergejoin = off;
--dg-cascade
--dg drop index ec1_expr3;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1
--dg   where ss1.x = ec1.f1 and ec1.ff = 42::int8;
-- let's try that as a mergejoin
set enable_mergejoin = on;
set enable_nestloop = off;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec1,
--dg     (select ff + 1 as x from
--dg        (select ff + 2 as ff from ec1
--dg         union all
--dg         select ff + 3 as ff from ec1) ss0
--dg      union all
--dg      select ff + 4 as x from ec1) as ss1
--dg   where ss1.x = ec1.f1 and ec1.ff = 42::int8;
-- check effects of row-level security
set enable_nestloop = on;
set enable_mergejoin = off;
--dg-cascade
--dg alter table ec1 enable row level security;
--dg-skip: relation pg_class cannot be opened: digres has no catalog tables
--dg create policy p1 on ec1 using (f1 < '5'::int8alias1);
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg create user regress_user_ectest;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg grant select on ec0 to regress_user_ectest;
--dg-cascade
--dg grant select on ec1 to regress_user_ectest;
-- without any RLS, we'll treat {a.ff, b.ff, 43} as an EquivalenceClass
--dg-cascade
--dg explain (costs off)
--dg   select * from ec0 a, ec1 b
--dg   where a.ff = b.ff and a.ff = 43::bigint::int8alias1;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg set session authorization regress_user_ectest;
-- with RLS active, the non-leakproof a.ff = 43 clause is not treated
-- as a suitable source for an EquivalenceClass; currently, this is true
-- even though the RLS clause has nothing to do directly with the EC
--dg-cascade
--dg explain (costs off)
--dg   select * from ec0 a, ec1 b
--dg   where a.ff = b.ff and a.ff = 43::bigint::int8alias1;
reset session authorization;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg revoke select on ec0 from regress_user_ectest;
--dg-cascade
--dg revoke select on ec1 from regress_user_ectest;
--dg-skip: relation pg_authid cannot be opened: digres has no catalog tables
--dg drop user regress_user_ectest;
-- check that X=X is converted to X IS NOT NULL when appropriate
explain (costs off)
  select * from tenk1 where unique1 = unique1 and unique2 = unique2;
                         QUERY PLAN                          
-------------------------------------------------------------
 Seq Scan on tenk1
   Filter: ((unique1 IS NOT NULL) AND (unique2 IS NOT NULL))
(2 rows)

-- Test that broken ECs are processed correctly during self join removal.
-- Disable merge joins so that we don't get an error about missing commutator.
-- Test both orientations of the join clause, because only one of them breaks
-- the EC.
set enable_mergejoin to off;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec0 m join ec0 n on m.ff = n.ff
--dg   join ec1 p on m.ff + n.ff = p.f1;
--dg-cascade
--dg explain (costs off)
--dg   select * from ec0 m join ec0 n on m.ff = n.ff
--dg   join ec1 p on p.f1::int8 = (m.ff + n.ff)::int8alias1;
reset enable_mergejoin;
-- this could be converted, but isn't at present
explain (costs off)
  select * from tenk1 where unique1 = unique1 or unique2 = unique2;
                       QUERY PLAN                       
--------------------------------------------------------
 Seq Scan on tenk1
   Filter: ((unique1 = unique1) OR (unique2 = unique2))
(2 rows)

-- check that we recognize equivalence with dummy domains in the way
create temp table undername (f1 name, f2 int);
--dg-skip: schema "?" does not exist
--dg create temp view overview as
--dg   select f1::information_schema.sql_identifier as sqli, f2 from undername;
--dg-cascade
--dg explain (costs off)  -- this should not require a sort
--dg   select * from overview where sqli = 'foo' order by sqli;
--
-- test handling of merge/hash clauses that do not have valid commutators
--
-- There are not (and should not be) any such operators built into Postgres
-- that are mergejoinable or hashable but have no commutators; so we leverage
-- the alias type 'int8alias1' created in this file to conduct the tests.
-- That's why this test is included here rather than in join.sql.
begin;
--dg-cascade
--dg create table tbl_nocom(a int8, b int8alias1);
-- check that non-commutable merge clauses do not lead to error
--dg-cascade
--dg set enable_hashjoin to off;
--dg-cascade
--dg set enable_mergejoin to on;
--dg-cascade
--dg explain (costs off)
--dg select * from tbl_nocom t1 full join tbl_nocom t2 on t2.a = t1.b;
-- check that non-commutable hash clauses do not lead to error
--dg-cascade
--dg alter operator = (int8, int8alias1) set (hashes);
--dg-cascade
--dg alter operator family integer_ops using hash add
--dg   operator 1 = (int8, int8alias1);
--dg-cascade
--dg create function hashint8alias1(int8alias1) returns int
--dg   strict immutable language internal as 'hashint8';
--dg-cascade
--dg alter operator family integer_ops using hash add
--dg   function 1 hashint8alias1(int8alias1);
--dg-cascade
--dg set enable_hashjoin to on;
--dg-cascade
--dg set enable_mergejoin to off;
--dg-cascade
--dg explain (costs off)
--dg select * from tbl_nocom t1 full join tbl_nocom t2 on t2.a = t1.b;
abort;
