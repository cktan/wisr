----------------------------------------------------------------------------------------------------------------------------
 Subquery Scan on emp
   Filter: (emp.c <= 3)
   ->  WindowAgg
         Window: w1 AS (ORDER BY empsalary.salary ROWS BETWEEN UNBOUNDED PRECEDING AND '0'::bigint PRECEDING EXCLUDE GROUP)
         ->  Sort
               Sort Key: empsalary.salary
               ->  Seq Scan on empsalary
(7 rows)

