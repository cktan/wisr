psql:test/check_sequence.sql:15: ERROR:  sequence calls are not supported in CHECK constraints
DETAIL:  digres does not track CHECK dependencies on sequences.
alter table check_sequence_alter add check
  (pg_get_sequence_data(0::regclass) is null);
psql:test/check_sequence.sql:17: ERROR:  sequence calls are not supported in CHECK constraints
DETAIL:  digres does not track CHECK dependencies on sequences.
alter table check_sequence_alter add check
  (pg_get_serial_sequence('check_sequence_alter', 'a') is null);
psql:test/check_sequence.sql:19: ERROR:  sequence calls are not supported in CHECK constraints
DETAIL:  digres does not track CHECK dependencies on sequences.
drop table check_sequence_alter;
