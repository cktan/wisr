-- Verify that numeric, a decimal of at most 36 digits (DECIMAL.md), gives
-- PostgreSQL's results: its text, its scales, its errors.
-- 1. Read literals, text with spaces, base 16 and underscores; a literal
--    past 36 digits is a float8.
-- 2. Add, subtract, multiply and divide, at PostgreSQL's scales.
-- 3. Take remainders and integer quotients, compare across scales, and
--    round, truncate, take ceilings and floors.
-- 4. Take square roots, exponentials, logarithms and powers.
-- 5. Keep 36 digits, round to a typmod, and cast to and from the integers
--    and floats.
-- 6. Take scales, gcd, lcm and a factorial.
-- 7. Sum, average and take deviations of numerics and integers; int8 sums
--    past int8, of nulls, and over a moving window whose frame empties.
-- 8. Make a series and find a bucket.
-- 9. Use numeric in jsonb, jsonpath, extract, to_char, money and pg_lsn.
-- 10. Send values in PostgreSQL's binary format.
-- 11. Add, subtract, multiply, divide, take remainders, gcd and lcm of,
--     sum, average, round, truncate, take ceilings, floors and signs of,
--     and format
--     numerics of at most 17 digits by their own paths, and get what
--     decimal128's give, a product past 17 digits and sums across scales
--     and windows among them.
-- (Errors are server.sh's: a run stops at its first.)
SELECT 1.5, -0.001, 1e3, 1.50, '  12.340  '::numeric, '0x1F'::numeric, '1_000.5'::numeric;
 ?column? | ?column? | ?column? | ?column? | numeric | numeric | numeric 
----------+----------+----------+----------+---------+---------+---------
      1.5 |   -0.001 |     1000 |     1.50 |  12.340 |      31 |  1000.5
(1 row)

SELECT 1e300, 3.4e38, 1e35;
 ?column? | ?column? | ?column? 
----------+----------+----------
   1e+300 |  3.4e+38 |    1e+35
(1 row)

SELECT 1.5 + 2.25, 1.5 - 2.25, 1.5 * 2.25, 10 / 3.0, 1 / 3::numeric, 2.0 / 3;
 ?column? | ?column? | ?column? |      ?column?      |        ?column?        |        ?column?        
----------+----------+----------+--------------------+------------------------+------------------------
     3.75 |    -0.75 |    3.375 | 3.3333333333333333 | 0.33333333333333333333 | 0.66666666666666666667
(1 row)

SELECT 7.5 % 2, -7.5 % 2, div(7.5, 2), 1.5 = 1.50, 1.5 < 1.51, abs(-2.5), -(2.5);
 ?column? | ?column? | div | ?column? | ?column? | abs | ?column? 
----------+----------+-----+----------+----------+-----+----------
      1.5 |     -1.5 |   3 | t        | t        | 2.5 |     -2.5
(1 row)

SELECT round(2.5), round(-2.5), round(1.2345, 2), round(1234.5, -2), trunc(1.999, 2), trunc(-1.999), ceil(1.1), floor(-1.1);
 round | round | round | round | trunc | trunc | ceil | floor 
-------+-------+-------+-------+-------+-------+------+-------
     3 |    -3 |  1.23 |  1200 |  1.99 |    -1 |    2 |    -2
(1 row)

SELECT sqrt(2::numeric), sqrt(16::numeric), exp(1::numeric), ln(10::numeric), log(100::numeric), log(2, 8::numeric);
       sqrt        |       sqrt        |        exp         |         ln         |        log         |        log         
-------------------+-------------------+--------------------+--------------------+--------------------+--------------------
 1.414213562373095 | 4.000000000000000 | 2.7182818284590452 | 2.3025850929940457 | 2.0000000000000000 | 3.0000000000000000
(1 row)

SELECT power(2::numeric, 10), power(2::numeric, 0.5), power(2.0, -2), 2::numeric ^ 3;
       power        |       power        |       power        |      ?column?      
--------------------+--------------------+--------------------+--------------------
 1024.0000000000000 | 1.4142135623730950 | 0.2500000000000000 | 8.0000000000000000
(1 row)

SELECT 999999999999999999999999999999999999::numeric(36,0) + 0, '1.000000000000000000000000000000000000000000'::numeric(36,35);
               ?column?               |                numeric                
--------------------------------------+---------------------------------------
 999999999999999999999999999999999999 | 1.00000000000000000000000000000000000
(1 row)

SELECT 1.23::numeric(5,1), 123.45::numeric(5,2), 0.1::float8::numeric, 1.5::numeric::float8, 2.5::numeric::int4, 3.5::numeric::int8;
 numeric | numeric | numeric | float8 | int4 | int8 
---------+---------+---------+--------+------+------
     1.2 |  123.45 |     0.1 |    1.5 |    3 |    4
(1 row)

SELECT scale(1.230), min_scale(1.230), trim_scale(1.230), gcd(12.0, 18), lcm(1.5, 2.25), factorial(20);
 scale | min_scale | trim_scale | gcd | lcm  |      factorial      
-------+-----------+------------+-----+------+---------------------
     3 |         2 |       1.23 | 6.0 | 4.50 | 2432902008176640000
(1 row)

SELECT sum(x), avg(x), min(x), max(x) FROM (VALUES (1.5), (2.25), (3)) v(x);
 sum  |        avg         | min | max 
------+--------------------+-----+-----
 6.75 | 2.2500000000000000 | 1.5 |   3
(1 row)

SELECT sum(x::int8), avg(x::int4), stddev(x::int4), variance(x::numeric) FROM generate_series(1, 10) x;
 sum |        avg         |       stddev       |      variance      
-----+--------------------+--------------------+--------------------
  55 | 5.5000000000000000 | 3.0276503540974917 | 9.1666666666666667
(1 row)

SELECT x FROM generate_series(0.5, 2, 0.5) x;
  x  
-----
 0.5
 1.0
 1.5
 2.0
(4 rows)

SELECT width_bucket(5.35, 0.024, 10.06, 5), sign(-3.2);
 width_bucket | sign 
--------------+------
            3 |   -1
(1 row)

SELECT '{"a": 1.5, "b": [1, 2.25, -3]}'::jsonb, '{"a": 1}'::jsonb = '{"a": 1.0}'::jsonb;
             jsonb              | ?column? 
--------------------------------+----------
 {"a": 1.5, "b": [1, 2.25, -3]} | t
(1 row)

SELECT jsonb_path_query('{"x": 2.5}'::jsonb, '$.x * 2 + 1'::jsonpath, '{}'::jsonb, false);
 jsonb_path_query 
------------------
 6.0
(1 row)

SELECT extract(epoch FROM timestamp '2024-01-01 00:00:01.5'), to_char(1234.5::numeric, '9999.99'), to_char(0.000123::numeric(17,6), '9.99EEEE'), to_number('1,234.5', '9,999.9');
      extract      | to_char  |  to_char  | to_number 
-------------------+----------+-----------+-----------
 1704067201.500000 |  1234.50 |  1.23e-04 |    1234.5
(1 row)

SELECT 12.34::numeric::money, '0/10'::pg_lsn + 5::numeric, '0/20'::pg_lsn - '0/10'::pg_lsn;
 money  | ?column? | ?column? 
--------+----------+----------
 $12.34 | 0/15     |       16
(1 row)

SELECT numeric_send(1.5), numeric_send(-0.0001), numeric_send(0::numeric), numeric_send(12345678.9);
        numeric_send        |      numeric_send      |    numeric_send    |          numeric_send          
----------------------------+------------------------+--------------------+--------------------------------
 \x000200000000000100011388 | \x0001ffff400000040001 | \x0000000000000000 | \x000300010000000104d2162e2328
(1 row)

SELECT a * b, a % b, mod(b, a), sign(a), gcd(a, b), lcm(a, b), bool_and(gcd(a, b)::text = gcd(a::decimal128, b::decimal128)::text AND lcm(a, b)::text = lcm(a::decimal128, b::decimal128)::text AND (a + b)::text = (a::decimal128 + b::decimal128)::text AND (a - b)::text = (a::decimal128 - b::decimal128)::text AND (a * b)::text = (a::decimal128 * b::decimal128)::text AND (a / b)::text = (a::decimal128 / b::decimal128)::text AND (-a)::text = (-(a::decimal128))::text AND abs(a)::text = abs(a::decimal128)::text AND (a % b)::text = (a::decimal128 % b::decimal128)::text AND mod(b, a)::text = mod(b::decimal128, a::decimal128)::text AND sign(a)::text = sign(a::decimal128)::text) OVER () FROM (VALUES (1.5, 2.25), (-99999999999999.999, 0.001), (12345678901234567::numeric(17,0), -3), (0.00000000000000001, 7), (99999999999999999::numeric(17,0), 99999999999999999::numeric(17,0))) v(a, b);
              ?column?              |      ?column?       |         mod         | sign |         gcd         |         lcm         | bool_and 
------------------------------------+---------------------+---------------------+------+---------------------+---------------------+----------
                              3.375 |                1.50 |                0.75 |    1 |                0.75 |                4.50 | t
                -99999999999.999999 |               0.000 |               0.001 |   -1 |               0.001 |  99999999999999.999 | t
                 -37037036703703701 |                   1 |                  -3 |    1 |                   1 |   37037036703703701 | t
                0.00000000000000007 | 0.00000000000000001 | 0.00000000000000000 |    1 | 0.00000000000000001 | 7.00000000000000000 | t
 9999999999999999800000000000000001 |                   0 |                   0 |    1 |   99999999999999999 |   99999999999999999 | t
(5 rows)

SELECT sum(x), avg(x), sum(x)::text = sum(x::decimal128)::text, avg(x)::text = avg(x::decimal128)::text FROM (VALUES (1.5), (2.25), (-3), (0.001), (99999999999999999::numeric(17,0))) v(x);
          sum          |          avg          | ?column? | ?column? 
-----------------------+-----------------------+----------+----------
 99999999999999999.751 | 19999999999999999.950 | t        | t
(1 row)

