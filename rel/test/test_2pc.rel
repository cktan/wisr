# test_2pc.rel -- Two-Phase Commit (2PC): prepare, list, commit-prepared, abort-prepared

(def test-dir "/tmp/wisr_rel_test_2pc")
(rm-rf test-dir)
(env-init test-dir)
(env-attach test-dir)

(db-create "twopcdb")
(db-open "twopcdb")

(begin :rc)
(table-create accounts
  (columns
    (id :int4 :not-null)
    (holder :text :not-null)
    (balance :int8 :not-null)))
(insert accounts [1 "Alice" 1000])
(commit)

# 1. Prepare and Commit-Prepared
(begin :rc)
(insert accounts [2 "Bob" 500])
(prepare "tx_bob_deposit")

# Check prepared-list
(def plist (prepared-list))
(assert-count 1 plist)
(assert-eq ((plist 0) :gid) "tx_bob_deposit")

# Commit prepared transaction
(commit-prepared "tx_bob_deposit")

# Row 2 is now committed and visible
(begin :rc)
(assert-eq (read accounts 2) [2 "Bob" 500])
(commit)

# 2. Prepare and Abort-Prepared
(begin :rc)
(insert accounts [3 "Charlie" 750])
(prepare "tx_charlie_deposit")

(def plist2 (prepared-list))
(assert-count 1 plist2)
(assert-eq ((plist2 0) :gid) "tx_charlie_deposit")

# Abort prepared transaction
(abort-prepared "tx_charlie_deposit")

# Verify prepared list is empty and row 3 was aborted
(def plist3 (prepared-list))
(assert-count 0 plist3)

(begin :rc)
(assert-nil (read accounts 3))
(assert-count 2 (scan accounts))
(commit)

(db-close)
(env-detach :force true)
(rm-rf test-dir)
(print "test_2pc.rel: PASSED")
